# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Required Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Your composed Convex deployment's public endpoint (not a credential).
# Get this from: https://dashboard.convex.dev
CONVEX_URL=https://your-project.convex.cloud

# Server-only deployment administrator key for the app's internal handlers.
# Obtain it from your own deployment setup. Never use NEXT_PUBLIC_* for this key.
CORTEX_APP_DEPLOYMENT_ADMIN_KEY=your-private-deployment-admin-key

# Exact browser origin, including the port; use localhost consistently locally.
# Replace with the exact HTTPS origin for a hosted deployment.
CORTEX_APP_ORIGIN=http://localhost:3000

# Server-only first-admin bootstrap capability, supplied in the normal setup form.
# Generate a private value, for example with: openssl rand -hex 32
# This is separate from the deployment administrator key and account passwords.
CORTEX_APP_SETUP_TOKEN=your-private-first-setup-token

# OpenAI API Key for LLM and embeddings
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Private Account Scope
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# First setup assigns the tenant; normal registration cannot select tenant or role.
# Allowed memory spaces come from the verified server session, not an env default.

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Optional: Fact Extraction (SDK v0.18.0+)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable automatic LLM-powered fact extraction
CORTEX_FACT_EXTRACTION=true

# Model for fact extraction (default: gpt-4o-mini)
CORTEX_FACT_EXTRACTION_MODEL=gpt-4o-mini

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Optional: Graph Database (SDK v0.19.0+)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable automatic graph sync
# CORTEX_GRAPH_SYNC=true

# Neo4j connection (choose one)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password

# Or Memgraph connection
# MEMGRAPH_URI=bolt://localhost:7687
# MEMGRAPH_USERNAME=
# MEMGRAPH_PASSWORD=
