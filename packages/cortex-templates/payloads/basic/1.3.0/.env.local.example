# Already installed, verified development backend; app commands never deploy it.
CONVEX_URL=https://your-deployment.convex.cloud
# These selectors must match the host-issued token's current backend grants.
TENANT_ID=your-tenant
MEMORY_SPACE_ID=your-space
AGENT_ID=basic-assistant
AGENT_VERSION=1
# CLI only: host refresh callback rereads this private file each time.
CORTEX_AUTH_TOKEN_FILE=/absolute/path/to/host-jwt.txt
# Or set CORTEX_AUTH_TOKEN in the process environment; never commit a token.
RUNTIME_TIMEOUT_MS=30000
# HTTP requests supply their own Authorization: Bearer JWT. Server ignores CLI tokens.
HOST=127.0.0.1
PORT=3001
