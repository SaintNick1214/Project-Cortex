# Your already-owned backend, installed additively.
NEXT_PUBLIC_CONVEX_URL=https://your-owned-deployment.convex.cloud
NEXT_PUBLIC_CORTEX_HTTP_URL=https://your-owned-deployment.convex.site
NEXT_PUBLIC_CORTEX_TENANT_ID=your-verified-tenant
NEXT_PUBLIC_CORTEX_MEMORY_SPACE_ID=your-verified-memory-space
NEXT_PUBLIC_CORTEX_AGENT_ID=published-agent-id
NEXT_PUBLIC_CORTEX_AGENT_VERSION=1
CONVEX_URL=https://your-owned-deployment.convex.cloud
CORTEX_HTTP_URL=https://your-owned-deployment.convex.site
CORTEX_TENANT_ID=your-verified-tenant
CORTEX_MEMORY_SPACE_ID=your-verified-memory-space
CORTEX_AGENT_ID=published-agent-id
CORTEX_AGENT_VERSION=1
# JWT is supplied per request and kept only in browser memory.
# No model-provider secret is needed. AUTH_SECRET is only for the retained Auth.js example.
