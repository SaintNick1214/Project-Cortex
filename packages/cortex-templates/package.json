{
  "name": "@cortexmemory/templates",
  "version": "1.4.0",
  "description": "Independently versioned Cortex application template catalog and payloads",
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "files": [
    "catalog.json",
    "payloads",
    "README.md"
  ],
  "exports": {
    "./catalog": "./catalog.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "assemble": "node scripts/assemble-canonical.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint scripts tests --report-unused-disable-directives"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.5.2",
    "eslint": "^9.39.2",
    "globals": "^17.4.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.2.0"
}
