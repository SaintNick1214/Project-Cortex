{
  "name": "@cortexmemory/cli",
  "version": "0.39.0",
  "description": "CLI tool for managing Cortex Memory deployments, performing administrative tasks, and streamlining development workflows",
  "type": "module",
  "bin": {
    "cortex": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts/completions",
    "scripts/postinstall.js",
    "scripts/preuninstall.js",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "preuninstall": "node scripts/preuninstall.js",
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint . --report-unused-disable-directives",
    "test": "node scripts/test-runner.js all",
    "test:watch": "node scripts/test-runner.js all --watch",
    "test:coverage": "node scripts/test-runner.js all --coverage",
    "test:unit": "node scripts/test-runner.js unit",
    "test:commands": "node scripts/test-runner.js commands",
    "test:e2e": "node scripts/test-runner.js e2e",
    "test:integration": "node scripts/test-runner.js e2e",
    "test:fast": "node scripts/test-runner.js fast",
    "typecheck": "tsc --noEmit",
    "typecheck:templates": "cd templates/basic && npx tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build && npm run test:unit"
  },
  "keywords": [
    "cortex",
    "memory",
    "ai",
    "convex",
    "cli",
    "admin",
    "database",
    "management"
  ],
  "author": "Saint Nick LLC",
  "license": "FSL-1.1-Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaintNick1214/Project-Cortex.git",
    "directory": "packages/cortex-cli"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@cortexmemory/sdk": "^0.39.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "convex": "^1.46.0",
    "cosmiconfig": "^10.0.1",
    "dotenv": "^18.0.5",
    "fs-extra": "^11.4.1",
    "neo4j-driver": "^6.2.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "typescript": "~6.0.3",
    "@cortexmemory/templates": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14"
  },
  "packageManager": "npm@12.2.0"
}
