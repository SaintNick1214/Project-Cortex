{
  "name": "{{PROJECT_NAME}}",
  "version": "1.3.0",
  "description": "Verified Cortex backend-run CLI and authenticated HTTP example",
  "type": "module",
  "scripts": {
    "dev": "node dev-runner.mjs",
    "start": "node --env-file-if-exists=.env.local --import tsx src/index.ts",
    "server": "node --env-file-if-exists=.env.local --import tsx src/server.ts",
    "build": "tsc",
    "build:convex": "convex deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json && node --check dev-runner.mjs"
  },
  "dependencies": {
    "@cortexmemory/sdk": "^0.38.0",
    "@hono/node-server": "^2.1.3",
    "convex": "^1.46.0",
    "dotenv": "^18.0.5",
    "hono": "^4.13.12",
    "openai": "^7.27.0",
    "@convex-dev/agent": "0.7.3",
    "@convex-dev/ai-sdk-provider": "0.2.1",
    "@convex-dev/workflow": "0.4.8",
    "@convex-dev/workpool": "0.4.13",
    "ai": "7.0.127",
    "fast-sha256": "1.3.0",
    "neo4j-driver": "^6.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@12.2.0"
}
