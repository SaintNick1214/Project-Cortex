# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Auth Configuration (REQUIRED)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Auth.js secret for JWT signing and encryption
# Generate with: openssl rand -base64 32
# Or visit: https://generate-secret.vercel.app/32
AUTH_SECRET=your-auth-secret-here

# Use this exact origin in the browser and both settings, including the port.
# Local Next.js normalizes loopback hosts to localhost; do not mix it with 127.0.0.1.
# Replace both values with the same HTTPS origin for a hosted deployment.
AUTH_URL=http://localhost:3000
CORTEX_APP_ORIGIN=http://localhost:3000

# Normal guest and email/password login are supported; OAuth is not configured.

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI Provider Configuration (REQUIRED)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Option 1: Vercel AI Gateway (recommended for Vercel deployments)
# Instructions: https://vercel.com/ai-gateway
# This app's Gateway model selection requires AI_GATEWAY_API_KEY.
# AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# OpenAI is required for memory embeddings, including when using AI Gateway.
# It also supports direct OpenAI chat and title generation.
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Cortex Memory Configuration (REQUIRED)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Your composed Convex deployment's public endpoint (not a credential).
# Get this from: https://dashboard.convex.dev
# This is auto-set when you run: pnpm convex:dev
CONVEX_URL=https://your-project.convex.cloud

# Server-only deployment administrator key for the composed app's internal handlers.
# Obtain it from your own deployment setup. Never use NEXT_PUBLIC_* for this key.
CORTEX_APP_DEPLOYMENT_ADMIN_KEY=your-private-deployment-admin-key

# Explicit server-owned tenant for this app; keep it stable across restarts.
# Browser login/registration cannot choose this authority.
CORTEX_APP_TENANT_ID=chat-sdk-local

# Stable prefix for each authenticated or guest principal's separate memory space.
# Default: chat-sdk-demo
MEMORY_SPACE_ID=chat-sdk-demo

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Cortex Fact Extraction (Recommended)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable automatic LLM-powered fact extraction from conversations
# Extracts: preferences, identity, relationships, opinions
# Default: true
CORTEX_FACT_EXTRACTION=true

# Model for fact extraction
# Smaller models are faster and cheaper, but may miss nuance
# Options: gpt-4o-mini (fast), gpt-4o (accurate)
# Default: gpt-4o-mini
CORTEX_FACT_EXTRACTION_MODEL=gpt-4o-mini

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Optional: Graph Database
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable automatic graph sync for entity relationships
# Requires Neo4j or Memgraph connection below
# CORTEX_GRAPH_SYNC=true

# Neo4j connection
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password

# Or Memgraph connection (alternative to Neo4j)
# MEMGRAPH_URI=bolt://localhost:7687
# MEMGRAPH_USERNAME=
# MEMGRAPH_PASSWORD=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Optional: Redis for Resumable Streams
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable resumable streams across page refreshes
# Instructions: https://vercel.com/docs/redis
# REDIS_URL=redis://...

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Optional: Vercel Analytics
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Enable Vercel Analytics (automatically enabled on Vercel)
# VERCEL_ANALYTICS=true
