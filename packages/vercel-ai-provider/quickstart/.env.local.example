# Fresh Cortex backend installation with verified host authentication and a published agent.
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
# Required for private file upload/download and media previews; use the installed HTTP action origin.
NEXT_PUBLIC_CORTEX_HTTP_URL=https://your-project.convex.site
NEXT_PUBLIC_CORTEX_AGENT_ID=your-published-agent-id
NEXT_PUBLIC_CORTEX_AGENT_VERSION=1
# Optional selector when the verified actor has more than one eligible space.
# NEXT_PUBLIC_CORTEX_MEMORY_SPACE_ID=your-memory-space

# Enter a host-issued access token in the quickstart Connect form. It is kept only in
# memory. Applications can instead supply their host auth provider's fetchToken callback
# to CortexRuntimeClient. Never set a token or an upstream inference key in NEXT_PUBLIC_*.
# Inference, tools, embedding and asynchronous memory are configured on the backend.
# Optional local metadata diagnostics; contains no prompts, reply text or tokens.
# NEXT_PUBLIC_CORTEX_LATENCY_TRACE=1
