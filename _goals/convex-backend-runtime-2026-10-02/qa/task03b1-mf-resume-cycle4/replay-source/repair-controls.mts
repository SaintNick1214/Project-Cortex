await check('positive-real-fact-update-history-current',async()=>{const h=harness();await h.provisionScope();const a:any=await h.invoke(facts.store,factStoreArgs);const b:any=await h.invoke(facts.update,{memorySpaceId:'space-a',factId:a.factId,fact:'Updated current user assertion'});const hist:any[]=await h.invoke(facts.getHistory,{memorySpaceId:'space-a',factId:a.factId});assert.equal(hist.length,2);assert.deepEqual(hist.map(x=>[x.version,x.stale,x.historical]),[[1,true,true],[2,false,true]]);const current:any=await h.invoke(facts.get,{memorySpaceId:'space-a',factId:b.factId});assert.equal(current.fact,'Updated current user assertion');assert.equal(current.lineage.sourceRevision,2);let denied=false;try{await h.invoke(facts.get,{memorySpaceId:'space-a',factId:a.factId});}catch(e:any){denied=e.data?.code==='STALE_SOURCE';}assert(denied);return {historicalVersions:hist.length,currentRevision:current.lineage.sourceRevision,oldCurrentDenied:true};});
