for(const operation of ['update','updateInPlace'] as const)await check(`positive-extracted-${operation}-dedicated-binding-source-sibling-preserved`,async()=>{const h=harness();const owner=await h.provisionScope();const memory:any=await h.invoke(memories.store,memoryStoreArgs);const sharedBefore=structuredClone(h.db.rows.get('runtimeMemorySources')![0]);const memoryBefore=structuredClone(h.db.rows.get('memories')![0]);const fields={fact:'Extracted shared assertion',factType:'preference',confidence:80,tenantId:'tenant-a',memorySpaceId:'space-a',ownerPrincipalId:owner.principalId,lineage:memory.lineage,extractionPolicyVersion:'extract-v1',sourceType:'conversation',sourceRef:{memoryId:memory.memoryId},tags:[],version:1,createdAt:Date.now(),updatedAt:Date.now()};await h.db.insert('facts',{...fields,factId:'derived'});const sibling=await h.db.insert('facts',{...fields,factId:'sibling'});const siblingBefore=structuredClone(await h.db.get(sibling));const row:any=await h.invoke(facts[operation],{memorySpaceId:'space-a',factId:'derived',fact:'Explicit user correction',metadata:{manualSourceBinding:{resourceType:'memory',resourceId:memory.memoryId},runtimeEditor:{principalId:'forged'}}});assert.equal(row.fact,'Explicit user correction');assert.equal(row.manualSourceBinding.resourceType,'fact');assert.equal(row.lineage.trust,'user_assertion');assert.equal(row.runtimeEditor.principalId,owner.principalId);assert.notEqual(row.lineage.sourceId,memory.lineage.sourceId);assert.deepEqual(h.db.rows.get('runtimeMemorySources')![0],sharedBefore);assert.deepEqual(h.db.rows.get('memories')![0],memoryBefore);assert.deepEqual(await h.db.get(sibling),siblingBefore);return {sharedSourcePreserved:true,siblingPreserved:true,binding:row.manualSourceBinding.resourceType,actorBound:true};});
for(const kind of ['memory','fact'] as const)await check(`positive-${kind}-distinct-raw-tenant-read-space-write`,async()=>{const h=harness();const writer=await h.provisionScope({capabilities:['write']});await h.seedData(kind==='memory'?'memories':'facts',writer,'private',{tags:['archived']});const reader=await h.provisionTenantRead();assert.notEqual(reader.grantId,writer.grantId);assert.equal(reader.memorySpaceId,undefined);const result:any=await h.invoke(kind==='memory'?memories.restoreFromArchive:facts.updateInPlace,{memorySpaceId:'space-a',memoryId:'private',factId:'private',confidence:90});assert.equal(kind==='memory'?result.memory.content:result.fact,'tenant-a private private');return {distinctGrant:true,tenantReader:true,privateResponse:true};});
for(const kind of ['memory','fact'] as const)for(const readable of [false,true])await check(`positive-${kind}-two-row-delete-readable-${readable}`,async()=>{const h=harness();const owner=await h.provisionScope({capabilities:readable?['read','write']:['write']});await h.seedData(kind==='memory'?'memories':'facts',owner,'first');await h.seedData(kind==='memory'?'memories':'facts',owner,'second');const result:any=await h.invoke(kind==='memory'?memories.deleteMany:facts.deleteMany,{memorySpaceId:'space-a'});assert.equal(result.deleted,2);if(kind==='memory')assert.deepEqual(result,readable?{deleted:2,memoryIds:['first','second']}:{deleted:2,mutationReceipt:true});else assert.deepEqual(result,{deleted:2,memorySpaceId:'space-a'});assert.equal(h.db.rows.get('runtimeAuthTombstones')!.length,2);assert((h.db.rows.get(kind==='memory'?'memories':'facts')??[]).every(r=>typeof r.tombstonedAt==='number'));return {deleted:2,unsuppliedIdsDisclosed:kind==='memory'&&readable};});
for(const kind of ['memory','fact'] as const)for(const readable of [false,true])for(const mode of ['source-valid-payload','tenant-resource','source-control'] as const)await check(`deletion-${kind}-readable-${readable}-${mode}-late-denies-rollback`,async()=>{const h=harness();const owner=await h.provisionScope({capabilities:readable?['read','write']:['write']});const table=kind==='memory'?'memories':'facts';await h.seedData(table,owner,'first');await h.seedData(table,owner,'second');const source=h.db.rows.get('runtimeMemorySources')![0];const text='Independent canonical replacement';const hash=await semanticHash(text);const before=structuredClone(h.db.rows);h.db.attemptedWrites=[];const patch=h.db.patch.bind(h.db);let injected=false;h.db.patch=async(...args:any[])=>{await (patch as any)(...args);const id=typeof args[1]==='string'?args[1]:args[0];if(!injected&&String(id).startsWith(table+'/')){injected=true;if(mode==='source-valid-payload')await patch(source._id,{content:text,contentHash:hash});else await h.db.insert('runtimeAuthTombstones',{tenantId:'tenant-a',resourceType:mode==='tenant-resource'?kind:'source',resourceId:mode==='tenant-resource'?'first':(source.lineage as any).sourceId,deletedAt:Date.now()});}};const code=await deny(h,()=>h.invoke(kind==='memory'?memories.deleteMany:facts.deleteMany,{memorySpaceId:'space-a'}),before);assert(injected);return {injected,code,rolledBack:true,attemptedDataWrites:h.db.attemptedWrites.filter(x=>x.startsWith('patch:'+table+'/')).length};});
for(const kind of ['memory','fact'] as const)for(const capability of ['read','write'] as const)await check(`final-source-reload-expiry-${kind}-${capability}`,async()=>{const h=harness();const writer=await h.provisionScope({capabilities:['write']});await h.seedData(kind==='memory'?'memories':'facts',writer,'private',{tags:['archived']});const base=Date.now();const reader=await h.provisionTenantRead(base+(capability==='read'?1000000:2000000));await h.db.patch(writer.grantId,{expiresAt:base+(capability==='write'?1000000:2000000)});const before=structuredClone(h.db.rows);h.db.attemptedWrites=[];let time=base;let readAdmitted=false;let hashes=0;let finalHash=false;let grantReads=0;let finalGrantsFetched=false;let injected=false;const now=Date.now;const digest=crypto.subtle.digest;const get=h.db.get.bind(h.db);const query=h.db.query.bind(h.db);Date.now=()=>time;h.setAuthHook(async()=>{if(h.db.attemptedWrites.some(x=>x.startsWith(kind==='memory'?'patch:memories/':'patch:facts/')))readAdmitted=true;});crypto.subtle.digest=async(a:any,b:any)=>{if(readAdmitted&&++hashes===2)finalHash=true;return await digest.call(crypto.subtle,a,b);};h.db.get=async(...args:any[])=>{const row=await (get as any)(...args);if(finalHash&&(args[1]??args[0])===reader.grantId&&++grantReads===3)finalGrantsFetched=true;return row;};h.db.query=(table:string)=>{const selection=query(table);const unique=selection.unique;selection.unique=async()=>{const row=await unique();if(table==='runtimeMemorySources'&&finalGrantsFetched){injected=true;time=base+1000001;}return row;};return selection;};try{const code=await deny(h,()=>h.invoke(kind==='memory'?memories.restoreFromArchive:facts.updateInPlace,{memorySpaceId:'space-a',memoryId:'private',factId:'private',confidence:90}),before);assert(injected);assert.equal(grantReads,3);assert(finalGrantsFetched);return {injected,finalRawGrantsFetched:true,grantReads,code,rolledBack:true};}finally{Date.now=now;crypto.subtle.digest=digest;}});
