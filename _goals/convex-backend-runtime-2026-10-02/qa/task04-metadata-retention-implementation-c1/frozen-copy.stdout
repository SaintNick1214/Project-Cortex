import type {Receipt,BindingV2,Data,Category,Method,Reason} from './contracts.ts';
import {binding,canonical,count,hash,id,record,one,list,same,micro,conservativeUsdDecimal,caseFor,fail} from './validate.ts';
import {BINDING,SOURCE_SNAPSHOT} from './installed.ts';
export interface Context {binding:BindingV2;scenarioId:Receipt['scenarioId'];dispatchIdentity:string;enteredAt:number;now:number;originalDeadline:number;sourceClosureHash:string}
export type Decision<T>={kind:'validated';proofHash:string;value:T}|{kind:'unknown';reason:Exclude<Reason,'none'|'authority-closed'>};
export interface Nomination {method:Method;responseId:string|null;actualModel:string|null;rawFinish:Receipt['rawFinish'];nativeFinish:Receipt['nativeFinish'];nativeRawFinish:string|null;correlatedShape:boolean;rawDigest:string;ended:'returned'|'reader-done'|'abort'|'deadline'|'error';rawCost:unknown;rawCurrency:string|null;categories:Category[];outcome:'returned'|'rejected'|'cancelled'|'unknown'}
export interface Resolver {lifetime(ctx:Context,n:Nomination):Decision<true>;serving(ctx:Context,n:Nomination):Decision<Data>;money(ctx:Context,n:Nomination):Decision<{microUSD:number;currency:'USD';categories:Category[]}>}
export const ACTUAL_PROOFS:readonly Data[]=Object.freeze([]);
const common='version proofHash type installationHash reviewerAcceptanceHash validatorSourceHash providerSourceHash providerVersion adapterVersion providerV4Version loadedClosureHash sourceRevision checkedAt expiresAt targetHash manifestHash requestedModel actualModels methods';
export function validateProof(value:unknown):Data {const r=record(value);const type=one(r.type,['lifetime','serving','money']);const extra=type==='lifetime'?'rule supportsRawFinish confirmsWholeInvocationTermination':type==='serving'?'exactObservedModel immutableRevision tokenizerArtifact framingProof capProof decoderProof nativePrivateCorrespondenceProof boundsRevision inputUCap outputMCap privateMaximumBytes':'extraction currency aggregate categories coversAllAttempts coversDriftModels rejectedAndCancelledChargeRule cacheAndRoutingChargeRule currencySemanticProof wholeInvocationProof rateRevision categorySemanticProof';record(r,common+' '+extra);if(r.version!==1||r.providerVersion!=='0.2.1'||r.adapterVersion!=='3.0.14'||r.providerV4Version!=='4.0.21')fail('PROOF_VERSION');for(const k of ['proofHash','installationHash','reviewerAcceptanceHash','validatorSourceHash','providerSourceHash','loadedClosureHash','sourceRevision','targetHash','manifestHash'])hash(r[k]);count(r.checkedAt);count(r.expiresAt);if(Number(r.checkedAt)>=Number(r.expiresAt))fail('PROOF_TIME');one(r.requestedModel,['openai/gpt-4o-mini','openai/text-embedding-3-small']);const models=list(r.actualModels,16).map(id),methods=list(r.methods,3).map(x=>one(x,['generate','stream','embed']));same(models,[...new Set(models)].sort());same(methods,[...new Set(methods)].sort());if(type==='lifetime'){one(r.rule,['chat-correlated-raw-native-finish-v1','successful-single-vector-response-id-model-v1']);same(r.supportsRawFinish,r.rule==='chat-correlated-raw-native-finish-v1'?['stop','length','content_filter']:[]);if(r.confirmsWholeInvocationTermination!==true)fail('PROOF');}else if(type==='serving'){id(r.exactObservedModel);id(r.immutableRevision);for(const k of ['tokenizerArtifact','framingProof','capProof','decoderProof','nativePrivateCorrespondenceProof','boundsRevision'])hash(r[k]);for(const k of ['inputUCap','outputMCap','privateMaximumBytes'])count(r[k]);}else {if(r.extraction!=='raw-usage-cost-v1'||r.currency!=='USD'||r.aggregate!=='complete-whole-invocation-account-charge'||r.coversAllAttempts!==true)fail('PROOF');same(r.categories,['cache-read','cache-write','cancelled','inference','rejected','routing','surcharge']);const drift=list(r.coversDriftModels,16).map(id);same(drift,[...new Set(drift)].sort());for(const k of ['rejectedAndCancelledChargeRule','cacheAndRoutingChargeRule','currencySemanticProof','wholeInvocationProof','rateRevision','categorySemanticProof'])hash(r[k]);}canonical(r,8192);return r}
/** Registry constructor is server code only. Accepted content/review/installation pins are compiled,
 * never run/capture args. Actual exported registry below is EMPTY. Tests use disjoint synthetic pins. */
export function createResolver(entries:readonly unknown[],accepted:readonly {proofHash:string;canonical:string}[],installationHash:string):Resolver {const proofs=entries.map(validateProof);for(const p of proofs){const pin=accepted.find(x=>x.proofHash===p.proofHash);if(!pin||pin.canonical!==canonical(p,8192)||p.installationHash!==installationHash)fail('UNREVIEWED_PROOF');}const unknown:Decision<never>={kind:'unknown',reason:'missing-evidence'};function choose(type:string,ctx:Context,n:Nomination){binding(ctx.binding);same(ctx.binding,BINDING);const eligible=proofs.filter(p=>p.type===type&&p.providerSourceHash===SOURCE_SNAPSHOT.providerSourceHash&&p.targetHash===ctx.binding.targetHash&&p.manifestHash===ctx.binding.manifestHash&&p.loadedClosureHash===ctx.sourceClosureHash&&ctx.sourceClosureHash===ctx.binding.installedClosureHash&&p.requestedModel===(n.method==='embed'?'openai/text-embedding-3-small':'openai/gpt-4o-mini')&&Number(p.checkedAt)<=ctx.enteredAt&&ctx.enteredAt<Number(p.expiresAt)&&(p.methods as string[]).includes(n.method)&&n.actualModel!==null&&(p.actualModels as string[]).includes(n.actualModel));if(eligible.length>1)fail('PROOF_COLLISION');return eligible[0]}
return Object.freeze({lifetime(ctx:Context,n:Nomination):Decision<true>{const p=choose('lifetime',ctx,n);if(!p||!n.correlatedShape||!n.responseId||!n.actualModel)return unknown;const rule=n.method==='embed'?'successful-single-vector-response-id-model-v1':'chat-correlated-raw-native-finish-v1';if(p.rule!==rule||n.method!=='embed'&&(!['stop','length','content_filter'].includes(String(n.rawFinish))||n.nativeRawFinish!==n.rawFinish||n.nativeFinish!==({stop:'stop',length:'length',content_filter:'content-filter'} as Data)[String(n.rawFinish)]))return {kind:'unknown',reason:'unsupported'};return {kind:'validated',proofHash:String(p.proofHash),value:true}},serving(ctx:Context,n:Nomination):Decision<Data>{const p=choose('serving',ctx,n);const c=caseFor(ctx.scenarioId);if(!p||n.actualModel!==p.requestedModel||n.actualModel!==p.exactObservedModel||Number(p.inputUCap)<c.inputU||Number(p.outputMCap)<c.maximumOutputM||Number(p.privateMaximumBytes)<c.conditionalPrivateMaximumBytes)return unknown;return {kind:'validated',proofHash:String(p.proofHash),value:p}},money(ctx:Context,n:Nomination):Decision<{microUSD:number;currency:'USD';categories:Category[]}>{const p=choose('money',ctx,n);if(!p||!n.actualModel||!n.responseId||!n.categories.length)return unknown;if(n.actualModel!==p.requestedModel&&!(p.coversDriftModels as string[]).includes(n.actualModel))return unknown;const d=conservativeUsdDecimal(n.rawCost);if(d===undefined)return unknown;try{return {kind:'validated',proofHash:String(p.proofHash),value:{microUSD:micro(d),currency:'USD',categories:n.categories}}}catch{return {kind:'unknown',reason:'unsupported'}}}})}
export const EMPTY_RESOLVER=createResolver(ACTUAL_PROOFS,[],BINDING.installedClosureHash);
export function unknownReceipt(ctx:Context,c:{normalizedNativeRequestHash:string;expectedWireBodyHash:string;method:Method;nativeInterface:'chat'|'embedding';modelId:Receipt['requestedModel']},rawDigest:string):Receipt{return {version:2,evidenceScope:'actual-experiment-native',binding:ctx.binding,scenarioId:ctx.scenarioId,dispatchIdentity:ctx.dispatchIdentity,nativeHash:c.normalizedNativeRequestHash,expectedWireHash:c.expectedWireBodyHash,rawDigest,method:c.method,interface:c.nativeInterface,requestedModel:c.modelId,responseId:null,actualModel:null,rawFinish:null,nativeFinish:null,nativeRawFinish:null,rawCounts:{input:null,output:null},mappedCounts:{input:null,output:null},usage:'unknown',lifetime:'unknown',lifetimeProof:null,serving:'unknown',servingProof:null,money:'unknown',observedCostDecimal:null,observedCurrency:null,observedCategories:[],microUSD:null,moneyProof:null,resultHash:null,reason:'missing-evidence'}}
export function qualify(ctx:Context,r:Receipt,n:Nomination,resolver:Resolver){const lifetime=resolver.lifetime(ctx,n),serving=resolver.serving(ctx,n),money=resolver.money(ctx,n);if(lifetime.kind==='validated'){r.lifetime='validated-provider-terminal';r.lifetimeProof=lifetime.proofHash;}if(serving.kind==='validated'){r.serving='validated-bound-premises';r.servingProof=serving.proofHash;}else if(r.actualModel!==null&&r.actualModel!==r.requestedModel)r.serving='drift';if(money.kind==='validated'){r.money='validated-whole-invocation-usd';r.microUSD=money.value.microUSD;r.observedCurrency='USD';r.observedCategories=money.value.categories;r.moneyProof=money.proofHash;}if(r.reason==='missing-evidence'&&r.usage==='validated-raw-mapped'&&r.lifetime==='validated-provider-terminal'&&r.serving==='validated-bound-premises'&&r.money==='validated-whole-invocation-usd'&&r.resultHash!==null)r.reason='none';return r}


