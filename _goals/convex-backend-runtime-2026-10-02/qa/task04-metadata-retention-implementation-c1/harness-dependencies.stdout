import assert from 'node:assert/strict';
import {Harness} from './harness.mjs';
import * as guard from '../convex/guard.ts';
import {BINDING} from '../convex/installed.ts';
import {CASES,ORDER} from '../convex/cases.ts';
import {canonical,micro} from '../convex/validate.ts';
import {observeGenerate,observeStream,observeEmbed,makeEvent} from '../convex/observer.ts';
const H='a'.repeat(64),cats=['cache-read','cache-write','cancelled','inference','rejected','routing','surcharge'];
// DUMMY conditional trusted server resolver; no installed actual registry/native/proof claims.
const resolver={lifetime:(_c,n)=>n.correlatedShape?{kind:'validated',proofHash:H,value:true}:{kind:'unknown',reason:'missing-evidence'},serving:()=>({kind:'validated',proofHash:H,value:{}}),money:(_c,n)=>({kind:'validated',proofHash:H,value:{microUSD:micro(n.rawCost),currency:'USD',categories:cats}})};
export const h=await new Harness().setup(guard.buildControls(resolver));
for(const scenarioId of ORDER){await h.reserve(scenarioId);await h.enter(scenarioId);if(scenarioId==='C09')break;const a=h.state().attempts.at(-1),c=CASES.find(c=>c.scenarioId===scenarioId),now=Date.now(),oc={binding:BINDING,scenarioId,dispatchIdentity:a.dispatchIdentity,enteredAt:now,now,originalDeadline:now+15000,sourceClosureHash:BINDING.installedClosureHash};let o;
if(c.method==='generate')o=await observeGenerate(oc,{content:[{type:'text',text:'DUMMY'}],finishReason:{unified:'stop',raw:'stop'},usage:{inputTokens:{total:1},outputTokens:{total:1}},response:{body:{id:'DUMMY',model:c.modelId,choices:[{index:0,message:{content:'DUMMY'},finish_reason:'stop'}],usage:{prompt_tokens:1,completion_tokens:1,cost:'0'}}}},resolver);
else if(c.method==='embed'){const v=Array(1536).fill(0);o=await observeEmbed(oc,{embeddings:[v],usage:{tokens:1},response:{body:{id:'DUMMY',model:c.modelId,data:[{embedding:v}],usage:{prompt_tokens:1,cost:'0'}}}},resolver)}
else {const e=[['raw',{id:'DUMMY',model:c.modelId,choices:[{index:0,delta:{content:'DUMMY'},finish_reason:null}]}],['text-start',{id:'DUMMY'}],['text-delta',{id:'DUMMY',delta:'DUMMY'}],['raw',{id:'DUMMY',model:c.modelId,choices:[{index:0,delta:{},finish_reason:'stop'}],usage:{prompt_tokens:1,completion_tokens:1,cost:'0'}}],['text-end',{id:'DUMMY'}],['finish',{finish:{unified:'stop',raw:'stop'},usage:{input:1,output:1}}]];o=await observeStream(oc,await Promise.all(e.map(([k,d],i)=>makeEvent(i,k,d))),'reader-done',resolver)}
assert.equal(o.receipt.reason,'none');await h.mutation(h.controls.capture,{scenarioId,dispatchIdentity:a.dispatchIdentity,observationCanonical:canonical(o.receipt,8192),contextCanonical:canonical(oc),transcriptCanonical:o.transcriptCanonical});}

import assert from 'node:assert/strict';
import {registerHooks} from 'node:module';
import {createHash} from 'node:crypto';
import {readFileSync} from 'node:fs';
const modules=['controls','lifecycle','managed','late-accounting','runner','observer'];
const hash=s=>createHash('sha256').update(s).digest('hex');const transformed=[];
const originalLog=console.log.bind(console),originalWrite=process.stdout.write.bind(process.stdout),groups=new Map();
const collect=value=>{try{const parsed=JSON.parse(String(value));if(parsed.outcomes)for(const outcome of parsed.outcomes)groups.set(outcome.name,outcome)}catch{/* output may contain non-JSON text */}};
process.stdout.write=(chunk,...args)=>{collect(chunk);return originalWrite(chunk,...args)};
console.log=(...args)=>{for(const value of args){try{const parsed=JSON.parse(value);if(parsed.outcomes)for(const outcome of parsed.outcomes)groups.set(outcome.name,outcome)}catch{/* output may contain non-JSON text */}}originalLog(...args)};
const hooks=registerHooks({load(url,context,next){const loaded=next(url,context);if(!modules.some(name=>url===new URL('./'+name+'.mjs',import.meta.url).href))return loaded;const raw=readFileSync(new URL(url),'utf8');const line=raw.split('\n').find(line=>line.startsWith('const outcomes=[];async function test('));assert.ok(line&&line.endsWith('throw error}}'));const replacement=line.replace('throw error}}','/* independent collector retains failure and executes the next original callback */}}');const changed=raw.replace(line,replacement);assert.equal(changed.slice(changed.indexOf('\n',changed.indexOf(replacement))+1),raw.slice(raw.indexOf('\n',raw.indexOf(line))+1));transformed.push({url,rawSHA256:hash(raw),loadedSHA256:hash(changed),change:'Only outer reporting-wrapper rethrow suppressed. Every callback body/assertion and all source/authority/transport/key dependencies byte unchanged.'});return {...loaded,source:changed}}});
let outsideFailure;try{await import('./all.mjs')}catch(error){outsideFailure=String(error)}finally{hooks.deregister();console.log=originalLog;process.stdout.write=originalWrite}
const expected=[];for(const module of [...modules,'proofs']){const raw=readFileSync(new URL('./'+module+'.mjs',import.meta.url),'utf8');for(const match of raw.matchAll(/(?:await )?test\('([^']+)'/g))expected.push(match[1])}expected.push('21 independent typed enum/key/hash/count/category/crossfield rejects and first malformedSTOP1write then0repeat');
assert.equal(expected.length,40);const outcomes=expected.map(name=>groups.get(name)??{name,status:'NOT_RUN'});originalLog(JSON.stringify({scope:'UNCHANGED_ORIGINAL40_CALLBACKS_INDEPENDENT_FAILURE_COLLECTION_NO_AUTHORITY_BYPASS',transformed,outsideFailure:outsideFailure??null,outcomes,total:outcomes.length,passed:outcomes.filter(x=>x.status==='PASS').length,failed:outcomes.filter(x=>x.status==='FAIL').length,notRun:outcomes.filter(x=>x.status==='NOT_RUN').length,skipped:0}));if(outcomes.some(x=>x.status!=='PASS')||outsideFailure)process.exitCode=1;

import assert from 'node:assert/strict';
import {Ownership,buildRunner,OFFICIAL_DRIVER} from '../convex/runner.ts';
import {OWNER_RUN_ID,BINDING} from '../convex/installed.ts';
import {Harness} from './harness.mjs';
import {generate} from './controls.mjs';
import {observeGenerate,observeEmbed,observeStream,nativeEvent,makeEvent} from '../convex/observer.ts';
import {REQUESTS} from '../convex/requests.ts';
import {CASES} from '../convex/cases.ts';
import {fail,canonical} from '../convex/validate.ts';
const wait=ms=>new Promise(resolve=>setTimeout(resolve,ms));
const unhandled=[];const listener=error=>unhandled.push(String(error));process.on('unhandledRejection',listener);
const outcomes=[];
for(const late of ['success','failure']){
 const owner=new Ownership();let resolve,reject;const source=new Promise((yes,no)=>{resolve=yes;reject=no});const tracked=owner.track(source);const continuation=owner.track(tracked.then(()=>{if(late==='failure')throw Error('DUMMY_SECONDARY_FAILURE');return 'DUMMY_SUCCESS'}));assert.equal((await owner.cleanup(2)).pending,2);
 if(late==='success')resolve('DUMMY_FIRST_SUCCESS');else reject(Error('DUMMY_PRIMARY_FAILURE'));
 await wait(10);assert.equal(owner.pending,0);assert.equal(owner.failures.length,late==='failure'?2:0);assert.equal(unhandled.length,0);
let parts=[];export function setParts(value){parts=value;}export function convexGateway(){return {doStream:async()=>({stream:new ReadableStream({start(controller){for(const part of parts)controller.enqueue(part);controller.close();}})})};}

