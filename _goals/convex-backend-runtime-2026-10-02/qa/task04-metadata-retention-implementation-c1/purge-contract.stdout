export const recoverOwnedEvidence=internalQueryGeneric({args:{ownedCanonical:v.string()},handler:async(ctx,args)=>{record(args,'ownedCanonical');try{const r=await loadRecovery(ctx);ownedInput(parseCanonical(args.ownedCanonical,4096),r.o);const p=await projections(r.o,r.s,r.data);return {kind:'summary',evidenceSnapshotHash:await digest(canonical(p.E)),sourceTombstoned:r.data.source.tombstone,grantActive:r.data.grant.active,stageReceipts:p.T.triggers.map(i=>({scenarioId:i.scenarioId,stageHash:i.stageHash,stageIdentityHash:i.stageIdentityHash})),active:r.s.active,reserved:r.s.reserved,known:r.s.known,stopped:r.s.stopped}}catch(error){return recoveryDeny(error)}}});
export const purgeOwnedPrivate=internalMutationGeneric({args:{intentCanonical:v.string()},handler:cleanupHandler('purge')});

