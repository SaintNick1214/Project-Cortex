function cleanupHandler(operation:Operation){return async(ctx:Write,args:{intentCanonical:string})=>{record(args,'intentCanonical');let mutating=false;try{const r=await loadRecovery(ctx),intent=typedIntent(args.intentCanonical,operation,r.o),original=r.h.find(x=>x.data.operation===operation);if(original){if(original.data.intentCanonical===canonical(intent,8192))return {kind:'replay',receiptHash:original.data.receiptHash};if(original.data.intentKey===intent.intentKey||operation==='purge')return {kind:'collision',reason:'intent-identity'}}const before=await projections(r.o,r.s,r.data);if(operation==='purge'){if(r.data.source.tombstone!==true||r.data.chunk.tombstone!==true||r.data.grant.active!==false||intent.evidenceSnapshotHash!==await digest(canonical(before.E)))return {kind:'denied',reason:'stale'}}else {if(intent.expectedGrantEpoch!==r.data.grant.epoch||operation==='delete'&&(intent.expectedSourceEpoch!==r.data.source.epoch||intent.expectedSourceRevision!==r.data.source.revision))return {kind:'denied',reason:'stale'};if(operation==='delete'&&r.data.source.tombstone===true||operation==='revoke'&&r.data.grant.active===false){const noWrite=await makeLifecycle(operation,intent,before,before,operation==='delete'?'already-tombstoned':'already-revoked');return {kind:operation==='delete'?'already-tombstoned':'already-revoked',receiptHash:noWrite.receiptHash}}}
const next=structuredClone(r.s),data=structuredClone(r.data);if(operation==='delete'){data.source.tombstone=true;data.source.revision=count(Number(data.source.revision)+1);data.source.epoch=count(Number(data.source.epoch)+1);data.chunk.tombstone=true;data.vectors.forEach(x=>x.data.tombstone=true);next.sourceCurrent=false;close(next);}else if(operation==='revoke'){data.grant.active=false;data.grant.epoch=count(Number(data.grant.epoch)+1);next.revoked=true;close(next);}else {data.vectors=[];data.stages=[];data.evidence=[];}const after=await projections(r.o,next,data),receipt=await makeLifecycle(operation,intent,before,after);await validateLifecycle({_id:'offline-validation-only',...receipt},r.o);mutating=true;if(operation==='delete'){await ctx.db.patch(r.o.sourceId as GenericId<string>,{tombstone:true,revision:count(data.source.revision,1),epoch:count(data.source.epoch,1)});if(!r.data.chunk.tombstone)await ctx.db.patch(r.o.chunkId as GenericId<string>,{tombstone:true});for(const item of r.data.vectors)if(!item.data.tombstone)await ctx.db.patch(item.row._id as GenericId<string>,{tombstone:true});if(canonical(next,524288)!==canonical(r.s,524288))await save(ctx,r.row,next);}else if(operation==='revoke'){await ctx.db.patch(r.o.grantId as GenericId<string>,{active:false,epoch:count(data.grant.epoch,1)});if(canonical(next,524288)!==canonical(r.s,524288))await save(ctx,r.row,next);}else {for(const item of [...r.data.vectors,...r.data.stages,...r.data.evidence])await ctx.db.delete(item.row._id as GenericId<string>);}await ctx.db.insert('fixtureLifecycle',receipt);return {kind:operation==='delete'?'tombstoned':operation==='revoke'?'revoked':'purged',receiptHash:receipt.receiptHash};}catch(error){if(mutating)throw error;return recoveryDeny(error)}}}
export const deleteOwned=internalMutationGeneric({args:{intentCanonical:v.string()},handler:cleanupHandler('delete')});
export const revokeOwned=internalMutationGeneric({args:{intentCanonical:v.string()},handler:cleanupHandler('revoke')});
export const purgeOwnedPrivate=internalMutationGeneric({args:{intentCanonical:v.string()},handler:cleanupHandler('purge')});

