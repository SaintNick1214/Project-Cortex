import {verifyStageCapability} from './runner.ts';
import {internalMutationGeneric,internalQueryGeneric} from 'convex/server';
import {v,type GenericId} from 'convex/values';
import type {Data,Owned,Account,Operation} from './contracts.ts';
import {BINDING,ACCOUNT_HASH,SCOPE} from './installed.ts';
import {vectorRow} from './repository-codec.ts';
import {ORDER} from './cases.ts';
import {canonical,parseCanonical,digest,record,same,str,id,hash,count,bool,list,one,trigger,caseFor,fail,bytes} from './validate.ts';
import {load,save,root,close,installation,resources,rows,strip,ownership,ownFields,liveResources,type Read,type Write} from './store.ts';
export async function ownedRows(ctx:Read,o:Owned){const r=await resources(ctx,o);const vv=await ctx.db.query('fixtureVectors').take(2) as Data[];if(vv.length>1)fail('CARDINALITY');const vectors=await Promise.all(vv.map(async row=>{const d=await vectorRow(strip(row));for(const [k,val] of Object.entries(SCOPE))same(d[k],val);same([d.sourceId,d.chunkId,d.profileHash],[o.sourceId,o.chunkId,BINDING.profileHash]);return {row,data:d}}));const stages=(await rows(ctx,'fixtureStages',2)).map(row=>{const d=record(strip(row),'accountHash targetHash operatorHash manifestHash scenarioId dispatchIdentity stageIdentityCanonical stageIdentityHash partSeq
capture import {observeTranscript} from './observer.ts';
const capture=internalMutationGeneric({args:{scenarioId:v.string(),dispatchIdentity:v.string(),observationCanonical:v.string(),contextCanonical:v.string(),transcriptCanonical:v.string()},handler:async(ctx,args)=>{record(args,'scenarioId dispatchIdentity observationCanonical contextCanonical transcriptCanonical');await root(ctx);const {row,s}=await load(ctx),a=s.attempts.find(a=>a.scenarioId===args.scenarioId);if(!a||a.dispatchIdentity!==args.dispatchIdentity)fail('DISPATCH_CONFLICT');const installed=await installation(ctx),historical=await history(ctx,installed,s),data=await ownedRows(ctx,installed);await validateStages(data,s);if(a.firstCapture===args.observationCanonical||a.refinements.includes(args.observationCanonical))return {status:a.state,slotReleased:a.slotReleased};let text:string,r:ReturnType<typeof receipt>;let rawIncoming:Data|null=null;try{rawIncoming=record(parseCanonical(args.observationCanonical,8192))}catch{}if(rawIncoming)for(const k of ['binding','scenarioId','dispatchIdentity','nativeHash','expectedWireHash','method','interface','requestedModel']){const value=rawIncoming[k];let wellTyped=false;try{if(k==='binding'){parseBinding(value);wellTyped=true}else if(k==='scenarioId'){caseFor(value);wellTyped=true}else if(['dispatchIdentity','nativeHash','expectedWireHash'].includes(k))wellTyped=typeof value==='string'&&/^[a-f0-9]{64}$/.test(value);else if(k==='method')wellTyped=['generate','stream','embed'].includes(String(value));else if(k==='interface')wellTyped=['chat','embedding'].includes(String(value));else wellTyped=['openai/gpt-4o-mini','openai/text-embedding-3-small'].includes(String(value))}catch{}if(!wellTyped)continue;const expected= k==='binding'?BINDING:k==='scenarioId'?a.scenarioId:k==='dispatchIdentity'?a.dispatchIdentity:k==='nativeHash'?caseFor(a.scenarioId).normalizedNativeRequestHash:k==='expectedWireHash'?caseFor(a.scenarioId).expectedWireBodyHash:k==='interface'?caseFor(a.scenarioId).nativeInterface:k==='requestedModel'?caseFor(a.scenarioId).modelId:caseFor(a.scenarioId).method;same(rawIncoming[k],expected)}try{const incoming=receipt(args.observationCanonical,BINDING);same(incoming.dispatchIdentity,a.dispatchIdentity);const cc=record(parseCanonical(args.contextCanonical,4096),'binding scenarioId dispatchIdentity enteredAt now originalDeadline sourceClosureHash');same(cc.binding,BINDING);same([cc.scenarioId,cc.dispatchIdentity,cc.sourceClosureHash],[a.scenarioId,a.dispatchIdentity,BINDING.installedClosureHash]);for(const k of ['enteredAt','now','originalDeadline'])count(cc[k]);if(Number(cc.enteredAt)<SOURCE_WINDOW.checkedAt||Number(cc.enteredAt)>=SOURCE_WINDOW.expiresAt||Number(cc.now)<Number(cc.enteredAt)||Number(cc.originalDeadline)<Number(cc.enteredAt)||Number(cc.originalDeadline)-Number(cc.enteredAt)>16000)fail('CONTEXT_TIME');const backing=await observeTranscript(cc as unknown as Context,args.transcriptCanonical,resolver);const rebuilt=backing.receipt;for(const key of ['responseId','actualModel','rawFinish','nativeFinish','nativeRawFinish','rawCounts','mappedCounts','observedCostDecimal','resultHash','rawDigest','nativeHash','expectedWireHash'] as const)same(incoming[key],rebuilt[key]);r=receipt(canonical(rebuilt,8192),BINDING);text=canonical(r,8192);}catch(error){if(error instanceof Error&&error.message==='DISPATCH_CONFLICT')throw error;if(!s.stopped||a.attachment!=='closed'){s.stopped=true;close(s);if(!a.slotReleased&&a.state==='inflight')a.state='unknown';await save(ctx,row,s)}return {status:'invalid-retained',slotReleased:a.slotReleased};}
return {provision,reserveCheckpoint,enterPeer,stop,capture,attach,control,inspect};}
const controls=buildControls();export const {provision,reserveCheckpoint,enterPeer,stop,capture,attach,control,inspect}=controls;
