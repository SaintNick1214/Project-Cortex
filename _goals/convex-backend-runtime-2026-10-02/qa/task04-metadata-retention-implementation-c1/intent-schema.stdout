function typedIntent(text:string,operation:Operation,o:Owned):Data{const extra=operation==='delete'?'expectedSourceRevision expectedSourceEpoch expectedGrantEpoch':operation==='revoke'?'expectedGrantEpoch':'evidenceSnapshotHash';const r=record(parseCanonical(text,8192),'domain version owned intentKey '+extra);if(r.domain!==`cortex.experiment.${operation}-intent.v1`||r.version!==1)fail('INTENT_VERSION');ownedInput(r.owned,o);hash(r.intentKey);if(operation==='purge')hash(r.evidenceSnapshotHash);else extra.split(' ').forEach(k=>count(r[k],1));return {domain:`cortex.experiment.${operation}-intent.v1`,version:1,...r}}
