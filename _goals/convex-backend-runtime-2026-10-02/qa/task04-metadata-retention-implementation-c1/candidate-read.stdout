const outcomes=[];async function test(name,fn){try{await fn();outcomes.push({name,status:'PASS'})}catch(error){outcomes.push({name,status:'FAIL',error:String(error)});console.log(JSON.stringify({scope:'OFFLINE_OBSERVER_ONLY',outcomes}));throw error}}
const ctx={binding:BINDING,scenarioId:'C09',dispatchIdentity:'a'.repeat(64),enteredAt:Date.now(),now:Date.now(),originalDeadline:Date.now()+15000,sourceClosureHash:BINDING.installedClosureHash};
const data=[['raw',{id:'response',model:'openai/gpt-4o-mini',choices:[{index:0,delta:{content:'first'},finish_reason:null}]}],['text-start',{id:'text'}],['text-delta',{id:'text',delta:'first'}],['raw',{id:'response',model:'openai/gpt-4o-mini',choices:[{index:0,delta:{},finish_reason:'stop'}],usage:{prompt_tokens:1,completion_tokens:1,total_tokens:2,cost:'0'}}],['text-end',{id:'text'}],['finish',{finish:{unified:'stop',raw:'stop'},usage:{input:1,output:1}}]];
async function events(prefix=false,parts=data){return Promise.all([...(prefix?[['stream-start',{type:'stream-start',warnings:[]}]]:[]),...parts].map(([kind,d],i)=>makeEvent(i,kind,d)))}
await test('proper original prefix exactsame substantive facts different fullhash actual eligible sequence+1 no rawdigest change',async()=>{const a=await observeStream(ctx,await events(),'reader-done'),b=await observeStream(ctx,await events(true),'reader-done');const {rawDigest:ad,...af}=a.receipt,{rawDigest:bd,...bf}=b.receipt;assert.deepEqual(af,bf);assert.notEqual(ad,bd);assert.equal(b.eligible[0].partSequence,a.eligible[0].partSequence+1);assert.equal(b.eligible[0].rawPartDigest,a.eligible[0].rawPartDigest);const start=await nativeEvent(0,{type:'stream-start',warnings:[]});assert.equal(start.kind,'stream-start');assert.deepEqual(start.data,{type:'stream-start',warnings:[]});assert.equal(start.digest,await digest(canonical(start.data)));assert.equal(JSON.parse(b.transcriptCanonical).events[0].sequence,0)});
await test('prefix alone unknown all dimensions/no eligible no authoritative inferred serving or zero money',async()=>{const o=await observeStream(ctx,await events(true,[]),'reader-done');for(const key of ['lifetime','money','serving','usage'])assert.equal(o.receipt[key],'unknown');assert.equal(o.receipt.microUSD,null);assert.equal(o.receipt.responseId,null);assert.equal(o.eligible.length,0)});
await test('native prefix malformed descriptors/symbol/prototype/sparse/warnings/missingextra keys reject without getters',async()=>{let reads=0;const getter={type:'stream-start'};Object.defineProperty(getter,'warnings',{enumerable:true,get(){reads++;return []}});for(const part of [getter,{type:'stream-start',warnings:[],extra:true},{type:'stream-start'},{type:'stream-start',warnings:[{type:'other',message:'warning'}]},{type:'stream-start',warnings:new Array(1)},{type:'stream-start',warnings:[],[Symbol('extra')]:1},Object.assign(Object.create({}),{type:'stream-start',warnings:[]})])await assert.rejects(nativeEvent(0,part));assert.equal(reads,0)});
await test('backing repeat/late prefix/warnings/unknownkey/changedtext/rawID conflict STOP/privatewithhold',async()=>{for(const parts of [[['stream-start',{type:'stream-start',warnings:[]}],['stream-start',{type:'stream-start',warnings:[]}],...data],[...data,['stream-start',{type:'stream-start',warnings:[]}]],[['stream-start',{type:'stream-start',warnings:['x']}],...data],[['stream-start',{type:'stream-start',warnings:[],extra:true}],...data],data.map((p,i)=>i===2?['text-delta',{id:'text',delta:'changed'}]:p),data.map((p,i)=>i===3?['raw',{...p[1],id:'other'}]:p)]){const o=await observeStream(ctx,await events(false,parts),'reader-done');assert.ok(['unsupported','contradiction'].includes(o.receipt.reason));assert.equal(o.receipt.lifetime,'unknown');assert.equal(o.privateResultCanonical,null);assert.equal(o.eligible.length,0)}});
await test('flush alone no trusted lifetime; genuine completed conditional terminal survives reader error; drift full covered syntheticmoney withheld',async()=>{const flush=await observeStream(ctx,await events(false,[data[1],data[4],data[5]]),'reader-done',mockResolver);assert.equal(flush.receipt.lifetime,'unknown');const e=await events();e.push(await makeEvent(e.length,'error',{type:'error'}));const genuine=await observeStream(ctx,e,'error',mockResolver);assert.equal(genuine.receipt.lifetime,'validated-provider-terminal');const h=await new Harness().setup();await h.reserve();await h.enter();const drift=await observeGenerate(context(h),generate(undefined,'0.10','observed-other-model'),mockResolver);assert.equal(drift.receipt.serving,'drift');assert.equal(drift.receipt.microUSD,100000);assert.notEqual(drift.receipt.reason,'none')
