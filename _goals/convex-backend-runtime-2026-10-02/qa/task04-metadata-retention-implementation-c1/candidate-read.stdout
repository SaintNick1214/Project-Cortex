function own(x:unknown):Data {if(!x||typeof x!=='object'||Array.isArray(x)||![Object.prototype,null].includes(Object.getPrototypeOf(x)))fail('OWN_DATA');const d=Object.getOwnPropertyDescriptors(x);if(Reflect.ownKeys(d).some(k=>typeof k!=='string'))fail('SYMBOL');for(const [k,v] of Object.entries(d))if(!k.isWellFormed()||!('value'in v)||!v.enumerable)fail('OWN_DATA');return x as Data}
function field(x:unknown,k:string){return own(x)[k]??null}
