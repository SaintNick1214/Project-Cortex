function rawCounts(u:Data|null){if(!u)return;r.rawCounts={input:optionalCount(u.prompt_tokens),output:c.method==='embed'?null:optionalCount(u.completion_tokens)};const total=optionalCount(u.total_tokens);if(total!==null&&r.rawCounts.input!==null&&r.rawCounts.output!==null&&total!==r.rawCounts.input+r.rawCounts.output)fail('CONFLICT');r.observedCostDecimal=conservativeUsdDecimal(u.cost)??null;if(u.currency!==undefined&&u.currency!==null)r.observedCurrency=optionalId(u.currency);for(const key of ['cost_details','prompt_tokens_details','completion_tokens_details'])if(u[key]!==undefined&&u[key]!==null)canonical(u[key],8192);}
