const parts=[{type:'raw',rawValue:{id:'DUMMY',model:'openai/gpt-4o-mini',choices:[{index:0,delta:{content:'first'},finish_reason:null}]}},{type:'text-start',id:'DUMMY'},{type:'text-delta',id:'DUMMY',delta:'first'}];
