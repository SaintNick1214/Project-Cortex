export function selectGenerate(r:LanguageModelV4GenerateResult){const response=field(r,'response'),metadata=response===null?null:{id:field(response,'id'),modelId:field(response,'modelId')};return {body:response===null?null:field(response,'body'),content:field(r,'content'),finish:selectedFinish(field(r,'finishReason')),usage:selectedUsage(field(r,'usage')),metadata}}
export function selectEmbed(r:EmbeddingModelV4Result){const response=field(r,'response');return {body:response===null?null:parseCanonical(canonical(field(response,'body'),180000),180000),embeddings:parseCanonical(canonical(field(r,'embeddings'),180000),180000),usage:field(r,'usage')}}
export async function nativeEvent(sequence:number,part:LanguageModelV4StreamPart):Promise<Event>{const p=own(part),type=String(p.type);const kind:Event['kind']=['stream-start','raw','response-metadata','text-delta','text-start','text-end','finish','error'].includes(type)?type as Event['kind']:'unsupported';let data:unknown;if(type==='stream-start'){const original=record(part,'type warnings');same(original.type,'stream-start');if(!Array.isArray(original.warnings)||original.warnings.length!==0)fail('STREAM_START');canonical(original,180000);data={type:'stream-start',warnings:[]}}else if(type==='raw')data=p.rawValue??null;else if(type==='finish')data={finish:selectedFinish(p.finishReason??null),usage:selectedUsage(p.usage)};else if(type==='response-metadata')data={id:p.id??null,modelId:p.modelId??null};else if(type==='text-delta')data={id:p.id??null,delta:p.delta??null};else if(type==='text-start'||type==='text-end')data={id:p.id??null};else data={type};return await makeEvent(sequence,kind,data)}
