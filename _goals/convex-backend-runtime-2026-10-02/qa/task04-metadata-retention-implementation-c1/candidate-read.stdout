try {if(c.method==='generate'){if(events.length!==1||events[0]!.kind!=='raw')fail('SHAPE');const d=record(events[0]!.data,'body content finish usage metadata'),body=record(d.body);correlateId(body.id,'responseId');correlateId(body.model,'actualModel');if(!Array.isArray(body.choices)||body.choices.length!==1)fail('SHAPE');const choice=record(body.choices[0]);if(choice.index!==0)fail('SHAPE');const message=record(choice.message);for(const k of ['tool_calls','function_call','reasoning','reasoning_content','refusal'])if(message[k]!==undefined&&message[k]!==null)fail('UNSUPPORTED');if(typeof message.content!=='string'||!message.content.isWellFormed())fail('SHAPE');const parts=d.content;if(!Array.isArray(parts))fail('SHAPE');output=parts.map(p=>{const v=record(p,'type text');if(v.type!=='text'||typeof v.text!=='string')fail('UNSUPPORTED');return v.text}).join('');same(output,message.content);if(d.metadata!==null){const m=record(d.metadata,'id modelId');if(m.id!==null&&m.id!==r.responseId||m.modelId!==null&&m.modelId!==r.actualModel)fail('CONFLICT');}finish(choice.finish_reason,d.finish);rawUsage=body.usage===undefined||body.usage===null?null:record(body.usage);mapped=d.usage===null?null:record(d.usage,'input output');correlated=r.responseId!==null&&r.actualModel!==null&&r.rawFinish!==null&&r.nativeRawFinish===r.rawFinish;privateCanonical=canonical({text:output},c.conditionalPrivateMaximumBytes);
}else if(c.method==='embed'){if(events.length!==1||events[0]!.kind!=='raw')fail('SHAPE');const d=record(events[0]!.data,'body embeddings usage'),body=record(d.body);correlateId(body.id,'responseId');correlateId(body.model,'actualModel');if(!Array.isArray(body.data)||body.data.length!==1||!Array.isArray(d.embeddings)||d.embeddings.length!==1)fail('SHAPE');const v=vector(record(body.data[0]).embedding);same(v,vector(d.embeddings[0]));rawUsage=body.usage===undefined||body.usage===null?null:record(body.usage);mapped=d.usage===null?null:{input:optionalCount(record(d.usage,'tokens').tokens),output:null};privateCanonical=canonical({profile:PROFILE,vector:v},c.conditionalPrivateMaximumBytes);correlated=r.responseId!==null&&r.actualModel!==null;
}else {for(const e of events){if(e.kind==='stream-start'){const original=record(e.data,'type warnings');if(e.sequence!==0||original.type!=='stream-start'||!Array.isArray(original.warnings)||original.warnings.length!==0)fail('UNSUPPORTED');continue;}if(e.kind==='error'&&rawEnd&&nativeEnd){correlated=r.responseId!==null&&r.actualModel!==null;continue;}if(e.kind==='unsupported'||e.kind==='error')fail('UNSUPPORTED');if(nativeEnd)fail('CONFLICT');if(e.kind==='raw'){const raw=record(e.data);correlateId(raw.id,'responseId');correlateId(raw.model,'actualModel');if(raw.usage!==undefined&&raw.usage!==null){if(++usageChunks>8)fail('SHAPE');const u=record(raw.usage);if(rawUsage)for(const [key,value]of Object.entries(rawUsage))if(value!==null&&value!==undefined&&u[key]!==undefined)same(value,u[key]);rawUsage=Object.assign({},rawUsage,u);}if(!Array.isArray(raw.choices)||raw.choices.length>1)fail('SHAPE');if(raw.choices.length){if(rawEnd)fail('CONFLICT');const ch=record(raw.choices[0]);if(ch.index!==0)fail('SHAPE');const delta=record(ch.delta);for(const k of ['reasoning','reasoning_content','tool_calls','function_call'])if(delta[k]!==undefined&&delta[k]!==null)fail('UNSUPPORTED');if(delta.content!==undefined&&delta.content!==null){if(typeof delta.content!=='string'||!delta.content.isWellFormed()||pendingDelta)fail('SHAPE');pendingDelta=delta.content;rawOutput+=pendingDelta;lastRawDigest=e.digest;}if(ch.finish_reason!==null&&ch.finish_reason!==undefined){if(++rawFinishCount>1)fail('CONFLICT');rawEnd=true;finish(ch.finish_reason,null);}}}else if(e.kind==='response-metadata'){const d=record(e.data,'id modelId'),mid=optionalId(d.id),mm=optionalId(d.modelId);if(mid!==null&&(r.responseId!==null&&mid!==r.responseId||mappedResponseId!==null&&mid!==mappedResponseId)||mm!==null&&(r.actualModel!==null&&mm!==r.actualModel||mappedModelId!==null&&mm!==mappedModelId))fail('CONFLICT');if(mid!==null)mappedResponseId=mid;if(mm!==null)mappedModelId=mm;}else if(e.kind==='text-delta'){const d=record(e.data,'id delta');if(activeTextId===null||id(d.id)!==activeTextId)fail('CONFLICT');if(typeof d.delta!=='string'||d.delta!==pendingDelta||!d.delta.isWellFormed())fail('CONFLICT');output+=d.delta;canonical({text:output},c.conditionalPrivateMaximumBytes);if(d.delta&&r.responseId&&r.actualModel===r.requestedModel)eligible.push({text:d.delta,partSequence:e.sequence,rawPartDigest:lastRawDigest});pendingDelta='';}else if(e.kind==='text-start'){const d=record(e.data,'id');if(activeTextId!==null)fail('CONFLICT');activeTextId=id(d.id);}else if(e.kind==='text-end'){const d=record(e.data,'id');if(activeTextId===null||id(d.id)!==activeTextId)fail('CONFLICT');activeTextId=null;}else if(e.kind==='finish'){if(++nativeFinishCount>1)fail('CONFLICT');if(!rawEnd){reason(r,'missing-evidence');continue;}if(activeTextId!==null)fail('CONFLICT');const d=record(e.data,'finish usage');finish(r.rawFinish,d.finish);mapped=d.usage===null?null:record(d.usage,'input output');nativeEnd=true;}}if(pendingDelta||rawOutput!==output)fail('CONFLICT');correlated=rawEnd&&nativeEnd&&r.responseId!==null&&r.actualModel!==null;privateCanonical=canonical({text:output},c.conditionalPrivateMaximumBytes);if(!correlated)reason(r,'missing-evidence');}
