const n:Nomination={method:c.method,responseId:r.responseId,actualModel:r.actualModel,rawFinish:r.rawFinish,nativeFinish:r.nativeFinish,nativeRawFinish:r.nativeRawFinish,correlatedShape:correlated,rawDigest:r.rawDigest,ended:tr.ended as Nomination['ended'],rawCost:rawUsage?.cost??null,rawCurrency:r.observedCurrency,categories:r.observedCategories,outcome:tr.ended==='returned'?'returned':'unknown'};if(r.reason==='contradiction'||r.reason==='unsupported'||r.reason==='bound-violation'){n.correlatedShape=false;eligible.length=0;}qualify(ctx,r,n,resolver);if(c.method==='embed'&&r.lifetime==='validated-provider-terminal'&&r.rawCounts.input!==null&&r.rawCounts.input===r.mappedCounts.input){r.rawCounts.output=0;r.mappedCounts.output=0;r.usage='validated-raw-mapped';}if(r.reason==='missing-evidence'&&r.usage==='validated-raw-mapped'&&r.lifetime==='validated-provider-terminal'&&r.serving==='validated-bound-premises'&&r.money==='validated-whole-invocation-usd'&&r.resultHash!==null)r.reason='none';return {receipt:r,transcriptCanonical:text,privateResultCanonical:privateCanonical,eligible}}
