1:/** Inspect the entire bounded own-data graph before reading any property values.
2: * Convex deserialized values are plain data. Accessors/symbols/prototypes/sparse arrays
3: * are refused; arbitrary JS Proxy traps are outside Convex's value boundary. */
4:export function canonical(value: unknown, maximumBytes = 65536): string {
5:  const seen = new Set<object>(); let nodes = 0;
6:  function inspect(item: unknown, depth: number): void {
7:    if (++nodes > 4096 || depth > 16) throw new Error("GRAPH_LIMIT");
8:    if (typeof item === "string") { if (!item.isWellFormed()) throw new Error("UNICODE"); return; }
9:    if (item === null || typeof item === "boolean") return;
10:    if (typeof item === "number") { if (!Number.isFinite(item) || Object.is(item, -0)) throw new Error("NUMBER"); return; }
11:    if (typeof item !== "object" || seen.has(item)) throw new Error("DATA_GRAPH");
12:    seen.add(item);
13:    const array = Array.isArray(item), proto = Object.getPrototypeOf(item);
14:    if (proto !== (array ? Array.prototype : Object.prototype) && !(proto === null && !array)) throw new Error("PROTOTYPE");
15:    const descriptors = Object.getOwnPropertyDescriptors(item);
16:    if (Reflect.ownKeys(descriptors).some(k => typeof k !== "string")) throw new Error("SYMBOL");
17:    for (const [key, d] of Object.entries(descriptors)) {
18:      if (!key.isWellFormed() || !("value" in d) || (!d.enumerable && !(array && key === "length"))) throw new Error("OWN_DATA");
19:    }
20:    if (array) {
21:      const length = descriptors.length.value as number;
22:      if (length > 4096 || Object.keys(descriptors).length !== length + 1) throw new Error("ARRAY");
23:      for (let i = 0; i < length; i++) { if (!descriptors[String(i)]) throw new Error("SPARSE"); inspect(descriptors[String(i)].value, depth + 1); }
24:    } else for (const d of Object.values(descriptors)) inspect(d.value, depth + 1);
25:  }
26:  inspect(value, 0);
27:  function encode(item: unknown): string {
28:    if (item === null || typeof item !== "object") return JSON.stringify(item);
29:    if (Array.isArray(item)) return "[" + item.map(encode).join(",") + "]";
30:    const data = item as Record<string, unknown>;
31:    return "{" + Object.keys(data).sort().map(key => JSON.stringify(key) + ":" + encode(data[key])).join(",") + "}";
32:  }
33:  const result = encode(value);
34:  if (new TextEncoder().encode(result).length > maximumBytes) throw new Error("BYTE_LIMIT");
35:  return result;
36:}
37:export function parseCanonical(text: string, maximumBytes = 65536): unknown {
38:  if (typeof text !== "string" || new TextEncoder().encode(text).length > maximumBytes) throw new Error("BYTE_LIMIT");
39:  const value: unknown = JSON.parse(text);
40:  if (canonical(value, maximumBytes) !== text) throw new Error("NONCANONICAL");
41:  return value;
42:}
43:export function exact(value: unknown, keys: readonly string[], maximumBytes=65536): asserts value is Record<string, unknown> {
44:  canonical(value,maximumBytes);
45:  if (!value || typeof value !== "object" || Array.isArray(value) || Object.keys(value).sort().join("|") !== [...keys].sort().join("|")) throw new Error("SHAPE");
46:}
47:export async function digest(value: string): Promise<string> {
48:  const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
49:  return Array.from(new Uint8Array(bytes), b => b.toString(16).padStart(2, "0")).join("");
50:}
