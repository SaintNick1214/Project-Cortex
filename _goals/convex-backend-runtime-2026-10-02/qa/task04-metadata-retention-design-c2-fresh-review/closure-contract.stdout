5:export const bytes=(s:string)=>new TextEncoder().encode(s).length;
6:export function fail(code:string):never{throw new Error(code)}
7:export function record(x:unknown,keys?:string,maximumBytes=1048576):Data {if(keys)exact(x,keys.split(' '),maximumBytes);else {canonical(x,maximumBytes);if(!x||typeof x!=='object'||Array.isArray(x))fail('OBJECT');}return x as Data}
8:export function str(x:unknown,max=256):string{if(typeof x!=='string'||!x.isWellFormed()||bytes(x)>max)fail('STRING');return x}
9:export function id(x:unknown):string{const s=str(x);if(!s||/[\u0000-\u001f\u007f]/u.test(s))fail('ID');return s}
10:export function hash(x:unknown):string{const s=str(x,64);if(!/^[a-f0-9]{64}$/.test(s))fail('HASH');return s}
11:export function count(x:unknown,min=0,max=Number.MAX_SAFE_INTEGER):number{if(typeof x!=='number'||!Number.isSafeInteger(x)||Object.is(x,-0)||x<min||x>max)fail('COUNT');return x}
12:export function bool(x:unknown):boolean{if(typeof x!=='boolean')fail('BOOL');return x}
13:export function one<T extends string>(x:unknown,values:readonly T[]):T {if(typeof x!=='string'||!values.includes(x as T))fail('ENUM');return x as T}
14:export function list(x:unknown,max:number):unknown[]{canonical(x,1048576);if(!Array.isArray(x)||x.length>max)fail('ARRAY');return x}
15:export function nullable<T>(x:unknown,f:(x:unknown)=>T):T|null{return x===null?null:f(x)}
16:export function same(a:unknown,b:unknown){if(canonical(a)!==canonical(b))fail('IDENTITY_CONFLICT')}
17:export const caseFor=(x:unknown)=>{const c=CASES.find(c=>c.scenarioId===x);if(!c)fail('NO_PERMIT');return c};
18:export function binding(x:unknown):BindingV2{const r=record(x,'manifestHash targetHash sourceHash installedClosureHash operatorHash grantHash sourceRecordHash profileHash grantEpoch sourceEpoch sourceRevision profileEpoch windowEpoch validatorRevision');for(const k of ['manifestHash','targetHash','sourceHash','installedClosureHash','operatorHash','grantHash','sourceRecordHash','profileHash'])hash(r[k]);for(const k of ['grantEpoch','sourceEpoch','sourceRevision','profileEpoch','windowEpoch'])count(r[k],1);if(r.validatorRevision!==1)fail('VERSION');return r as unknown as BindingV2}
19:export function conservativeUsdDecimal(value:unknown):string|undefined{if(typeof value==='string')return /^\d+(?:\.\d+)?$/.test(value)&&value.length<=80?value:undefined;if(typeof value!=='number'||!Number.isFinite(value)||value<0||Object.is(value,-0))return undefined;if(value===0)return '0';const view=new DataView(new ArrayBuffer(8));view.setFloat64(0,value);const bits=view.getBigUint64(0)+1n;const e=Number((bits>>52n)&0x7ffn);if(e===0x7ff)return undefined;const sig=(bits&((1n<<52n)-1n))+(e?1n<<52n:0n);const power=(e||1)-1023-52;const num=sig*1_000_000n*(power>=0?1n<<BigInt(power):1n),den=power<0?1n<<BigInt(-power):1n;const n=(num+den-1n)/den;if(n>BigInt(Number.MAX_SAFE_INTEGER))return undefined;return `${n/1_000_000n}.${(n%1_000_000n).toString().padStart(6,'0')}`}
20:export function micro(decimal:string){if(!/^\d+(?:\.\d+)?$/.test(decimal)||decimal.length>80)fail('DECIMAL');const [a,b='']=decimal.split('.');const den=10n**BigInt(b.length),n=(BigInt(a!+b)*1_000_000n+den-1n)/den;if(n>BigInt(Number.MAX_SAFE_INTEGER))fail('MONEY_OVERFLOW');return Number(n)}
