22:export function result(c:ReturnType<typeof caseFor>,text:string){const r=record(parseCanonical(text,c.conditionalPrivateMaximumBytes),c.method==='embed'?'profile vector':'text');if(c.method==='embed'){same(r.profile,PROFILE);vector(r.vector);}else str(r.text,c.conditionalPrivateMaximumBytes);return r}
23:export function vector(x:unknown):number[]{const a=list(x,1536);if(a.length!==1536)fail('DIMENSION');a.forEach(v=>{if(typeof v!=='number'||!Number.isFinite(v)||Object.is(v,-0))fail('VECTOR')});return a as number[]}
24:export function add(a:number,b:number){return count(a+b)}
