18: async before<T>(p:Promise<T>,deadline:number):Promise<T>{let timer:ReturnType<typeof setTimeout>|undefined;try{if(this.clock()>=deadline)throw new Error('LOCAL_DEADLINE_UNKNOWN');return await Promise.race([p,new Promise<never>((_,reject)=>{timer=setTimeout(()=>{this.timedOut=true;reject(new Error('LOCAL_DEADLINE_UNKNOWN'))},Math.max(0,deadline-this.clock()))})])}finally{if(timer)clearTimeout(timer)}}
19: async join():Promise<void>{await Promise.allSettled([...this.tasks]);}
20: async cleanup(milliseconds:number){this.closed=true;try{await this.before(Promise.allSettled([...this.tasks]),this.clock()+milliseconds)}catch{}return {pending:this.pending,timedOut:this.timedOut}}
25:export const OFFICIAL_DRIVER:Driver=Object.freeze({async execute(c:Case,ctx:Context,signal:AbortSignal,onEvents:(events:Event[])=>Promise<boolean>){const native=REQUESTS[c.scenarioId].native;if(c.method==='embed'){const model=convexGateway.embeddingModel(c.modelId);if(!('values'in native))fail('REQUEST_INTERFACE');return observeEmbed(ctx,await model.doEmbed({values:[...native.values],abortSignal:signal}))}if(!('prompt'in native))fail('REQUEST_INTERFACE');const params={maxOutputTokens:native.maxOutputTokens,prompt:native.prompt.map(m=>{if(m.role==='system')return {role:'system' as const,content:m.content};if(m.role==='user')return {role:'user' as const,content:m.content.map(p=>({...p}))};return {role:'assistant' as const,content:m.content.map(p=>({...p}))}}),abortSignal:signal};const model=convexGateway(c.modelId);if(c.method==='generate')return observeGenerate(ctx,await model.doGenerate(params));const events:Event[]=[];let ended:Transcript['ended']='reader-done';const stream=await model.doStream({...params,includeRawChunks:true}),reader=stream.stream.getReader(),readerOwner=new Ownership();let readerDone=false;try{while(true){const item=await readerOwner.before(readerOwner.track(reader.read()),ctx.originalDeadline);if(item.done){readerDone=true;break;}const event=await nativeEvent(events.length,item.value);if(events.length>=512)fail('STREAM_BOUND');canonical({version:1,method:'stream',events:[...events,event],ended:'reader-done'},180000);events.push(event);if(await onEvents(events)){ended='abort';break}}}catch(primaryError){readerOwner.failures.push(primaryError);ended=signal.aborted?'abort':'error';if(!signal.aborted){const marker=await makeEvent(events.length,'unsupported',{type:'malformed-or-unbounded-native-part'});try{canonical({version:1,method:'stream',events:[...events,marker],ended},180000);if(events.length>=512)fail('STREAM_BOUND');events.push(marker)}catch{events.length=0;events.push(await makeEvent(0,'unsupported',{type:'observation-bound-violation'}))}}}finally{if(!readerDone){const cancelling=readerOwner.track(Promise.resolve().then(()=>reader.cancel('EXPERIMENT_READER_CLOSED')));try{await readerOwner.before(cancelling,ctx.originalDeadline)}catch(error){readerOwner.failures.push(error)}}try{reader.releaseLock()}catch(error){readerOwner.failures.push(error)}}const observed=await observeStream(ctx,events,ended);return {...observed,readerOwnership:readerOwner}}});
