    {
      "hook": "await readManagedConversationRows(ctx, source.tenantId, source.memorySpaceId, origin.conversationId)",
      "original": "await ctx.db.query(\"runtimeConversations\").withIndex(\"by_scoped_id\", q => q.eq(\"tenantId\", source.tenantId).eq(\"memorySpaceId\", source.memorySpaceId).eq(\"conversationId\", origin.conversationId)).take(2)",
      "bound": 2
    },
    {
      "hook": "await readManagedTranscriptBridgeRows(ctx, source.tenantId, source.memorySpaceId, origin.nativeMessageId)",
      "original": "await ctx.db.query(\"runtimeTranscriptMessages\").withIndex(\"by_native\", q => q.eq(\"tenantId\", source.tenantId).eq(\"memorySpaceId\", source.memorySpaceId).eq(\"nativeMessageId\", origin.nativeMessageId)).take(2)",
      "bound": 2
    },
    {
      "hook": "await readManagedSourceRunRows(ctx, source.tenantId, source.memorySpaceId, bridge.runId)",
      "original": "await ctx.db.query(\"runtimeRuns\").withIndex(\"by_scoped_id\", q => q.eq(\"tenantId\", source.tenantId).eq(\"memorySpaceId\", source.memorySpaceId).eq(\"runId\", bridge.runId!)).take(2)",
      "bound": 2
    },
    {
      "hook": "await readManagedSourceRows(ctx, source.tenantId, source.memorySpaceId, witness.sourceId)",
      "original": "await ctx.db.query(\"runtimeMemorySources\").withIndex(\"by_scope_source\", q => q.eq(\"tenantId\", source.tenantId).eq(\"memorySpaceId\", source.memorySpaceId).eq(\"lineage.sourceId\", witness.sourceId)).take(2)",
      "bound": 2
    }
