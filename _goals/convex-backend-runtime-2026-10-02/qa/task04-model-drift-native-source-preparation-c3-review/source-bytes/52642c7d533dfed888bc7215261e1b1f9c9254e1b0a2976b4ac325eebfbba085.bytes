import *as fs from'node:fs';import *as path from'node:path';import{createHash}from'node:crypto';import assert from'node:assert/strict';import ts from'typescript';const repo='/workspace/Project-Cortex',out=path.resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-source-preparation-c3-review'),sha=b=>createHash('sha256').update(b).digest('hex'),results=[];for(const kind of['extension','regression','extra']){const root=path.resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+kind+'-preparation-c3'),prior=root.replace('-c3','-c2'),rows=[];for(const name of['scripts/cases.mjs','scripts/original-b-cases.mjs','fixture/convex/qualificationCapture.ts']){const a=fs.readFileSync(path.resolve(root,name)),b=fs.readFileSync(path.resolve(prior,name));assert.equal(sha(a),sha(b));rows.push({path:name,byteExactC2:true,sha256:sha(a)});}const extract=(r,name)=>{const body=fs.readFileSync(path.resolve(r,'scripts/driver.mjs'),'utf8'),ast=ts.createSourceFile('driver.mjs',body,ts.ScriptTarget.Latest,true);return ast.statements.find(n=>ts.isFunctionDeclaration(n)&&n.name?.text===name)?.getText(ast);};for(const name of['shape','security','qualify']){const a=extract(root,name),b=extract(prior,name);assert.ok(a);assert.equal(a,b);rows.push({function:name,byteExactC2:true,sha256:sha(a)});}const inv=JSON.parse(fs.readFileSync(path.resolve(root,'registration-inventory.json')));assert.equal(inv.registrations.length,287);assert.equal(inv.registrations.filter(x=>x.visibility==='public').length,200);assert.equal(inv.registrations.filter(x=>x.visibility==='internal').length,87);results.push({kind,rows,registered287:true,public200:true,internal87:true});}fs.writeFileSync(path.resolve(out,'assertion-preservation-audit.json'),JSON.stringify({results,limit:'Exact C2 assertion regions and fixture preserved; semantic exhaustiveness of every imported original path remains separate.'},null,2)+'\n');console.log('all3 exact cases/fixture and shape/security/qualify original C2 function preservation PASS');
