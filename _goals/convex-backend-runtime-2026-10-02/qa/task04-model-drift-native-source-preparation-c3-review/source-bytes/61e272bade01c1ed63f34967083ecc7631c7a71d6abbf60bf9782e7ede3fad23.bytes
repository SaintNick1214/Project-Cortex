import assert from'node:assert/strict';import{ConvexHttpClient}from'convex/browser';import{makeFunctionReference}from'convex/server';import{writeFileSync}from'node:fs';const results=[];
for(const type of['query','mutation','action','function'])for(const mode of['healthy','http-error','udf-error','transport-error']){let calls=0;const client=new ConvexHttpClient('https://dummy-owned-qualification.convex.cloud',{logger:false,fetch:async()=>{calls++;if(mode==='transport-error')throw Error('DUMMY_TRANSPORT');return new Response(JSON.stringify(mode==='udf-error'?{status:'error',errorMessage:'DUMMY_UDF'}:{status:'success',value:null}),{status:mode==='http-error'?503:200});}});let error;try{await(type==='function'?client.function('DUMMY:operation',undefined,{}):client[type](makeFunctionReference('DUMMY:operation'),{}));}catch(e){error=e;}assert.equal(calls,1,'SDK must not retry implicitly');assert.equal(Boolean(error),mode!=='healthy');results.push({type,mode,calls,error:error?.message??null,status:'PASS'});}
let calls=0;const endpoints=[];const c=new ConvexHttpClient('https://dummy-owned-qualification.convex.cloud',{logger:false,fetch:async url=>{calls++;endpoints.push(new URL(url).pathname);return new Response(JSON.stringify(url.endsWith('/api/query_ts')?{ts:'DUMMY_TIMESTAMP'}:{status:'success',value:null}),{status:200});}});await c.consistentQuery(makeFunctionReference('DUMMY:operation'),{});assert.deepEqual(endpoints,['/api/query_ts','/api/query_at_ts']);results.push({type:'consistentQuery',mode:'first',calls,endpoints,status:'PASS_TWO_REQUESTS_SPECIAL_METHOD'});await c.consistentQuery(makeFunctionReference('DUMMY:operation'),{});assert.equal(calls,3);results.push({type:'consistentQuery',mode:'cached-timestamp',totalCalls:calls,status:'PASS_ONE_SUBSEQUENT_REQUEST'});writeFileSync('/workspace/Project-Cortex/_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-source-preparation-c3-review/sdk-entry-controls.json',JSON.stringify({results,scope:'EXACT_INSTALLED_SDK_OFFLINE_FETCH_PORT_NO_WRAPPER_CERTIFICATION'},null,2)+'\n');console.log(results.length+' SDK entry/error/request-count controls PASS');
