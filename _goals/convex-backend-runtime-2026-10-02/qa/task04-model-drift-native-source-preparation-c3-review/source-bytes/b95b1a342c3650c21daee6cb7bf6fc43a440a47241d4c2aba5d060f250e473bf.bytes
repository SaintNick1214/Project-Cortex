import assert from'node:assert/strict';import{readFileSync,writeFileSync}from'node:fs';import{resolve}from'node:path';import{createHash}from'node:crypto';import{SourceTextModule,SyntheticModule,createContext}from'node:vm';
const repo='/workspace/Project-Cortex',sha=b=>createHash('sha256').update(b).digest('hex');for(const kind of['extension','regression','extra']){const root=resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+kind+'-preparation-c3'),results=[];let offset=0;const fakeDate={now:()=>Date.now()+offset};const context=createContext({Buffer,Date:fakeDate,Error,setTimeout,clearTimeout,AbortSignal});const load=async name=>{const source=readFileSync(resolve(root,'scripts',name),'utf8'),m=new SourceTextModule(source,{context,identifier:name});await m.link(async spec=>{if(spec==='./bounded-response.mjs')return helper;if(spec==='./guard.mjs'){const g={limits:{resultBytes:256000,rpcMs:12000},sha256:sha,reserveTicket(){throw Error('NO_TICKET');},livePreflight(){throw Error('NO_LIVE');},qualifierDeadline(){throw Error('NO_WINDOW');},reviewPin(){throw Error('NO_PIN');},root,scratch:'DUMMY',repo,json(){throw Error('NO_PRIVATE');},canonical(){throw Error('NO_PRIVATE');}};return new SyntheticModule(Object.keys(g),function(){for(const[k,v]of Object.entries(g))this.setExport(k,v);},{context});}const exp=await import(spec==='./publication-contract.mjs'?'file://'+resolve(root,'scripts/publication-contract.mjs'):spec);return new SyntheticModule(Object.keys(exp),function(){for(const[k,v]of Object.entries(exp))this.setExport(k,v);},{context});});await m.evaluate();return m;};const helper=new SourceTextModule(readFileSync(resolve(root,'scripts/bounded-response.mjs'),'utf8'),{context});await helper.link(()=>{throw Error('NO_IMPORT');});await helper.evaluate();const peer=await load('peer.mjs'),pub=await load('publication-artifacts.mjs');
for(const [entry,call,max]of[['shared',(r,d)=>peer.namespace.boundedBody(r,3,d),3],['publication',(r,d)=>pub.namespace.boundedRawResponse(r,d),256000],['management',(r,d)=>helper.namespace.ownedResponseBytes(r,16384,d,{requireBody:true}),16384]]){let deadline;for(const mode of['success','exact-limit','chunked-limit','overflow','read-error','read-cancel-error','read-release-error','overflow-cancel-release','release-only','expired-entry','slow-read','late-read','no-body']){offset=0;deadline=Date.now()+(mode==='expired-entry'?-1:mode==='slow-read'?5:1000);let reads=0,cancels=0,releases=0,acquired=0,caught,value;const primary=Error('DUMMY_PRIMARY_READ'),secondary=Error('DUMMY_SECONDARY'),data=mode==='exact-limit'?Buffer.alloc(max):mode==='chunked-limit'?Buffer.alloc(max/2|0):mode.startsWith('overflow')?Buffer.alloc(max+1):Buffer.from('ok');const reader={async read(){reads++;if(mode.startsWith('read-'))throw primary;if(mode==='slow-read')await new Promise(d=>setTimeout(d,30));if(mode==='late-read')offset=2000;return reads===(mode==='chunked-limit'?3:2)?{done:true}:{done:false,value:data};},async cancel(){cancels++;if(mode==='read-cancel-error'||mode==='overflow-cancel-release')throw secondary;},releaseLock(){releases++;if(mode.includes('release')||mode==='release-only')throw secondary;}};const response={body:mode==='no-body'?null:{getReader(){acquired++;return reader;}}};try{value=await call(response,deadline);}catch(e){caught=e;}
if(['success','exact-limit','chunked-limit'].includes(mode)){assert.equal(caught,undefined);assert.equal(Buffer.byteLength(value),mode==='success'?2:mode==='chunked-limit'?2*(max/2|0):max);assert.equal(cancels,0);}else if(mode==='no-body'){assert.equal(caught?.message,entry==='management'?'QA_RESPONSE_BODY':undefined);}else{assert.ok(caught,entry+' '+mode);if(mode.startsWith('read-'))assert.equal(caught,primary);if(mode.startsWith('overflow'))assert.equal(caught.message,'QA_RESPONSE_CEILING');if(mode==='expired-entry'){assert.equal(reads,0);assert.equal(cancels,1);}if(mode==='slow-read')assert.equal(caught.message,'QA_RESPONSE_DEADLINE');if(mode==='read-cancel-error')assert.equal(caught.qaBodyCancelFailure,secondary);if(mode.includes('release')&&mode!=='release-only')assert.equal(caught.qaBodyReleaseFailure,secondary);}if(mode!=='no-body')assert.equal(releases,1);results.push({entry,mode,reads,cancels,releases,acquired,status:'PASS',error:caught?.message??null});}}
writeFileSync(resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-source-preparation-c3-review',kind+'-body-controls.json'),JSON.stringify({results,sourcePins:['peer.mjs','publication-artifacts.mjs','bounded-response.mjs'].map(n=>({path:'scripts/'+n,sha256:sha(readFileSync(resolve(root,'scripts',n)))})),scope:'EXACT_HELPERS_VM_DUMMY_STREAMS_ONLY_NO_NETWORK_PRIVATE_OR_NATIVE',native:'NOT_RUN'},null,2)+'\n');console.log(kind+' '+results.length+' body controls PASS');}
