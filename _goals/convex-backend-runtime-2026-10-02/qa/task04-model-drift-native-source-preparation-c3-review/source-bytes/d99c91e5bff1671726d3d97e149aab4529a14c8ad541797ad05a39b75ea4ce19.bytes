import assert from'node:assert/strict';import *as fs from'node:fs';import *as path from'node:path';import{SourceTextModule,SyntheticModule}from'node:vm';import{ConvexHttpClient}from'convex/browser';import{prepared,mutate}from'./prepared-guard.mjs';import{root,kind,digest}from'./dispatch-context.mjs';
const output=path.resolve('/workspace/Project-Cortex/_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-source-preparation-c3-review');const results=[];
for(const mode of['healthy','source','target','env','publication','pin','window']){
 const h=await prepared();Object.assign(h.vmContext,{URL,Response,TextDecoder,TextEncoder,Uint8Array});h.vmContext.process.argv=['node','offline-queue-controls'];const cache=new Map();
 const synth=obj=>new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:h.vmContext});const guard=synth({...h.module});cache.set('guard.mjs',guard);
 async function load(name){if(cache.has(name))return cache.get(name);const m=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts',name),'utf8'),{context:h.vmContext,identifier:path.resolve(root,'scripts',name),initializeImportMeta:m=>m.url='file://'+path.resolve(root,'scripts',name)});cache.set(name,m);await m.link(async spec=>{if(spec.startsWith('.'))return load(path.normalize(path.join(path.dirname(name),spec)));return synth(await import(spec));});return m;}
 const artifacts=await load('publication-artifacts.mjs');await artifacts.evaluate();const inventory=h.module.json(path.resolve(h.packet,'registration-inventory.json')).registrations;const published=inventory.map(row=>({identifier:row.path.replace(':','.js:'),functionType:row.type[0].toUpperCase()+row.type.slice(1),visibility:row.visibility,args:row.args}));published.push({functionType:'HttpAction',path:'/qa/task04-peer/effect',method:'POST'});const raw=artifacts.namespace.captureRawResponse('synthetic',h.baseline.target.operation,Buffer.from(JSON.stringify({status:'success',value:published})),200);fs.unlinkSync(path.resolve(h.module.scratch,'publication-synthetic.json'));artifacts.namespace.writePublication('synthetic',h.baseline.target.operation,published,h.baseline.publication,raw,{routes:[{path:'/qa/task04-peer/effect',method:'POST'}],basis:'DUMMY'});h.baseline=h.module.livePreflight('synthetic');const identities=Object.fromEntries(['expiredJWT','foreign','forgedJWT','noJWT','ungranted','wrongAudience','wrongIssuer'].map(x=>[x,'']));h.putPrivate('identities.json',{operation:h.baseline.target.operation,runId:h.module.json(path.resolve(h.packet,'project-request.json')).runId,identities});
 const driver=await load('driver.mjs');await driver.evaluate();let dispatches=0,releaseFirst;const held=new Promise(resolve=>releaseFirst=resolve);let firstEntered;const entered=new Promise(resolve=>firstEntered=resolve);h.vmContext.fetch=async(url,options)=>{dispatches++;assert.equal(new URL(url).origin,'https://dummy-owned-qualification.convex.cloud');if(dispatches===1){firstEntered();await held;}return new Response(JSON.stringify({status:'success',value:null}),{status:200,headers:{'content-type':'application/json'}});};
 const s=await driver.namespace.session('synthetic');const first=s.rpc('mutation','qualificationOwned:DUMMY_first',{});await entered;const second=s.rpc('mutation','qualificationOwned:DUMMY_second',{});await new Promise(resolve=>setTimeout(resolve,10));assert.equal(dispatches,1,'second SDK mutation must be queued');const ticketCount=fs.readdirSync(h.module.scratch).filter(x=>x.startsWith('ticket-native-')).length;assert.equal(ticketCount,2,'both exact wrapper preflights completed before local drift');if(mode!=='healthy')mutate(h,mode);let independentDenial;try{h.module.livePreflight('synthetic','rpc');}catch(e){independentDenial=e.message;}releaseFirst();const outcomes=await Promise.allSettled([first,second]);s.close();const expectedSecond=mode==='healthy'?1:0,actualSecond=dispatches-1;let failure;try{assert.equal(actualSecond,expectedSecond,'queued stale mutation must perform zero actual transport calls');if(mode!=='healthy')assert.equal(outcomes[1].status,'rejected','queued stale mutation must reject');}catch(e){failure=e.message;}const r={kind,mode,dispatches,secondDispatches:actualSecond,expectedSecondDispatches:expectedSecond,ticketCount,independentDenial:independentDenial??null,outcomes:outcomes.map(x=>({status:x.status,error:x.reason?.message??null})),failure:failure??null,status:failure?'FAIL':'PASS',dummyPacket:h.packet,exactDriverSHA256:digest(fs.readFileSync(path.resolve(root,'scripts/driver.mjs'))),sdkSHA256:digest(fs.readFileSync('/workspace/Project-Cortex/node_modules/convex/dist/esm/browser/http_client.js'))};results.push(r);console.log(JSON.stringify(r));
}
fs.writeFileSync(path.resolve(output,kind+'-sdk-queue-results.json'),JSON.stringify({scope:'OFFLINE_EXACT_DRIVER_GUARD_ARTIFACT_VALIDATORS_AND_INSTALLED_SDK_DUMMY_NETWORK_PORT_NO_ACTUAL_PRIVATE',results},null,2)+'\n');assert.equal(results.filter(x=>x.status==='FAIL').length,0,'original stale-dispatch zero assertions');
