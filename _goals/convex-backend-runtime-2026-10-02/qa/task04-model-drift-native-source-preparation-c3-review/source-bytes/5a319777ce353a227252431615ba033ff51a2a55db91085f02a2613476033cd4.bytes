import assert from'node:assert/strict';import{readFileSync,writeFileSync,mkdirSync,readdirSync}from'node:fs';import{resolve}from'node:path';import{createHash}from'node:crypto';
const repo='/workspace/Project-Cortex',root=resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-extra-preparation-c3'),inventory=JSON.parse(readFileSync(resolve(root,'registration-inventory.json'))),plan=JSON.parse(readFileSync(resolve(root,'cases.json')));const operation='a'.repeat(36),runId='admission-'+'a'.repeat(32),sha256=x=>createHash('sha256').update(x).digest('hex');
const rows=[];const add=event=>{const body={version:1,operation,runId,sequence:4800,previousDigest:'f'.repeat(64),...event};const line=JSON.stringify({...body,receiptDigest:sha256(JSON.stringify(body))})+'\n';assert.ok(Buffer.byteLength(line)<=1024,'LINE '+Buffer.byteLength(line)+' '+event.caseId);rows.push({form:event,serializedBytes:Buffer.byteLength(line)});};
for(const r of inventory.registrations){add({phase:'synthetic',caseId:r.path.replace(':','-'),status:'PASS',observedCategory:'rpc-complete',elapsedMs:12000});add({phase:'synthetic',caseId:r.path.replace(':','-'),status:'FAIL',observedCategory:'rpc-rejected',failureClass:'a'.repeat(64)});add({phase:'security',caseId:r.path.replace(':','-'),status:'PASS',observedCategory:r.visibility==='public'?'authorization-denied':'published-internal-inaccessible'});if(r.visibility==='public')add({phase:'security',caseId:r.path.replace(':','-'),status:'PASS',noEffect:true,observedCategory:'whole-state-equal'});}
for(const r of plan.scenarios)add({phase:'case',caseId:r.id,status:'PASS',observedCategory:'outcome-asserted'});
for(const status of['PASS','FAIL'])add({phase:'final',caseId:'native-qualifier',status,cleanupComplete:status==='PASS',counts:{rpc:2963,cleanupRpc:256,peerEffects:8,peerOther:24,cumulativeCreatedRows:444,cumulativeDeletedRows:444}});
add({phase:'synthetic',caseId:'publication-arguments',status:'PASS',observedCategory:'published-arguments-equal',apiSpecDigest:'f'.repeat(64)});add({phase:'security',caseId:'healthy-authenticated-public',status:'PASS',observedCategory:'nonempty-public-control'});
for(const status of['PASS','FAIL'])add({phase:'peer',caseId:'public-denial',status,observedCategory:'opaque-denial',elapsedMs:12000});
const numerical={security:{seedControl:4,public:200*(7+2),internal:87*2,maintenance:5*4*3,peerCounter:1,totalNativeClient:2039,allocatedClientUpper:2044},newMinimal:{core:26*32,empty:20,publication:2,finalRecovery:10,nested:37,total:2945},newStronger:{core:4*36+22*32,empty:20,publication:2,finalRecovery:10,nested:37,total:2961},journal:{allocatedRowsUpper:4800,computedStrongerRowsUpper:2924+1400+200+174+26+1+2+2+5+28,maximumSerializedBytes:Math.max(...rows.map(x=>x.serializedBytes)),allocatedSerializedUpper:1024,publicationDiagnosticReserve:2211840,windowReserve:16384,totalBytesUpper:4800*1024+2211840+16384}};assert.ok(numerical.journal.computedStrongerRowsUpper<=4800);assert.equal(numerical.journal.totalBytesUpper,7143424);
const managementForms=[];for(const mode of['provision','retire'])for(const event of[{operation,mode,status:'PENDING',observedAt:'9999-12-31T23:59:59.999Z'},{operation,mode,sequence:5,method:'POST',observedAt:'9999-12-31T23:59:59.999Z',status:'CONSUMED_NO_REFUND'},{operation,mode,status:'FAIL',observedAt:'9999-12-31T23:59:59.999Z',calls:5,dispatched:5,lastStatus:599,bodyComplete:false,failureClass:'A'.repeat(64)}]){const bytes=Buffer.byteLength(JSON.stringify(event,null,2)+'\n');assert.ok(bytes<=1024);managementForms.push({event,bytes});}numerical.management={operations:2,attempts:2,tickets:10,outcomes:2,createdFilesUpper:14,maximumFileBytes:1024,allocatedJointRows:4800,nativeRowsAllocation:4786,sourceJointRowsUpper:numerical.journal.computedStrongerRowsUpper+14,sourceJointBytesUpper:7143424,constructorRowsReserve:38,constructorBytesReserve:2226176};assert.ok(numerical.management.sourceJointRowsUpper<=4800);assert.equal(4786*1024+14*1024+2211840+16384,7143424);const mutations=[];for(const[label,event]of[['overlong-path',{phase:'synthetic',caseId:'a'.repeat(2000),status:'PASS'}],['overlarge-count-form',{phase:'final',caseId:'native-qualifier',status:'FAIL',counts:Object.fromEntries(Array.from({length:200},(_,i)=>['unexpected'+i,Number.MAX_SAFE_INTEGER]))}]]){assert.throws(()=>add(event),/LINE/);mutations.push({label,rejected:true});}
writeFileSync(resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-source-preparation-c3-review/journal-forms-rerun.json'),JSON.stringify({rows,managementForms,numerical,mutations,scope:'Static max-encoding of concrete runner event forms; no actual journal/native observation',native:'NOT_RUN'},null,2)+'\n');console.log(JSON.stringify({encodedForms:rows.length,maximumSerializedBytes:numerical.journal.maximumSerializedBytes,rowsUpper:numerical.journal.computedStrongerRowsUpper,bytesUpper:numerical.journal.totalBytesUpper,controls:mutations.length}));
