import assert from'node:assert/strict';import *as fs from'node:fs';import *as path from'node:path';import{SourceTextModule,SyntheticModule}from'node:vm';import{prepared}from'./prepared-guard.mjs';import{root,kind,digest}from'./dispatch-context.mjs';
const results=[];for(const mode of['provision','retire'])for(const when of['before','after-ticket'])for(const drift of['healthy','source','pin','credentials','selectors','request','ownership','target','env','key-check']){if(mode==='retire'&&drift==='key-check')continue;const h=await prepared(),request=JSON.parse(fs.readFileSync(path.resolve(h.packet,'project-request.json')));h.env.CONVEX_TEAM_ID='DUMMY_TEAM';h.env.CONVEX_TEAM_API_KEY='DUMMY_NONCREDENTIAL';if(mode==='provision'){fs.unlinkSync(path.resolve(h.module.scratch,'target.json'));fs.unlinkSync(path.resolve(h.module.scratch,'deploy.env'));}else h.putPrivate('created-project.json',{operation:request.operation,requestSha256:digest(JSON.stringify(request)),id:99999999,slug:request.projectSlug,requestedName:request.projectName,deploymentName:h.baseline.target.deploymentName,startedAt:new Date().toISOString()});h.env.CORTEX_QA_TASK04_KEY_CHECK_RECEIPT=path.resolve(h.module.scratch,'key-check.json');h.putPrivate('key-check.json',{operation:request.operation,status:'PASS'});let fetches=0,tickets=0;const mutation=()=>{if(drift==='source')h.put('fixture/module.ts','DRIFT');if(drift==='pin')h.env.CORTEX_QA_TASK04_REVIEW_SHA256='0'.repeat(64);if(drift==='credentials')h.env.CONVEX_TEAM_API_KEY='DUMMY_CHANGED';if(drift==='selectors')h.env.CONVEX_URL='https://DUMMY_CHANGED.invalid';if(drift==='request')h.put('project-request.json',{...request,operation:'DUMMY_CHANGED'});if(drift==='ownership')h.putPrivate('created-project.json',{operation:'DUMMY_CHANGED'});if(drift==='target')h.putPrivate('target.json',{...h.baseline.target,projectId:99999998});if(drift==='env')h.putPrivate('deploy.env','CONVEX_URL=https://DUMMY_CHANGED.invalid\n');if(drift==='key-check')h.putPrivate('key-check.json',{operation:'DUMMY_CHANGED'});};const guard={...h.module,exclusive(...args){const v=h.module.exclusive(...args);if(args[0].includes('ticket-')){tickets++;if(when==='after-ticket'&&drift!=='healthy')mutation();}return v;}};h.vmContext.fetch=async()=>{fetches++;let read=0;return{status:200,body:{getReader:()=>({read:async()=>++read===1?{done:false,value:Buffer.from('{}')}:{done:true},cancel:async()=>{},releaseLock(){}})}};};const helper=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts/bounded-response.mjs'),'utf8'),{context:h.vmContext});await helper.link(()=>{});await helper.evaluate();const contract=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts/management-contract.mjs'),'utf8'),{context:h.vmContext});const synth=obj=>new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:h.vmContext});await contract.link(()=>synth(guard));await contract.evaluate();const module=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts/management-transport.mjs'),'utf8'),{context:h.vmContext});await module.link(async n=>n==='./guard.mjs'?synth(guard):n==='./bounded-response.mjs'?helper:n==='./management-contract.mjs'?contract:synth(await import(n)));await module.evaluate();const g=module.namespace.managementGuard(mode,request),op=module.namespace.managementOperation(mode,request,g,mode==='provision'?150000:180000);if(when==='before'&&drift!=='healthy')mutation();let error;try{await op.api('/DUMMY','GET');}catch(e){error=e;}assert.equal(fetches,drift==='healthy'?1:0);assert.equal(tickets,when==='after-ticket'||drift==='healthy'?1:0);if(drift!=='healthy')assert.ok(error);else assert.equal(error,undefined);op.finish(error?'FAIL':'PASS',error);results.push({mode,when,drift,fetches,tickets,error:error?.message??null,consumedNoRefund:tickets===1&&fetches===0,status:'PASS'});}
fs.writeFileSync(path.resolve('/workspace/Project-Cortex/_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-source-preparation-c3-review',kind+'-c3-management-guards.json'),JSON.stringify({kind,results,scope:'EXACT_MANAGEMENT_GUARD_CONTRACT_VM_WITH_REAL_DUMMY_FILES_AND_ACTUAL_GUARD_NO_NATIVE',sourcePins:['management-transport.mjs','management-contract.mjs','guard.mjs'].map(n=>({path:'scripts/'+n,sha256:digest(fs.readFileSync(path.resolve(root,'scripts',n)))}))},null,2)+'\n');console.log(kind+' '+results.length+' management guard controls PASS');
