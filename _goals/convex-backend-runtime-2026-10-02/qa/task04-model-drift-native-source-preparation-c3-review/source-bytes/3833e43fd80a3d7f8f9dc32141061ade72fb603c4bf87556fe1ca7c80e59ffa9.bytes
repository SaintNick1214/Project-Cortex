import{build}from'esbuild';import *as fs from'node:fs';import *as path from'node:path';import{createHash}from'node:crypto';import ts from'typescript';const repo='/workspace/Project-Cortex',out=path.resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-source-preparation-c3-review'),errors=[],results=[];const hash=b=>createHash('sha256').update(b).digest('hex');
for(const kind of['extension','regression','extra']){const root=path.resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+kind+'-preparation-c3'),entries=fs.readdirSync(path.resolve(root,'scripts')).filter(x=>x.endsWith('.mjs')),full=JSON.parse(fs.readFileSync(path.resolve(root,'runner-dependency-inventory.json'))),tiers=JSON.parse(fs.readFileSync(path.resolve(root,'dependency-tiers.json'))),tools=JSON.parse(fs.readFileSync(path.resolve(root,'toolchain-evidence.json')));const graph=async names=>{const r=await build({entryPoints:names.map(n=>path.resolve(root,'scripts',n)),bundle:true,platform:'node',format:'esm',metafile:true,write:false,outdir:path.resolve(out,'UNWRITTEN_GRAPH'),logLevel:'silent'});return{paths:Object.keys(r.metafile.inputs).map(p=>path.relative(repo,path.resolve(repo,p))).sort(),metafile:r.metafile};};const f=await graph(entries),r=await graph(tiers.runtimeEntries);const expected=full.inputs.map(x=>x.path).sort();if(JSON.stringify(f.paths)!==JSON.stringify(expected))errors.push({kind,error:'FULL_GRAPH',added:f.paths.filter(x=>!expected.includes(x)),missing:expected.filter(x=>!f.paths.includes(x))});const exactUnion=(a,b,expected,name)=>{const union=[...a,...b].map(x=>x.path).sort();if(new Set(union).size!==union.length||JSON.stringify(union)!==JSON.stringify(expected.map(x=>x.path).sort()))errors.push({kind,error:name});};exactUnion(tiers.rpc.runner,tiers.boundaryOnly.runner,full.inputs,'RUNNER_UNION');exactUnion(tiers.rpc.tools,tiers.boundaryOnly.tools,tools.files,'TOOLS_UNION');if(JSON.stringify(r.paths)!==JSON.stringify(tiers.rpc.runner.map(x=>x.path).sort()))errors.push({kind,error:'RUNTIME_GRAPH'});for(const row of[...full.inputs,...tools.files]){const b=fs.readFileSync(path.resolve(repo,row.path));if(hash(b)!==row.sha256||row.bytes!==undefined&&b.length!==row.bytes)errors.push({kind,path:row.path,error:'BYTES'});}
 const sources=[];for(const name of entries){const p=path.resolve(root,'scripts',name),body=fs.readFileSync(p,'utf8'),ast=ts.createSourceFile(name,body,ts.ScriptTarget.Latest,true,ts.ScriptKind.JS),functions=[],sites=[];function walk(n){const loc=ast.getLineAndCharacterOfPosition(n.getStart(ast));if(ts.isFunctionLike(n)&&n.body)functions.push({name:n.name?.getText(ast)??'anonymous',line:loc.line+1,endLine:ast.getLineAndCharacterOfPosition(n.end).line+1});if(ts.isCallExpression(n)){const callee=n.expression.getText(ast);if(/assert|rpc|call|snapshot|deny|denied|duplicate|seed|insert|delete|patch|create|track|journal|fetch|spawn|exclusive|write|reserve|cleanup|publish|reap|cancel|release|JSON\.|review|Preflight|Deadline|schedule/.test(callee))sites.push({kind:'call',callee,line:loc.line+1,text:n.getText(ast)});}if(ts.isAwaitExpression(n)||ts.isThrowStatement(n)||ts.isTryStatement(n)||ts.isIfStatement(n)||ts.isForStatement(n)||ts.isForOfStatement(n)||ts.isWhileStatement(n))sites.push({kind:ts.SyntaxKind[n.kind],line:loc.line+1,text:n.getText(ast)});ts.forEachChild(n,walk);}walk(ast);sources.push({path:path.relative(repo,p),sha256:hash(body),functions,sites});}
 results.push({kind,entries,fullRows:f.paths.length,runtimeRows:r.paths.length,rpcTools:tiers.rpc.tools.length,boundaryTools:tiers.boundaryOnly.tools.length,fullGraph:f,runtimeGraph:r,sources,limit:'Complete AST site discovery and import graphs; unresolved dynamic calls and semantic branch upper bounds are not proved by lexical discovery.'});console.log(kind+' FULL '+f.paths.length+' runtime '+r.paths.length+' scripts '+entries.length);}
fs.writeFileSync(path.resolve(out,'graph-and-callsite-audit.json'),JSON.stringify({errors,results,status:errors.length?'FAIL':'PASS_GRAPH_DISCOVERY_ONLY'},null,2)+'\n');if(errors.length)throw Error(JSON.stringify(errors));
