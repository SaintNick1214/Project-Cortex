568:               controller.enqueue({ type: 'raw', rawValue: chunk.rawValue });
569:             }
570: 
571:             // handle failed chunk parsing / validation:
572:             if (!chunk.success) {
573:               finishReason = { unified: 'error', raw: undefined };
574:               controller.enqueue({ type: 'error', error: chunk.error });
575:               return;
576:             }
577: 
578:             metadataExtractor?.processChunk(chunk.rawValue);
579: 
580:             // handle error chunks:
581:             if ('error' in chunk.value) {
582:               finishReason = { unified: 'error', raw: undefined };
583:               controller.enqueue({
584:                 type: 'error',
585:                 error: chunk.value.error,
586:               });
587:               return;
588:             }
589: 
590:             // TODO we lost type safety on Chunk, most likely due to the error schema. MUST FIX
591:             // remove this workaround when the issue is fixed
592:             const value = chunk.value as z.infer<typeof chunkBaseSchema>;
593: 
594:             if (isFirstChunk) {
595:               isFirstChunk = false;
596: 
597:               controller.enqueue({
598:                 type: 'response-metadata',
599:                 ...getResponseMetadata(value),
600:               });
601:             }
602: 
603:             if (value.usage != null) {
604:               usage = value.usage;
605:             }
606: 
607:             const choice = value.choices[0];
608: 
609:             if (choice?.finish_reason != null) {
610:               finishReason = {
611:                 unified: mapOpenAICompatibleFinishReason(choice.finish_reason),
695:               });
696:             }
697:             pendingToolCalls.clear();
698: 
699:             toolCallTracker.flush();
700: 
701:             const providerMetadata: SharedV4ProviderMetadata = {
702:               [providerOptionsName]: {},
703:               ...metadataExtractor?.buildMetadata(),
704:             };
705:             if (
706:               usage?.completion_tokens_details?.accepted_prediction_tokens !=
707:               null
708:             ) {
709:               providerMetadata[providerOptionsName].acceptedPredictionTokens =
710:                 usage?.completion_tokens_details?.accepted_prediction_tokens;
711:             }
712:             if (
713:               usage?.completion_tokens_details?.rejected_prediction_tokens !=
714:               null
715:             ) {
716:               providerMetadata[providerOptionsName].rejectedPredictionTokens =
717:                 usage?.completion_tokens_details?.rejected_prediction_tokens;
718:             }
719: 
720:             controller.enqueue({
721:               type: 'finish',
722:               finishReason,
723:               usage: convertUsage(usage),
724:               providerMetadata,
725:             });
