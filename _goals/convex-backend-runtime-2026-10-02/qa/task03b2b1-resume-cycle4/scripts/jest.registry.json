{
  "rootDir": "/workspace/Project-Cortex/work/resume/registry/candidate",
  "roots": [
    "<rootDir>/tests/unit/runtimeRegistryAuth"
  ],
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/tests/unit/runtimeRegistryAuth/**/*.test.ts"
  ],
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.(ts|js)$": [
      "/workspace/Project-Cortex/work/resume/registry/candidate/node_modules/ts-jest",
      {
        "useESM": true,
        "tsconfig": {
          "allowJs": true,
          "module": "ESNext",
          "moduleResolution": "bundler",
          "target": "ES2021",
          "lib": [
            "ES2021",
            "DOM"
          ]
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(convex))"
  ],
  "cacheDirectory": "/workspace/Project-Cortex/work/resume/registry/cache-registry"
}
