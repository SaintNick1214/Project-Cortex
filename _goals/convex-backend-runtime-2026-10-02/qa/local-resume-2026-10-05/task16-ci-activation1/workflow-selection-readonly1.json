{
  "selectedJobs": {
    "setup-and-purge": {
      "timeoutMinutes": null,
      "strategy": null,
      "if": "(github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) && (\n  needs.detect-changes.outputs.typescript == 'true' ||\n  needs.detect-changes.outputs.vercel-ai-provider == 'true' ||\n  needs.detect-changes.outputs.typescript == 'true' ||\n  needs.detect-changes.outputs.convex == 'true' ||\n  needs.detect-changes.outputs.cli == 'true' ||\n  needs.detect-changes.outputs.typescript == 'true' ||\n  needs.detect-changes.outputs.convex == 'true' ||\n  needs.detect-changes.outputs.convex == 'true' ||\n  (github.event.pull_request.base.ref == 'main' || github.event_name == 'push' || github.event_name == 'workflow_dispatch')\n)\n",
      "needs": "detect-changes",
      "environmentKeys": [
        "CORTEX_CI_RUN_ID",
        "CORTEX_CI_AUTH_ISSUER",
        "CORTEX_CI_AUTH_AUDIENCE",
        "CORTEX_CI_AUTH_PRIVATE_KEY",
        "CORTEX_CI_DISPOSABLE_DEPLOYMENTS",
        "CONVEX_URL",
        "CONVEX_URL_CLI",
        "CONVEX_DEPLOY_KEY",
        "CONVEX_DEPLOY_KEY_CLI",
        "CORTEX_CI_MODEL_MANIFEST_ID",
        "CORTEX_CI_MODEL_MANIFEST_REVISION"
      ],
      "relevantSteps": [
        {
          "name": "Require explicitly approved disposable development targets",
          "if": null,
          "run": "node scripts/ci/verify-disposable-targets.mjs",
          "environmentKeys": []
        },
        {
          "name": "Write public CI JWT verification config (preserve existing host auth)",
          "if": null,
          "run": "node scripts/ci/runtime-fixtures.mjs auth-config",
          "environmentKeys": []
        },
        {
          "name": "Deploy SDK Convex backend to guarded dev target",
          "if": null,
          "run": "npx convex deploy --yes",
          "environmentKeys": []
        },
        {
          "name": "Deploy CLI Convex backend to guarded distinct dev target",
          "if": null,
          "run": "npx convex deploy --yes",
          "environmentKeys": [
            "CONVEX_URL",
            "CONVEX_DEPLOY_KEY"
          ]
        },
        {
          "name": "Install the pinned compiled policy (unknown, synthetic or expired qualification fails closed)",
          "if": null,
          "run": "node scripts/ci/runtime-fixtures.mjs install-policy sdk > ci-sdk-policy.json\nnode scripts/ci/runtime-fixtures.mjs install-policy cli > ci-cli-policy.json\n",
          "environmentKeys": []
        }
      ]
    },
    "test-typescript": {
      "timeoutMinutes": null,
      "strategy": {
        "matrix": {
          "shard": [
            1,
            2,
            3,
            4,
            5
          ]
        },
        "max-parallel": 5,
        "fail-fast": false
      },
      "if": "always() &&\n(github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) &&\nneeds.setup-and-purge.result == 'success' &&\nneeds.detect-changes.result == 'success' &&\n(\n  needs.detect-changes.outputs.typescript == 'true' ||\n  needs.detect-changes.outputs.convex == 'true' ||\n  (github.event.pull_request.base.ref == 'main' || github.event_name == 'push' || github.event_name == 'workflow_dispatch')\n)\n",
      "needs": [
        "detect-changes",
        "setup-and-purge"
      ],
      "environmentKeys": [
        "CORTEX_CI_RUN_ID",
        "CORTEX_CI_AUTH_ISSUER",
        "CORTEX_CI_AUTH_AUDIENCE",
        "CORTEX_CI_AUTH_PRIVATE_KEY",
        "CORTEX_CI_DISPOSABLE_DEPLOYMENTS",
        "CONVEX_URL",
        "CONVEX_URL_CLI"
      ],
      "relevantSteps": [
        {
          "name": "Run tests (shard ${{ matrix.shard }}/5)",
          "if": null,
          "run": "node --experimental-vm-modules node_modules/jest/bin/jest.js \\\n  --testPathIgnorePatterns=debug \\\n  --shard=${{ matrix.shard }}/5 \\\n  --maxWorkers=75%\n",
          "environmentKeys": [
            "CONVEX_URL",
            "OPENAI_API_KEY",
            "CONVEX_TEST_MODE"
          ]
        }
      ]
    },
    "test-vercel-ai-provider": {
      "timeoutMinutes": null,
      "strategy": null,
      "if": "always() &&\n(github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository) &&\nneeds.setup-and-purge.result == 'success' &&\nneeds.detect-changes.result == 'success' &&\n(\n  needs.detect-changes.outputs.vercel-ai-provider == 'true' ||\n  needs.detect-changes.outputs.typescript == 'true' ||\n  needs.detect-changes.outputs.convex == 'true' ||\n  (github.event.pull_request.base.ref == 'main' || github.event_name == 'push' || github.event_name == 'workflow_dispatch')\n)\n",
      "needs": [
        "detect-changes",
        "setup-and-purge"
      ],
      "environmentKeys": [
