import identity from './fs-identity.cjs';
import path from'node:path';import crypto from'node:crypto';import{heldSnapshot,captureHeldRow}from'./preimage-store.mjs';const R='/workspace/Project-Cortex',H=b=>crypto.createHash('sha256').update(b).digest('hex');
export function forkMetadataRows(rows,{map,allowed,immutableBaselines}){return rows.map(row=>{const p=path.resolve(R,row.path);if(!allowed.has(p))throw Error('QA_C6_METADATA_NONMEMBER');const input=map.get(p),snap=heldSnapshot(p),bytes=snap.bytes.length,sha256=H(snap.bytes);if(!input){const baseline=immutableBaselines?.get(p);if(!baseline||!identity.same(snap.identity,baseline.identity)||bytes!==baseline.bytes||sha256!==baseline.sha256)throw Error('QA_C7_METADATA_IMMUTABLE_BASELINE');if(bytes!==row.bytes||sha256!==row.sha256)throw Error('QA_C6_METADATA_IMMUTABLE_DRIFT');return{row:{...row,identity:snap.identity},lineage:null};}const original=heldSnapshot(input.source);if(!identity.same(original.identity,input.sourceIdentity)||!identity.same(snap.identity,input.destinationIdentity))throw Error('QA_C7_METADATA_FORK_IDENTITY');if(original.bytes.length!==input.bytes||H(original.bytes)!==input.sha256||bytes!==input.destinationBytes||sha256!==input.destinationSHA256)throw Error('QA_C6_METADATA_FORK_SOURCE_DRIFT');if(!((row.bytes===input.bytes&&row.sha256===input.sha256)||(row.bytes===bytes&&row.sha256===sha256)))throw Error('QA_C6_METADATA_SOURCE_PIN');const originalBefore=captureHeldRow({path:input.source,bytes:input.bytes,sha256:input.sha256,identity:original.identity},original),destinationBefore=captureHeldRow({path:p,bytes,sha256,identity:snap.identity},snap);return{row:{...row,bytes,sha256,identity:snap.identity},lineage:{utcBeforeMetadataWrite:new Date().toISOString(),path:p,original:originalBefore,destination:destinationBefore,transforms:input.changes,metadataPrior:{...row}}};});}
