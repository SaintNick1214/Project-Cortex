import fs from 'node:fs';import path from 'node:path';import crypto from 'node:crypto';import assert from 'node:assert/strict';import {createRequire} from 'node:module';import {routePolicy} from './route-policy.mjs';import {generateParent,validateGeneratedParent} from './generated-parent-port.mjs';
const require=createRequire(import.meta.url),{install}=require('./bridge-preload.cjs'),raw={...fs},w=path.dirname(new URL(import.meta.url).pathname),root=raw.mkdtempSync('/dev/shm/cortex-native-c7-exact-identity-repair/route-fixture-'),source=path.join(root,'source'),dest=path.join(root,'dest'),results=[];raw.mkdirSync(source);raw.mkdirSync(dest);raw.writeFileSync(path.join(source,'one'),'ONE');raw.mkdirSync(path.join(source,'nested'));raw.writeFileSync(path.join(source,'nested/two'),'TWO');
async function test(name,fn){try{await fn();results.push({name,status:'PASS'});}catch(e){results.push({name,status:'FAIL',error:e.stack});}}
const port=install({roots:[root],readDirectories:['/workspace/Project-Cortex/node_modules'],copySources:[source],stageLinkRoots:[root],stageLinkTarget:'/workspace/Project-Cortex/node_modules',procDiagnostics:true});
try{
 await test('finite-source-specific-recursive-copy-real-effects',()=>{fs.cpSync(source,dest,{recursive:true,errorOnExist:true,force:false});assert.equal(raw.readFileSync(path.join(dest,'one'),'utf8'),'ONE');assert.equal(raw.readFileSync(path.join(dest,'nested/two'),'utf8'),'TWO');});
 await test('arbitrary-recursive-source-denied-zero-destination',()=>{const out=path.join(root,'denied');assert.throws(()=>fs.cpSync(dest,out,{recursive:true}),/QA_BRIDGE_OUTPUT_BINDING/);assert.equal(raw.existsSync(out),false);});
 await test('copy-accessor-never-evaluated-zero-effects',()=>{const out=path.join(root,'getter');let reads=0;const options={get recursive(){reads++;return true;}};assert.throws(()=>fs.cpSync(source,out,options),/QA_BRIDGE_OUTPUT_BINDING/);assert.equal(reads,0);assert.equal(raw.existsSync(out),false);});
 await test('copy-symlink-member-denied-before-tree-dispatch',()=>{const out=path.join(root,'withlink');raw.symlinkSync('one',path.join(source,'link'));try{assert.throws(()=>fs.cpSync(source,out,{recursive:true}),/QA_BRIDGE_OUTPUT_BINDING/);assert.equal(raw.existsSync(out),false);}finally{raw.unlinkSync(path.join(source,'link'));}});
 await test('relative-own-symlink-and-inspection-retain-original-literal',()=>{fs.symlinkSync('one',path.join(dest,'literal'));assert.equal(fs.readlinkSync(path.join(dest,'literal')),'one');assert.equal(fs.lstatSync(path.join(dest,'literal')).isSymbolicLink(),true);assert.throws(()=>fs.readFileSync(path.join(dest,'literal')),/QA_BRIDGE_OUTPUT_BINDING/);});
 await test('finite-installed-stage-link-realpath-positive-no-package-write',()=>{const link=path.join(dest,'node_modules');fs.symlinkSync('/workspace/Project-Cortex/node_modules',link,'dir');assert.equal(fs.realpathSync(link),'/workspace/Project-Cortex/node_modules');assert.throws(()=>fs.writeFileSync(path.join(link,'FORBIDDEN_C3_PACKAGE_WRITE'),'NO'),/QA_BRIDGE_OUTPUT_BINDING/);assert.equal(raw.existsSync('/workspace/Project-Cortex/node_modules/FORBIDDEN_C3_PACKAGE_WRITE'),false);});
 await test('unsupported-named-futimes-denied-zero-change',()=>{const fd=fs.openSync(path.join(dest,'one'),'r+'),before=raw.fstatSync(fd).mtimeMs;try{assert.throws(()=>fs.futimesSync(fd,1,1),/QA_BRIDGE_OUTPUT_BINDING/);assert.equal(raw.fstatSync(fd).mtimeMs,before);}finally{fs.closeSync(fd);}});
 await test('bounded-proc-diagnostic-read-positive-nonstat-denied',()=>{assert.ok(fs.readdirSync('/proc').includes(String(process.pid)));assert.ok(fs.readFileSync('/proc/'+process.pid+'/stat','utf8').length>0);assert.throws(()=>fs.readFileSync('/proc/'+process.pid+'/environ'),/QA_BRIDGE_OUTPUT_BINDING/);});
}finally{port.restore();}
const recipes=JSON.parse(raw.readFileSync(path.join(w,'parent-source-recipes.json'))).recipes;
for(const recipe of recipes){await test(recipe.profile+'-exact-two-original-source-bound-DUMMY-fields',()=>{const source=raw.readFileSync(recipe.source,'utf8'),generated=generateParent(recipe,source),policy=routePolicy({roots:[root]}),destination=path.join(root,recipe.profile,recipe.allowedFilename);assert.equal(validateGeneratedParent({recipe,source,generated,destination,policy}),generated);assert.throws(()=>validateGeneratedParent({recipe,source,generated:generated+'\n',destination,policy}),/QA_BRIDGE_PARENT_RECIPE/);assert.throws(()=>generateParent(recipe,source+'\n'),/QA_BRIDGE_PARENT_SOURCE/);assert.throws(()=>validateGeneratedParent({recipe,source,generated,destination:path.join(root,'arbitrary.mjs'),policy}),/QA_BRIDGE_PARENT_PATH/);});}
console.log(JSON.stringify({status:results.every(x=>x.status==='PASS')?'PASS_FINITE_ADAPTER_ROUTES_ONLY':'FAIL',results,original122:'HELD',root}));if(results.some(x=>x.status==='FAIL'))process.exitCode=1;
