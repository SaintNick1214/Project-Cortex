// A small strict JSON boundary: duplicate keys, unsafe integers and unknown fields fail.
export function strictJSON(raw) {
  const text=new TextDecoder('utf-8',{fatal:true}).decode(raw);let at=0,nodes=0;
  const ws=()=>{while(/[\t\n\r ]/.test(text[at]??'!'))at++;};
  function string(){const start=at++;for(;;){if(at>=text.length)throw Error('CONSUMER_PARTIAL_JSON');const c=text[at++];if(c==='"')return JSON.parse(text.slice(start,at));if(c==='\\')at++;}}
  function value(depth){ws();if(++nodes>5000000||depth>64)throw Error('CONSUMER_JSON_BOUND');
    const c=text[at];if(c==='"')return string();
    if(c==='{'){at++;const out=Object.create(null),seen=new Set();ws();if(text[at]==='}'){at++;return out;}for(;;){ws();if(text[at]!=='"')throw Error('CONSUMER_JSON_KEY');const key=string();if(seen.has(key))throw Error('CONSUMER_DUPLICATE_JSON_KEY');seen.add(key);ws();if(text[at++]!==':')throw Error('CONSUMER_JSON_COLON');out[key]=value(depth+1);ws();const end=text[at++];if(end==='}')return out;if(end!==',')throw Error('CONSUMER_PARTIAL_JSON');}}
    if(c==='['){at++;const out=[];ws();if(text[at]===']'){at++;return out;}for(;;){out.push(value(depth+1));ws();const end=text[at++];if(end===']')return out;if(end!==',')throw Error('CONSUMER_PARTIAL_JSON');}}
    for(const [token,result]of[['true',true],['false',false],['null',null]])if(text.startsWith(token,at)){at+=token.length;return result;}
    const token=text.slice(at).match(/^-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?/)?.[0];if(!token)throw Error('CONSUMER_JSON_VALUE');at+=token.length;const result=Number(token);if(!Number.isFinite(result)||(Number.isInteger(result)&&!Number.isSafeInteger(result)))throw Error('CONSUMER_UNSAFE_JSON_NUMBER');return result;
  }
  const out=value(0);ws();if(at!==text.length)throw Error('CONSUMER_TRAILING_JSON');return out;
}
export function shape(value,required,optional=[]){if(!value||typeof value!=='object'||Array.isArray(value)||required.some(k=>!Object.hasOwn(value,k))||Object.keys(value).some(k=>!required.includes(k)&&!optional.includes(k)))throw Error('CONSUMER_STRICT_SCHEMA_UNKNOWN_OR_MISSING');return value;}
export function identity(value){shape(value,['schema','fields']);if(value.schema!=='FS_IDENTITY_DECIMAL_V1')throw Error('CONSUMER_IDENTITY_SCHEMA');shape(value.fields,['dev','ino','mode','uid','gid','nlink','size','mtime_ns','ctime_ns']);for(const[k,v]of Object.entries(value.fields)){if(typeof v!=='string'||!(k.endsWith('_ns')?/^-?(0|[1-9][0-9]*)$/:/^(0|[1-9][0-9]*)$/).test(v)||v==='-0'||BigInt(v)<-(2n**63n)||BigInt(v)>=2n**64n)throw Error('CONSUMER_IDENTITY_TOKEN');}return value;}
export function pin(value,optional=[]){shape(value,['path','bytes','sha256','identity'],optional);if(typeof value.path!=='string'||!value.path.startsWith('/')||value.path.includes('\0')||!Number.isSafeInteger(value.bytes)||value.bytes<0||!/^[a-f0-9]{64}$/.test(value.sha256))throw Error('CONSUMER_PIN_SCHEMA');identity(value.identity);if(BigInt(value.identity.fields.size)!==BigInt(value.bytes))throw Error('CONSUMER_PIN_SIZE');if(value.beforeByteBacking){pin(value.beforeByteBacking,['encoding']);if(!['GZIP_EXACT_PREIMAGE','RAW_EXACT_PREIMAGE'].includes(value.beforeByteBacking.encoding))throw Error('CONSUMER_BACKING_ENCODING');}return value;}
export function validateOutput(name,value,root,commandIds,outputRoot=root+'/generated-inputs',publicControl=false){
  const file=r=>pin(r,['beforeByteBacking']);
  if(name==='package-graph.json'){shape(value,['packages','files','identityObservation']);if(JSON.stringify(value.packages)!==JSON.stringify(['@esbuild/linux-x64','@types/node','convex','esbuild','semver','typescript','zod']))throw Error('CONSUMER_ALL_SEVEN_PACKAGES');if(value.identityObservation!=='CURRENT_SOURCE_ONLY_NOT_HISTORICAL_CUSTODY')throw Error('CONSUMER_GRAPH_OBSERVATION_SCOPE');value.files.forEach(file);}
  else if(name==='original-read-map.json'){shape(value,['files','historicalCustody','original122']);if(value.historicalCustody!=='BROKEN_NOT_REPAIRED'||value.original122!=='HELD')throw Error('CONSUMER_ORIGINAL_SCOPE_HELD');value.files.forEach(row=>pin(row,['beforeByteBacking','kind','targetHex']));}
  else if(name==='package-aliases.json'){shape(value,['directories','links','wholeNodeModulesAlias','NODE_PATH','packageGraphSHA256']);if(value.wholeNodeModulesAlias!==false||value.NODE_PATH!=='ABSENT'||value.links.length!==7||value.directories.length!==3)throw Error('CONSUMER_SEVEN_LITERAL_ALIASES');value.directories.forEach(row=>{shape(row,['path','identity']);identity(row.identity);});value.links.forEach(row=>{shape(row,['package','path','target','identity','literalTargetBytes','literalTargetSHA256','capturedPackageRows']);identity(row.identity);});}
  else if(name==='historical-plan-index.json'){shape(value,['kind','perId','sourceRecipeProvenance']);shape(value.perId,['offline-runtime-freeze-extension','offline-runtime-freeze-regression','offline-runtime-freeze-extra','freeze-after-scratch']);Object.values(value.perId).forEach(row=>pin(row,['beforeByteBacking','rows','historicalBytes']));}
  else if(name==='candidate/mirror-source-transform-map.json'){shape(value,['status','inputs','original122']);if(value.status!=='CURRENT_SOURCE_ONLY_INPUTS_NOT_QUALIFICATION'||value.original122!=='HELD')throw Error('CONSUMER_LINEAGE_SCOPE_HELD');value.inputs.forEach(row=>{shape(row,['logicalSource','source','bytes','sha256','sourceIdentity','identity','beforeByteBacking','destination','destinationBytes','destinationSHA256','destinationIdentity','prospectiveDestinationBeforeByteBacking','comparisonSource','changes','historicalIdentityAdopted']);identity(row.sourceIdentity);identity(row.destinationIdentity);file(row.comparisonSource);pin(row.beforeByteBacking,['encoding']);pin(row.prospectiveDestinationBeforeByteBacking,['encoding']);if(row.historicalIdentityAdopted!==false)throw Error('CONSUMER_HISTORICAL_IDENTITY_ADOPTED');});}
  else if(name==='candidate/finite-producer-rules.json'){shape(value,['kind','perId']);if(value.kind!=='FIXED_122_SOURCE_BOUND_VM_RULES')throw Error('CONSUMER_RULE_KIND');const ids=[...commandIds,'OWN_VM_CONSUMER_CONTROL','OWN_EXTERNAL_REVIEW'];if(JSON.stringify(Object.keys(value.perId).sort())!==JSON.stringify(ids.sort()))throw Error('CONSUMER_ALL_124_IDS');for(const recipe of Object.values(value.perId)){shape(recipe,['entry','calls','parentProfile','readiness'],['scope']);if(recipe.readiness!=='FINITE_SOURCE_SELECTORS_BOUND; ORIGINAL_EXECUTION_HELD')throw Error('CONSUMER_RULE_READINESS');for(const call of recipe.calls){shape(call,['producer','producerSHA256','producerIdentity','line','columnStart','columnEnd','kind','argumentExpression','sources','parent','canonical','json','resolution']);identity(call.producerIdentity);call.sources.forEach(file);if(!Number.isSafeInteger(call.line)||call.line<1||!Number.isSafeInteger(call.columnStart)||call.columnStart<1||!Number.isSafeInteger(call.columnEnd)||call.columnEnd<call.columnStart||!['SourceTextModule','runInContext'].includes(call.kind))throw Error('CONSUMER_UTF16_COORDINATE_SCHEMA');}}}
  else if(name==='candidate/prepared-source-inputs.json'){shape(value,['files','identityObservation','excludedSelf','enclosingReceipt']);if(value.files.length!==7||value.excludedSelf!==name||value.enclosingReceipt!==outputRoot+'/producer-receipt.json')throw Error('CONSUMER_PREPARED_SELF_MEMBERSHIP');if(value.identityObservation!==(publicControl?'PUBLIC_SYNTHETIC_ONLY':'CURRENT_NATIVE_SOURCE_ONLY'))throw Error('CONSUMER_PREPARED_SCOPE');value.files.forEach(file);}
  else throw Error('CONSUMER_UNKNOWN_OUTPUT');
  if(!publicControl){
    const counts={'package-graph.json':3458,'original-read-map.json':148325,'candidate/mirror-source-transform-map.json':823};
    if(counts[name]&&(value.files??value.inputs).length!==counts[name])throw Error('CONSUMER_COMPLETE_ORIGINAL_COHORT_COUNT');
    if(name==='historical-plan-index.json'&&(value.perId['freeze-after-scratch'].rows!==70020||Object.entries(value.perId).some(([id,row])=>id!=='freeze-after-scratch'&&row.rows!==1)))throw Error('CONSUMER_WHOLE_70020_HISTORY');
    if(name==='candidate/finite-producer-rules.json'&&Object.values(value.perId).reduce((n,row)=>n+row.calls.length,0)!==246)throw Error('CONSUMER_ALL_246_SELECTORS');
    if(commandIds.length!==122)throw Error('CONSUMER_ALL_122_COMMANDS');
  }
}
