  "contract": {
    "publicModule": "runtimeContentJobs",
    "publicKind": "mutation",
    "methods": [
      "submit",
      "get",
      "list",
      "cancel",
      "reconcile",
      "applySuggestion"
    ],
    "submit": {
      "tenantId": "verified selector",
      "memorySpaceId": "verified selector",
      "version": 1,
      "requestId": "caller-stable-id",
      "intent": "text",
      "prompt": "Write a short document",
      "conversationId": "optional-current-conversation",
      "artifact": "optional immutable {artifactId,version}",
      "parentRunId": "optional REAL active parent; mismatches rejected"
    },
    "list": "{tenantId?,memorySpaceId?,conversationId?,limit?}; RuntimeContentJobV1[]; default20/max50",
    "internal": [
      "enqueueParentTitle",
      "claim",
      "input",
      "pin",
      "bindOperation",
      "save",
      "next",
      "publish",
      "failed",
      "expire",
      "execute"
    ],
    "factory": "runtimeContentGateway.processContentStageHandler(ctx,{jobId,leaseToken},factory:ContentModelFactory)",
    "budget": "automatic title uses active Agent run/account/completed native parent model operation; new explicit intent owns one logical job account; primary/secondary share it; no cost/uncertainty resets on replay/reconcile/cancel",
    "proofs": "Existing root9 plain-chat doGenerate proofs; no V1/V2 catalog or five existing proof modification; exact resolved per-function snapshots govern",
    "policy": {
      "artifactFunctions": [
        "artifact.text",
        "artifact.code",
        "artifact.sheet",
        "artifact.suggestions"
      ],
      "artifactModel": "openai/gpt-4o-mini",
      "titleFunction": "conversation.title",
      "titleModel": "openai/gpt-4o",
      "nativeInterface": "chat",
      "priceRevision": "openrouter-2026-10-08-candidate",
      "boundRevision": "text-8192-512-schema-v2",
      "featureEnvelope": "plain-chat-v1",
      "ruleId": "plain-chat-cookbook-utf8-v1",
      "inputCeiling": 8192,
      "contextCeiling": 16384,
      "outputCeiling": 512,
      "fullUnknownMicroUSDPerCall": 100000
    },
    "sourceCurrentness": "source message hash/revision/bridge, source ancestry and artifact witnesses, exact immutable selected base artifact/hash, current grant/share/epoch/definition/native parent are rechecked at each paid guard and atomic publication; delivery retains unrelated consumed artifact witnesses independently of output version",
    "recovery": "confirmed attached native private {text} draft only; no blind retry of unknown; saved primary alone cannot publish a new artifact without its secondary title",
    "limits": {
      "promptUtf8Bytes": 4096,
      "outputUtf8Bytes": 32768,
