rt not stat.S_ISLNK(value.st_mode) and current.resolve()==current", "65:         if current!=path:assert stat.S_ISDIR(value.st_mode)", "66:     pre=path.lstat();now=time.time_ns()", "67:     assert stat.S_ISREG(pre.st_mode) and pre.st_nlink==1 and pre.st_uid==501 and pre.st_gid==20", "68:     assert 0<=pre.st_size<=16*1024*1024", "69:     assert max(pre.st_mtime_ns,pre.st_ctime_ns)+AGE<=now, 'immature_before_first_capture:'+str(path)", "70:     reserve_source_graph(path,pre.st_size)", "71:     if str(path)in unique_pins:", "72:         pin=unique_pins[str(path)]", "73:         assert nine(pre)==nine(os.fstat(pin['fd']))==pin['PRE9'],'held_duplicate_path_nine_drift'", "74:         if original is not None:assert pin['PRE9']==original,'original_nine_changed:'+str(path)", "75:         return pin", "76:     fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)", "77:     pin={'path':str(path),'fd':fd,'closeAttempted':False}", "78:     all_pins.append(pin) # successful open is immediately owned before metadata/assertion work", "79:     pin.update(kind=kind,PRE9=nine(pre),capturedUnixNs=str(now))", "80:     unique_pins[str(path)]=pin", "81:     assert nine(os.fstat(fd))==pin['PRE9']", "82:     if original is not None:assert pin['PRE9']==original,'original_nine_changed:'+str(path)", "83:     return pin", "84: ", "85: def qualify(pin,expected=None,collect=False):", "86:     fd=pin['fd'];path=Path(pin['path']);baseline=pin['PRE9'];os.lseek(fd,0,os.SEEK_SET)", "87:     assert nine(os.fstat(fd))==baseline", "88:     digest=hashlib.sha256();length=0;chunks=[]", "89:     while data:=os.read(fd,65536):", "90:         length+=len(data);assert length<=int(baseline['size']);digest.update(data)", "91:         if collect:chunks.append(data)", "92:     assert length==int(baseline['size']) and nine(os.fstat(fd))==nine(path.lstat())==baseline", "93:     row={'path':str(path),'sha256':digest.hexdigest(),'bytes':length,'PRE9':baseline,'capturedUnixNs':pin['capturedUnixNs'],'fullEOF':True,'finalDescrip