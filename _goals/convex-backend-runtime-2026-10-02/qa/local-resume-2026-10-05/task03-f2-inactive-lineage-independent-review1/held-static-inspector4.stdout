rtionError,ValueError,KeyError):assert denied,name;rows.append({'id':name,'observed':'DENIED_PUBLIC_DUMMY_ONLY','status':'PASS','privateAccess':0,'realEffects':0});return\n    assert not denied,name;rows.append({'id':name,'observed':'NAMED_PUBLIC_SOURCE_OUTCOME','status':'PASS','privateAccess':0,'realEffects':0})\ndef bound(value):return T.binding_target([{'name':'target.json','bytes':json.dumps(target).encode()}],value)\ncontrol('new-six-canonical-fields-pass-unchanged-T',lambda:bound(binding))\ncontrol('new-six-canonical-fields-pass-pre-private-gate',lambda:G['validate_current_binding'](binding,request))\ncontrol('old-frozen-binding-still-rejects-current-target',lambda:bound(old),True)\ncontrol('old-frozen-binding-still-rejects-pre-private-gate',lambda:G['validate_current_binding'](old,request),True)\nfor field in G['SIX']:\n    changed={**binding,field:1 if field=='teamId'else 'public-foreign-value'}\n    control('unchanged-T-deny-'+field,lambda changed=changed:bound(changed),True)\n    control('pre-private-gate-deny-'+field,lambda changed=changed:G['validate_current_binding'](changed,request),True)\ncontrol('pre-private-gate-team-boolean-denied',lambda:G['validate_current_binding']({**binding,'teamId':True},request),True)\ncontrol('pre-private-gate-extra-key-denied',lambda:G['validate_current_binding']({**binding,'obsoleteAuthority':True},request),True)\ncontrol('pre-private-gate-retired-protection-removal-denied',lambda:G['validate_current_binding']({**binding,'forbiddenRetiredDeployments':binding['forbiddenRetiredDeployments'][:-1]},request),True)\n\n# Execute the unchanged full T stage entry with only public dummy source and\n# filesystem effects substituted. Its target comparisons themselves are untouched.\nfor field in G['SIX']:\n    changed={**binding,field:1 if field=='teamId'else 'public-foreign-value'};effects=[];closed=[]\n    source_rows=[{'name':'target.json','bytes':json.dumps(target).encode(),'fd':999001}]\n    original_open,original_os=T.open_sources,T.os\n    T.open_sources=lambda *_:('PUBLIC_DUMMY_SOURCE',None,999000,source_rows)\n    T.os=types.SimpleNamespace(getuid=lambda:501,getgid=lambda:20,close=lambda fd:closed.append(fd))\n    original_directory=T.owned_directory\n    def deny_effect(*args):effects.append(args);raise RuntimeError('UNEXPECTED_DESTINATION_EFFECT')\n    T.owned_directory=deny_effect\n    try:\n        control('unchanged-stage-denies-'+field+'-before-destination-effect',lambda:T.copy_private('PUBLIC_MEMORY_SOURCE','PUBLIC_MEMORY_DESTINATION',changed,stage=True),True)\n        assert effects==[] and closed==[999001,999000]\n    finally:T.open_sources=original_open;T.os=original_os;T.owned_directory=original_directory\n\ndef function(source,name):return next(node for node in ast.parse(source).body if isinstance(node,ast.FunctionDef)and node.name==name)\nprivate=(P/'private-coordinate.py').read_bytes();official=(P/'official-dispatcher.py').read_bytes();held=(P/'held-acquisition.py').read_bytes();A=(Q/'attempt5/source-acquisition.py').read_bytes()\nassert \"binding = release['currentTransportBinding']\"in ast.unparse(function(private,'preflight'))\nreceiver=ast.unparse(function(private,'receiver_command'));assert '/current-transport-binding.json'in receiver and '/prep/transport-prep/transport-binding.json'not in receiver\nassert 'currentTransportBindingOriginalNine'in receiver and 'currentTransportBindingSha256'in receiver\nnative=ast.unparse(function(held,'native_main'));assert native.index('binding_source.content()')<native.index('load_acquisition(')\nassert native.index(\"current == config['currentTransportBinding']\")<native.index('load_acquisition(')\nstage=ast.unparse(function(raw,'copy_private'));assert stage.index('binding_target(held, binding)')<stage.index('owned_directory(destination)')\nassert \"T.binding_target(self.rows, binding)\"in ast.unparse(ast.parse(A))and 'T.binding_target(held_rows, binding)'in ast.unparse(ast.parse(A))\nobserver=(P/'linux-private-custody-crypto-obser