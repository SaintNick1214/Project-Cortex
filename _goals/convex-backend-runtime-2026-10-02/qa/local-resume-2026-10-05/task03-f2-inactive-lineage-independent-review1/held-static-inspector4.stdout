e):\n try:fn()\n except (AssertionError,ValueError,TimeoutError,RuntimeError):\n  assert deny,name+': expected acceptance but was denied'\n  controls.append({'id':name,'observed':'DENIED_BEFORE_EFFECT','status':'PASS','effects':'ALL_SUBSTITUTED'});return\n assert not deny,name+': unsafe case was unexpectedly accepted'\n controls.append({'id':name,'observed':'NAMED_OUTCOME_ASSERTION_PASSED','status':'PASS','effects':'ALL_SUBSTITUTED'})\ndef witness(name,fn,detail):\n fn();unsafe.append({'id':name,'observed':'UNSAFE_ACCEPTANCE_REPRODUCED','sourceDefect':detail,'effects':'ALL_SUBSTITUTED'});controls.append({'id':name,'observed':'UNSAFE_ACCEPTANCE_REPRODUCED','status':'PASS_WITNESS_ONLY','effects':'ALL_SUBSTITUTED'})\n\nOP='c9fbaa34-8ca8-4153-b8bd-1cfe60a8241f';V='cortex-task03-attempt6-fixture-20261006-c9fbaa34';IMAGE='sha256:9ff43bfe7849197a6dfbaa80f2d11a34db4202d8aaae269ddc8b740f7da75fb3';FREEZE='115e417419ab7b55e9fdbad97e51513f9f24a8e523c7b344168a63c92d8e968c'\npe,pt=modules(P/'private-coordinate.py',['strict_json','inspect_owned','assert_recipe','docker_create'],{'json':json,'OP':OP,'VOLUME':V,'IMAGE':IMAGE,'P':P,'OWNED_NAMES':('receiver','selector'),'OWNED_IDS':{'receiver':'a'*64,'selector':'b'*64},'SELECTOR_NAME':'selector','OWNED_COMMANDS':{'receiver':['REVIEWED_RECEIVER'],'selector':['REVIEWED_SELECTOR']}})\nbase={'Name':'/receiver','Config':{'Labels':{'cortex.operation':OP},'Image':IMAGE,'User':'501:20','WorkingDir':'/tmp','Tty':False,'OpenStdin':True,'StdinOnce':False,'Cmd':['REVIEWED_RECEIVER'],'Entrypoint':None},'Image':IMAGE,'Id':'a'*64,'Platform':'linux','State':{'Running':False,'Pid':0,'OOMKilled':False,'Status':'created','ExitCode':0,'Error':''},'HostConfig':{'ReadonlyRootfs':True,'NetworkMode':'none','Memory':536870912,'MemorySwap':536870912,'PidsLimit':64,'NanoCpus':2000000000,'Privileged':False,'AutoRemove':False,'PublishAllPorts':False,'Binds':None,'PortBindings':{},'CapAdd':None,'CapDrop':None,'VolumesFrom':None,'Devices':[],'SecurityOpt':None,'Tmp