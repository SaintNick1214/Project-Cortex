{"/Users/SaintNick/Documents/Cortex/worktrees/backend-runtime-completion/_goals/convex-backend-runtime-2026-10-02/qa/local-resume-2026-10-05/task03-attempt6-current-binding-repair2/automatic-root-driver.py": "\"\"\"Pre-reviewed automatic Root role. Import is effect-free; no self-issued source authority.\n\nPC, dispatcher and audit launcher execute in this same process. Docker children stay\nunder original Common190 ownership. No long outer command, source edit or new clock.\n\"\"\"\nfrom pathlib import Path\nimport datetime,hashlib,json,os,stat,sys,time,types\nR=Path('/Users/SaintNick/Documents/Cortex/worktrees/backend-runtime-completion');F=R/'_goals/convex-backend-runtime-2026-10-02/qa/local-resume-2026-10-05/task03-attempt6-current-binding-repair2';B=F/'new-bounded-private-native-reader3/shared-source-epoch3';S=Path('/Users/SaintNick/.codex/tmp/cortex-runtime-task03-attempt6-private-20261006');OP='c9fbaa34-8ca8-4153-b8bd-1cfe60a8241f';V='cortex-task03-attempt6-fixture-20261006-c9fbaa34';IMAGE='sha256:9ff43bfe7849197a6dfbaa80f2d11a34db4202d8aaae269ddc8b740f7da75fb3';FREEZE='115e417419ab7b55e9fdbad97e51513f9f24a8e523c7b344168a63c92d8e968c';BIND='3cf0becc5cbb8718bb01c3566e9cb8d71aae1f8c30348aeff7ac40e3f5e9b08e';FIELDS=('dev','ino','mode','uid','gid','nlink','size','mtime_ns','ctime_ns')\nCOUNTS={'discovered':275,'public':200,'internal':75,'deltaVisibilityCases':32,'deltaNativeControls':16,'deltaHealthyAuthorityControls':2,'deltaRevokedNoEffectControls':1,'negativeCases':1400,'visibilityCases':150,'closureCases':262,'domainClosureCases':10,'functionalCases':130,'blocked':0,'failed':0,'skipped':0,'observedPublicPaths':200,'observedInternalPaths':75}\ndef sha(raw):return hashlib.sha256(raw).hexdigest()\ndef strict(raw):\n def pairs(items):\n  out={}\n  for k,v in items:assert k not in out,'duplicate_root_data';out[k]=v\n  return out\n return json.loads(raw,object_pairs_hook=pairs,parse_constant=lambda x:(_ for _ in ()).throw(ValueError('nonfinite_root_data')))\ndef identity(s):return {k:str(getattr(s,'st_'+k))for k in FIELDS}\ndef stamp(s):\n d=datetime.datetime.fromisoformat(s.replace('Z','+00:00'));assert d.tzinfo is not None;return d\nclass Held:\n def __init__(self,end=None):self.rows={};self.end=end\n def open(self,path,limit=16777216,pin=None,private=False,directory=False):\n  if self.end is not None:assert time.monotonic()<self.end,'late_stage_no_further_protected_stat'\n  assert path.is_absolute()and(path.is_relative_to(R)or private and path.is_relative_to(S))and path.resolve()==path\n  if str(path)in self.rows:\n   row=self.rows[str(path)];assert row['directory']==directory and row['private']==private;assert int(row['pin']['size'])<=limit\n   if pin is not None:assert row['pin']==pin\n   self.check(row);return row\n  assert len(self.rows)+32<=4096,'combined_held_source_and_actual_descriptor_bound'\n  s=path.lstat();assert s.st_uid==501 and s.st_gid==20 and s.st_size<=limit\n  assert stat.S_ISDIR(s.st_mode)if directory else stat.S_ISREG(s.st_mode)and s.st_nlink==1\n  key=str(path);row={'path':path,'fd':None,'pin':identity(s),'limit':limit,'private':private,'directory':directory};fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|(os.O_DIRECTORY if directory else 0));row['fd']=fd\n  try:self.rows[key]=row\n  except BaseException as original:\n   try:os.close(fd)\n   except BaseException as cleanup:raise RuntimeError('unregistered_root_fd_close_failed:'+type(original).__name__+':'+type(cleanup).__name__)from original\n   raise\n  self.check(row)\n  if pin is not None:assert row['pin']==pin\n  return row\n def check(self,row):\n  if self.end is not None:assert time.monotonic()<self.end,'held_result_read_after_original_stage_deadline'\n  assert identity(os.fstat(row['fd']))==identity(row['path'].lstat())==row['pin']\n def read(self,row):\n  self.check(row);assert not row['directory'];raw=bytearray();offset=0\n  while data:=os.pread(row['fd'],65536,offset):\n   raw.extend(data);offset+=len(data);assert len(raw)<=row['limit']and len(raw)<=int(row['pin']['size']);self.check(row)\n  assert len(raw)==int(row['pin']['size']);self.check(row);return bytes(raw)\n def closecheck(self):\n  for row in self.rows.values():self.check(row)\n def close(self):\n  rows,self.rows=list(self.rows.values()),{}\n  errors=[]\n  for row in rows:\n   try:os.close(row['fd'])\n   except BaseException as e:errors.append(type(e).__name__)\n  assert errors==[],'owned_held_fd_release_failed'\ndef publish(path,value,limit):\n assert path.is_relative_to(F)or path.is_relative_to(B)or path==S/'coordination/coordinator-finish.json'\n raw=(json.dumps(value,indent=2)+'\\n').encode();assert len(raw)<=limit\n fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600)\n with os.fdopen(fd,'wb')as out:out.write(raw);out.flush();os.fsync(out.fileno())\n d=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)\n try:os.fsync(d)\n finally:os.close(d)\n return sha(raw)\ndef mature(path,end):\n while True:\n  s=path.lstat();wait=max(0,(max(s.st_mtime_ns,s.st_ctime_ns)+60000000000-time.time_ns())/1e9)\n  if wait==0:return\n  assert time.monotonic()+wait<end,'mature_handoff_original_stage_admission_denied'\n  time.sleep(min(wait,0.25))\ndef reviewed_bytes(path,holder,mf,approval):\n found=[r for r in mf['files']if R/r['path']==path];assert len(found)==1;row=found[0]\n h=holder.open(path,pin=row['PRE']);raw=holder.read(h);assert len(raw)==row['bytes']and sha(raw)==row['sha256']==approval['sources'][row['path']]\n holder.check(h);return raw\ndef load_reviewed(path,holder,mf,approval,name):\n raw=reviewed_bytes(path,holder,mf,approval)\n module=types.ModuleType(name);module.__file__=str(path);module.__package__='';exec(compile(raw,str(path),'exec',dont_inherit=True),module.__dict__);return module\nclass RootRole:\n def __init__(self,h,mf,approval,holder,G,PC,AL,D):\n  self.h=h;self.mf=mf;self.approval=approval;self.holder=holder;self.G=G;self.PC=PC;self.AL=AL;self.D=D;self.original_end=None;self.first=None;self.prepared=None;self.window_sha=None;self.private_done=False;self.native_done=False;self.sticky=[];self.remaining={'crypto','native'}\n def common_handoff(self,stage):\n  return {k:self.h[k]for k in ('operation','volume','immutableImage','immutableImageDefaultEnv','candidateSha256','sourceManifestSha256','sourceManifestOriginalNine','sourceMemberCount','sourceMemberBytes','sourceApprovalSha256','actualObserverSha256','currentTransportBindingSha256','currentBindingPublicDecisionSha256','preparedReaderPlanSha256')}|{'authorizedByRoot':True,'sourceOnly':False,'stage':stage}\n def handoff(self,stage,extra=None):\n  p=B/'handoffs'/(stage+'.json');publish(p,self.common_handoff(stage)|(extra or {}),65536);return p\n def audit(self,stage,path,end):\n  mature(path,end);assert time.monotonic()<end\n  argv=sys.argv;signals={sig:self.PC.signal.getsignal(sig)for sig in(self.PC.signal.SIGTERM,self.PC.signal.SIGINT)}\n  try:\n   sys.argv=[str(B/'audit-launcher.py'),'--plan-sha256',self.h['preparedReaderPlanSha256'],'--handoff',str(path)];code=self.AL.main();assert type(code)is int and code==0,'actual_audit_child_or_reader_failed'\n  finally:\n   sys.argv=argv\n   for sig,value in signals.items():self.PC.signal.signal(sig,value)\n  assert time.monotonic()<end,'actual_audit_completion_after_original_window'\n def prepare(self):\n  (B/'handoffs').mkdir(mode=0o700);p=self.handoff('PREPARE_OBSERVERS');self.audit('PREPARE_OBSERVERS',p,time.monotonic()+420)\n  with_read=Held()\n  try:\n   raw=with_read.read(with_read.open(B/'prepare/prepared-observers.json',65536));v=strict(raw);assert v['operation']==OP and v['status']=='PREPARED_NOT_STARTED'and v['privateReads']==v['targetProvisioning']==0;assert set(v['specs'])==self.remaining\n   self.prepared=sha(raw);self.prepared_specs=v['specs'];with_read.closecheck()\n  finally:with_read.close()\n def first_transfer(self,value,end):\n  assert self.first is None and value['operation']==OP and value['volume']==V and value['candidateSha256']==FREEZE and value['phase']=='ACTUAL_PRIVATE_TRANSFER_AWAITING_INDEPENDENT_REVIEW'and value['status']=='HELD'\n  assert value['privateFilesTransferred']==3 and value['nativeSourceFiles']==4 and value['cliDispatched']is False and value['actualPrivateCryptographicAcceptance']is False\n  self.original_end=end;utc_end=stamp(value['observedAtUtc'])+datetime.timedelta(seconds=2400);assert abs((utc_end-datetime.datetime.now(datetime.timezone.utc)).total_seconds()-(end-time.monotonic()))<1\n  tmp=Held()\n  try:\n   raw=tmp.read(tmp.open(F/'runtime/coordinator-status.json',32768));assert strict(raw)==value;self.first=sha(raw);tmp.closecheck()\n  finally:tmp.close()\n  self.private_handoff=self.handoff('PRIVATE',{'initialTransferStatusSha256':self.first,'preparedObserversSha256':self.prepared})\n def held_audit_result(self,stage,limit,end):\n  held=Held(end)\n  try:\n   raw=held.read(held.open(B/stage/'decision.json',limit));decision=strict(raw)\n   closure=strict(held.read(held.open(B/stage/'final-held-closure.json',16777216)))\n   assert closure['status']=='PASS_ALL_ORIGINAL_NINE_FULL_EOF_HASH_SIZE'\n   assert len(closure['files'])==len({r['path']for r in closure['files']}) and closure['files']\n   if stage=='private':assert closure['directories']\n   assert {str(R/r['path'])for r in self.mf['files']}<={r['path']for r in closure['files']},'complete_reviewed_source_cohort_missing_from_actual_held_result'\n   for row in closure['files']:\n    path=Path(row['path']);item=held.open(path,16777216,pin=row['originalNine'],private=path.is_relative_to(S));content=held.read(item);assert row['fullEOF']is True and len(content)==row['bytes']and sha(content)==row['sha256']\n   for row in closure['directories']:held.open(Path(row['path']),pin=row['originalNine'],private=True,directory=True)\n   held.closecheck();return held,raw,decision\n  except BaseException:held.close();raise\n def private_release(self,end,observer_sha):\n  assert end==self.original_end and observer_sha==self.h['actualObserverSha256']\n  if self.private_done:return\n  assert end-time.monotonic()>=2050+270,'original_private270_and_official2050_admission_denied'\n  self.audit('PRIVATE',self.private_handoff,end-2050)\n  held,raw,v=self.held_audit_result('private',262144,end-2050)\n  try:\n   validator,lease=self.AL.load_reader(self.h['preparedReaderPlanSha256'])\n   try:\n    v=validator.decode_crypto_decision(raw);assert validator.encode_crypto_decision(v)==raw;lease.closecheck()\n   finally:lease.close()\n   self.D.bind_crypto_gate(v,self.h['sourceApprovalSha256'],self.h['sourceManifestSha256'],observer_sha)\n   assert v['currentBindingPublicDecisionSha256']==self.h['currentBindingPublicDecisionSha256']and v['firstTransferStatusSha256']==self.first and v['independentObservationHeldSeconds']==20\n   assert stamp(v['originalDeadlineUtc'])-stamp(v['latestRootReleaseUtc'])==datetime.timedelta(seconds=2050)\n   window=strict(held.read(held.open(B/'private/original-window.json',65536)));assert window['initialTransferStatusSha256']==self.first and window['operation']==OP and window['seconds']==2400;self.window_sha=sha(held.read(held.open(B/'private/original-window.json',65536)))\n   assert end-time.monotonic()>=2050\n   publish(F/'actual-private-crypto-independent-review.json',v,262144)\n   release={'operation':OP,'volume':V,'candidateSha256':FREEZE,'decisionPath':str(F/'actual-private-crypto-independent-review.json'),'decisionSha256':sha((json.dumps(v,indent=2)+'\\n').encode()),'sourceManifestSha256':self.h['sourceManifestSha256'],'sourceApprovalSha256':self.h['sourceApprovalSha256'],'actualObserverSha256':observer_sha};assert len(release)==8\n   held.closecheck();assert end-time.monotonic()>=2050;publish(F/'actual-private-crypto-execution-release.json',release,32768);held.closecheck();assert end-time.monotonic()>=2050\n   self.private_done=True;self.remaining.discard('crypto')\n   self.native_handoff=self.handoff('NATIVE',{'originalWindowSha256':self.window_sha,'preparedObserversSha256':self.prepared});self.retirement_handoff=self.handoff('RETIREMENT',{'originalWindowSha256':self.window_sha})\n  finally:held.close()\n def native_finish(self,end):\n  assert end==self.original_end\n  if self.native_done:return\n  assert end-time.monotonic()>=270,'original_native270_admission_denied'\n  self.audit('NATIVE',self.native_handoff,end-30);held,raw,v=self.held_audit_result('native',65536,end-30)\n  try:\n   assert v['scope']=='ACTUAL_CURRENT_FOUNDATION_NATIVE_OUTCOME_ONLY'and v['verdict']=='PASS'and v['independent']is True and v['actualNativeOutcomeIndependentlyReviewed']is True\n   for key,expected in {'operation':OP,'volume':V,'immutableImage':IMAGE,'candidateSha256':FREEZE,'sourceManifestSha256':self.h['sourceManifestSha256'],'privateSourceApprovalSha256':self.h['sourceApprovalSha256'],'originalWindowSha256':self.window_sha}.items():assert v[key]==expected\n   assert v['counts']==COUNTS and all(type(n)is int for n in v['counts'].values())\n   for key in ('officialDeploymentAndCodegen','allOriginalCaseCoverage','originalSourceClosureAllNineFullEOFHashSize','ownedProcessAndNativeCleanup'):assert v[key]=='PASS'\n   assert v['fullTask03']is False and v['goalAccepted']is False\n   held.closecheck();assert time.monotonic()<end\n   publish(S/'coordination/coordinator-finish.json',{'operation':OP,'finish':True,'candidateSha256':FREEZE,'actualNativeOutcomeIndependentlyReviewed':True},32768);held.closecheck();assert time.monotonic()<end\n   self.native_done=True;self.remaining.discard('native')\n  finally:held.close()\n def finish_after_coordinator(self):\n  assert self.private_done and self.native_done and self.window_sha is not None\n  self.audit('RETIREMENT',self.retirement_handoff,time.monotonic()+300)\n  h=Held()\n  try:\n   v=strict(h.read(h.open(B/'retirement/decision.json',65536)));assert v['scope']=='ACTUAL_OWNED_TARGET_RETIREMENT_AND_LINUX_SELECTOR_CLEANUP_ONLY'and v['verdict']=='PASS'and v['independent']is True and v['operation']==OP and v['volume']==V and v['candidateSha256']==FREEZE\n   for key in ('managementOwnedDeletionHTTP200','managementOwnedVerificationHTTP404','linuxSelectorInvalidated','linuxSelectorContainerRemoved'):assert v[key]is True\n   v=strict(h.read(h.open(F/'runtime/coordinator-status.json',32768)));assert v['phase']=='COORDINATOR_TERMINAL'and v['status']=='PASS'and v['physicalProjectRetired']is True and v['completionSignal']is True and v['failures']==[];h.closecheck()\n  finally:h.close()\n def cleanup(self):\n  if self.prepared is None:return\n  # Reviewed launcher interface independently reacquires every source/recipe and\n  # reconciles only retained exact IDs. Unknown ownership is never signaled.\n  module,lease=self.AL.load_reader(self.h['preparedReaderPlanSha256'])\n  try:\n   result=module.cleanup_prepared(self.common_handoff('PREPARE_OBSERVERS')|{'preparedObserversSha256':self.prepared,'cleanupAttempt':1},sorted(self.remaining));assert result['status']=='PASS'and result['cleanupErrors']==[]and result['remainingKeys']==[]and result['privateReads']==0 and result['targetEffects']==0 and result['noForeignSignals']is True\n   lease.closecheck();self.remaining.clear()\n  finally:lease.close()\ndef main():\n assert sys.dont_write_bytecode is True and len(sys.argv)==3 and sys.argv[1]=='--root-handoff'\n holder=Held();role=None;failure=None\n try:\n  hp=Path(sys.argv[2]);assert hp==F/'automatic-root-execution-handoff.json';hraw=holder.read(holder.open(hp,32768));h=strict(hraw);assert h['scope']=='ROOT_EXPLICIT_PRE_REVIEWED_AUTOMATIC_TASK03_EXECUTION_ONLY'and h['authorizedByRoot']is True and h['sourceOnly']is False\n  assert time.time_ns()-max(int(holder.rows[str(hp)]['pin'][k])for k in('ctime_ns','mtime_ns'))>=60000000000\n  for key,value in {'operation':OP,'volume':V,'immutableImage':IMAGE,'candidateSha256':FREEZE,'currentTransportBindingSha256':BIND}.items():assert h[key]==value\n  mfraw=holder.read(holder.open(F/'prospective-source-manifest.json',4194304,pin=h['sourceManifestOriginalNine']));mf=strict(mfraw);assert sha(mfraw)==h['sourceManifestSha256']and mf['members']==h['sourceMemberCount']and mf['bytes']==h['sourceMemberBytes']\n  araw=holder.read(holder.open(F/'integrated-source-review.json',1048576));a=strict(araw);assert sha(araw)==h['sourceApprovalSha256']and a['scope']=='TASK03_ATTEMPT6_CURRENT_BINDING_REPAIR2_SOURCE_ONLY'and a['independent']is True and a['verdict']=='PASS'and a['sourceManifestSha256']==sha(mfraw)and a['sourceManifestOriginalNine']==h['sourceManifestOriginalNine']and a['sources']=={r['path']:r['sha256']for r in mf['files']}\n  assert sum(r['bytes']for r in mf['files'])+len(mfraw)+len(araw)+2097152<=67108864 and len(mf['files'])+32<=4096\n  G=load_reviewed(F/'source-gates.py',holder,mf,a,'root_actual_source_gates');release=G.qualify_public_release();assert release['currentBindingPublicDecisionSha256']==h['currentBindingPublicDecisionSha256']\n  PC=load_reviewed(F/'private-coordinate.py',holder,mf,a,'root_actual_private_coordinator');D=load_reviewed(F/'official-dispatcher.py',holder,mf,a,'root_actual_verdict_validator');AL=load_reviewed(B/'audit-launcher.py',holder,mf,a,'root_actual_audit_launcher')\n  assert sha(reviewed_bytes(B/'audit-plan.json',holder,mf,a))==h['preparedReaderPlanSha256'];assert sha(reviewed_bytes(F/'linux-private-custody-crypto-observer.mjs',holder,mf,a))==h['actualObserverSha256']\n  role=RootRole(h,mf,a,holder,G,PC,AL,D);role.prepare();PC.main(root_role=role);role.finish_after_coordinator();holder.closecheck()\n except BaseException as e:failure=type(e).__name__\n finally:\n  if role is not None:\n   try:role.cleanup()\n   except BaseException as e:failure=failure or type(e).__name__\n  try:holder.closecheck()\n  except BaseException as e:failure=failure or type(e).__name__\n  try:holder.close()\n  except BaseException as e:failure=failure or type(e).__name__\n print(json.dumps({'scope':'ACTUAL_AUTOMATIC_ROOT_ROLE_OUTCOME_ONLY','status':'FAIL_STICKY'if failure else'PASS_BOUNDED_FOUNDATION_ONLY','failureClass':failure,'operation':OP,'fullTask03':False,'goalAccepted':False,'historicalCustodyRepaired':False,'privateContentsPrinted':False}));return 1 if failure else 0\nif __name__=='__main__':raise SystemExit(main())\n", "/Users/SaintNick/Documents/Cortex/worktrees/backend-runtime-completion/_goals/convex-backend-runtime-2026-10-02/qa/local-resume-2026-10-05/task03-attempt6-current-binding-repair2/source-gates.py": "\"\"\"Public-only immutable source and current independent release gates; no private access.\"\"\"\nfrom pathlib import Path\nimport hashlib, json, os, stat\nR = Path('/Users/SaintNick/Documents/Cortex/worktrees/backend-runtime-completion')\nQA = R / '_goals/convex-backend-runtime-2026-10-02/qa'\nP = QA / 'local-resume-2026-10-05/task03-attempt6-current-binding-repair2'\nQ = QA / 'task03-local-native-attempt6-2026-10-06'\nFIELDS = ('dev', 'ino', 'mode', 'uid', 'gid', 'nlink', 'size', 'mtime_ns', 'ctime_ns')\n\ndef identity(s):\n    return {k: str(getattr(s, 'st_' + k)) for k in FIELDS}\n\ndef strict(raw):\n\n    def pairs(items):\n        out = {}\n        for k, v in items:\n            if k in out:\n                raise ValueError('duplicate_public_gate_key')\n            out[k] = v\n        return out\n    return json.loads(raw, object_pairs_hook=pairs, parse_constant=lambda x: (_ for _ in ()).throw(ValueError('nonfinite_gate')))\n\ndef digest(raw):\n    return hashlib.sha256(raw).hexdigest()\nRELEASE_DATA_NAMES = {'independent-preparation-review.json': 32768, 'task03-attempt6-management-review.json': 32768, 'base-public-custody-review.json': 131072, 'current-binding-public-custody-review.json': 131072, 'actual-private-crypto-execution-release.json': 32768, 'actual-private-crypto-independent-review.json': 262144, 'private-key-reuse-authorization.json': 32768, 'runtime/coordinator-status.json': 32768}\n\ndef read(path, pin=None):\n    assert path.is_absolute() and path.is_relative_to(R) and (path.resolve() == path)\n    pre = os.lstat(path)\n    relative = str(path.relative_to(P)) if path.is_relative_to(P) else None\n    if relative in RELEASE_DATA_NAMES:\n        assert pre.st_size <= RELEASE_DATA_NAMES[relative]\n        assert sum(RELEASE_DATA_NAMES.values()) <= 2097152, 'single_total_future_release_data_reservation_exceeded'\n    assert stat.S_ISREG(pre.st_mode) and pre.st_nlink == 1 and (pre.st_uid == 501) and (pre.st_gid == 20) and (0 <= pre.st_size <= 16 * 1024 * 1024)\n    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)\n    try:\n        current = identity(pre)\n        assert current == identity(os.fstat(fd))\n        if pin is not None:\n            assert current == pin\n        raw = bytearray()\n        while (data := os.read(fd, 65536)):\n            raw.extend(data)\n            assert len(raw) <= pre.st_size\n        assert len(raw) == pre.st_size\n        assert current == identity(os.fstat(fd)) == identity(os.lstat(path))\n        return bytes(raw)\n    finally:\n        os.close(fd)\n\nclass HeldSourceLease:\n    \"\"\"Borrow reviewed Cohort rows; only their original owner closes descriptors.\"\"\"\n\n    def __init__(self, owner):\n        assert type(owner.rows) is list and type(owner.by_path) is dict and owner.rows\n        self.owner = owner\n        self.owner_rows = owner.rows\n        self.detached = False\n        self.acquired = []\n        self.check_owner()\n\n    def check_owner(self):\n        assert not self.detached and self.owner.rows is self.owner_rows, 'closed_or_foreign_source_owner'\n        assert len(self.owner.rows) == len(self.owner.by_path) and all((self.owner.by_path[r['path']] is r for r in self.owner.rows))\n        assert all(r['ownerToken'] is self.owner.source_owner_token for r in self.owner.rows), 'foreign_descriptor_owner_map'\n        fds = [r['fd'] for r in self.owner.rows]\n        assert len(fds) == len(set(fds)) and all((type(fd) is int and fd >= 0 for fd in fds))\n        selected = [r for r in self.owner.rows if r['source'] or r['data']]\n        assert len(selected) + 32 <= 4096, 'one_simultaneous_owned_source_descriptor_ceiling'\n        assert self.owner.source_bytes + 2097152 <= 67108864 and self.owner.data_bytes <= 2097152\n\n    def acquire(self, path, pin=None):\n        self.check_owner()\n        assert path.is_absolute() and path.is_relative_to(R) and (path.resolve() == path)\n        assert str(path) in self.owner.by_path, 'incomplete_shared_source_map'\n        row = self.owner.by_path[str(path)]\n        assert row['private'] is False and row['directory'] is False and (row['source'] or row['data'])\n        if pin is not None:\n            assert row['originalNine'] == pin, 'foreign_or_stale_shared_source_pin'\n        assert row['originalNine']['uid'] == '501' and row['originalNine']['gid'] == '20' and (row['originalNine']['nlink'] == '1')\n        assert identity(os.fstat(row['fd'])) == identity(path.lstat()) == row['originalNine']\n        if row not in self.acquired:\n            self.acquired.append(row)\n        return row\n\n    def read(self, path, pin=None):\n        row = self.acquire(path, pin)\n        raw = self.owner.read(row)\n        relative = str(path.relative_to(P)) if path.is_relative_to(P) else None\n        assert len(raw) <= 16777216\n        if relative in RELEASE_DATA_NAMES:\n            assert len(raw) <= RELEASE_DATA_NAMES[relative]\n        assert row['fullEOF'] is True and len(raw) == row['bytes'] and (digest(raw) == row['sha256'])\n        self.check_owner()\n        return raw\n\n    def release(self):\n        self.check_owner()\n        self.detached = True\n        self.acquired = []\n\ndef source_read(path, pin=None, source_lease=None):\n    if source_lease is None:\n        return read(path, pin)\n    assert type(source_lease) is HeldSourceLease\n    return source_lease.read(path, pin)\n\ndef expected_source_paths(source_lease=None):\n    plan = strict(source_read(P / 'prospective-source-plan.json', source_lease=source_lease))\n    assert plan['scope'] == 'TASK03_ATTEMPT6_REPAIR2_FINITE_SOURCE_PLAN_ONLY'\n    assert plan['historicalD101OriginalCustody'] == 'FAILED_UNKNOWN_ONE_CTIME_NOT_REPAIRED'\n    assert len(plan['members']) == len({row['path'] for row in plan['members']})\n    paths = {R / row['path'] for row in plan['members']} | {P / 'prospective-source-plan.json', P / 'source-writers-stopped.json'}\n    assert all((path.is_absolute() and path.is_relative_to(R) and (path.resolve() == path) for path in paths))\n    return sorted(paths)\n\ndef reviewed_source(path, source_lease=None):\n    mf = strict(source_read(P / 'prospective-source-manifest.json', source_lease=source_lease))\n    approval = strict(source_read(P / 'integrated-source-review.json', source_lease=source_lease))\n    assert approval['scope'] == 'TASK03_ATTEMPT6_CURRENT_BINDING_REPAIR2_SOURCE_ONLY' and approval['verdict'] == 'PASS' and (approval['independent'] is True)\n    assert digest(source_read(P / 'prospective-source-manifest.json', approval['sourceManifestOriginalNine'], source_lease=source_lease)) == approval['sourceManifestSha256']\n    found = [row for row in mf['files'] if row['path'] == str(path.relative_to(R))]\n    assert len(found) == 1\n    row = found[0]\n    raw = source_read(path, row['PRE'], source_lease=source_lease)\n    assert len(raw) == row['bytes'] and digest(raw) == row['sha256'] == approval['sources'][row['path']]\n    return (row, raw)\n\ndef qualify_sources(source_lease=None):\n    approvalraw = source_read(P / 'integrated-source-review.json', source_lease=source_lease)\n    assert len(approvalraw) <= 1048576\n    approval = strict(approvalraw)\n    mfraw = source_read(P / 'prospective-source-manifest.json', approval['sourceManifestOriginalNine'], source_lease=source_lease)\n    mf = strict(mfraw)\n    assert approval['verdict'] == 'PASS' and approval['independent'] is True and (approval['scope'] == 'TASK03_ATTEMPT6_CURRENT_BINDING_REPAIR2_SOURCE_ONLY')\n    assert approval['sourceManifestSha256'] == digest(mfraw)\n    assert approval['candidateSha256'] == digest(source_read(Q / 'candidate-freeze-attempt6.json', source_lease=source_lease))\n    assert mf['scope'] == 'TASK03_ATTEMPT6_REPAIR2_NEW_PROSPECTIVE_SOURCE_CLOSURE_ONLY' and mf['status'] == 'READY_FOR_FRESH_INDEPENDENT_REVIEW' and (mf['sourceWriters'] == 'STOPPED')\n    assert mf['historicalD101OriginalCustody'] == 'FAILED_UNKNOWN_ONE_CTIME_NOT_REPAIRED'\n    planraw = source_read(P / 'prospective-source-plan.json', source_lease=source_lease)\n    assert digest(planraw) == mf['sourcePlanSha256'] == approval['sourcePlanSha256']\n    stopraw = source_read(P / 'source-writers-stopped.json', source_lease=source_lease)\n    stop = strict(stopraw)\n    assert digest(stopraw) == mf['sourceWritersStoppedSha256'] and stop['sourceWriters'] == 'STOPPED' and (stop['remainingSourceWrites'] == [])\n    assert int(mf['capturedUnixNs']) >= int(stop['stoppedUnixNs']) + 60000000000\n    assert all((max(int(row['PRE']['ctime_ns']), int(row['PRE']['mtime_ns'])) + 60000000000 <= int(mf['capturedUnixNs']) for row in mf['files']))\n    assert all((max(int(row['PRE']['ctime_ns']), int(row['PRE']['mtime_ns'])) <= int(stop['stoppedUnixNs']) for row in mf['files'] if row['path'] != str((P / 'source-writers-stopped.json').relative_to(R))))\n    assert len(mf['files']) == len({row['path'] for row in mf['files']})\n    assert {R / row['path'] for row in mf['files']} == set(expected_source_paths(source_lease=source_lease))\n    assert set(approval['sources']) == {row['path'] for row in mf['files']}\n    plan = strict(planraw)\n    planrows = {row['path']: row for row in plan['members']}\n    assert 0 < len(mf['files']) <= 4096 and sum((row['bytes'] for row in mf['files'])) <= 67108864\n    assert plan['sourceGraphBudgetIncludesManifestApprovalAndReleaseData'] is True\n    assert type(plan['futureReleaseDataByteReserve']) is int and plan['futureReleaseDataByteReserve'] == 2097152\n    assert sum((row['bytes'] for row in mf['files'])) + len(mfraw) + len(approvalraw) + plan['futureReleaseDataByteReserve'] <= 67108864, 'whole_declared_source_control_data_graph_not_admitted'\n    for row in mf['files']:\n        assert type(row['bytes']) is int and 0 <= row['bytes'] <= 16777216\n        if row['path'] in planrows:\n            assert row['sha256'] == planrows[row['path']]['sha256'] and row['bytes'] == planrows[row['path']]['bytes']\n    held = []\n    failure = None\n    try:\n        for row in mf['files']:\n            path = R / row['path']\n            assert path.is_relative_to(R) and path.resolve() == path\n            pre = os.lstat(path)\n            assert stat.S_ISREG(pre.st_mode) and pre.st_nlink == 1\n            if source_lease is None:\n                fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)\n                try:held.append((path, fd, row))\n                except BaseException as original:\n                    try:os.close(fd)\n                    except BaseException as cleanup:raise RuntimeError('unregistered_gate_fd_close_failed:'+type(original).__name__+':'+type(cleanup).__name__)from original\n                    raise\n            else:\n                borrowed = source_lease.acquire(path, row['PRE'])\n                fd = borrowed['fd']\n                held.append((path, fd, row))\n            assert pre.st_uid == 501 and pre.st_gid == 20 and (pre.st_size <= 16777216)\n            assert identity(pre) == identity(os.fstat(fd)) == row['PRE']\n        for path, fd, row in held:\n            raw = bytearray()\n            offset = 0\n            while (data := os.pread(fd, 65536, offset)):\n                raw.extend(data)\n                offset += len(data)\n                assert len(raw) <= 16777216\n            assert len(raw) == row['bytes'] and digest(raw) == row['sha256'] == approval['sources'][row['path']]\n            assert identity(os.fstat(fd)) == identity(os.lstat(path)) == row['PRE']\n        for path, fd, row in held:\n            assert identity(os.fstat(fd)) == identity(os.lstat(path)) == row['PRE']\n    except BaseException as original:\n        failure = original\n        raise\n    finally:\n        if source_lease is None:\n            owned = list(held)\n            held.clear()\n            errors = []\n            for path, fd, row in owned:\n                try:\n                    os.close(fd)\n                except BaseException as cleanup:\n                    errors.append(type(cleanup).__name__)\n            if errors:\n                raise RuntimeError('all_attempted_gate_source_close_errors:' + ','.join(errors)) from failure\n        else:\n            source_lease.check_owner()\n    return (approval, digest(approvalraw), digest(mfraw))\nOLD = P.parent / 'task03-attempt6-integrated-repair1'\nCURRENT_PATH = P / 'current-transport-binding.json'\nCURRENT_SHA = '3cf0becc5cbb8718bb01c3566e9cb8d71aae1f8c30348aeff7ac40e3f5e9b08e'\nNATIVE_CURRENT_PATH = '/current-transport-binding.json'\nSIX = ('operation', 'requestSha256', 'projectSlug', 'projectName', 'teamId', 'privateEnvironmentFile')\n\ndef validate_current_binding(binding, request):\n    assert set(binding) == set(SIX) | {'forbiddenRetiredDeployments'}\n    assert type(binding['teamId']) is int and binding['teamId'] == 325340\n    assert all((type(binding[field]) is str for field in SIX if field != 'teamId'))\n    for field in SIX:\n        expected = digest(json.dumps(request, separators=(',', ':'), ensure_ascii=False).encode()) if field == 'requestSha256' else request[field]\n        assert binding[field] == expected, 'current_transport_binding_canonical_field_mismatch'\n    assert binding['projectName'] == binding['projectSlug'] == 'cortex-foundation-delta-312f13a61cc6'\n    assert binding['forbiddenRetiredDeployments'] == ['efficient-ox-979', 'fiery-setter-784', 'admired-walrus-730', 'quaint-jellyfish-819', 'joyous-ostrich-974', 'gallant-mastiff-565', 'brilliant-chinchilla-648']\n    assert request['requiredKind'] == 'cloud' and request['requiredDeploymentType'] == 'dev' and (request['maximumPaidCalls'] == 0)\n    assert request['productionDeployment'] is False and request['sharedCiTarget'] is False and (request['retirementRequired'] is True)\n    return binding\n\ndef qualify_current_binding(source_lease=None):\n    row, raw = reviewed_source(CURRENT_PATH, source_lease=source_lease)\n    assert digest(raw) == row['sha256'] == CURRENT_SHA\n    return validate_current_binding(strict(raw), strict(source_read(Q / 'project-request.json', source_lease=source_lease)))\n\ndef qualify_base_public(source_lease=None):\n    approval, approval_sha, mf_sha = qualify_sources(source_lease=source_lease)\n    binding = strict(source_read(P / 'prospective-binding.json', source_lease=source_lease))\n    freeze_sha = digest(source_read(Q / 'candidate-freeze-attempt6.json', source_lease=source_lease))\n    assert freeze_sha == binding['freezeSha256'] == approval['candidateSha256']\n    request = strict(source_read(Q / 'project-request.json', source_lease=source_lease))\n    assert request['operation'] == binding['operation']\n    assert digest(json.dumps(request, separators=(',', ':'), ensure_ascii=False).encode()) == binding['requestSha256']\n    assert binding['currentTransportBindingPath'] == str(CURRENT_PATH) and binding['currentTransportBindingSha256'] == CURRENT_SHA and (binding['currentTransportBindingNativePath'] == NATIVE_CURRENT_PATH)\n    assert binding['additionalCurrentPublicInputs'] == 1 and type(binding['additionalCurrentPublicInputs']) is int\n    transport = qualify_current_binding(source_lease=source_lease)\n    prep = strict(source_read(P / 'independent-preparation-review.json', source_lease=source_lease))\n    assert prep['scope'] == 'BOUNDED_03_FOUNDATION_CURRENT_DELTA_PREPARATION' and prep['verdict'] == 'PASS' and (prep['independent'] is True)\n    assert prep['candidateSha256'] == freeze_sha and type(prep['candidateMembers']) is int and (prep['candidateMembers'] == 1907)\n    management = strict(source_read(P / 'task03-attempt6-management-review.json', source_lease=source_lease))\n    assert management['scope'] == 'TASK03_DISPOSABLE_TARGET_MANAGEMENT_ONLY' and management['verdict'] == 'PASS' and (management['independent'] is True)\n    assert management['managementSourceSha256'] == digest(source_read(P / 'target-management.mjs', source_lease=source_lease)) and management['requestSha256'] == binding['requestSha256']\n    custody = strict(source_read(P / 'base-public-custody-review.json', source_lease=source_lease))\n    assert custody['scope'] == 'TASK03_ACTUAL_PUBLIC_LINUX_CUSTODY_ONLY' and custody['verdict'] == 'PASS' and (custody['independent'] is True)\n    assert custody['operation'] == binding['operation'] and custody['volume'] == binding['volume'] and (custody['candidateSha256'] == freeze_sha)\n    assert custody['prospectiveSourceManifestSha256'] == mf_sha\n    assert custody['sourceApprovalSha256'] == approval_sha\n    assert custody['immutableImage'] == 'sha256:9ff43bfe7849197a6dfbaa80f2d11a34db4202d8aaae269ddc8b740f7da75fb3'\n    assert type(custody['publicFiles']) is int and custody['publicFiles'] == 1914 and (binding['publicCopiedFiles'] == 1914) and (binding['candidateMembers'] == 1907)\n    assert custody['allCurrentDestinationIdentities'] == 'PASS_ALL9' and custody['currentSourceDestinationFullContent'] == 'PASS'\n    assert custody['publicRecipeBindingSha256'] == digest(source_read(OLD / 'public-recipe-binding-final.json', source_lease=source_lease)) and custody['publicSourceManifestSha256'] == digest(source_read(OLD / 'public-source-receipt-manifest-final.json', source_lease=source_lease))\n    assert type(custody['publicTransferReceiptSha256']) is str and len(custody['publicTransferReceiptSha256']) == 64 and all((c in '0123456789abcdef' for c in custody['publicTransferReceiptSha256']))\n    return {'binding': binding, 'currentTransportBinding': transport, 'approvalSha256': approval_sha, 'sourceManifestSha256': mf_sha, 'publicTransferReceiptSha256': custody['publicTransferReceiptSha256'], 'basePublicDecisionSha256': digest(source_read(P / 'base-public-custody-review.json', source_lease=source_lease))}\n\ndef qualify_public_release(source_lease=None):\n    released = qualify_base_public(source_lease=source_lease)\n    custodyraw = source_read(P / 'current-binding-public-custody-review.json', source_lease=source_lease)\n    custody = strict(custodyraw)\n    assert custody['scope'] == 'ACTUAL_CURRENT_TRANSPORT_BINDING_PUBLIC_INPUT_ONLY' and custody['verdict'] == 'PASS' and (custody['independent'] is True)\n    for field in ('operation', 'volume', 'candidateSha256'):\n        expected = released['binding']['freezeSha256'] if field == 'candidateSha256' else released['binding'][field]\n        assert custody[field] == expected\n    assert custody['sourceManifestSha256'] == released['sourceManifestSha256'] and custody['sourceApprovalSha256'] == released['approvalSha256']\n    assert custody['currentTransportBindingSha256'] == CURRENT_SHA and custody['currentTransportBindingSourcePath'] == str(CURRENT_PATH) and (custody['currentTransportBindingNativePath'] == NATIVE_CURRENT_PATH)\n    assert custody['currentTransportBindingSixFieldsCanonical'] == 'PASS' and custody['currentTransportBindingFullEOFAllNine'] == 'PASS'\n    assert custody['basePublicDecisionSha256'] == released['basePublicDecisionSha256'] and custody['basePublicTransferReceiptSha256'] == released['publicTransferReceiptSha256']\n    assert custody['probeSourceSha256'] == digest(source_read(P / 'linux-current-binding-probe.py', source_lease=source_lease)) and custody['probeCoordinatorSha256'] == digest(source_read(P / 'public-current-binding-coordinate.py', source_lease=source_lease))\n    assert custody['immutableImage'] == 'sha256:9ff43bfe7849197a6dfbaa80f2d11a34db4202d8aaae269ddc8b740f7da75fb3'\n    assert type(custody['additionalPublicInputs']) is int and custody['additionalPublicInputs'] == 1\n    assert custody['basePublicCopiedFiles'] == 1914 and type(custody['basePublicCopiedFiles']) is int\n    assert custody['privateAccess'] is False and custody['serviceRequests'] == 0 and (type(custody['serviceRequests']) is int) and (custody['targetCreated'] is False)\n    native = custody['currentTransportBindingOriginalNine']\n    assert set(native) == set(FIELDS) and all((type(v) is str and v.isdecimal() for v in native.values()))\n    row, raw = reviewed_source(CURRENT_PATH, source_lease=source_lease)\n    assert custody['currentTransportBindingSourceOriginalNine'] == row['PRE'] and native['uid'] == '501' and (native['gid'] == '20') and (native['nlink'] == '1') and (stat.S_IMODE(int(native['mode'])) == 384) and (int(native['size']) == len(raw))\n    assert type(custody['actualProbeReceiptSha256']) is str and len(custody['actualProbeReceiptSha256']) == 64 and all((c in '0123456789abcdef' for c in custody['actualProbeReceiptSha256']))\n    return {**released, 'currentBindingPublicDecisionSha256': digest(custodyraw), 'currentTransportBindingOriginalNine': native, 'actualProbeReceiptSha256': custody['actualProbeReceiptSha256']}\n"}
