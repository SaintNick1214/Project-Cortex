2026-10-09T22:16:50.2377345Z [36;1m  if [ -n "$input_value" ] && [ "$input_value" != "$default_value" ]; then[0m
2026-10-09T22:16:50.2377788Z [36;1m    # If action was provided with explicit input by the caller set that[0m
2026-10-09T22:16:50.2378274Z [36;1m    # Use printf %q to safely escape special characters and prevent command injection[0m
2026-10-09T22:16:50.2378759Z [36;1m    printf 'export %s=%q\n' "$var_name" "$input_value" >> trivy_envs.txt[0m
2026-10-09T22:16:50.2379103Z [36;1m  fi[0m
2026-10-09T22:16:50.2379307Z [36;1m}[0m
2026-10-09T22:16:50.2379502Z [36;1m[0m
2026-10-09T22:16:50.2379778Z [36;1m# Set environment variables, handling those with default values[0m
