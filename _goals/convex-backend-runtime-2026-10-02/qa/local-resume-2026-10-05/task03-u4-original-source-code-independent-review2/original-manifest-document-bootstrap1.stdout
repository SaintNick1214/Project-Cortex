{"op": "show", "result": "\"\"\"Root compiles these held verified entry bytes; source preparation gives no effects.\"\"\"\nimport hashlib,json,os,stat,sys,time\nfrom pathlib import Path\nFIELDS=('dev','ino','mode','nlink','uid','gid','size','mtime_ns','ctime_ns')\ndef nine(s):return {k:str(getattr(s,'st_'+k))for k in FIELDS}\ndef main():\n    owned=[];primary=None;cleanup=[];scope=None\n    try:\n        assert sys.dont_write_bytecode and len(sys.argv)==4\n        p=Path(sys.argv[1]);expected=json.loads(sys.argv[2]);handoff=sys.argv[3]\n        assert p.is_absolute()and p.resolve()==p\n        pre=p.lstat();assert stat.S_ISREG(pre.st_mode)and pre.st_nlink==1 and pre.st_uid==501 and pre.st_gid==20\n        assert max(pre.st_mtime_ns,pre.st_ctime_ns)+60000000000<=time.time_ns()\n        fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)\n        owner={'fd':fd,'path':p,'closeAttempted':False};owned.append(owner)\n        owner['PRE9']=nine(pre)\n        assert nine(pre)==nine(os.fstat(fd))==expected['PRE9']\n        raw=bytearray()\n        while block:=os.read(fd,65536):raw.extend(block);assert len(raw)<=expected['bytes']<=16777216\n        assert len(raw)==expected['bytes']and hashlib.sha256(raw).hexdigest()==expected['sha256']\n        assert nine(os.fstat(fd))==nine(p.lstat())==expected['PRE9']\n        sys.argv=[str(p),handoff];scope={'__name__':'__main__','__file__':str(p),'__package__':None}\n        exec(compile(raw,str(p),'exec',dont_inherit=True),scope)\n    except BaseException as error:primary=error\n    finally:\n        for owner in owned:\n            try:assert nine(os.fstat(owner['fd']))==nine(owner['path'].lstat())==owner.get('PRE9')\n            except BaseException as error:cleanup.append(error)\n        for owner in owned:\n            if owner['closeAttempted']:continue\n            owner['closeAttempted']=True\n            try:os.close(owner['fd'])\n            except BaseException as error:cleanup.append(error)\n    # A runner's ordinary zero exit stays successful only if entry final checks/close succeed.\n    if isinstance(primary,SystemExit)and primary.code in(None,0)and not cleanup:return 0\n    if primary is not None or cleanup:\n        chain=([primary]if primary is not None else[])+cleanup\n        message='Root entry sticky primary/final-nine/owned-close failure chain'\n        aggregate=Exception(message)if all(isinstance(error,Exception)for error in chain)else BaseException(message)\n        aggregate.message=message;aggregate.exceptions=tuple(chain)\n        raise aggregate from chain[0]\n    return 0\nif __name__=='__main__':raise SystemExit(main())\n"}
{"op": "show", "result": "\"\"\"Root-handoff-gated finite actual public review. No private or product effects.\"\"\"\nimport base64, hashlib, json, os, re, resource, stat, sys, time, types, zlib\nfrom pathlib import Path\n\nR = Path('/Users/SaintNick/Documents/Cortex/worktrees/backend-runtime-completion')\nQA = R / '_goals/convex-backend-runtime-2026-10-02/qa'\nQ = QA / 'task03-local-native-attempt6-2026-10-06'\nF = QA / 'local-resume-2026-10-05/task03-attempt6-integrated-repair1'\nO = QA / 'local-resume-2026-10-05/task03-attempt6-actual-public-entry-compatibility-repair4'\nOBSERVERS = QA / 'local-resume-2026-10-05/task03-attempt6-actual-public-custody-readiness-repair3'\nOLD = QA / 'local-resume-2026-10-05/task03-attempt6-actual-public-custody-readiness-repair2'\nCURRENT = QA / 'local-resume-2026-10-05/task03-attempt6-current-binding-repair2'\nOUT = O / 'actual-observation1'\nRAW = OUT / 'raw'\nCOMMON = OLD / 'coordinate-common-highfd.py'\nIMAGE = 'sha256:9ff43bfe7849197a6dfbaa80f2d11a34db4202d8aaae269ddc8b740f7da75fb3'\nVOLUME = 'cortex-task03-attempt6-fixture-20261006-c9fbaa34'\nDEPS = 'cortex-task03-deps-20261005-b681774e'\nFREEZE = '115e417419ab7b55e9fdbad97e51513f9f24a8e523c7b344168a63c92d8e968c'\nHISTORICAL_MF_SHA = 'd9e5929e79d682ae2f4e3dfaad4e2fce01e81f09746a8e3f38b094ebaaf330fc'\nMF_SHA = None\nOP = 'c9fbaa34-8ca8-4153-b8bd-1cfe60a8241f'\nREVIEW_OP = 'bd0980b8-7a63-459b-8b13-ef852041999c'\nNAMES = {k:'cortex-task03-attempt6-repair4-review-'+k+'-bd0980b8' for k in ('collect','custody','dependencies','readiness')}\nLABELS = {'cortex.operation':REVIEW_OP,'cortex.scope':'independent-public-custody-readiness-only'}\nDOCKER = '/usr/local/bin/docker'\nFIELDS = ('dev','ino','mode','nlink','uid','gid','size','mtime_ns','ctime_ns')\nAGE = 60_000_000_000\nMEM = 2147483648\nMAX_EXPORT = 4 * 1024 * 1024\nENV = {'HOME':'/Users/SaintNick','PATH':'/usr/local/bin:/usr/bin:/bin','LANG':'C.UTF-8','CORTEX_COORDINATOR_CWD':str(R)}\nall_pins=[]; source_pins=[]; controls=[]; records=[]; owners={}; recipes={}; cleanup_errors=[]; results={}\nSOURCE_GRAPH_MAX_FILES=4096; SOURCE_GRAPH_MAX_BYTES=67108864; SOURCE_GRAPH_MAX_FILE=16777216\nsource_graph_members={}; source_graph_bytes=0; unique_pins={}; source_graph_complete=False\n\ndef reserve_source_graph(path,size):\n    global source_graph_bytes\n    key=str(path)\n    assert type(size)is int and 0<=size<=SOURCE_GRAPH_MAX_FILE,'source_graph_file_ceiling'\n    if key in source_graph_members:\n        assert source_graph_members[key]==size,'source_graph_duplicate_path_size_drift'\n        return\n    assert len(source_graph_members)+1<=SOURCE_GRAPH_MAX_FILES,'source_graph_descriptor_ceiling'\n    assert source_graph_bytes+size<=SOURCE_GRAPH_MAX_BYTES,'source_graph_aggregate_byte_ceiling'\n    source_graph_members[key]=size;source_graph_bytes+=size\n\ndef strict(raw):\n    def pairs(items):\n        out={}\n        for k,v in items:\n            assert k not in out, 'duplicate_key'\n            out[k]=v\n        return out\n    return json.loads(raw,object_pairs_hook=pairs,parse_constant=lambda _:(_ for _ in ()).throw(ValueError('nonfinite')))\n\ndef sha(raw): return hashlib.sha256(raw).hexdigest()\ndef nine(s): return {k:str(getattr(s,'st_'+k)) for k in FIELDS}\n\ndef capture(path,kind,original=None):\n    path=Path(path)\n    assert path.is_absolute() and path.is_relative_to(R) and path.resolve()==path\n    current=R\n    for part in ('.',*path.relative_to(R).parts):\n        if part!='.':current/=part\n        value=current.lstat();assert not stat.S_ISLNK(value.st_mode) and current.resolve()==current\n        if current!=path:assert stat.S_ISDIR(value.st_mode)\n    pre=path.lstat();now=time.time_ns()\n    assert stat.S_ISREG(pre.st_mode) and pre.st_nlink==1 and pre.st_uid==501 and pre.st_gid==20\n    assert 0<=pre.st_size<=16*1024*1024\n    assert max(pre.st_mtime_ns,pre.st_ctime_ns)+AGE<=now, 'immature_before_first_capture:'+str(path)\n    reserve_source_graph(path,pre.st_size)\n    if str(path)in unique_pins:\n        pin=unique_pins[str(path)]\n        assert nine(pre)==nine(os.fstat(pin['fd']))==pin['PRE9'],'held_duplicate_path_nine_drift'\n        if original is not None:assert pin['PRE9']==original,'original_nine_changed:'+str(path)\n        return pin\n    fd=os.open(path,os.O_RDONLY|os.O_NOFOLLOW)\n    pin={'path':str(path),'fd':fd,'closeAttempted':False}\n    all_pins.append(pin) # successful open is immediately owned before metadata/assertion work\n    pin.update(kind=kind,PRE9=nine(pre),capturedUnixNs=str(now))\n    unique_pins[str(path)]=pin\n    assert nine(os.fstat(fd))==pin['PRE9']\n    if original is not None:assert pin['PRE9']==original,'original_nine_changed:'+str(path)\n    return pin\n\ndef qualify(pin,expected=None,collect=False):\n    fd=pin['fd'];path=Path(pin['path']);baseline=pin['PRE9'];os.lseek(fd,0,os.SEEK_SET)\n    assert nine(os.fstat(fd))==baseline\n    digest=hashlib.sha256();length=0;chunks=[]\n    while data:=os.read(fd,65536):\n        length+=len(data);assert length<=int(baseline['size']);digest.update(data)\n        if collect:chunks.append(data)\n    assert length==int(baseline['size']) and nine(os.fstat(fd))==nine(path.lstat())==baseline\n    row={'path':str(path),'sha256':digest.hexdigest(),'bytes':length,'PRE9':baseline,'capturedUnixNs':pin['capturedUnixNs'],'fullEOF':True,'finalDescriptorAndPathNineEqual':True}\n    if expected:assert row['sha256']==expected['sha256'] and row['bytes']==expected['bytes']\n    return row,b''.join(chunks)\n\ndef load_current_common(pin,row):\n    _,raw=qualify(pin,row,True)\n    assert sha(raw)=='3b7d195b905465275b081b32f0a934af4c232f7dafb76281c044d50e8b03dc8f' and len(raw)==21476\n    module=types.ModuleType('attempt6_independent_common');module.__file__=str(COMMON);module.__package__=''\n    exec(compile(raw,str(COMMON),'exec',dont_inherit=True),module.__dict__)\n    qualify(pin,row)\n    return module\n\ndef command(label,argv,timeout=30,required=True):\n    assert source_graph_complete is True,'source_graph_not_complete_no_dispatch'\n    assert len(records)<48 and 0<timeout<=190\n    row,out,err=C.run(label,argv,RAW,timeout,ENV,required=False);records.append(row)\n    assert row['terminal'] is True and row['closeErrors']==[] and row['failureClass'] is None,'command_terminal_unknown:'+label\n    assert type(row['exitCode'])is int\n    if required:assert row['exitCode']==0,'command_exit:'+label\n    return row,out,err\n\ndef inspect(key,label,required=True):\n    row,raw,err=command(label,[DOCKER,'inspect',NAMES[key]],required=required)\n    if row['exitCode']==1:\n        assert raw==b'[]\\n' and err.lower().strip()==('error: no such object: '+NAMES[key]).encode()\n        return None\n    assert row['exitCode']==0 and err==b''\n    objs=strict(raw);assert type(objs)is list and len(objs)==1\n    return objs[0]\n\ndef recipe(obj,key,argv,mounts,initial=False,allow_running=False):\n    assert obj['Name']=='/'+NAMES[key] and obj['Config']['Labels']==LABELS\n    assert obj['Id']==owners[key] and len(obj['Id'])==64 and all(c in '0123456789abcdef'for c in obj['Id'])\n    assert obj['Image']==obj['Config']['Image']==IMAGE and obj['Platform']=='linux'\n    assert obj['Config']['User']=='501:20' and obj['Config']['WorkingDir']==str(R)\n    assert obj['Config']['Cmd']==argv and obj['Config']['Entrypoint'] is None\n    assert obj['Config']['Env']==image_env\n    state=obj['State'];assert type(state['Running'])is bool and state['Running'] is allow_running and state['OOMKilled'] is False\n    assert type(state['ExitCode'])is int and state['Error']==''\n    assert state['Status']==('running'if allow_running else('created'if initial else'exited'))\n    host=obj['HostConfig']\n    assert host['NetworkMode']=='none' and host['ReadonlyRootfs'] is True and host['Privileged'] is False and host['AutoRemove'] is False\n    assert host['PortBindings']=={} and host['PublishAllPorts'] is False and host['CapDrop']==['ALL'] and host['SecurityOpt']==['no-new-privileges']\n    for k,v in [('Memory',MEM),('MemorySwap',MEM),('PidsLimit',64),('NanoCpus',2000000000)]:assert type(host[k])is int and host[k]==v\n    assert host['Tmpfs']=={'/tmp':'rw,noexec,nosuid,size=67108864,mode=0700,uid=501,gid=20'}\n    choices=[]\n    for mapping,prefix in [('literal',''),('docker-desktop-host_mnt','/host_mnt')]:\n        expected=[]\n        for m in mounts:\n            m=dict(m)\n            if m['Type']=='bind':m['Source']=prefix+m['Source']\n            expected.append(m)\n        if host['Mounts']==expected:choices.append(mapping)\n    assert len(choices)==1,'exact_mapping_required';mapping=choices[0]\n    if key in recipes:assert mapping==recipes[key]['mapping']\n    actual=obj['Mounts'];assert type(actual)is list and len(actual)==len(mounts)\n    by={m['Destination']:m for m in actual};assert len(by)==len(actual) and set(by)=={m['Target']for m in mounts}\n    for m in mounts:\n        a=by[m['Target']];assert a['Type']==m['Type'] and type(a['RW'])is bool and a['RW'] is False\n        if m['Type']=='bind':assert a['Source']==(''if mapping=='literal'else'/host_mnt')+m['Source']\n        else:assert a['Name']==m['Source'] and a['Driver']=='local' and a['Source']=='/var/lib/docker/volumes/'+m['Source']+'/_data'\n    return mapping\n\ndef execute(key,argv,mounts):\n    assert inspect(key,key+'-absence',False)is None\n    create=[DOCKER,'create','--name',NAMES[key],'--label','cortex.operation='+REVIEW_OP,'--label','cortex.scope='+LABELS['cortex.scope'],'--platform','linux/amd64','--network','none','--memory',str(MEM),'--memory-swap',str(MEM),'--cpus','2','--pids-limit','64','--read-only','--user','501:20','--workdir',str(R),'--cap-drop','ALL','--security-opt','no-new-privileges','--tmpfs','/tmp:rw,noexec,nosuid,size=67108864,mode=0700,uid=501,gid=20']\n    for m in mounts:\n        value='type='+m['Type']+',source='+m['Source']+',target='+m['Target']+',readonly'\n        if m['Type']=='volume':\n            value+=',volume-nocopy'\n            if m['VolumeOptions'].get('Subpath'):value+=',volume-subpath='+m['VolumeOptions']['Subpath']\n        create+=['--mount',value]\n    _,raw,err=command(key+'-create',create+[IMAGE,*argv]);assert err==b''\n    cid=raw.strip().decode();assert len(cid)==64 and all(c in '0123456789abcdef'for c in cid)\n    owners[key]=cid\n    obj=inspect(key,key+'-initial-inspect');mapping=recipe(obj,key,argv,mounts,True)\n    recipes[key]={'containerId':cid,'mapping':mapping,'argv':argv,'mounts':mounts,'initialInspect':obj}\n    C.durable_json(OUT/(key+'-initial-recipe.json'),recipes[key])\n    row,out,err=command(key+'-run',[DOCKER,'start','--attach',cid],190,False)\n    obj=inspect(key,key+'-terminal-inspect');recipe(obj,key,argv,mounts)\n    assert row['exitCode']==obj['State']['ExitCode']==0 and err==b''\n    command(key+'-remove',[DOCKER,'rm',cid]);assert inspect(key,key+'-removed-absence',False)is None\n    return out\n\ndef compressed(raw):\n    assert len(raw)<=262144;env=strict(raw)\n    assert env['encoding']=='gzip+base64' and type(env['decodedBytes'])is int and 0<=env['decodedBytes']<=MAX_EXPORT\n    compressed=base64.b64decode(env['body'],validate=True);decoder=zlib.decompressobj(16+zlib.MAX_WBITS)\n    body=decoder.decompress(compressed,MAX_EXPORT+1)\n    assert len(body)<=MAX_EXPORT and decoder.eof and not decoder.unused_data and not decoder.unconsumed_tail\n    assert len(body)==env['decodedBytes'] and sha(body)==env['decodedSha256']\n    return strict(body)\n\ndef volume(name,label,expected):\n    _,raw,err=command(label,[DOCKER,'volume','inspect',name]);assert err==b''\n    rows=strict(raw);assert type(rows)is list and len(rows)==1 and rows[0]==expected\n    return rows[0]\n\ndef verify_raw(directory,rows):\n    snapshots=[]\n    assert len(rows)<=48 and len({r['label']for r in rows})==len(rows)\n    for row in rows:\n        assert re.fullmatch('[a-z][a-z0-9-]{1,70}',row['label'])\n        assert row['terminal'] is True and row['failureClass'] is None and row['closeErrors']==[] and type(row['exitCode'])is int\n        assert row['pipeLimits']==262144 and row['ownedGroup']['absenceObserved'] is True\n        for suffix in ('receipt.json','stdout','stderr'):\n            pin=capture(directory/(row['label']+'.'+suffix),'retained-acquisition-raw')\n            meta,raw=qualify(pin,collect=True);controls.append(pin);snapshots.append(meta)\n            if suffix=='receipt.json':assert strict(raw)==row\n            else:assert sha(raw)==row[suffix+'Sha256'] and len(raw)==row['streamByteCounts'][suffix]\n    return snapshots\n\nfailure=None;failure_chain=[];C=None;image_env=None;handoff_pin=None;public_transfer_sha=None;control_rows={}\ndef retain_error(stage,error,primary=False):\n    global failure\n    row={'stage':stage,'class':type(error).__name__,'reason':str(error)[:500]}\n    failure_chain.append(row)\n    if primary and failure is None:failure={'class':row['class'],'reason':row['reason']}\n    return row\n\ndef close_owned_inputs():\n    for pin in all_pins:\n        if pin.get('closeAttempted')is True:continue\n        pin['closeAttempted']=True # unknown descriptor state is never retried\n        try:os.close(pin['fd'])\n        except BaseException as error:\n            row=retain_error('input-close',error)\n            cleanup_errors.append({'key':'held-input-close','path':pin.get('path'),'fd':pin['fd'],**row})\n\ntry:\n    assert os.getuid()==501 and os.getgid()==20 and sys.dont_write_bytecode and Path.cwd()==R\n    assert len(sys.argv)==2,'explicit_root_handoff_path_required'\n    soft,hard=resource.getrlimit(resource.RLIMIT_NOFILE)\n    if soft<8192:resource.setrlimit(resource.RLIMIT_NOFILE,(min(8192,hard),hard))\n    assert resource.getrlimit(resource.RLIMIT_NOFILE)[0]>=4096\n    handoff_pin=capture(Path(sys.argv[1]),'explicit-Root-actual-handoff')\n    handoff_meta,hraw=qualify(handoff_pin,collect=True);H=strict(hraw)\n    assert H['scope']=='TASK03_ATTEMPT6_REPAIR4_ACTUAL_PUBLIC_REVIEW_HANDOFF' and H['explicitActualPublicReviewAuthorized'] is True\n    assert H['operation']==OP and H['reviewerOperation']==REVIEW_OP and H['volume']==VOLUME and H['immutableImage']==IMAGE and H['candidateSha256']==FREEZE\n    assert H['allNewWritersStopped'] is True and H['remainingWrites']==[]\n    MF_SHA=H['sourceManifestSha256']\n    assert re.fullmatch('[a-f0-9]{64}',MF_SHA) and MF_SHA!=HISTORICAL_MF_SHA\n    assert H['sourceEpochScope']=='TASK03_ATTEMPT6_REPAIR2_NEW_PROSPECTIVE_SOURCE_CLOSURE_ONLY'\n    assert type(H['sourceRows'])is int and 0<H['sourceRows']<=4096 and type(H['sourceBytes'])is int and 0<H['sourceBytes']<=67108864\n    control_paths=['sourceApproval','preparationDecision','managementDecision','sourceManifest','sourcePlan','sourceWritersStopped','publicRecipeBinding','publicSourceManifest','acquisitionCommands','reviewSourceAcceptance']\n    control_docs={};control_rows={}\n    # Each dependent data document has its first mature held capture before its first content qualification.\n    for name in control_paths:\n        row=H['inputs'][name];pin=capture(Path(row['path']),name,row['PRE9']);controls.append(pin)\n        meta,raw=qualify(pin,row,True);control_rows[name]=meta;control_docs[name]=strict(raw)\n    approval=control_docs['sourceApproval'];mf=control_docs['sourceManifest'];prep=control_docs['preparationDecision'];management=control_docs['managementDecision']\n    assert approval['scope']=='TASK03_ATTEMPT6_CURRENT_BINDING_REPAIR2_SOURCE_ONLY' and approval['independent'] is True and approval['verdict']=='PASS'\n    assert approval['sourceManifestSha256']==MF_SHA==control_rows['sourceManifest']['sha256'] and approval['sourceManifestOriginalNine']==control_rows['sourceManifest']['PRE9']\n    assert approval['candidateSha256']==FREEZE and mf['sourceWriters']=='STOPPED' and mf['historicalD101OriginalCustody']=='FAILED_UNKNOWN_ONE_CTIME_NOT_REPAIRED'\n    assert Path(control_rows['sourceManifest']['path'])==CURRENT/'prospective-source-manifest.json'\n    assert Path(control_rows['sourceApproval']['path'])==CURRENT/'integrated-source-review.json'\n    assert mf['scope']==H['sourceEpochScope']\n    assert mf['sourcePlanSha256']==approval['sourcePlanSha256']==control_rows['sourcePlan']['sha256']\n    assert mf['sourceWritersStoppedSha256']==control_rows['sourceWritersStopped']['sha256']\n    assert len(mf['files'])==len({r['path']for r in mf['files']})==H['sourceRows'] and sum(r['bytes']for r in mf['files'])==H['sourceBytes']\n    assert set(approval['sources'])=={r['path']for r in mf['files']}\n    assert prep['scope']=='BOUNDED_03_FOUNDATION_CURRENT_DELTA_PREPARATION' and prep['independent'] is True and prep['verdict']=='PASS' and prep['candidateSha256']==FREEZE and prep['candidateMembers']==1907\n    assert management['scope']=='TASK03_DISPOSABLE_TARGET_MANAGEMENT_ONLY' and management['independent'] is True and management['verdict']=='PASS'\n    binding=control_docs['publicRecipeBinding'];assert binding['operation']==OP and binding['volume']==VOLUME and binding['immutableImage']==IMAGE and binding['publicCopiedFiles']==1914\n    required_sources={str(O/n) for n in ('actual-entry.py','run-actual-review.py')}|{str(OBSERVERS/n) for n in ('linux-public-observer.py','linux-dependency-observer.mjs')}|{str(COMMON)}\n    named_acceptance=control_docs['reviewSourceAcceptance']\n    assert named_acceptance['scope']=='TASK03_ATTEMPT6_PUBLIC_REVIEW_REPAIR4_NAMED_SOURCE_ACCEPTANCE' and named_acceptance['independent']is True and named_acceptance['verdict']=='PASS'\n    assert named_acceptance['reviewerOperation']==REVIEW_OP and named_acceptance['sourceEpochManifestSha256']==MF_SHA\n    assert named_acceptance['sourceHashes']=={p:r['sha256']for p,r in H['reviewSources'].items()}\n    assert set(H['reviewSources'])==required_sources\n    for path,row in H['reviewSources'].items():\n        pin=capture(Path(path),'Root-reviewed-new-observer',row['PRE9']);controls.append(pin);qualify(pin,row)\n    # Entire newly accepted source epoch captured before qualifying ANY of its source cohort content.\n    for row in mf['files']:\n        path=Path(row['path']);assert not path.is_absolute() and '..'not in path.parts\n        source_pins.append((capture(R/path,'current-approved-operative-source',row['PRE']),row))\n    assert len(all_pins)<=4096\n    initial=[]\n    for pin,row in source_pins:\n        assert approval['sources'][row['path']]==row['sha256']\n        meta,_=qualify(pin,row);initial.append(meta)\n    common_pin=unique_pins[str(COMMON)];common_row=H['reviewSources'][str(COMMON)]\n    C=load_current_common(common_pin,common_row)\n    OUT.mkdir(mode=0o700);RAW.mkdir(mode=0o700)\n    C.durable_json(OUT/'current-source-pre9-and-full-content.json',{'scope':'NEW_CURRENT_ORIGINAL_APPROVED_SOURCE_COHORT_ONLY','files':initial,'allCapturedBeforeFirstSourceContentQualification':True,'sourceRows':H['sourceRows'],'sourceBytes':H['sourceBytes'],'historicalFailuresNotAdopted':True})\n    C.durable_json(OUT/'review-operation.json',{'scope':'TASK03_ACTUAL_PUBLIC_LINUX_CUSTODY_ONLY','operation':OP,'reviewerOperation':REVIEW_OP,'names':NAMES,'labels':LABELS,'handoff':handoff_meta,'reviewSources':H['reviewSources'],'effectsBudgetPaid':0})\n    acq=control_docs['acquisitionCommands'];assert acq['operation']==OP and acq['volume']==VOLUME and acq['status']=='PASS' and acq['cleanupErrors']==[] and acq['custodyReview']=='REQUIRED'\n    assert acq['credentialReads']==acq['serviceCalls']==0 and acq['CLI'] is False and acq['nativeFoundationAccepted'] is False\n    original_raw=verify_raw(Path(H['acquisitionDirectory']),acq['commands'])\n    C.durable_json(OUT/'retained-acquisition-raw-verification.json',{'status':'PASS','commands':len(acq['commands']),'rawFiles':original_raw})\n    source_graph_complete=True\n    C.durable_json(OUT/'source-graph-aggregate-ledger.json',{'scope':'ONE_SOURCE_ACQUISITION_GRAPH_ALL_SOURCE_CONTROL_DATA_INPUTS','files':len(source_graph_members),'bytes':source_graph_bytes,'limits':{'files':4096,'bytes':67108864,'perFileBytes':16777216},'members':source_graph_members,'noSubgraphReset':True,'allInputDescriptorsRemainHeld':True,'distinctLinux1914CustodyContractUnchanged':True})\n    _,raw,_=command('daemon-memory',[DOCKER,'info','--format','{{json .MemTotal}}']);assert int(raw)>=MEM\n    _,raw,_=command('running-container-ids',[DOCKER,'ps','--quiet']);assert raw==b'','foreign_container_resource_admission'\n    _,raw,err=command('immutable-image',[DOCKER,'image','inspect',IMAGE]);assert err==b''\n    images=strict(raw);assert len(images)==1 and images[0]['Id']==IMAGE and images[0]['Architecture']=='amd64' and images[0]['Os']=='linux';image_env=images[0]['Config']['Env']\n    expected_public=H['publicVolumeInspect'];expected_deps=H['dependencyVolumeInspect']\n    assert expected_public['Name']==VOLUME and expected_public['Driver']=='local' and expected_public['Labels']=={'cortex.goal':'convex-backend-runtime-2026-10-02','cortex.operation':OP}\n    assert expected_public['Mountpoint']=='/var/lib/docker/volumes/'+VOLUME+'/_data' and expected_public['Options']is None and expected_public['Scope']=='local'\n    assert expected_deps['Name']==DEPS and expected_deps['Driver']=='local' and expected_deps['Mountpoint']=='/var/lib/docker/volumes/'+DEPS+'/_data'\n    volume(VOLUME,'public-volume-initial',expected_public);volume(DEPS,'dependency-volume-initial',expected_deps)\n    source={'Type':'bind','Source':str(R),'Target':str(R),'ReadOnly':True}\n    public={'Type':'volume','Source':VOLUME,'Target':'/owned','ReadOnly':True,'VolumeOptions':{'NoCopy':True}}\n    selected=['/usr/bin/env','-i','PATH='+str(R/'node_modules/.bin')+':/usr/local/bin:/usr/bin:/bin','HOME=/tmp','LANG=C.UTF-8','NO_COLOR=1','CI=1','TMPDIR=/tmp']\n    linux=str(OBSERVERS/'linux-public-observer.py')\n    collection=compressed(execute('collect',[*selected,'/usr/local/bin/python3.12','-B',linux,'collect'],[source,public]))\n    receipt_raw=collection.pop('receiptBody').encode();receipt_metadata=collection['receiptMetadata']\n    assert sha(receipt_raw)==receipt_metadata['sha256'] and len(receipt_raw)==receipt_metadata['bytes'] and collection['publicMembers']==1914\n    public_transfer_sha=sha(receipt_raw)\n    C.durable(OUT/'collected-public-transfer-receipt.json',receipt_raw);C.durable_json(OUT/'collected-transfer-metadata.json',collection)\n    raw=execute('custody',[*selected,'/usr/local/bin/python3.12','-B',linux,'custody',receipt_metadata['sha256'],json.dumps(receipt_metadata['PRE9'],separators=(',',':'))],[source,public])\n    lines=raw.splitlines();assert len(lines)==2;pre,custody=[compressed(line)for line in lines]\n    assert pre['descriptors']==3828 and len(pre['files'])==1914 and pre['captureBeforeQualification'] is True\n    assert custody['status']=='PASS' and custody['publicMembers']==len(custody['observed'])==1914 and custody['receiptMetadata']==receipt_metadata\n    assert custody['allCurrentDestinationIdentities']=='PASS_ALL9' and custody['currentSourceDestinationFullContent']=='PASS' and custody['transferSourceOriginalNine']=='PASS_ALL9'\n    C.durable_json(OUT/'linux1914-first-pre9.json',pre);C.durable_json(OUT/'actual-public-custody.json',custody);results['custody']='PASS'\n    depsroot={'Type':'volume','Source':DEPS,'Target':'/deps','ReadOnly':True,'VolumeOptions':{'NoCopy':True}}\n    deps={'Type':'volume','Source':DEPS,'Target':str(R/'node_modules'),'ReadOnly':True,'VolumeOptions':{'NoCopy':True,'Subpath':'node_modules'}}\n    candidate={'Type':'volume','Source':VOLUME,'Target':str(Q),'ReadOnly':True,'VolumeOptions':{'NoCopy':True,'Subpath':'candidate'}}\n    raw=execute('dependencies',[*selected,'/usr/local/bin/node',str(OBSERVERS/'linux-dependency-observer.mjs')],[source,depsroot,deps,candidate])\n    lines=raw.splitlines();assert len(lines)==2;pre,deps_result=[compressed(line)for line in lines]\n    assert pre['sourceRoots']==4 and pre['compilerProjectionMembers']==114 and deps_result['compilerProjectionMembers']==114 and deps_result['sourcePreflightCounts']==[161,138,1907]\n    assert deps_result['fixtureExactPackagePins']==9 and deps_result['ancillaryExactPackagePins']==3 and len(deps_result['versions'])==12\n    assert deps_result['status']=='PASS' and deps_result['currentSourceAll9BeforeFirstQualificationThroughHeldFinal']=='PASS' and deps_result['retainedOriginalVolumePackageAll9']=='PASS'\n    assert deps_result['externalRequests']==deps_result['serviceDeployments']==deps_result['packageInstalls']==deps_result['volumeWrites']==deps_result['privateScratchReads']==0\n    final={(r['kind'],r['path']):r for r in deps_result['finalHeld']};assert len(final)==len(pre['files'])==pre['heldDescriptors']\n    for row in pre['files']:assert final[(row['kind'],row['path'])]['identityDecimal']==row['identityDecimal']\n    C.durable_json(OUT/'dependency-first-pre9.json',pre);C.durable_json(OUT/'actual-dependency-readiness.json',deps_result);results['dependencies']='PASS'\n    source_command=\"import {sourcePreflight} from \"+json.dumps(str(Q/'scripts/guard.mjs'))+\";import{readFileSync}from'node:fs';if(process.env.NODE_OPTIONS!==undefined||readFileSync('/sys/fs/cgroup/memory.max','utf8').trim()!=='2147483648'||readFileSync('/sys/fs/cgroup/memory.swap.max','utf8').trim()!=='0')throw Error('resource recipe');const{source,copies,frozen}=sourcePreflight();if(source.files.length!==161||copies.files.length!==138||frozen.files.length!==1907||frozen.actualExternalRequests!==0||frozen.actualDeployments!==0)throw Error('source counts');console.log(JSON.stringify({scope:'ACTUAL_PUBLIC_SOURCE_PREFLIGHT_ONLY',status:'PASS',sources:161,copies:138,frozenMembers:1907,actualExternalRequests:0,actualDeployments:0}));await import(\"+json.dumps(str(Q/'attempt2/cli-readiness.mjs'))+\");\"\n    raw=execute('readiness',[*selected,'/usr/local/bin/node','--input-type=module','-e',source_command],[source,deps,candidate])\n    lines=raw.splitlines();assert len(lines)==2;preflight,ready=[strict(line)for line in lines]\n    assert preflight['status']==ready['status']=='PASS' and ready['scope']=='CREDENTIAL_FREE_ACTUAL_CLI_COMPILER_READINESS'\n    assert ready['nodeVersion']=='v24.15.0' and ready['npmVersion']=='12.2.0' and ready['compilerVersion']==ready['projectedCompilerVersion']=='Version 6.0.3'\n    assert len(ready['results'])==3 and all(row['exitCode']==0 for row in ready['results']) and ready['actualExternalRequests']==ready['serviceDeployments']==0\n    for sample in (ready['resourceBefore'],ready['resourceAfter']):\n        assert sample['cgroupMemoryMax']=='2147483648'\n        events=dict(line.split()for line in sample['cgroupMemoryEvents'].splitlines());assert all(events[k]=='0'for k in ('oom','oom_kill','oom_group_kill'))\n    C.durable_json(OUT/'actual-public-source-preflight.json',preflight);C.durable_json(OUT/'actual-cli-compiler-readiness.json',ready);results['readiness']='PASS'\n    final=[]\n    for pin,row in source_pins:final.append(qualify(pin,row)[0])\n    assert final==initial\n    for pin in controls:qualify(pin)\n    qualify(handoff_pin)\n    C.durable_json(OUT/'current-source-final.json',{'status':'PASS_ALL_NEW_SOURCE_EPOCH_ORIGINAL_NINE_FULL_EOF_HASH_SIZE','files':final,'initialEqualsFinal':True})\n    volume(VOLUME,'public-volume-final',expected_public);volume(DEPS,'dependency-volume-final',expected_deps)\nexcept BaseException as error:\n    retain_error('primary',error,True)\nfinally:\n    try:\n        if C is not None and RAW.is_dir():\n            for key in NAMES:\n                try:\n                    obj=inspect(key,'final-'+key+'-inspect',False)\n                    if obj is not None:\n                        assert key in recipes and key in owners\n                        # Unknown or foreign recipe is NEVER signaled or removed.\n                        if obj['State']['Running']:\n                            recipe(obj,key,recipes[key]['argv'],recipes[key]['mounts'],allow_running=True)\n                            command('final-'+key+'-sigterm',[DOCKER,'kill','--signal','SIGTERM',owners[key]])\n                            command('final-'+key+'-wait',[DOCKER,'wait',owners[key]],30)\n                            obj=inspect(key,'final-'+key+'-terminal')\n                        recipe(obj,key,recipes[key]['argv'],recipes[key]['mounts'])\n                        command('final-'+key+'-remove',[DOCKER,'rm',owners[key]])\n                        assert inspect(key,'final-'+key+'-absence',False)is None\n                except BaseException as error:retain_error('container-cleanup:'+key,error);cleanup_errors.append({'key':key,'class':type(error).__name__,'reason':str(error)[:250]})\n            try:\n                _,raw,err=command('final-known-owned-containers',[DOCKER,'ps','--all','--quiet','--filter','label=cortex.operation='+REVIEW_OP]);assert raw==b'' and err==b''\n            except BaseException as error:retain_error('final-known-owned',error);cleanup_errors.append({'key':'final-known-owned','class':type(error).__name__,'reason':str(error)[:250]})\n            for pin in all_pins:\n                try:qualify(pin)\n                except BaseException as error:retain_error('final-held-input',error);cleanup_errors.append({'key':'final-held-input','class':type(error).__name__,'reason':str(error)[:250]})\n            status='PASS'if failure is None and cleanup_errors==[] and results=={'custody':'PASS','dependencies':'PASS','readiness':'PASS'}else'FAIL'\n            C.durable_json(OUT/'commands.json',{'scope':'TASK03_ACTUAL_PUBLIC_LINUX_CUSTODY_ONLY','status':status,'operation':OP,'reviewerOperation':REVIEW_OP,'volume':VOLUME,'dependencyVolume':DEPS,'commands':records,'results':results,'failure':failure,'failureChain':failure_chain,'cleanupErrors':cleanup_errors,'inputCloses':'FINAL_CLOSE_RECEIPT_REQUIRED','ownedContainersRemoved':cleanup_errors==[],'volumeWrites':0,'privateReads':0,'serviceCalls':0,'paidCalls':0,'nativeFoundationAccepted':False,'fullTask03':False,'fullGoal':False,'prospectiveSourceManifestSha256':MF_SHA,'sourceApprovalSha256':control_rows.get('sourceApproval',{}).get('sha256'),'publicRecipeBindingSha256':control_rows.get('publicRecipeBinding',{}).get('sha256'),'publicSourceManifestSha256':control_rows.get('publicSourceManifest',{}).get('sha256'),'publicTransferReceiptSha256':public_transfer_sha,'sourceGraphFiles':len(source_graph_members),'sourceGraphBytes':source_graph_bytes,'independentFinalEvidenceSeal':'REQUIRED_AFTER_ALL_OUTPUTS_MATURE'})\n    except BaseException as error:\n        retain_error('final-reconciliation-or-report',error,True)\n        cleanup_errors.append({'key':'final-report-or-reconciliation','class':type(error).__name__,'reason':str(error)[:500]})\n    finally:\n        close_owned_inputs()\n    # The main report retains inputs through its durable attempt. This separate final\n    # receipt makes close failures sticky; a failed write cannot bypass owned closes.\n    if C is not None and OUT.is_dir():\n        try:C.durable_json(OUT/'input-close-receipt.json',{'scope':'ALL_OWNED_INPUT_CLOSE_ATTEMPTS_FINAL','status':'PASS'if not cleanup_errors and failure is None else'FAIL','failure':failure,'failureChain':failure_chain,'cleanupErrors':cleanup_errors,'closeAttempts':[{'path':p.get('path'),'fd':p['fd'],'attempted':p.get('closeAttempted')is True}for p in all_pins],'unknownCloseStatesNeverRetried':True,'nativeFoundationAccepted':False,'fullTask03':False})\n        except BaseException as error:retain_error('input-close-report',error,True);cleanup_errors.append({'key':'input-close-report','class':type(error).__name__,'reason':str(error)[:500]})\nprint(json.dumps({'status':'PASS'if failure is None and cleanup_errors==[] and results=={'custody':'PASS','dependencies':'PASS','readiness':'PASS'}else'FAIL','results':results,'failure':failure,'failureChain':failure_chain,'cleanupErrors':cleanup_errors,'actualEvidenceClosureRequired':True}))\nraise SystemExit(0 if failure is None and cleanup_errors==[] and len(results)==3 else 1)\n"}
{"op": "show", "result": "\"\"\"SOURCE-only tests of actual isolated functions using owned public host descriptors.\"\"\"\nimport ast,base64,gzip,hashlib,json,os,re,stat,sys,time,types,zlib,subprocess\nfrom pathlib import Path\nN=Path(__file__).resolve().parent\nR=Path('/Users/SaintNick/Documents/Cortex/worktrees/backend-runtime-completion')\nFIELDS=('dev','ino','mode','nlink','uid','gid','size','mtime_ns','ctime_ns')\ndef nine(s):return {k:str(getattr(s,'st_'+k)) for k in FIELDS}\ndef sha(b):return hashlib.sha256(b).hexdigest()\ndef require(v,msg):\n if not v:raise AssertionError(msg)\nclass Injected(OSError):pass\nreceipts=[];source_owners=[]\ndef source_capture(paths):\n try:\n  for p in paths:\n   pre=p.lstat();require(stat.S_ISREG(pre.st_mode) and pre.st_nlink==1,'source_regular')\n   require(time.time_ns()>=max(pre.st_mtime_ns,pre.st_ctime_ns)+60_000_000_000,'source_maturity:'+str(p))\n   fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW);pin={'path':str(p),'fd':fd,'PRE9':nine(pre),'closeAttempted':False};source_owners.append(pin)\n   require(nine(os.fstat(fd))==pin['PRE9'],'source_open_nine')\n  bodies={}\n  for pin in source_owners:\n   raw=bytearray()\n   while b:=os.read(pin['fd'],65536):raw.extend(b);require(len(raw)<=16*1024*1024,'source_size')\n   require(len(raw)==int(pin['PRE9']['size']) and nine(os.fstat(pin['fd']))==nine(Path(pin['path']).lstat())==pin['PRE9'],'source_fullEOF_allNine')\n   pin.update(sha256=sha(raw),bytes=len(raw),fullEOF=True);bodies[Path(pin['path']).name]=bytes(raw)\n  return bodies\n except BaseException:\n  close_sources();raise\n\ndef close_sources():\n failures=[]\n for pin in source_owners:\n  if pin['closeAttempted']:continue\n  pin['closeAttempted']=True\n  try:os.close(pin['fd'])\n  except BaseException as e:failures.append(str(e))\n require(not failures,'source_close_failures')\n\ndef selected(raw,functions,assignments):\n tree=ast.parse(raw)\n nodes=[n for n in tree.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and n.name in functions]\n for n in tree.body:\n  if isinstance(n,ast.Assign) and any(isinstance(x,ast.Name) and x.id in assignments for x in n.targets):nodes.append(n)\n ns=dict(base64=base64,gzip=gzip,hashlib=hashlib,json=json,os=os,re=re,stat=stat,sys=sys,time=time,types=types,zlib=zlib,Path=Path)\n exec(compile(ast.fix_missing_locations(ast.Module(body=nodes,type_ignores=[])),'<held-isolated-source>','exec',dont_inherit=True),ns)\n return ns,tree\n\nclass FaultOS:\n \"\"\"Explicit isolated namespace injection. A close fault is raised after real close, with no retry.\"\"\"\n def __init__(self,stage=None,index=None):self.stage=stage;self.index=index;self.fds={};self.open_attempts=[];self.close_attempts=[];self.writes=0;self.error=None\n def __getattr__(self,k):return getattr(os,k)\n def fault(self,stage,index):\n  if self.stage==stage and self.index==index:\n   self.error=Injected(stage+':'+str(index));raise self.error\n def open(self,p,flags):\n  i=int(Path(p).stem.rsplit('-',1)[1]);self.open_attempts.append(i);self.fault('open',i)\n  fd=os.open(p,flags);self.fds[fd]=i;return fd\n def fstat(self,fd):self.fault('fstat',self.fds[fd]);return os.fstat(fd)\n def read(self,fd,n):self.fault('read',self.fds[fd]);return os.read(fd,n)\n def close(self,fd):\n  require(fd not in self.close_attempts,'unknown_fd_retry');self.close_attempts.append(fd);os.close(fd);self.fault('close',self.fds[fd])\n def write(self,fd,b):\n  require(fd==1,'foreign_output_fd');i=self.writes;self.writes+=1;self.fault('report',i);return len(b)\n\ndef build_module(raw,kind,fos):\n names={'nine','strict','capture','qualify','emit','close_owned_inputs','retain_error','reserve_source_graph'}\n ns,tree=selected(raw,names,{'AGE','MAX','FIELDS','SOURCE_GRAPH_MAX_FILES','SOURCE_GRAPH_MAX_BYTES','SOURCE_GRAPH_MAX_FILE'})\n ns.update(os=fos,R=R,all_pins=[],held=[],unique_pins={},source_graph_members={},source_graph_bytes=0,cleanup_errors=[],failure=None,failure_chain=[],close_errors=[],output_bytes=0)\n ns['canonical']=lambda *a,**k:None\n ns['time']=types.SimpleNamespace(time_ns=lambda:time.time_ns())\n if kind=='runner':ns['FIELDS']=FIELDS\n return ns,tree\n\ndef record(name,details):receipts.append({'name':name,'status':'PASS',**details})\ndef attempts(ns,kind,fos,primary):\n pins=ns['all_pins'] if kind=='runner' else ns['held'];ns['close_owned_inputs']()\n require(fos.close_attempts==[p['fd'] for p in pins],'all_owned_close_attempts_in_order')\n require(all(p['closeAttempted'] for p in pins),'every_owner_attempted')\n before=list(fos.close_attempts);ns['close_owned_inputs']();require(fos.close_attempts==before,'never_retry_unknown_state')\n if kind=='runner':\n  if primary is not None:require(ns['failure']['class']==type(primary).__name__ and ns['failure']['reason']==str(primary)[:500],'sticky_primary')\n else:\n  chain=([primary] if primary is not None else [])+ns['close_errors']\n  if chain:\n   try:raise BaseExceptionGroup('isolated actual observer final chain',chain)\n   except BaseExceptionGroup as group:\n    if primary is not None:require(group.exceptions[0] is primary,'primary_error_identity_retained')\n return {'opened':len(pins),'closeAttempts':len(fos.close_attempts),'allOwnedAttemptedExactlyOnce':True,'noForeignFDs':set(fos.close_attempts)<=set(fos.fds)}\n\ndef python_cases(raw,kind,fixtures):\n for stage in ('open','fstat','maturity','read','parse','report','close','assert'):\n  for index in (0,1,2):\n   fos=FaultOS(stage,index);ns,tree=build_module(raw,kind,fos);primary=None\n   try:\n    for i,p in enumerate(fixtures):\n     if stage=='maturity':ns['time']=types.SimpleNamespace(time_ns=lambda i=i:0 if i==index else time.time_ns())\n     pin=ns['capture'](p,'owned-public-source-control') if kind=='runner' else ns['capture'](p,N,'owned-public-source-control')\n     if stage=='assert' and i==index:raise Injected('postopen-assert:'+str(i))\n     if stage=='fstat':continue\n    if stage not in ('open','fstat','maturity','assert'):\n     for i,pin in enumerate(ns['all_pins'] if kind=='runner' else ns['held']):\n      row,rawbody=ns['qualify'](pin,collect=True)\n      ns['strict'](b'{' if stage=='parse' and i==index else rawbody)\n      if stage=='report':\n       if kind=='python':ns['emit']({'fixture':i})\n       else:fos.write(1,json.dumps({'fixture':i}).encode())\n    if stage=='close':primary=Injected('retained-primary-before-close');raise primary\n   except BaseException as e:primary=e\n   if kind=='runner' and primary is not None:ns['retain_error']('primary',primary,True)\n   detail=attempts(ns,kind,fos,primary)\n   if stage!='close':require(primary is not None,'fault_must_deny:'+stage)\n   else:require(len(ns['cleanup_errors'] if kind=='runner' else ns['close_errors'])==1,'close_fault_sticky')\n   if stage in ('fstat','assert'):require(detail['opened']==index+1,'postopen_fault_owner_registered')\n   record(kind+':'+stage+':'+str(index),{**detail,'primaryClass':type(primary).__name__,'injectionPosition':index,'scope':'ISOLATED_ACTUAL_SOURCE_HOST_OWNED_FD'})\n # Positive path retains physical full EOF/hash/nine and runs original observer exporter.\n fos=FaultOS();ns,_=build_module(raw,kind,fos)\n pins=[ns['capture'](p,'positive') if kind=='runner' else ns['capture'](p,N,'positive') for p in fixtures]\n for pin in pins:\n  row,body=ns['qualify'](pin,collect=True);require(row['fullEOF'] and row['sha256']==sha(body),'positive_fullEOF_hash');ns['strict'](body)\n  if kind=='python':ns['emit'](row)\n record(kind+':positive-fullEOF-allNine',attempts(ns,kind,fos,None))\n\n def finalize(ns,tree):\n  outer=next(n for n in tree.body if isinstance(n,ast.Try))\n  exec(compile(ast.fix_missing_locations(ast.Module(body=outer.finalbody,type_ignores=[])),'<held-actual-finalizer>','exec',dont_inherit=True),ns)\n if kind=='runner':\n  # Actual finalbody reproduces F4 with all held inputs and durable report faults.\n  for point in (0,1):\n   fos=FaultOS('close',point);ns,tree=build_module(raw,kind,fos)\n   for p in fixtures:ns['capture'](p,'actual-finalizer-fixture')\n   primary=Injected('original-primary-retained');ns['retain_error']('primary',primary,True)\n   writes=[]\n   def durable(p,data):\n    i=len(writes);writes.append(str(p))\n    if i==point:raise Injected('actual-report-write:'+str(i))\n   ns.update(C=types.SimpleNamespace(durable_json=durable),RAW=N,OUT=N,NAMES={},results={},records=[],MF_SHA=None,OP='source-fixture',REVIEW_OP='source-fixture',VOLUME='none',DEPS='none',public_transfer_sha=None,control_rows={},source_graph_members={})\n   ns['command']=lambda *a,**k:({'exitCode':0},b'',b'')\n   finalize(ns,tree)\n   require(fos.close_attempts==[p['fd'] for p in ns['all_pins']],'F4_report_fault_all_closes')\n   require(ns['failure']['reason']==str(primary),'F4_sticky_primary')\n   require(any(x['stage'] in ('final-reconciliation-or-report','input-close-report') for x in ns['failure_chain']),'report_fault_retained')\n   require(any(x['stage']=='input-close' for x in ns['failure_chain']),'primary_report_close_all_sticky')\n   record('runner:actual-finalbody-report:'+str(point),{'writes':writes,'closeAttempts':len(fos.close_attempts),'stickyPrimary':True,'reportAndCloseErrorsRetained':True,'allOwnedAttemptedExactlyOnce':True})\n  # Actual runner body-independent finalizer reports all first/middle/last close failures.\n  for i in (0,1,2):\n   fos=FaultOS('close',i);ns,tree=build_module(raw,kind,fos)\n   for p in fixtures:ns['capture'](p,'close-finalizer')\n   ns.update(C=None,RAW=N,OUT=N)\n   finalize(ns,tree)\n   require(len(fos.close_attempts)==3 and len(ns['cleanup_errors'])==1,'F1_actual_finalbody_all_closes')\n   record('runner:actual-finalbody-close:'+str(i),{'closeAttempts':3,'allOwnedAttemptedExactlyOnce':True,'unknownRetry':False})\n\n def original_invariants(oldraw):\n  old=ast.parse(oldraw);new=ast.parse(raw)\n  for n in ast.walk(old):\n   if isinstance(n,ast.Constant) and isinstance(n.value,str):n.value=n.value.replace('TASK03_ATTEMPT6_REPAIR2_ACTUAL_PUBLIC_REVIEW_HANDOFF','TASK03_ATTEMPT6_REPAIR4_ACTUAL_PUBLIC_REVIEW_HANDOFF').replace('TASK03_ATTEMPT6_PUBLIC_REVIEW_REPAIR2_NAMED_SOURCE_ACCEPTANCE','TASK03_ATTEMPT6_PUBLIC_REVIEW_REPAIR4_NAMED_SOURCE_ACCEPTANCE')\n  changed={'capture','close_owned_inputs','retain_error'}\n  oldfunctions={n.name:ast.dump(n,include_attributes=False) for n in old.body if isinstance(n,ast.FunctionDef)}\n  newfunctions={n.name:ast.dump(n,include_attributes=False) for n in new.body if isinstance(n,ast.FunctionDef)}\n  for name,value in oldfunctions.items():\n   if name not in changed:require(newfunctions[name]==value,'unchanged_original_function:'+name)\n  oldasserts=[ast.dump(n,include_attributes=False) for n in ast.walk(old) if isinstance(n,ast.Assert)]\n  newasserts=[ast.dump(n,include_attributes=False) for n in ast.walk(new) if isinstance(n,ast.Assert)]\n  from collections import Counter\n  require(not(Counter(oldasserts)-Counter(newasserts)),'every_original_assertion_retained')\n  record(kind+':all-original-assertions-and-unaffected-functions',{'originalAssertions':len(oldasserts),'retained':True,'allUnaffectedFunctionsEqual':True})\n return original_invariants\n\ndef budget_cases(raw):\n ns,_=build_module(raw,'runner',FaultOS())\n for i in range(4096):ns['reserve_source_graph']('/owned-budget/'+str(i),0)\n try:ns['reserve_source_graph']('/owned-budget/4096',0)\n except AssertionError:pass\n else:raise AssertionError('4097_sources_not_denied')\n require(len(ns['source_graph_members'])==4096,'FDledger_not_reset')\n record('runner:one-source-ledger-4096-descriptor-boundary',{'limit':4096,'extraDenied':True})\n ns,_=build_module(raw,'runner',FaultOS())\n for i in range(4):ns['reserve_source_graph']('/owned-byte-budget/'+str(i),16777216)\n ns['reserve_source_graph']('/owned-byte-budget/0',16777216)\n require(ns['source_graph_bytes']==67108864,'duplicate_path_no_budget_reset')\n for label,size in (('aggregate',1),('perfile',16777217),('bool',True),('negative',-1)):\n  try:ns['reserve_source_graph']('/owned-byte-budget/'+label,size)\n  except AssertionError:pass\n  else:raise AssertionError('source_budget_denial:'+label)\n  require(ns['source_graph_bytes']==67108864,'nonresetting_after_denial')\n  record('runner:one-source-ledger-denial:'+label,{'bytes':67108864,'nonresetting':True})\n try:ns['reserve_source_graph']('/owned-byte-budget/0',16777215)\n except AssertionError:pass\n else:raise AssertionError('duplicate_changed_size_denied')\n record('runner:duplicate-path-size-drift-denial',{'nonresetting':True})\n\n\ndef entry_cases(raw,entry_fixture):\n ns,tree=selected(raw,{'nine','main'},{'FIELDS'})\n expected_raw=b'raise SystemExit(0)\\n';pre=entry_fixture.lstat();expected={'PRE9':nine(pre),'sha256':sha(expected_raw),'bytes':len(expected_raw)}\n for stage in ('positive','open','fstat','maturity','read','parse','close','final-nine'):\n  fos=FaultOS(stage,3);scope,_=selected(raw,{'nine','main'},{'FIELDS'});scope['os']=fos\n  scope['sys']=types.SimpleNamespace(dont_write_bytecode=True,argv=['held-entry',str(entry_fixture),json.dumps(expected),'/source-only-never-read-handoff'])\n  scope['time']=types.SimpleNamespace(time_ns=lambda:0 if stage=='maturity' else time.time_ns())\n  if stage=='parse':scope['sys'].argv[2]='{'\n  if stage=='final-nine':\n   original=fos.fstat;calls=[0]\n   def last_fstat(fd):\n    calls[0]+=1\n    if calls[0]==3:raise Injected('entry-final-nine')\n    return original(fd)\n   fos.fstat=last_fstat\n  primary=None\n  try:status=scope['main']()\n  except BaseException as e:primary=e\n  require(len(fos.close_attempts)==len(fos.fds),'entry_all_owned_closes')\n  if stage=='positive':require(primary is None and status==0,'entry_positive')\n  else:require(primary is not None,'entry_fault_denial')\n  record('entry:'+stage,{'opened':len(fos.fds),'closeAttempts':len(fos.close_attempts),'allOwnedAttemptedExactlyOnce':True,'unknownRetry':False,'stage':stage})\n\ndef main():\n U3=N.parent/'task03-attempt6-actual-public-custody-readiness-repair3'\n U= N.parent/'task03-attempt6-actual-public-custody-readiness-repair2'\n files=[U3/n for n in('linux-public-observer.py','linux-dependency-observer.mjs','source-fault-controls.mjs')]+[N/'run-actual-review.py',N/'actual-entry.py',Path(__file__)]+list((U3/'fixtures').glob('*'))\n files += [U/'run-actual-review.py',U/'linux-public-observer.py',U/'linux-dependency-observer.mjs']\n source_capture(files)\n bypath={}\n for p in source_owners:\n  os.lseek(p['fd'],0,0);chunks=[]\n  while b:=os.read(p['fd'],65536):chunks.append(b)\n  raw=b''.join(chunks);require(sha(raw)==p['sha256'] and len(raw)==p['bytes'],'held_repeat_source');bypath[p['path']]=raw\n try:\n  fixtures=sorted((U3/'fixtures').glob('*.json'));require(len(fixtures)==3,'three_owned_fixtures')\n  for name,kind in(('run-actual-review.py','runner'),('linux-public-observer.py','python')):\n   check=python_cases(bypath[str((N if kind=='runner'else U3)/name)],kind,fixtures);check(bypath[str(U/name)])\n  budget_cases(bypath[str(N/'run-actual-review.py')])\n  entry_cases(bypath[str(N/'actual-entry.py')],U3/'fixtures/owned-entry-3.py')\n  node='/Users/SaintNick/.codex/tmp/cortex-runtime-toolchain-20261005/node_modules/.bin/node'\n  payload={'newSource':bypath[str(U3/'linux-dependency-observer.mjs')].decode(),'oldSource':bypath[str(U/'linux-dependency-observer.mjs')].decode(),'fixtures':[str(p)for p in fixtures]}\n  js=bypath[str(U3/'source-fault-controls.mjs')]\n  proc=subprocess.run([node,'--input-type=module','-e',js.decode()],input=json.dumps(payload).encode(),stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=30,env={'PATH':'/usr/bin:/bin','HOME':'/Users/SaintNick','LANG':'C.UTF-8'})\n  require(proc.returncode==0,'JS_control_failure:'+proc.stderr.decode()[:1000]);j=json.loads(proc.stdout);require(j['status']=='PASS','JS_status');receipts.extend(j['controls'])\n  require(len(receipts)==97,'all_original97_conditions_preserved')\n  for pin in source_owners:require(nine(os.fstat(pin['fd']))==nine(Path(pin['path']).lstat())==pin['PRE9'],'final_source_nine')\n finally:close_sources()\n result={'scope':'U4_AUTHOR_ORIGINAL97_SOURCE_ONLY_WITH_ENTRY_WIRING','status':'PASS','controls':receipts,'count':len(receipts),'nodeVersion':j['nodeVersion'],'pythonVersion':sys.version,'pythonExecutable':sys.executable,'sourceInputs':[{k:v for k,v in p.items()if k!='fd'}for p in source_owners],'allSourceFDsClosedExactlyOnce':True,'dockerCommands':0,'privateReads':0,'serviceCalls':0,'unknownForeignEffects':False,'nativeFoundationAccepted':False,'fullTask03':False,'fullGoal':False}\n print(json.dumps(result,separators=(',',':')))\nif __name__=='__main__':main()\n"}
{"op": "show", "result": "\"\"\"Owned SOURCE/MOCK entry tests, exact /usr/bin/python3 and supported interpreter.\"\"\"\nimport ast,hashlib,json,os,stat,sys,time,types\nfrom pathlib import Path\nP=json.loads(sys.stdin.buffer.read());raw=P['entry'].encode();fixture=Path(P['fixture']);expected=P['fixturePin']\nREAL_OS=os\nFIELDS=('dev','ino','mode','nlink','uid','gid','size','mtime_ns','ctime_ns')\ndef nine(s):return{k:str(getattr(s,'st_'+k))for k in FIELDS}\ndef check(v,label):\n if not v:raise AssertionError(label)\nclass OwnedFinal(OSError):pass\nclass OwnedClose(OSError):pass\nclass OwnedPrimary(BaseException):pass\nclass FaultOS:\n def __init__(self,final,close):self.fds=[];self.closes=[];self.fstatCalls=0;self.final=final;self.close_error=close\n def __getattr__(self,name):return getattr(REAL_OS,name)\n def open(self,path,flags):\n  check(Path(path)==fixture,'only_owned_fixture');fd=REAL_OS.open(path,flags);self.fds.append(fd);return fd\n def fstat(self,fd):\n  check(fd in self.fds,'owned_fstat');self.fstatCalls+=1\n  if self.fstatCalls==3 and self.final is not None:raise self.final\n  return REAL_OS.fstat(fd)\n def close(self,fd):\n  check(fd in self.fds and fd not in self.closes,'owned_close_once');self.closes.append(fd);REAL_OS.close(fd)\n  if self.close_error is not None:raise self.close_error\ndef run(label,primary,final,close,positive_exit=None):\n tree=ast.parse(raw)\n tree.body=[n for n in tree.body if not(isinstance(n,ast.If)and isinstance(n.test,ast.Compare)and isinstance(n.test.left,ast.Name)and n.test.left.id=='__name__')]\n ns={'__name__':'isolated_held_entry','__file__':P['entryPath']}\n exec(compile(ast.fix_missing_locations(tree),P['entryPath'],'exec'),ns)\n fos=FaultOS(final,close)\n ns.update(os=fos,sys=types.SimpleNamespace(dont_write_bytecode=True,argv=['held-entry',str(fixture),json.dumps(expected),'/owned-source-only-unused-handoff']))\n real_compile=compile;real_exec=exec\n def owned_compile(source,path,mode,**kwargs):\n  check(bytes(source)==b'raise SystemExit(0)\\n','complete_original_fixture_bytes')\n  return real_compile('raise _owned_primary'if primary is not None else('raise SystemExit('+repr(positive_exit)+')'if positive_exit is not None else'pass'),path,mode)\n def owned_exec(code,scope):\n  scope['_owned_primary']=primary\n  real_exec(code,scope)\n ns.update(compile=owned_compile,exec=owned_exec)\n outcome=None;returned=None\n try:returned=ns['main']()\n except BaseException as error:outcome=error\n check(fos.closes==fos.fds and len(fos.closes)==1,'explicit_all_owned_close_exactly_once')\n children=([primary]if primary is not None else[])+([final]if final is not None else[])+([close]if close is not None else[])\n successful_zero=isinstance(primary,SystemExit)and primary.code in(None,0)and final is None and close is None\n if children and not successful_zero:\n  check(outcome is not None and not isinstance(outcome,NameError),'complete_sticky_failure_no_NameError')\n  check(isinstance(outcome.exceptions,tuple)and len(outcome.exceptions)==len(children),'complete_child_count')\n  check(all(a is b for a,b in zip(outcome.exceptions,children)),'exact_error_objects_and_order')\n  check(outcome.__cause__ is children[0],'original_cause_identity')\n  check(all(e.__traceback__ is not None for e in children),'original_tracebacks_retained')\n  check(isinstance(outcome,Exception)==all(isinstance(e,Exception)for e in children),'BaseException_semantics_preserved')\n else:check(outcome is None and returned==0,'positive_exact_zero_success')\n return{'name':label,'status':'PASS','closeAttempts':1,'closeRetries':0,'originalErrorIdentitiesRetained':True,'childCount':len(children),'scope':'OWNED_ISOLATED_HELD_ENTRY_SOURCE_MOCK'}\nrows=[]\nrows.append(run('positive-complete-baseline',None,None,None,positive_exit=0))\nfor name,make in [('Exception',lambda:RuntimeError('original-primary')),('BaseException',lambda:OwnedPrimary('original-base-primary')),('SystemExit0',lambda:SystemExit(0)),('SystemExit7',lambda:SystemExit(7)),('SystemExitNone',lambda:SystemExit(None)),('KeyboardInterrupt',lambda:KeyboardInterrupt('original-interrupt'))]:\n for final_on,close_on in[(False,False),(True,False),(False,True),(True,True)]:\n  rows.append(run(name+':final='+str(final_on)+':close='+str(close_on),make(),OwnedFinal('original-final-nine')if final_on else None,OwnedClose('original-owned-close')if close_on else None))\nfor name,f,c in [('close-alone',None,OwnedClose('close-only')),('final-nine-alone',OwnedFinal('final-only'),None),('final-plus-close',OwnedFinal('final-combined'),OwnedClose('close-combined'))]:rows.append(run(name,None,f,c))\ncheck(nine(fixture.lstat())==expected['PRE9'],'immutable_fixture_original_nine')\nprint(json.dumps({'scope':'U4_AUTHOR_EXACT_INTERPRETER_ENTRY_SOURCE_MOCK','status':'PASS','controls':rows,'count':len(rows),'pythonVersion':sys.version,'pythonExecutable':sys.executable,'entrySha256':hashlib.sha256(raw).hexdigest(),'entryBytes':len(raw),'actualRunnerExecuted':False,'dockerCommands':0,'privateReads':0,'serviceCalls':0,'nativePrivate':False,'fullTask03':False},separators=(',',':')))\n"}
{"op": "show", "result": "\"\"\"SOURCE/MOCK reachable successor gates, exact sets and semantic conservation.\"\"\"\nimport ast,collections,json,sys\nfrom pathlib import Path\nP=json.loads(sys.stdin.buffer.read());new=ast.parse(P['runner']);old=ast.parse(P['oldRunner'])\nreceipts=[]\ndef record(name,**kw):receipts.append({'name':name,'status':'PASS','scope':'ISOLATED_ACTUAL_SUCCESSOR_GATE_SOURCE_MOCK',**kw})\nfor n in ast.walk(old):\n if isinstance(n,ast.Constant)and isinstance(n.value,str):n.value=n.value.replace('TASK03_ATTEMPT6_REPAIR3_ACTUAL_PUBLIC_REVIEW_HANDOFF','TASK03_ATTEMPT6_REPAIR4_ACTUAL_PUBLIC_REVIEW_HANDOFF').replace('TASK03_ATTEMPT6_PUBLIC_REVIEW_REPAIR3_NAMED_SOURCE_ACCEPTANCE','TASK03_ATTEMPT6_PUBLIC_REVIEW_REPAIR4_NAMED_SOURCE_ACCEPTANCE')\nassert[ast.dump(n,include_attributes=False)for n in ast.walk(old)if isinstance(n,ast.Assert)]==[ast.dump(n,include_attributes=False)for n in ast.walk(new)if isinstance(n,ast.Assert)]\nassert{n.name:ast.dump(n,include_attributes=False)for n in old.body if isinstance(n,ast.FunctionDef)}=={n.name:ast.dump(n,include_attributes=False)for n in new.body if isinstance(n,ast.FunctionDef)}\nrecord('runner:all-original-assertions-and-functions-conserved',assertions=sum(isinstance(n,ast.Assert)for n in ast.walk(old)))\noe=ast.parse(P['oldEntry']);ne=ast.parse(P['entry'])\nassert[ast.dump(n,include_attributes=False)for n in ast.walk(oe)if isinstance(n,ast.Assert)]==[ast.dump(n,include_attributes=False)for n in ast.walk(ne)if isinstance(n,ast.Assert)]\nrecord('entry:all-original-assertions-conserved')\nnames={'R','QA','O','OBSERVERS','OLD','COMMON','REVIEW_OP','OP','VOLUME','IMAGE','FREEZE'}\nconstants=[n for n in new.body if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id in names for t in n.targets)]\nouter=next(n for n in new.body if isinstance(n,ast.Try))\ngate=[];take=False\nfor n in outer.body:\n if isinstance(n,ast.Assert)and any(isinstance(c,ast.Constant)and c.value=='TASK03_ATTEMPT6_REPAIR4_ACTUAL_PUBLIC_REVIEW_HANDOFF'for c in ast.walk(n)):gate.append(n)\n elif isinstance(n,ast.Assert)and getattr(n,'lineno',0)in(232,233):gate.append(n)\n if isinstance(n,ast.Assign)and any(isinstance(t,ast.Name)and t.id=='required_sources'for t in n.targets):take=True\n if take:\n  if isinstance(n,ast.For):break\n  gate.append(n)\nassert len(gate)>=7\nconstant_code=compile(ast.fix_missing_locations(ast.Module(body=constants,type_ignores=[])),'<held-successor-constants>','exec')\ngate_code=compile(ast.fix_missing_locations(ast.Module(body=gate,type_ignores=[])),'<held-successor-reachable-gates>','exec')\nbase={'Path':Path};exec(constant_code,base)\nrequired={str(base['O']/n)for n in('actual-entry.py','run-actual-review.py')}|{str(base['OBSERVERS']/n)for n in('linux-public-observer.py','linux-dependency-observer.mjs')}|{str(base['COMMON'])}\nassert len(required)==5 and str(base['OBSERVERS']/'actual-entry.py')not in required\ndef execute(kind):\n H={'scope':'TASK03_ATTEMPT6_REPAIR4_ACTUAL_PUBLIC_REVIEW_HANDOFF','explicitActualPublicReviewAuthorized':True,'operation':base['OP'],'reviewerOperation':base['REVIEW_OP'],'volume':base['VOLUME'],'immutableImage':base['IMAGE'],'candidateSha256':base['FREEZE'],'allNewWritersStopped':True,'remainingWrites':[],'reviewSources':{p:{'sha256':'a'*64}for p in required}}\n A={'scope':'TASK03_ATTEMPT6_PUBLIC_REVIEW_REPAIR4_NAMED_SOURCE_ACCEPTANCE','independent':True,'verdict':'PASS','reviewerOperation':base['REVIEW_OP'],'sourceEpochManifestSha256':'b'*64,'sourceHashes':{p:'a'*64 for p in required}}\n if kind=='stale-U3-handoff':H['scope']='TASK03_ATTEMPT6_REPAIR3_ACTUAL_PUBLIC_REVIEW_HANDOFF'\n if kind=='stale-U3-PASS-claim':A['scope']='TASK03_ATTEMPT6_PUBLIC_REVIEW_REPAIR3_NAMED_SOURCE_ACCEPTANCE'\n if kind=='wrong-active-entry':\n  row=H['reviewSources'].pop(str(base['O']/'actual-entry.py'));H['reviewSources'][str(base['OBSERVERS']/'actual-entry.py')]=row;A['sourceHashes']={p:r['sha256']for p,r in H['reviewSources'].items()}\n if kind=='extra-source-key':\n  H['reviewSources']['/owned-extra']={'sha256':'a'*64};A['sourceHashes']['/owned-extra']='a'*64\n if kind=='missing-source-key':\n  H['reviewSources'].pop(str(base['COMMON']));A['sourceHashes'].pop(str(base['COMMON']))\n if kind=='wrong-source-hash':A['sourceHashes'][str(base['O']/'actual-entry.py')]='c'*64\n if kind=='old-reviewer-operation':A['reviewerOperation']='7cd9aa43-6f70-49a2-a280-f43777386366'\n if kind=='non-independent-bool-alias':A['independent']=1\n if kind=='wrong-verdict':A['verdict']='REVISION'\n if kind=='source-epoch-mismatch':A['sourceEpochManifestSha256']='c'*64\n if kind=='unauthorized-actual-bool-alias':H['explicitActualPublicReviewAuthorized']=1\n if kind=='writers-not-stopped':H['allNewWritersStopped']=False\n if kind=='remaining-writes':H['remainingWrites']=['owned-future-write']\n ns={**base,'H':H,'control_docs':{'reviewSourceAcceptance':A},'MF_SHA':'b'*64}\n denied=False\n try:exec(gate_code,ns)\n except AssertionError:denied=True\n assert denied is(kind!='positive-exact-five')\n record('successor:'+kind,denied=denied,sourceEffects=0)\nfor kind in('positive-exact-five','stale-U3-handoff','stale-U3-PASS-claim','wrong-active-entry','extra-source-key','missing-source-key','wrong-source-hash','old-reviewer-operation','non-independent-bool-alias','wrong-verdict','source-epoch-mismatch','unauthorized-actual-bool-alias','writers-not-stopped','remaining-writes'):execute(kind)\nprint(json.dumps({'scope':'U4_AUTHOR_SUCCESSOR_GATE_AND_CONSERVATION_SOURCE_MOCK','status':'PASS','controls':receipts,'count':len(receipts),'pythonExecutable':sys.executable,'pythonVersion':sys.version,'actualRunnerExecuted':False,'nativePrivate':False,'fullTask03':False},separators=(',',':')))\n"}
{"op": "show", "result": "\"\"\"Finite host-only controls for separately adapted Common; no Docker/service/private effects.\"\"\"\nimport ast,hashlib,json,os,resource,select,socket,stat,sys,time,types\nfrom pathlib import Path\nR=Path('/Users/SaintNick/Documents/Cortex/worktrees/backend-runtime-completion')\nN=R/'_goals/convex-backend-runtime-2026-10-02/qa/local-resume-2026-10-05/task03-attempt6-actual-public-custody-readiness-repair2'\nORIGINAL=R/'_goals/convex-backend-runtime-2026-10-02/qa/task03-local-native-attempt6-2026-10-06/integrated/coordinate-common.py'\nADAPTED=N/'coordinate-common-highfd.py'\nFIELDS=('dev','ino','mode','nlink','uid','gid','size','mtime_ns','ctime_ns')\nENV={'PATH':'/usr/bin:/bin','LANG':'C.UTF-8','CORTEX_COORDINATOR_CWD':str(R)}\npins=[]\ndef nine(s):return {k:str(getattr(s,'st_'+k))for k in FIELDS}\ndef hold(p,expected):\n s=p.lstat();now=time.time_ns();assert stat.S_ISREG(s.st_mode)and s.st_nlink==1 and s.st_uid==501 and s.st_gid==20\n assert max(s.st_mtime_ns,s.st_ctime_ns)+60000000000<=now\n fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW);row={'path':str(p),'PRE9':nine(s),'firstCapturedNs':str(now),'fd':fd};pins.append(row)\n raw=read(row);assert hashlib.sha256(raw).hexdigest()==expected\n return row,raw\n\ndef read(pin):\n fd=pin['fd'];pre=pin['PRE9'];assert nine(os.fstat(fd))==pre;os.lseek(fd,0,0);raw=bytearray()\n while block:=os.read(fd,65536):raw.extend(block);assert len(raw)<=int(pre['size'])<=16777216\n assert len(raw)==int(pre['size'])and nine(os.fstat(fd))==nine(Path(pin['path']).lstat())==pre\n return bytes(raw)\ndef module(path,raw):\n result=types.ModuleType('bounded_common_control_'+path.stem);result.__file__=str(path);result.__package__=''\n exec(compile(raw,str(path),'exec',dont_inherit=True),result.__dict__);return result\nassert sys.dont_write_bytecode and Path.cwd()==R\nsoft,hard=resource.getrlimit(resource.RLIMIT_NOFILE)\nif soft<8192:resource.setrlimit(resource.RLIMIT_NOFILE,(min(8192,hard),hard))\nassert resource.getrlimit(resource.RLIMIT_NOFILE)[0]>=4096\nop,original=hold(ORIGINAL,'1f8f6005c668401b63681e28002715d977abcc02312a199a468e32c2505fa0a2')\nap,adapted=hold(ADAPTED,'3b7d195b905465275b081b32f0a934af4c232f7dafb76281c044d50e8b03dc8f')\nO=module(ORIGINAL,original);C=module(ADAPTED,adapted)\n# Exact reference transform and remaining AST protect all original safeguards.\ntext=original.decode();helper='def control_readable(control, wait):\\n    with selectors.DefaultSelector() as readiness:\\n        readiness.register(control, selectors.EVENT_READ)\\n        return bool(readiness.select(wait))\\n\\n'\ntext=text.replace('def anchor_main(fd, argv):\\n',helper+'def anchor_main(fd, argv):\\n')\nfor old,new in [('select.select([control],[],[],0.02)[0]','control_readable(control,0.02)'),('select.select([control],[],[],wait)[0]','control_readable(control,wait)'),('select.select([control],[],[],max(0,ready_deadline-time.monotonic()))[0]','control_readable(control,max(0,ready_deadline-time.monotonic()))')]:assert text.count(old)==1;text=text.replace(old,new)\nassert text.encode()==adapted\nassert C.PIPE_LIMIT==O.PIPE_LIMIT==262144 and C.INPUT_LIMIT==O.INPUT_LIMIT==327692 and C.CONTROL_LIMIT==O.CONTROL_LIMIT==8192\nOUT=N/'highfd-controls1';OUT.mkdir(mode=0o700);rows=[];held=[]\ndef terminal(row):\n assert row['terminal']is True and row['closeErrors']==[] and row['ownedGroup']['absenceObserved']is True\n assert row['ownedGroup']['unknownOwnershipNeverSignaled']is True\n assert row['pipeLimits']==262144 and row['stdinLimit']==327692 and row['stdinDeadlineSeconds']==12\n\ndef run(common,label,code,timeout=8,input_bytes=None):\n row,out,err=common.run(label,[sys.executable,'-B','-c',code],OUT,timeout,ENV,input_bytes=input_bytes,required=False)\n rows.append(row);terminal(row);return row,out,err\ntry:\n row,out,err=run(O,'original-lowfd-success',\"import os;os.write(1,b'low-ok');os.write(2,b'low-err')\")\n assert row['exitCode']==0 and row['failureClass']is None and out==b'low-ok'and err==b'low-err'\n while not held or held[-1]<2400:held.append(os.open('/dev/null',os.O_RDONLY))\n assert len(held)>=2352 and held[-1]>=2400\n a,b=socket.socketpair();descriptor=a.fileno();assert descriptor>2400\n try:\n  denied=None\n  try:select.select([a],[],[],0)\n  except ValueError as e:denied={'class':type(e).__name__,'reason':str(e),'descriptor':descriptor}\n  assert denied is not None\n  assert C.control_readable(a,0)is False\n  before=time.monotonic();assert C.control_readable(a,0.035)is False;elapsed=time.monotonic()-before;assert 0.025<=elapsed<=1\n  b.sendall(b'Q');assert C.control_readable(a,0)is True and a.recv(1)==b'Q'\n  b.close();assert C.control_readable(a,0)is True and a.recv(1)==b''\n finally:a.close();b.close()\n row,out,err=run(C,'highfd2400-success',\"import os;os.write(1,b'high-ok');os.write(2,b'high-err')\")\n assert row['exitCode']==0 and row['failureClass']is None and out==b'high-ok'and err==b'high-err'\n row,out,err=run(C,'highfd2400-nonzero',\"import os,sys;os.write(1,b'nonzero');sys.exit(7)\")\n assert row['exitCode']==7 and row['failureClass']is None and out==b'nonzero'and err==b''\n payload=b'z'*327692\n row,out,err=run(C,'highfd2400-stdin-max',\"import sys,hashlib;data=sys.stdin.buffer.read();print(str(len(data))+':'+hashlib.sha256(data).hexdigest())\",input_bytes=payload)\n assert row['exitCode']==0 and row['failureClass']is None and row['stdinBytes']==327692 and out.decode().strip()=='327692:'+hashlib.sha256(payload).hexdigest()and err==b''\n row,out,err=run(C,'highfd2400-pipes-max',\"import sys;sys.stdout.buffer.write(b'A'*262144);sys.stdout.buffer.flush();sys.stderr.buffer.write(b'B'*262144);sys.stderr.buffer.flush()\")\n assert row['exitCode']==0 and row['failureClass']is None and out==b'A'*262144 and err==b'B'*262144\n row,out,err=run(C,'highfd2400-stdout-overflow',\"import sys,time;sys.stdout.buffer.write(b'A'*262145);sys.stdout.buffer.flush();time.sleep(0.15)\")\n assert row['failureClass']=='ValueError'and len(out)==262144 and row['streamByteCounts']['stdout']==262145\n row,out,err=run(C,'highfd2400-stderr-overflow',\"import sys,time;sys.stderr.buffer.write(b'B'*262145);sys.stderr.buffer.flush();time.sleep(0.15)\")\n assert row['failureClass']=='ValueError'and len(err)==262144 and row['streamByteCounts']['stderr']==262145\n row,out,err=run(C,'highfd2400-deadline',\"import time;time.sleep(5)\",timeout=0.35)\n assert row['failureClass']=='TimeoutError'and row['elapsedSeconds']<4 and row['ownedGroup']['reconciliation']is not None\n # Child closes inherited streams; residual owned child still needs reconciliation.\n row,out,err=run(C,'highfd2400-residual',\"import subprocess,sys;subprocess.Popen([sys.executable,'-B','-c','import time;time.sleep(4)'],stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)\")\n assert row['failureClass']=='OwnedGroupResidual'and row['ownedGroup']['reconciliation']['signals']\n row,out,err=C.run('highfd2400-missing',['/nonexistent-task03-host-control'],OUT,8,ENV,required=False);rows.append(row)\n assert row['failureClass']=='FileNotFoundError'and row['closeErrors']==[]and row['ownedGroup']['absenceObserved']is True and row['terminal']is False\n for value,reason in [(0,'finite_command_timeout_required'),(191,'finite_command_timeout_required')]:\n  try:C.run('denied-timeout',[sys.executable],OUT,value,ENV)\n  except ValueError as e:assert str(e)==reason\n  else:raise AssertionError('timeout accepted')\n for value in (b'',b'x'*327693):\n  try:C.run('denied-stdin',[sys.executable],OUT,1,ENV,input_bytes=value)\n  except ValueError as e:assert str(e)=='finite_stdin_required'\n  else:raise AssertionError('stdin accepted')\n while held[-1]<4000:held.append(os.open('/dev/null',os.O_RDONLY))\n row,out,err=run(C,'highfd4000-success',\"print('near-ceiling-ok')\")\n assert row['exitCode']==0 and row['failureClass']is None and out==b'near-ceiling-ok\\n'and err==b''\n final=[]\n for pin in pins:\n  raw=read(pin);final.append({k:v for k,v in pin.items()if k!='fd'}|{'sha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw),'fullEOF':True,'finalPathAndDescriptorNineEqual':True})\n C.durable_json(OUT/'controls-summary.json',{'scope':'HOST_ONLY_SEPARATE_HIGHFD_COMMON_REGRESSION_CONTROLS','status':'PASS','actualDockerCalls':0,'privateReads':0,'serviceCalls':0,'paidCalls':0,'sourceMutation':False,'exactThreeReadinessSiteTransform':True,'originalSelectHighFdNegative':denied,'selectorEmptyTimeoutReadyEof':{'timeoutSeconds':elapsed,'readyDataAndEofObserved':True},'custodyDummyDescriptorsHeld':len(held),'highestCustodyDescriptor':held[-1],'custodyHeldUntilEveryControlFinal':True,'commands':rows,'sourcePins':final,'invalidTimeoutsAndStdinLimitsDenied':True,'originalAssertionsLimitsDeadlinesOwnershipCodeBytePreserved':True,'fullTask03':False,'fullGoal':False,'nativePrivate':False})\n C.durable_json(OUT/'writers-stopped.json',{'scope':'HIGHFD_CONTROLS_WRITERS_STOPPED','remainingWrites':[],'stoppedNs':str(time.time_ns()),'firstPhysicalQualification':'Root after max(mtime,ctime)>=60seconds','noPinsRefreshed':True})\n print(json.dumps({'status':'PASS','controls':len(rows),'highestHeldDescriptor':held[-1],'output':str(OUT)}))\nfinally:\n for fd in held:os.close(fd)\n for pin in pins:os.close(pin['fd'])\n"}
