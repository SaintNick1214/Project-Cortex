+def literal_equal(current,expected):
+    """Fresh typed comparison of small mutable rows, never a cached hash.
+
+    This avoids serializing/hashing all literal-row JSON at every nested IO
+    fence. Keys, scalar types, list order and every literal value stay exact.
+    The original ledger approval_binding/preflight still run each boundary.
+    """
+    if isinstance(expected,dict):
+        return (isinstance(current,(dict,FrozenMap)) and set(current)==set(expected)
+                and all(literal_equal(current[key],value)for key,value in expected.items()))
+    if isinstance(expected,list):
+        return (isinstance(current,(list,FrozenList))and len(current)==len(expected)
+                and all(literal_equal(a,b)for a,b in zip(current,expected)))
+    if isinstance(expected,tuple):
+        return (isinstance(current,tuple)and len(current)==len(expected)
+                and all(literal_equal(a,b)for a,b in zip(current,expected)))
+    return type(current)is type(expected)and current==expected
