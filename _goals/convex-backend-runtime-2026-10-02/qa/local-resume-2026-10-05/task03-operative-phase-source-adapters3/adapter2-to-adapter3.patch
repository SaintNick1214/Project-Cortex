+def freeze(value,journal):
+    if isinstance(value,(FrozenMap,FrozenList,NativeFrozenRow)):return value
+    if isinstance(value,dict):return FrozenMap(value,journal)
+    if isinstance(value,list):return FrozenList(value,journal)
+    if isinstance(value,tuple):return tuple(freeze(item,journal)for item in value)
+    return value
+
+def native(value):
+    if isinstance(value,FrozenMap):return {key:native(item)for key,item in value.items()}
+    if isinstance(value,FrozenList):return [native(item)for item in value]
+    if isinstance(value,dict):return {key:native(item)for key,item in value.items()}
+    if isinstance(value,(tuple,list)):return [native(item)for item in value]
+    return value
