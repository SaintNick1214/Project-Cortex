     5	  getFromApi,
     6	  lazySchema,
     7	  resolve,
     8	  zodSchema,
     9	} from '@ai-sdk/provider-utils';
    10	import { z } from './zod';
    11	import { asGatewayError } from './errors';
    12	import type { GatewayConfig } from './gateway-config';
    13	
    14	export interface GatewayGenerationInfoParams {
    15	  /** The generation ID to look up (format: gen_<ulid>) */
    16	  id: string;
    17	}
    18	
    19	export interface GatewayGenerationInfo {
    20	  /** The generation ID */
    21	  id: string;
    22	  /** Total cost in USD */
    23	  totalCost: number;
    24	  /** Upstream inference cost in USD (BYOK only) */
    25	  upstreamInferenceCost: number;
    26	  /** Usage cost in USD (same as totalCost) */
    27	  usage: number;
    28	  /** ISO 8601 timestamp when the generation was created */
    29	  createdAt: string;
    30	  /** Model identifier */
    31	  model: string;
    32	  /** Whether BYOK credentials were used */
    33	  isByok: boolean;
    34	  /** Provider that served this generation */
    35	  providerName: string;
    36	  /** Whether streaming was used */
    37	  streamed: boolean;
    38	  /** Finish reason (e.g. 'stop') */
    39	  finishReason: string;
    40	  /** Time to first token in milliseconds */
    41	  latency: number;
    42	  /** Total generation time in milliseconds */
    43	  generationTime: number;
    44	  /** Number of prompt tokens */
    45	  promptTokens: number;
    46	  /** Number of completion tokens */
    47	  completionTokens: number;
    48	  /** Reasoning tokens used */
    49	  reasoningTokens: number;
    50	  /** Cached tokens used */
    51	  cachedTokens: number;
    52	  /** Cache creation input tokens */
    53	  cacheCreationTokens: number;
    54	  /** Billable web search calls */
    55	  billableWebSearchCalls: number;
    56	}
    57	
    58	export class GatewayGenerationInfoFetcher {
    59	  constructor(private readonly config: GatewayConfig) {}
    60	
    61	  async getGenerationInfo(
    62	    params: GatewayGenerationInfoParams,
    63	  ): Promise<GatewayGenerationInfo> {
    64	    try {
    65	      const baseUrl = new URL(this.config.baseURL);
    66	
    67	      const { value } = await getFromApi({
    68	        url: `${baseUrl.origin}/v1/generation?id=${encodeURIComponent(params.id)}`,
    69	        validateUrl: false,
    70	        headers: this.config.headers
    71	          ? await resolve(this.config.headers)
    72	          : undefined,
    73	        successfulResponseHandler: createJsonResponseHandler(
    74	          gatewayGenerationInfoResponseSchema,
    75	        ),
    76	        failedResponseHandler: createJsonErrorResponseHandler({
    77	          errorSchema: z.any(),
    78	          errorToMessage: data => getErrorMessage(data) ?? 'unknown error',
    79	        }),
    80	        fetch: this.config.fetch,
    81	      });
    82	
    83	      return value;
    84	    } catch (error) {
    85	      throw await asGatewayError(error);
    86	    }
    87	  }
    88	}
    89	
    90	const gatewayGenerationInfoResponseSchema = lazySchema(() =>
    91	  zodSchema(
    92	    z
    93	      .object({
    94	        data: z
    95	          .object({
    96	            id: z.string(),
    97	            total_cost: z.number(),
    98	            upstream_inference_cost: z.number(),
    99	            usage: z.number(),
   100	            created_at: z.string(),
   101	            model: z.string(),
   102	            is_byok: z.boolean(),
   103	            provider_name: z.string(),
   104	            streamed: z.boolean(),
   105	            finish_reason: z.string(),
   106	            latency: z.number(),
   107	            generation_time: z.number(),
   108	            native_tokens_prompt: z.number(),
   109	            native_tokens_completion: z.number(),
   110	            native_tokens_reasoning: z.number(),
   111	            native_tokens_cached: z.number(),
   112	            native_tokens_cache_creation: z.number(),
   113	            billable_web_search_calls: z.number(),
   114	          })
   115	          .transform(
   116	            ({
   117	              total_cost,
   118	              upstream_inference_cost,
   119	              created_at,
   120	              is_byok,
   121	              provider_name,
   122	              finish_reason,
   123	              generation_time,
   124	              native_tokens_prompt,
   125	              native_tokens_completion,
   126	              native_tokens_reasoning,
   127	              native_tokens_cached,
   128	              native_tokens_cache_creation,
   129	              billable_web_search_calls,
   130	              ...rest
   131	            }) => ({
   132	              ...rest,
   133	              totalCost: total_cost,
   134	              upstreamInferenceCost: upstream_inference_cost,
   135	              createdAt: created_at,
   136	              isByok: is_byok,
   137	              providerName: provider_name,
   138	              finishReason: finish_reason,
   139	              generationTime: generation_time,
   140	              promptTokens: native_tokens_prompt,
   141	              completionTokens: native_tokens_completion,
   142	              reasoningTokens: native_tokens_reasoning,
   143	              cachedTokens: native_tokens_cached,
   144	              cacheCreationTokens: native_tokens_cache_creation,
   145	              billableWebSearchCalls: billable_web_search_calls,
   146	            }),
   147	          ),
   148	      })
   149	      .transform(({ data }) => data),
   150	  ),
   151	);
