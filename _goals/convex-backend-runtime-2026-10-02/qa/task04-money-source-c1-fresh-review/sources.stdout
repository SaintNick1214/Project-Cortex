     1	import { createAnthropic } from "@ai-sdk/anthropic";
     2	import { createOpenAI } from "@ai-sdk/openai";
     3	import {
     4	  createOpenAICompatible,
     5	  type MetadataExtractor,
     6	} from "@ai-sdk/openai-compatible";
     7	import {
     8	  defaultSettingsMiddleware,
     9	  wrapEmbeddingModel,
    10	  wrapLanguageModel,
    11	} from "ai";
    12	import { getServiceToken } from "convex/server";
    13	import { createEvaluationModel } from "./evaluation-model.js";
    14	import { createVideoModel } from "./video-model.js";
    15	
    16	type Provider = ReturnType<typeof createOpenAICompatible>;
    17	type ChatModel = ReturnType<Provider>;
    18	type EmbeddingModel = ReturnType<typeof wrapEmbeddingModel>;
    19	type ProviderMetadata = NonNullable<
    20	  Awaited<ReturnType<MetadataExtractor["extractMetadata"]>>
    21	>;
    22	type ImageModel = ReturnType<Provider["imageModel"]>;
    23	type LanguageModel = Parameters<typeof wrapLanguageModel>[0]["model"];
    24	type GatewayLanguageModel = ReturnType<typeof wrapLanguageModel>;
    25	
    26	const maxEmbeddingsPerCall = 512;
    27	// Official providers require a credential before gatewayFetch replaces it with a deployment JWT.
    28	const placeholderCredential = "convex-gateway";
    29	
    30	/**
    31	 * A deployment can set `CONVEX_INTERNAL_AI_GATEWAY_HOST` to reach a different
    32	 * gateway, which is how internal apps use staging.
    33	 */
    34	const productionGatewayHost = "https://ai-gateway.convex.dev";
    35	
    36	function gatewayBaseURL(version: "v1" | "alpha" = "v1"): string {
    37	  return `${process.env.CONVEX_INTERNAL_AI_GATEWAY_HOST || productionGatewayHost}/${version}`;
    38	}
    39	
    40	async function gatewayFetch(
    41	  input: RequestInfo | URL,
    42	  init?: RequestInit,
    43	): Promise<Response> {
    44	  const token = await getServiceToken("ai-gateway");
    45	  const headers = new Headers(init?.headers);
    46	  // Deployment JWT is the only accepted credential for the hosted gateway.
    47	  headers.set("Authorization", `Bearer ${token}`);
    48	  return globalThis.fetch(input, { ...init, headers });
    49	}
    50	
    51	// The SDK's standard usage mapping omits the gateway's dollar costs.
    52	function convexGatewayUsageMetadata(
    53	  usage: unknown,
    54	): ProviderMetadata | undefined {
    55	  if (!usage || typeof usage !== "object") return undefined;
    56	  const { cost, cost_details } = usage as ProviderMetadata[string];
    57	  const metadata: ProviderMetadata[string] = {};
    58	  if (typeof cost === "number") metadata.cost = cost;
    59	  if (cost_details && typeof cost_details === "object") {
    60	    metadata.costDetails = cost_details;
    61	  }
    62	  return Object.keys(metadata).length > 0
    63	    ? { convexGateway: metadata }
    64	    : undefined;
    65	}
    66	
    67	const costMetadataExtractor: MetadataExtractor = {
    68	  extractMetadata: async ({ parsedBody }) =>
    69	    convexGatewayUsageMetadata(
    70	      (parsedBody as { usage?: unknown } | undefined)?.usage,
    71	    ),
    72	  createStreamExtractor: () => {
    73	    // Streamed responses deliver usage (incl. cost) on the final chunk.
    74	    let usage: unknown;
    75	    return {
    76	      processChunk(parsedChunk: unknown) {
    77	        const chunk = parsedChunk as { usage?: unknown } | undefined;
    78	        if (chunk?.usage) usage = chunk.usage;
    79	      },
    80	      buildMetadata: () => convexGatewayUsageMetadata(usage),
    81	    };
    82	  },
    83	};
    84	
    85	function createGatewayProvider(): Provider {
    86	  return createOpenAICompatible({
    87	    name: "convexGateway",
    88	    baseURL: gatewayBaseURL(),
    89	    fetch: gatewayFetch,
    90	    metadataExtractor: costMetadataExtractor,
    91	    supportsStructuredOutputs: true,
    92	    supportedUrls: () => ({ "image/*": [/^https?:\/\/.*$/] }),
    93	  });
    94	}
    95	
    96	function sdkModelId(
    97	  gatewayModelId: string,
    98	  provider: "anthropic" | "openai",
    99	): string {
   100	  const prefix = `${provider}/`;
   101	  const modelId = gatewayModelId.startsWith(prefix)
   102	    ? gatewayModelId.slice(prefix.length)
   103	    : gatewayModelId;
   104	  // OpenRouter uses dots in Anthropic versions; the Anthropic SDK's capability lookup uses hyphens.
   105	  return provider === "anthropic" ? modelId.replaceAll(".", "-") : modelId;
   106	}
   107	
   108	function gatewayModelFetch(
   109	  gatewayModelId: string,
   110	  input: RequestInfo | URL,
   111	  init?: RequestInit,
   112	): Promise<Response> {
   113	  const body = JSON.parse(init?.body as string);
   114	  body.model = gatewayModelId;
   115	  return gatewayFetch(input, { ...init, body: JSON.stringify(body) });
   116	}
   117	
   118	function gatewayLanguageModel(
   119	  modelId: string,
   120	  model: LanguageModel,
   121	  middleware?: Parameters<typeof wrapLanguageModel>[0]["middleware"],
   122	): GatewayLanguageModel {
   123	  return wrapLanguageModel({
   124	    model,
   125	    modelId,
   126	    // The gateway does not expose the providers' batch APIs.
   127	    middleware: middleware ?? { specificationVersion: "v4" },
   128	  });
   129	}
   130	
   131	/**
   132	 * The recommended model interface for text generation through the Convex AI gateway.
   133	 * Use `messages` or `responses` only for endpoint-specific features.
   134	 *
   135	 * `getServiceToken` caches and refreshes credentials within the current action,
   136	 * so calling this more than once in the same action is fine.
   137	 */
   138	export function convexGateway(modelId: string): ChatModel {
   139	  return createGatewayProvider()(modelId);
   140	}
   141	
   142	convexGateway.messages = function (modelId: string): GatewayLanguageModel {
   143	  const provider = createAnthropic({
   144	    name: "convexGateway.messages",
   145	    baseURL: gatewayBaseURL(),
   146	    authToken: placeholderCredential,
   147	    fetch: (input, init) => gatewayModelFetch(modelId, input, init),
   148	  });
   149	  return gatewayLanguageModel(
   150	    modelId,
   151	    provider.messages(sdkModelId(modelId, "anthropic")),
   152	  );
   153	};
   154	
   155	convexGateway.responses = function (modelId: string): GatewayLanguageModel {
   156	  const provider = createOpenAI({
   157	    name: "convexGateway.responses",
   158	    baseURL: gatewayBaseURL(),
   159	    apiKey: placeholderCredential,
   160	    fetch: (input, init) => gatewayModelFetch(modelId, input, init),
   161	  });
   162	  return gatewayLanguageModel(
   163	    modelId,
   164	    provider.responses(sdkModelId(modelId, "openai")),
   165	    defaultSettingsMiddleware({
   166	      settings: { providerOptions: { openai: { store: false } } },
   167	    }),
   168	  );
   169	};
   170	
   171	/** Evaluate typed questions through the alpha Decisions API. */
   172	convexGateway.evaluationModel = function (modelId: string) {
   173	  return createEvaluationModel(
   174	    modelId,
   175	    gatewayBaseURL("alpha"),
   176	    gatewayFetch,
   177	    convexGatewayUsageMetadata,
   178	  );
   179	};
   180	
   181	convexGateway.embeddingModel = function (modelId: string): EmbeddingModel {
   182	  return wrapEmbeddingModel({
   183	    model: createGatewayProvider().embeddingModel(modelId),
   184	    middleware: {
   185	      specificationVersion: "v4",
   186	      overrideMaxEmbeddingsPerCall: () => maxEmbeddingsPerCall,
   187	    },
   188	  });
   189	};
   190	
   191	/** Image model for the AI SDK's `generateImage`. */
   192	convexGateway.imageModel = function (modelId: string): ImageModel {
   193	  return createGatewayProvider().imageModel(modelId);
   194	};
   195	
   196	/** Video generation for the AI SDK's `experimental_generateVideo`. */
   197	convexGateway.videoModel = function (modelId: string) {
   198	  return createVideoModel(
   199	    modelId,
   200	    gatewayBaseURL(),
   201	    gatewayFetch,
   202	    convexGatewayUsageMetadata,
   203	  );
   204	};
