7:export function record(x:unknown,keys?:string,maximumBytes=1048576):Data {if(keys)exact(x,keys.split(' '),maximumBytes);else {canonical(x,maximumBytes);if(!x||typeof x!=='object'||Array.isArray(x))fail('OBJECT');}return x as Data}
