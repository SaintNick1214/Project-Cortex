t());if(r.observedCostDecimal!==null){const d=str(r.observedCostDecimal,80);if(!/^\d+(?:\.\d+)?$/.test(d))fail('DECIMAL');}if(c.method==='embed'&&[r.rawFinish,r.nativeFinish,r.nativeRawFinish].some(x=>x!==null))fail('FINISH');if(r.usage==='validated-raw-mapped'&&(rc.input===null||rc.output===null||canonical(rc)!==canonical(mc)))fail('USAGE');if(r.lifetime==='validated-provider-terminal'){if(!r.lifetimeProof||!r.responseId||!r.actualModel)fail('TERMINAL');if(c.method!=='embed'){const map:Data={stop:'stop',length:'length',content_filter:'content-filter'};if(r.rawFinish===null||r.nativeRawFinish!==r.rawFinish||map[String(r.rawFinish)]!==r.nativeFinish)fail('TERMINAL');}}else if(r.lifetimeProof!==null)fail('PROOF');if(r.serving==='validated-bound-premises'){if(!r.actualModel||r.actualModel!==r.requestedModel||!r.servingProof)fail('SERVING');}else if(r.servingProof!==null)fail('PROOF');if(r.serving==='drift'&&(r.actualModel===null||r.actualModel===r.requestedModel))fail('DRIFT');if(r.money==='validated-whole-invocation-usd'){if(r.microUSD===null||!r.moneyProof||r.observedCurrency!=='USD'||r.observedCostDecimal===null||!cats.length||micro(String(r.observedCostDecimal))!==r.microUSD)fail('MONEY');}else if(r.microUSD!==null||r.moneyProof!==null)fail('PROOF');if(r.reason==='none'&&(['usage','lifetime','serving','money'].some(k=>r[k]==='unknown')||r.serving==='drift'||r.resultHash===null))fail('REASON');return r as unknown as Receipt}
