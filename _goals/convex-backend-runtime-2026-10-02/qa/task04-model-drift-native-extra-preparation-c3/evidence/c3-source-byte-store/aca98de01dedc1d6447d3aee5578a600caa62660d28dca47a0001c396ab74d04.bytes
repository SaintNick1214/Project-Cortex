/** ROOT-owned management; no selector/partial-state reset, five requests maximum. */
import{readFileSync,lstatSync,readdirSync}from'node:fs';import{resolve}from'node:path';
import{reviewed,reviewPin,canonical,root,scratch,sha256,validateTarget,exclusive}from'./guard.mjs';
import{validateCreatedOwnership}from'./management-contract.mjs';import{ownedResponseBytes}from'./bounded-response.mjs';
import{parseEnv}from'node:util';
const hash=v=>sha256(JSON.stringify(v));
export function managementGuard(mode,request){reviewed();const pin=reviewPin(),requestSHA=sha256(readFileSync(canonical(resolve(root,'project-request.json'),root))),credentials=hash({team:process.env.CONVEX_TEAM_ID??null,token:process.env.CONVEX_TEAM_API_KEY??null}),selectors=hash(Object.fromEntries(['CONVEX_DEPLOY_KEY','CONVEX_DEPLOYMENT','CONVEX_URL','CONVEX_DEPLOYMENT_TOKEN','CONVEX_OVERRIDE_ACCESS_TOKEN','CONVEX_SELF_HOSTED_URL','CONVEX_SELF_HOSTED_ADMIN_KEY'].map(k=>[k,process.env[k]??null])));let expected={};const files=['created-project.json','target.json','deploy.env'];const read=name=>{const p=resolve(scratch,name);return lstatSync(p,{throwIfNoEntry:false})?readFileSync(canonical(p,scratch,true)):undefined;};for(const name of files){const bytes=read(name);expected[name]=bytes?sha256(bytes):undefined;}let keyPath=process.env.CORTEX_QA_TASK04_KEY_CHECK_RECEIPT,keySHA;if(mode==='provision'){if(!keyPath)throw Error('QA_KEY_MATCH');keySHA=sha256(readFileSync(canonical(keyPath,scratch,true)));}
 const check=()=>{reviewed();if(reviewPin()!==pin)throw Error('QA_REVIEW_EXPECTED_PIN_DRIFT');if(sha256(readFileSync(canonical(resolve(root,'project-request.json'),root)))!==requestSHA)throw Error('QA_MANAGEMENT_REQUEST_DRIFT');if(hash({team:process.env.CONVEX_TEAM_ID??null,token:process.env.CONVEX_TEAM_API_KEY??null})!==credentials)throw Error('QA_MANAGEMENT_CREDENTIAL_DRIFT');if(hash(Object.fromEntries(['CONVEX_DEPLOY_KEY','CONVEX_DEPLOYMENT','CONVEX_URL','CONVEX_DEPLOYMENT_TOKEN','CONVEX_OVERRIDE_ACCESS_TOKEN','CONVEX_SELF_HOSTED_URL','CONVEX_SELF_HOSTED_ADMIN_KEY'].map(k=>[k,process.env[k]??null])))!==selectors)throw Error('QA_MANAGEMENT_SELECTOR_DRIFT');for(const name of files){const bytes=read(name);if((bytes?sha256(bytes):undefined)!==expected[name])throw Error('QA_MANAGEMENT_OWNERSHIP_DRIFT');}if(mode==='provision'&&(process.env.CORTEX_QA_TASK04_KEY_CHECK_RECEIPT!==keyPath||sha256(readFileSync(canonical(keyPath,scratch,true)))!==keySHA))throw Error('QA_KEY_MATCH_DRIFT');const own=read('created-project.json');if(own)validateCreatedOwnership(request,JSON.parse(own));const target=read('target.json'),env=read('deploy.env');if(target){if(!env)throw Error('QA_MANAGEMENT_SELECTOR');validateTarget(JSON.parse(target),request,parseEnv(env.toString()),process.env);}else if(env)throw Error('QA_MANAGEMENT_PARTIAL_SELECTOR');};
 const acceptOwned=(name,bytes)=>{if(!files.includes(name)||expected[name]!==undefined)throw Error('QA_MANAGEMENT_OWNERSHIP');const actual=read(name);if(!actual||sha256(actual)!==sha256(bytes))throw Error('QA_MANAGEMENT_OWNERSHIP');expected[name]=sha256(actual);};check();return{check,acceptOwned,pin};}
export function managementOperation(mode,request,guard,totalMs){const deadline=Date.now()+totalMs;let calls=0,dispatched=0,lastStatus,bodyComplete=false;const prefix='management-'+mode+'-';guard.check();if(readdirSync(scratch).some(n=>n.startsWith(prefix)))throw Error('QA_MANAGEMENT_ATTEMPT_EXISTS');const emit=(name,value)=>exclusive(resolve(scratch,prefix+name+'.json'),value,true,1024);emit('attempt',{operation:request.operation,mode,status:'PENDING',observedAt:new Date().toISOString()});
 const api=async(path,method='GET',body)=>{guard.check();if(calls>=5||Date.now()>=deadline)throw Error('QA_MANAGEMENT_CEILING');const sequence=++calls;emit('ticket-'+sequence,{operation:request.operation,mode,sequence,method,observedAt:new Date().toISOString(),status:'CONSUMED_NO_REFUND'});const encoded=body===undefined?undefined:JSON.stringify(body);guard.check();if(Date.now()>=deadline)throw Error('QA_MANAGEMENT_CEILING');const perDeadline=Math.min(deadline,Date.now()+30000);dispatched++;bodyComplete=false;const response=await fetch('https://api.convex.dev/v1'+path,{method,redirect:'error',headers:{Authorization:'Bearer '+process.env.CONVEX_TEAM_API_KEY,'Content-Type':'application/json'},...(encoded===undefined?{}:{body:encoded}),signal:AbortSignal.timeout(Math.max(1,perDeadline-Date.now()))});lastStatus=response.status;const bytes=await ownedResponseBytes(response,16384,perDeadline,{requireBody:true});bodyComplete=true;return{status:response.status,body:bytes.toString('utf8')};};
 const finish=(status,error)=>{const code=error?.message;emit('outcome',{operation:request.operation,mode,status,observedAt:new Date().toISOString(),calls,dispatched,lastStatus:lastStatus??0,bodyComplete,failureClass:status==='FAIL'&&typeof code==='string'&&/^[A-Z_]{1,64}$/.test(code)?code:'management_or_transport'});};return{api,finish,count:()=>calls};}
export function managementJSON(result){if(result.status!==200)throw Error('QA_MANAGEMENT_HTTP');try{return JSON.parse(result.body);}catch{throw Error('QA_MANAGEMENT_JSON');}}
