await test('generate V2 original number correlated private extraction empty actual money',async()=>{const o=await observeGenerate(context(),generate());assert.equal(JSON.parse(o.transcriptCanonical).version,2);assert.equal(o.amountEvidence.extraction,'convex-metadata-cost-correlated-v2');assert(Object.is(o.amountEvidence.cost,number));assert.equal(o.amountEvidence.transcriptDigest,o.receipt.rawDigest);assert.deepEqual(o.amountEvidence.rawUsageEventSequences,[0]);assert.equal(o.receipt.money,'unknown');assert.deepEqual(o.receipt.observedCategories,[]);assert.equal('providerShape'in o.receipt,false);assert.equal(NATIVE_INSTALLATION_ENABLED,false);assert.deepEqual(ACTUAL_PROOFS,[])});
await test('raw mapped mismatches missing amount and stable drift never positive',async()=>{const mismatch=generate();mismatch.providerMetadata.convexGateway.cost=1;const o=await observeGenerate(context(),mismatch);assert.equal(o.receipt.reason,'contradiction');assert.equal(o.amountEvidence,null);for(const x of [generate(),generate()]){if(x===undefined)throw Error('unreachable');}const rawOnly=generate();delete rawOnly.providerMetadata;assert.equal((await observeGenerate(context(),rawOnly)).amountEvidence,null);const mappedOnly=generate();delete mappedOnly.response.body.usage.cost;assert.equal((await observeGenerate(context(),mappedOnly)).amountEvidence,null);const drift=generate();drift.response.modelId='foreign';drift.response.body.model='foreign';const d=await observeGenerate(context(),drift);assert.equal(d.receipt.serving,'drift');assert.equal(d.receipt.money,'unknown');assert.equal(d.amountEvidence.actualModel,'foreign');const idbad=generate();idbad.response.id='foreign';assert.equal((await observeGenerate(context(),idbad)).receipt.reason,'contradiction')});
await test('stream finish maps original raw cost before nativefinish with one raw identity',async()=>{const p=await parts(),e=await events(p),o=await observeStream(context('C09'),e,'reader-done',undefined,2);assert(Object.is(o.amountEvidence.cost,number));assert.deepEqual(o.amountEvidence.rawUsageEventSequences,[4]);assert.equal(o.amountEvidence.providerEventSequence,6);assert.equal(o.eligible[0].rawPartDigest,e[0].digest);const old=await makeEvent(0,'raw',p[0].rawValue);assert.equal(old.digest,e[0].digest);assert.equal(o.receipt.money,'unknown')});
await test('missing final mapped cost cannot reuse previous raw amount',async()=>{const p=await parts();delete p.at(-1).providerMetadata;const o=await stream(p);assert.equal(o.amountEvidence,null);assert.equal(o.receipt.money,'unknown');assert.equal(o.receipt.usage,'validated-raw-mapped')});
await test('raw usage-only tail before native finish allowed repeated costs equal',async()=>{const p=await parts();p.splice(5,0,{type:'raw',rawValue:{id:'DUMMY',model,choices:[],usage:{cost:number}}});const o=await stream(p);assert.deepEqual(o.amountEvidence.rawUsageEventSequences,[4,5]);const bad=structuredClone(p);bad[5].rawValue.usage.cost=1;assert.equal((await stream(bad)).receipt.reason,'contradiction')});
await test('postfinish raw secondfinish openempty syntheticflush malformed tuple deny',async()=>{for(const mutate of [p=>p.push(p[4]),p=>p.push(p[6]),p=>p.splice(5,1),p=>{p[4].rawValue.choices[0].finish_reason=null}]){const p=await parts();mutate(p);const o=await stream(p);assert.equal(o.amountEvidence,null);assert.notEqual(o.receipt.reason,'none')}const p=await parts(),e=await events(p);e[6].data.providerShape=[];e[6].digest=await digest(canonical(e[6].data,180000));const o=await observeStream(context('C09'),e,'reader-done',undefined,2);assert.equal(o.receipt.reason,'unsupported');assert.equal(o.amountEvidence,null)});
await test('historicalV1 cannot be relabeled with V2 or enter embed V2',async()=>{const o=await observeGenerate(context(),generate()),tr=JSON.parse(o.transcriptCanonical);const data=tr.events[0].data;delete data.providerCost;delete data.providerShape;tr.events[0].digest=await digest(canonical(data,180000));tr.version=1;const old=await observeTranscript(context(),canonical(tr,180000));assert.equal(old.amountEvidence,null);assert.equal(JSON.parse(old.transcriptCanonical).version,1);tr.version=2;const falseV2=await observeTranscript(context(),canonical(tr,180000));assert.equal(falseV2.receipt.reason,'unsupported');const embed={embeddings:[Array(1536).fill(0)],usage:{tokens:1},response:{body:{id:'DUMMY',model:'openai/text-embedding-3-small',data:[{embedding:Array(1536).fill(0)}],usage:{prompt_tokens:1,cost:number}}}};const eo=await observeEmbed(context('E11'),embed);assert.equal(JSON.parse(eo.transcriptCanonical).version,1);assert.equal(eo.amountEvidence,null);const et=JSON.parse(eo.transcriptCanonical);et.version=2;await assert.rejects(observeTranscript(context('E11'),canonical(et,180000)),/TRANSCRIPT/)});
