  for(const key of keys)if(typeof key!=='string'||!key.isWellFormed()||!('value'in d[key]!)||!d[key]!.enumerable)return {parent:noParent('invalid'),descriptors:null};
  ancestors.add(value);
  return {parent:{state:'record',keys:(keys as string[]).sort()},descriptors:d};
 }catch(error){if(error instanceof Error&&error.message==='GRAPH_LIMIT')throw error;return {parent:noParent('invalid'),descriptors:null}}
}
function freezeSnapshot(x:ProviderSnapshot):ProviderSnapshot{
 const detached=parseCanonical(canonical(x,180000),180000) as unknown as ProviderSnapshot;
 for(const p of detached.providerShape){Object.freeze(p.keys);Object.freeze(p)}
 Object.freeze(detached.providerShape);Object.freeze(detached.providerCost);return Object.freeze(detached);
}
export function selectProviderSnapshot(root:unknown):ProviderSnapshot{
 const seen=new Set<object>(),a=inspectParent(root,seen);
 const b=a.parent.state==='record'?inspectParent(descriptorValue(a.descriptors!,'providerMetadata'),seen):{parent:noParent('invalid'),descriptors:null};
 const c=b.parent.state==='record'?inspectParent(descriptorValue(b.descriptors!,'convexGateway'),seen):{parent:noParent(b.parent.state),descriptors:null};
 let cost:ProviderCost;
 if([a,b,c].some(x=>x.parent.state==='invalid'))cost={state:'invalid',cost:null,reason:'shape'};
