export function factsFold(receipts:Receipt[]):Facts|null {let f:Facts|null=null;for(const r of receipts){if(!f){const {rawDigest,reason,...rest}=r;f={...rest,firstRawDigest:rawDigest,refinementRawDigests:[],stopReason:reason};continue;}for(const k of ['version','evidenceScope','binding','scenarioId','dispatchIdentity','nativeHash','expectedWireHash','method','interface','requestedModel','serving','usage'] as const)same(f[k],r[k]);for(const k of ['responseId','actualModel','rawFinish','nativeFinish','nativeRawFinish','observedCostDecimal','observedCurrency','resultHash','lifetimeProof','servingProof','moneyProof'] as const)if(f[k]!==null)same(f[k],r[k]);for(const side of ['rawCounts','mappedCounts'] as const)for(const k of ['input','output'] as const)if(f[side][k]!==null)same(f[side][k],r[side][k]);if(f.observedCategories.length)same(f.observedCategories,r.observedCategories);if(f.lifetime==='validated-provider-terminal'&&r.lifetime!==f.lifetime)fail('CAPTURE_COLLISION');if(f.money==='validated-whole-invocation-usd'&&(r.money!==f.money||r.microUSD!==f.microUSD))fail('CAPTURE_COLLISION');const upgrade=(f.lifetime==='unknown'&&r.lifetime==='validated-provider-terminal')||(f.money==='unknown'&&r.money==='validated-whole-invocation-usd');if(!upgrade||f.refinementRawDigests.length>=2)fail('CAPTURE_COLLISION');const {rawDigest,reason,...rest}=r;f={...rest,firstRawDigest:f.firstRawDigest,refinementRawDigests:[...f.refinementRawDigests,rawDigest],stopReason:f.stopReason==='none'?reason:f.stopReason};}return f}
export async function trigger(text:string,accountHash:string,b:BindingV2):Promise<TriggerProjection>{const t=record(parseCanonical(text,16384),'domain version accountHash bindingHash triggers');if(t.domain!=='cortex.experiment.trigger-set.v1'||t.version!==1||t.accountHash!==accountHash||t.bindingHash!==await digest(canonical(b)))fail('TRIGGER');const seen=new Set<string>();for(const value of list(t.triggers,2)){const i=record(value,'scenarioId dispatchIdentity trigger stageHash stageIdentityHash stageIdentityCanonical');hash(i.dispatchIdentity);hash(i.stageHash);hash(i.stageIdentityHash);const s=record(parseCanonical(str(i.stageIdentityCanonical,4096),4096),'version scenarioId dispatchIdentity binding partSequence rawPartDigest stageCanonicalHash trigger');if(s.version!==1||!['C09','C10'].includes(String(s.scenarioId))||seen.has(String(s.scenarioId)))fail('TRIGGER');seen.add(String(s.scenarioId));same(binding(s.binding),b);count(s.partSequence,0,511);hash(s.rawPartDigest);same([i.scenarioId,i.dispatchIdentity,i.trigger,i.stageHash],[s.scenarioId,s.dispatchIdentity,s.trigger,s.stageCanonicalHash]);if(i.trigger!==(i.scenarioId==='C09'?'revoke':'cancel')||i.stageIdentityHash!==await digest(String(i.stageIdentityCanonical)))fail('TRIGGER');}same(list(t.triggers,2).map(x=>record(x).scenarioId),['C09','C10'].filter(x=>seen.has(x)));return t as unknown as TriggerProjection}
export async function account(text:string,b:BindingV2,accountHash:string):Promise<Account>{const s=record(parseCanonical(text,524288),'version evidenceScope hypothesis binding retainedTriggerCanonical retainedTriggerSetHash next active reserved known stopped overrun revoked cancelled sourceCurrent profileCurrent proofCurrent windowCurrent attempts');if(s.version!==2||s.evidenceScope!=='actual-experiment-native'||s.hypothesis!==true)fail('SCOPE');same(binding(s.binding),b);for(const k of ['stopped','overrun','revoked','cancelled','sourceCurrent','profileCurrent','proofCurrent','windowCurrent'])bool(s[k]);count(s.next,0,14);count(s.reserved);count(s.known);const t=await trigger(str(s.retainedTriggerCanonical,16384),accountHash,b);if(s.retainedTriggerSetHash!==await digest(String(s.retainedTriggerCanonical)))fail('TRIGGER');let reserved=0,known=0;const active:string[]=[];const attempts=list(s.attempts,14);if(attempts.length!==s.next)fail('STATE');const {ORDER}=await import('./cases.ts');for(let index=0;index<attempts.length;index++){const a=record(attempts[index],'scenarioId dispatchIdentity identityCanonical state checkpoint slotReleased k known firstCapture refinements facts attachment privateCanonical trigger triggerStageHash triggerIdentityHash');if(a.scenarioId!==ORDER[index])fail('ORDER');const c=caseFor(a.scenarioId);const identity=canonical({binding:b,case:c});if(a.identityCanonical!==identity||a.dispatchIdentity!==await digest(identity)||a.k!==c.candidateReservationKMicroUSD||a.checkpoint!==true)fail('STATE');bool(a.slotReleased);one(a.state,['dispatch_pending','inflight','unknown','terminal']);one(a.attachment,['pending','attached','closed']);nullable(a.known,count);const refinements=list(a.refinements,2).map(x=>str(x,8192));const receipts=a.firstCapture===null?[]:[str(a.firstCapture,8192),...refinements].map(x=>receipt(x,b));if(a.firstCapture===null&&refinements.length||a.state==='dispatch_pending'&&a.firstCapture!==null)fail('STATE');for(const retained of receipts)same([retained.scenarioId,retained.dispatchIdentity,retained.nativeHash,retained.expectedWireHash,retained.method,retained.interface,retained.requestedModel],[a.scenarioId,a.dispatchIdentity,c.normalizedNativeRequestHash,c.expectedWireBodyHash,c.method,c.nativeInterface,c.modelId]);const f=factsFold(receipts);same(f,a.facts);if(a.slotReleased!==(f?.lifetime==='validated-provider-terminal')||(a.state==='terminal')!==a.slotReleased||a.known!==(f?.money==='validated-whole-invocation-usd'?f.microUSD:null))fail('STATE');if(a.known===null)reserved=add(reserved,Number(a.k));else known=add(known,Number(a.known));if(!a.slotReleased)active.push(c.scenarioId);if(a.privateCanonical!==null){if(a.attachment!=='attached')fail('PRIVATE');result(c,str(a.privateCanonical,c.conditionalPrivateMaximumBytes));if(!f?.resultHash||await digest(String(a.privateCanonical))!==f.resultHash)fail('PRIVATE');}const item=t.triggers.find(i=>i.scenarioId===a.scenarioId);if(item)same([a.dispatchIdentity,a.trigger,a.triggerStageHash,a.triggerIdentityHash],[item.dispatchIdentity,item.trigger,item.stageHash,item.stageIdentityHash]);else if(a.trigger!=='none'||a.triggerStageHash!==null||a.triggerIdentityHash!==null)fail('TRIGGER');}if(t.triggers.some(i=>i.trigger==='revoke'&&!s.revoked||i.trigger==='cancel'&&!s.cancelled))fail('TRIGGER_CONTROL');if((s.stopped||s.revoked||s.cancelled||!s.sourceCurrent||!s.profileCurrent||!s.proofCurrent||!s.windowCurrent)&&attempts.some(a=>record(a).attachment!=='closed'||record(a).privateCanonical!==null))fail('CLOSED');if(t.triggers.some(i=>!attempts.some(a=>record(a).dispatchIdentity===i.dispatchIdentity)))fail('TRIGGER');if(attempts.some(a=>{const d=record(a);return typeof d.known==='number'&&d.known>Number(d.k)})&&(!s.overrun||!s.stopped))fail('OVERRUN');if(attempts.some(a=>{const f=record(a).facts as Facts|null;return f&&(f.stopReason!=='none'||f.money==='unknown'||f.lifetime==='unknown'||f.serving!=='validated-bound-premises'||f.usage==='unknown')})&&!s.stopped)fail('STOP');if(active.length>1||s.active!==(active[0]??null)||s.reserved!==reserved||s.known!==known)fail('ACCOUNT');return s as unknown as Account}

