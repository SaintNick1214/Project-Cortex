 if(value===null||value===undefined)return {parent:noParent('missing'),descriptors:null};
 if(typeof value!=='object'||Array.isArray(value)||ancestors.has(value))return {parent:noParent('invalid'),descriptors:null};
 try{
  if(![Object.prototype,null].includes(Object.getPrototypeOf(value)))return {parent:noParent('invalid'),descriptors:null};
  const d=Object.getOwnPropertyDescriptors(value),keys=Reflect.ownKeys(d);
