import assert from 'node:assert/strict';
import {selectGenerate,nativeEvent,observeGenerate,observeStream,makeEvent} from '../../../_goals/convex-backend-runtime-2026-10-02/qa/task04-metadata-retention-implementation-c1/fixture/convex/observer.ts';
import {canonical} from '../../../_goals/convex-backend-runtime-2026-10-02/qa/task04-metadata-retention-implementation-c1/fixture/convex/validate.ts';
import {BINDING} from '../../../_goals/convex-backend-runtime-2026-10-02/qa/task04-metadata-retention-implementation-c1/fixture/convex/installed.ts';
const nodes=x=>1+(x&&typeof x==='object'?Object.values(x).reduce((a,b)=>a+nodes(b),0):0);
const context=scenarioId=>({binding:BINDING,scenarioId,dispatchIdentity:'a'.repeat(64),enteredAt:Date.now(),now:Date.now(),originalDeadline:Date.now()+15000,sourceClosureHash:BINDING.installedClosureHash});
const model='openai/gpt-4o-mini',cost=.000001;
const r={content:[{type:'text',text:'DUMMY'}],finishReason:{unified:'stop',raw:'stop'},usage:{inputTokens:{total:1},outputTokens:{total:1}},providerMetadata:{convexGateway:{cost}},response:{id:'DUMMY',modelId:model,body:{id:'DUMMY',model,choices:[{index:0,message:{content:'DUMMY'},finish_reason:'stop'}],usage:{prompt_tokens:1,completion_tokens:1,cost},padding:Array(4050).fill(null)}}};
for(let i=0;i<1000;i++)r.providerMetadata.convexGateway['unused'+i]=null;
const selected=selectGenerate(r);
assert.equal(selected.providerShape[2].keys.length,1001);
assert(Object.isFrozen(selected.providerShape));
assert(nodes(selected)>4096);
assert.throws(()=>canonical(selected,180000),/GRAPH_LIMIT/);
await assert.rejects(observeGenerate(context('C01'),r),/GRAPH_LIMIT/);
const raw=await makeEvent(0,'raw',{id:'DUMMY',model,choices:[],padding:Array(4050).fill(null)});
const finish=await nativeEvent(1,{type:'finish',finishReason:{unified:'stop',raw:'stop'},usage:r.usage,providerMetadata:r.providerMetadata});
assert.equal(finish.data.providerShape[2].keys.length,1001);
assert(nodes({events:[raw,finish]})>4096);
await assert.rejects(observeStream(context('C09'),[raw,finish],'reader-done',undefined,2),/GRAPH_LIMIT/);
console.log(JSON.stringify({finding:'standalone witness constructed before full prospective transcript bounds',generateSelectedNodes:nodes(selected),constructedKeys:1001,streamCombinedNodes:nodes({events:[raw,finish]}),downstreamOverflowDenied:true,actualMoney:'EMPTY'}));
