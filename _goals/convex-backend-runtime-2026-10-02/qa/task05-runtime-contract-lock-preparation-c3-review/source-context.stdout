291: export type BindBudgetArgs = { reference: RuntimeAuthorityReference; operationKey: ModelOperationKey; requestId: string; requestCanonical: string; agentId?: string; agentVersion?: number };
292: /** Task05 calls this helper in ITS native parent mutation. Creates accounts, no envelope double reservation. */
293: export async function bindTrustedBudget(ctx: WriteCtx, args: BindBudgetArgs): Promise<{ runBudgetId: string; runAccountId: Id<"runtimeBudgetAccounts"> }> {
294:   await currentAuthority(ctx, args.reference, args.operationKey); text(args.requestId); decode(args.requestCanonical);
295:   const bindingKey = canonical(["run", args.reference.tenantId, args.reference.memorySpaceId, args.reference.principalId, args.operationKey, args.requestId]);
296:   const runBudgetId = await semanticHash(bindingKey);
297:   const existing = single(await ctx.db.query("runtimeBudgetAccounts").withIndex("by_run", (q) => q.eq("runBudgetId", runBudgetId)).take(2));
298:   if (existing) {
299:     if (!existing.reference || !sameAuthority(existing.reference, args.reference) || existing.scopeKey !== bindingKey || existing.requestCanonical !== args.requestCanonical || existing.agentId !== args.agentId || existing.agentVersion !== args.agentVersion) fail("IDEMPOTENCY_CONFLICT");
300:     return { runBudgetId, runAccountId: existing._id };
301:   }
302:   if ((args.agentId === undefined) !== (args.agentVersion === undefined)) fail("INVALID_INPUT");
303:   if (args.agentId) { text(args.agentId); integer(args.agentVersion!, 1); }
304:   const agent = args.agentId ? { agentId: args.agentId, version: args.agentVersion! } : undefined;
305:   const resolved = await resolveCurrent(ctx, args.reference, args.operationKey, runBudgetId, undefined, undefined, agent);
306:   const now = integer(Date.now());
307:   const start = Math.floor(now / resolved.manifest.budgetWindowMs) * resolved.manifest.budgetWindowMs;
308:   const end = add(start, resolved.manifest.budgetWindowMs);
309:   const tenantScope = canonical(["tenant", args.reference.tenantId]);
310:   let tenant = single(await ctx.db.query("runtimeBudgetAccounts").withIndex("by_scope_current", (q) => q.eq("scopeKey", tenantScope).eq("current", true)).take(2));
311:   if (tenant && (tenant.windowEnd <= now || canonical(tenant.root) !== canonical(resolved.root))) {
312:     balanced(tenant);
313:     if (tenant.reservedUnits || tenant.uncertainUnits || tenant.activeConcurrency || tenant.overrun) fail("BUDGET_EXCEEDED");
314:     // Policy replacement within a window cannot reset money spent.
315:     if (tenant.windowEnd > now) fail("POLICY_DENIED");
316:     await ctx.db.patch("runtimeBudgetAccounts", tenant._id, { current: false, version: add(tenant.version, 1) });
317:     tenant = undefined;
318:   }
319:   await finalActor(ctx, args.reference, args.operationKey);
320:   const counters = { reservedUnits: 0, settledUnits: 0, uncertainUnits: 0, activeConcurrency: 0, overrun: false, current: true, cancelled: false, version: 1, createdAt: now };
321:   const window = { windowId: canonical([args.reference.tenantId, start, end]), windowStart: start, windowEnd: end, currency: "USD" as const, monetaryUnit: "micro-USD" as const, root: resolved.root };
322:   if (!tenant) await ctx.db.insert("runtimeBudgetAccounts", { accountKey: await semanticHash(canonical([tenantScope, start, end])), scopeKey: tenantScope,
323:     kind: "tenant", tenantId: args.reference.tenantId, ...window, ...counters,
324:     limitUnits: resolved.snapshot.limits.tenantBudgetUnits, concurrencyLimit: resolved.snapshot.limits.concurrency });
325:   else if (tenant.limitUnits !== resolved.snapshot.limits.tenantBudgetUnits || tenant.concurrencyLimit !== resolved.snapshot.limits.concurrency) {
326:     // Tenant-wide capacity is the tightest policy seen, never inflated by another operation.
327:     await ctx.db.patch("runtimeBudgetAccounts", tenant._id, { limitUnits: Math.min(tenant.limitUnits, resolved.snapshot.limits.tenantBudgetUnits),
328:       concurrencyLimit: Math.min(tenant.concurrencyLimit, resolved.snapshot.limits.concurrency), version: add(tenant.version, 1) });
329:   }
330:   const runAccountId = await ctx.db.insert("runtimeBudgetAccounts", { accountKey: runBudgetId, scopeKey: bindingKey, kind: "run",
331:     tenantId: args.reference.tenantId, runBudgetId, reference: args.reference, requestCanonical: args.requestCanonical, ...(agent ? { agentId: agent.agentId, agentVersion: agent.version } : {}), ...window, ...counters,
332:     limitUnits: resolved.snapshot.limits.runBudgetUnits, concurrencyLimit: resolved.snapshot.limits.concurrency });
333:   return { runBudgetId, runAccountId };
334: }
