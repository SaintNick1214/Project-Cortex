248: async function currentOperation(ctx: ReadCtx, reference: RuntimeAuthorityReference, operation: Operation, permitCancelled = false) {
249:   if (!sameAuthority(reference, operation.reference)) fail("FORBIDDEN");
250:   await currentAuthority(ctx, reference, operation.operationKey);
251:   await checkSource(ctx, reference, operation.operationKey, operation.source);
252:   if (operation.cancelled && !permitCancelled) fail("RUN_CANCELLED");
253:   const run = await ctx.db.get("runtimeBudgetAccounts", operation.runAccountId);
254:   if (!run || !run.reference || !sameAuthority(run.reference, reference) || run.tenantId !== reference.tenantId || (run.cancelled && !permitCancelled)) fail("FORBIDDEN");
255:   let parentId = operation.parentOperationId;
256:   const visited = new Set<string>([operation._id]);
257:   while (parentId) {
258:     if (visited.has(parentId) || visited.size > 16) fail("FORBIDDEN");
259:     visited.add(parentId);
260:     const parent = await ctx.db.get("runtimeModelOperations", parentId);
261:     if (!parent || !sameAuthority(reference, parent.reference) || parent.runAccountId !== operation.runAccountId || parent.cancelled) fail("FORBIDDEN");
262:     await currentAuthority(ctx, reference, parent.operationKey);
263:     await checkSource(ctx, reference, parent.operationKey, parent.source);
264:     parentId = parent.parentOperationId;
265:   }
266:   const snapshot = snapshotOf(operation);
267:   const current = await resolveCurrent(ctx, reference, operation.operationKey, run.runBudgetId!, operation.source, operation.parentOperationId, run.agentId ? { agentId: run.agentId, version: run.agentVersion! } : undefined);
268:   if (!current.snapshot.allowedModels.includes(snapshot.modelId) || !snapshot.capabilities.every((cap) => current.snapshot.capabilities.includes(cap))
269:     || !current.manifest.qualifications.some((q) => q.receiptId === snapshot.qualificationReceiptId && q.modelId === snapshot.modelId && q.nativeInterface === snapshot.nativeInterface
270:       && q.priceRevision === snapshot.pins.priceRevision && q.boundRevision === snapshot.pins.boundRevision)) fail("POLICY_DENIED");
271:   return { snapshot, run, current };
272: }
273: function balanced(account: Account): void {
274:   [account.limitUnits, account.reservedUnits, account.settledUnits, account.uncertainUnits, account.activeConcurrency, account.concurrencyLimit, account.version].forEach((value) => integer(value));
275:   add(account.reservedUnits, account.settledUnits, account.uncertainUnits);
276: }
277: function capacity(account: Account, ceiling: number, limit = account.limitUnits, concurrency = account.concurrencyLimit): void {
278:   balanced(account);
279:   if (!account.current || account.cancelled || account.overrun || Date.now() < account.windowStart || Date.now() >= account.windowEnd
280:     || add(account.reservedUnits, account.settledUnits, account.uncertainUnits, ceiling) > Math.min(account.limitUnits, integer(limit, 1))
281:     || account.activeConcurrency >= Math.min(account.concurrencyLimit, integer(concurrency, 1))) fail("BUDGET_EXCEEDED");
282: }
283: /** Permit-boundary capacity: the reservation and active slot are already counted. */
284: function heldCapacity(account: Account, limit: number, concurrency: number): void {
285:   balanced(account);
286:   if (!account.current || account.cancelled || account.overrun || Date.now() < account.windowStart || Date.now() >= account.windowEnd
287:     || add(account.reservedUnits, account.settledUnits, account.uncertainUnits) > Math.min(account.limitUnits, integer(limit, 1))
288:     || account.activeConcurrency > Math.min(account.concurrencyLimit, integer(concurrency, 1))) fail("BUDGET_EXCEEDED");
289: }
