186: /**
187:  * Task05 composition hook: selectors are never policy authority. Today executable definitions
188:  * do not exist, so only exact compiled/stored foundation entries are available. Task05 replaces
189:  * this bounded reader with its CURRENT owned immutable executable-definition/version lookup
190:  * (including scope/grant/revocation/source hash), and returns validated narrowed policies.
191:  * All resolve/admit/checkpoint paths use this hook. Scoped administrators register/update
192:  * owned definitions in Task05's native mutation; they cannot attest deployment prices/bounds.
193:  * The future lookup uses this same native db context, without a second run/transcript store.
194:  */
195: export async function readTrustedAgentPolicyVersion(ctx: ReadCtx, reference: RuntimeAuthorityReference,
196:   agent: { agentId: string; version: number }): Promise<TrustedAgentPolicyVersion> {
197:   text(agent.agentId); integer(agent.version, 1);
198:   await currentAuthority(ctx, reference, "agent.respond");
199:   const { manifest, root } = await activeRoot(ctx);
200:   const selected = manifest.policies.filter((policy) => policy.scope === "agent" && policy.tenantId === reference.tenantId
201:     && policy.agentId === agent.agentId && policy.agentVersion === agent.version);
202:   if (!selected.length) fail("CAPABILITY_UNAVAILABLE");
203:   for (const policy of selected) {
204:     const row = single(await ctx.db.query("runtimeModelPolicies").withIndex("by_policy_version", (q) => q.eq("policyId", policy.policyId).eq("version", policy.version)).take(2));
205:     if (!row || !row.active || row.revokedAt !== undefined || row.scope !== "agent" || row.tenantId !== reference.tenantId || row.agentId !== agent.agentId
206:       || row.agentVersion !== agent.version || row.canonical !== canonical(policy) || canonical(row.root) !== canonical(root)) fail("POLICY_DENIED");
207:   }
208:   return { tenantId: reference.tenantId, agent, policies: selected };
209: }
210: async function policies(ctx: ReadCtx, manifest: DeploymentPolicyManifest, root: Root, reference: RuntimeAuthorityReference, key: ModelOperationKey, agent?: { agentId: string; version: number }): Promise<TrustedModelPolicyRecord[]> {
211:   const rows = await ctx.db.query("runtimeModelPolicies").withIndex("by_scope_active", (q) => q.eq("scope", "tenant").eq("tenantId", reference.tenantId).eq("active", true)).take(65);
212:   if (rows.length > 64) fail("POLICY_DENIED");
213:   const agentPolicies = agent ? (await readTrustedAgentPolicyVersion(ctx, reference, agent)).policies : [];
214:   const selected: TrustedModelPolicyRecord[] = [...manifest.policies.filter((policy) => policy.scope === "deployment" && (!policy.operationKey || policy.operationKey === key)),
215:     ...agentPolicies.filter((policy) => !policy.operationKey || policy.operationKey === key)];
216:   for (const row of rows) {
217:     if (row.revokedAt !== undefined || canonical(row.root) !== canonical(root) || !row.actorReference) fail("POLICY_DENIED");
218:     await recheckAuthority(ctx, row.actorReference, { capability: "admin", tenantId: reference.tenantId, memorySpaceId: row.actorReference.memorySpaceId });
219:     const parsed = tenantPolicySchema.safeParse(decode(row.canonical));
220:     if (!parsed.success || parsed.data.policyId !== row.policyId || parsed.data.version !== row.version || parsed.data.tenantId !== reference.tenantId) fail("POLICY_DENIED");
221:     if (parsed.data.override) {
222:       const expected = await semanticHash(canonical([row.actorReference, parsed.data.policyId, parsed.data.version]));
223:       if (parsed.data.override.actorPrincipalId !== row.actorReference.principalId || parsed.data.override.changeRevision !== parsed.data.version || parsed.data.override.authorizationId !== expected) fail("POLICY_DENIED");
224:     }
225:     if (!parsed.data.operationKey || parsed.data.operationKey === key) selected.push(parsed.data);
226:   }
227:   return selected;
228: }
229: function resolutionContext(reference: RuntimeAuthorityReference, key: ModelOperationKey, runBudgetId: string, source?: Source, parentOperationId?: string, agent?: { agentId: string; version: number }): TrustedModelPolicyContext {
230:   return { scope: memoryScope(reference), operationKey: key, runBudgetId, authorizedOverrides: [], ...(agent ? { agent } : {}),
231:     ...(source ? { source: { sourceId: source.sourceId, sourceEventId: source.sourceEventId, sourceRevision: source.sourceRevision } } : {}),
232:     ...(parentOperationId ? { parentOperationId } : {}), ...(key.startsWith("embedding.") ? { semanticProfile: DEFAULT_EMBEDDING_PROFILE } : {}) };
