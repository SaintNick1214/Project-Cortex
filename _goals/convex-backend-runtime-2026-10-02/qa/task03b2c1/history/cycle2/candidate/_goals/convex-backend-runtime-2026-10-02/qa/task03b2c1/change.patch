+      if (item === undefined) delete row[name]; else row[name] = structuredClone(item);
+    }
+    this.writes.push({ action: "patch", table, id }); this.attempts.push({ action: "patch", table, id }); this.hook?.({ action: "patch", table, id });
+  }
