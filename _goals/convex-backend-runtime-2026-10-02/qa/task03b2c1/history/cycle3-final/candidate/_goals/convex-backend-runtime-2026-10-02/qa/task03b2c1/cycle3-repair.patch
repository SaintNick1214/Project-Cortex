+
+describe("cycle3 private error output admission", () => {
+  const errors = [
+    { name: "startStreaming", branch: "state", state: "paused", code: "INVALID_STATE_TRANSITION" },
+    { name: "appendContent", branch: "state", state: "paused", code: "INVALID_STATE_TRANSITION" },
+    { name: "pauseStreaming", branch: "state", state: "paused", code: "INVALID_STATE_TRANSITION" },
+    { name: "resumeStreaming", branch: "state", state: "draft", code: "INVALID_STATE_TRANSITION" },
+    { name: "cancelStreaming", branch: "state", state: "error", code: "INVALID_STATE_TRANSITION" },
+    { name: "finalizeStreaming", branch: "state", state: "draft", code: "INVALID_STATE_TRANSITION" },
+    { name: "setStreamingError", branch: "state", state: "final", code: "INVALID_STATE_TRANSITION" },
+    { name: "retryFromError", branch: "state", state: "paused", code: "INVALID_STATE_TRANSITION" },
+    { name: "setStreamingState", branch: "state", state: "final", code: "INVALID_STATE_TRANSITION" },
+    ...["appendContent", "pauseStreaming", "resumeStreaming", "cancelStreaming", "finalizeStreaming", "setStreamingError"]
+      .map((name) => ({ name, branch: "session", state: name === "resumeStreaming" ? "paused" : "streaming", code: "STREAMING_SESSION_INVALID" })),
+    { name: "cancelStreaming", branch: "missing-session", state: "streaming", code: "STREAMING_SESSION_INVALID" },
+  ];
+  for (const read of ["absent", "scope-owner-denied", "resource-admitted"] as const) {
+    test.each(errors)(`${read} $name $branch error contains only a safe typed code and no stored details`, async ({ name, branch, state, code }) => {
+      const f = fixture(["write"], "space");
+      if (read !== "absent") f.db.add("runtimeAuthGrants", { principalId: f.principal._id, membershipId: f.membership._id,
+        tenantId: "tenant-a", tenantEpoch: 1, capabilities: ["read"], resourceAccess: read === "scope-owner-denied" ? "own" : "tenant", version: 1 });
+      const row = f.row({ ownerPrincipalId: "other-canonical-owner", content: "unread canonical content", streamingState: state,
+        streamingMetadata: { ...(branch === "missing-session" ? {} : { sessionId: "unread canonical session" }),
+          startedAt: 1, bytesReceived: 7, errorMessage: "unread canonical error" },
+        metadata: { storedConfig: "unread canonical configuration" } });
+      if (read === "resource-admitted") {
+        expect((await f.invoke("get", { artifactId: "artifact-a", memorySpaceId: "space-a" })).content).toBe(row.content);
+      } else {
+        await expect(f.invoke("get", { artifactId: "artifact-a", memorySpaceId: "space-a" }))
+          .rejects.toMatchObject({ data: { code: "FORBIDDEN" } });
+      }
+      const identity = jest.spyOn(f.ctx.auth, "getUserIdentity");
+      let caught: { data?: unknown } | undefined;
+      try {
+        await f.invoke(name, { artifactId: "artifact-a", memorySpaceId: "space-a", sessionId: "caller guess", chunk: "caller chunk",
+          errorCode: "caller-error", errorMessage: "caller error", streamingState: "paused" }).catch((error) => { caught = error; });
+        expect(caught?.data).toEqual({ code, message: "Artifact operation denied." });
+        const output = JSON.stringify(caught?.data);
+        for (const privateValue of [row._id, row.content, "unread canonical session", "unread canonical error", "unread canonical configuration", state]) {
+          expect(output).not.toContain(privateValue);
+        }
+        // WRITE and initially independent READ are the only identity admissions.
+        // The error boundary does not acquire READ or retry a denied READ.
+        expect(identity).toHaveBeenCalledTimes(2);
+        expect(f.db.attempts).toEqual([]); expect(f.db.writes).toEqual([]);
+      } finally { identity.mockRestore(); }
+    });
+    test.each(["undo", "redo", "purgeVersions"] as const)(`${read} %s static availability error preserves its existing code and zero effects`, async (name) => {
+      const f = fixture(["write"], "space");
+      if (read !== "absent") f.db.add("runtimeAuthGrants", { principalId: f.principal._id, membershipId: f.membership._id,
+        tenantId: "tenant-a", tenantEpoch: 1, capabilities: ["read"], resourceAccess: read === "scope-owner-denied" ? "own" : "tenant", version: 1 });
+      f.row({ ownerPrincipalId: "other-canonical-owner", versionPointer: name === "undo" ? 1 : 2 });
+      const code = name === "undo" ? "UNDO_NOT_AVAILABLE" : name === "redo" ? "REDO_NOT_AVAILABLE" : "INVALID_ARGUMENT";
+      await expect(f.invoke(name, { artifactId: "artifact-a", keepLatest: 0 })).rejects.toMatchObject({ data: name === "purgeVersions"
+        ? { code, message: "Artifact operation denied." } : code });
+      expect(f.db.attempts).toEqual([]); expect(f.db.writes).toEqual([]);
+    });
+  }
+  test.each([...selected, "purgeAll"])("native %s unexpected database error hides row/config/document details", async (name) => {
+    const f = happyCase(name === "purgeAll" ? "get" : name as typeof selected[number]);
+    let injections = 0;
+    f.db.hook = (event) => { if (event.action === "query" && event.table === "artifacts") {
+      injections += 1;
+      throw new Error(`Database diagnostic: ${f.db.rows("artifacts")[0]?._id ?? "internal-document"}; unread stored content/configuration`);
+    } };
+    await expect(f.invoke(name, name === "purgeAll" ? { tenantId: "tenant-a", memorySpaceId: "space-a" } : f.args))
+      .rejects.toHaveProperty("data", { version: 1, code: "BACKEND_OPERATION_FAILED", message: "Artifact operation failed.", retryable: false, outcome: "not_committed" });
+    expect(injections).toBe(1); expect(f.db.attempts).toEqual([]); expect(f.db.writes).toEqual([]);
+  });
+  test.each(["recognized-code", "authority-code-with-diagnostics", "unknown-code", "string-payload"] as const)("unexpected native ConvexError %s cannot return stored private payload", async (kind) => {
+    const { ConvexError } = await import("convex/values");
+    const f = fixture(["write"], "space"); const row = f.row({ ownerPrincipalId: "other-canonical-owner" });
+    let injections = 0;
+    f.db.hook = (event) => { if (event.action === "query" && event.table === "artifacts") {
+      injections += 1;
+      throw new ConvexError(kind === "string-payload" ? "unread native backend payload" : {
+        code: kind === "recognized-code" ? "STREAMING_SESSION_INVALID" : kind === "authority-code-with-diagnostics" ? "FORBIDDEN" : "unread native backend code",
+        message: "unread native backend payload", expectedSessionId: "unread native session", currentState: "paused", documentId: row._id,
+      });
+    } };
+    await expect(f.invoke("appendContent", { artifactId: "artifact-a", sessionId: "guess", chunk: "caller chunk" }))
+      .rejects.toHaveProperty("data", { version: 1, code: "BACKEND_OPERATION_FAILED", message: "Artifact operation failed.", retryable: false, outcome: "not_committed" });
+    expect(injections).toBe(1); expect(f.db.attempts).toEqual([]); expect(f.db.writes).toEqual([]);
+  });
+  test("unexpected database error after a text effect remains a failure and rolls back", async () => {
+    const f = fixture(["write"], "space"); f.row({ ownerPrincipalId: "other-canonical-owner" }); let injections = 0;
+    f.db.hook = (event) => { if (event.action === "patch") { injections += 1; throw new Error("unread backend row/session/configuration"); } };
+    await expect(f.invoke("update", { artifactId: "artifact-a", content: "rollback" }))
+      .rejects.toHaveProperty("data", { version: 1, code: "BACKEND_OPERATION_FAILED", message: "Artifact operation failed.", retryable: false, outcome: "not_committed" });
+    expect(injections).toBe(1); expect(f.db.attempts).toHaveLength(1);
+    expect(f.db.rows("artifacts")[0].content).toBe("first"); expect(f.db.writes).toEqual([]);
+  });
+});
+
+test("malformed native exception getter remains an opaque backend failure with zero effects", async () => {
+  const { ConvexError } = await import("convex/values"); const f = fixture(["write"], "space"); f.row({ ownerPrincipalId: "other-canonical-owner" });
+  const error = new ConvexError({ code: "FORBIDDEN", message: "unexpected backend" }); let injections = 0; let getterCalls = 0;
+  Object.defineProperty(error, "data", { get: () => { getterCalls += 1; throw new Error("unread native diagnostic"); } });
+  f.db.hook = (event) => { if (event.action === "query" && event.table === "artifacts") { injections += 1; throw error; } };
+  await expect(f.invoke("update", { artifactId: "artifact-a", content: "caller content" })).rejects.toHaveProperty("data", {
+    version: 1, code: "BACKEND_OPERATION_FAILED", message: "Artifact operation failed.", retryable: false, outcome: "not_committed",
+  });
+  expect(injections).toBe(1); expect(getterCalls).toBe(1); expect(f.db.attempts).toEqual([]); expect(f.db.writes).toEqual([]);
+});
