import assert from'node:assert/strict';import *as fs from'node:fs';import *as path from'node:path';import{SourceTextModule,SyntheticModule}from'node:vm';import{context,approval,digest,root,kind}from'./dispatch-context.mjs';
const results=[];async function prepared(){const h=await context(),request=JSON.parse(fs.readFileSync(path.resolve(root,'project-request.json')));h.put('project-request.json',request);h.put('divergence.json',{syntheticSha256:'a'.repeat(64)});const f=JSON.parse(fs.readFileSync(path.resolve(h.packet,'runtime-freeze.json')));for(const r of f.files){const b=fs.readFileSync(path.resolve(h.packet,r.path));r.bytes=b.length;r.sha256=digest(b);}h.put('runtime-freeze.json',f);const m=JSON.parse(fs.readFileSync(path.resolve(h.packet,'qa-manifest.json')));for(const r of m.files){const b=fs.readFileSync(path.resolve(h.packet,r.path));r.bytes=b.length;r.sha256=digest(b);}h.put('qa-manifest.json',m);h.review.preservationManifestSHA256=digest(fs.readFileSync(path.resolve(h.packet,'qa-manifest.json')));const a=approval(h);h.env.CORTEX_QA_TASK04_REVIEW_SHA256=digest(fs.readFileSync(a.file));const put=(name,value)=>{const p=path.resolve(h.module.scratch,name);fs.mkdirSync(path.dirname(p),{recursive:true,mode:0o700});fs.writeFileSync(p,typeof value==='string'?value:JSON.stringify(value)+'\n',{mode:0o600});};const target={...request,requestSha256:digest(JSON.stringify(request)),projectId:99999999,deploymentName:'dummy-owned-qualification',deploymentUrl:'https://dummy-owned-qualification.convex.cloud',isolationVerified:true,active:true,retired:false,deleted:false};const values={CONVEX_DEPLOYMENT:'dev:'+target.deploymentName,CONVEX_DEPLOY_KEY:'dev:'+target.deploymentName+'|DUMMY_NONCREDENTIAL',CONVEX_URL:target.deploymentUrl};put('target.json',target);put('deploy.env',Object.entries(values).map(([k,v])=>k+'='+v).join('\n')+'\n');const generated=['api','server','dataModel'].map(n=>{const p='convex/_generated/'+n+'.ts';put('deploy-synthetic/'+p,'DUMMY');return{path:p,sha256:digest('DUMMY')};});const publication={operation:request.operation,phase:'synthetic',status:'PASS',officialCodegen:true,typecheck:'enable',freezeSha256:digest(fs.readFileSync(path.resolve(h.packet,'runtime-freeze.json'))),bootstrapSha256:'a'.repeat(64),generated};put('publication-synthetic.json',publication);put('qualifier-window.json',{startedAt:new Date().toISOString(),deadlineMs:1200000});h.module.reviewed();h.module.preservationPreflight();const baseline=h.module.livePreflight('synthetic');return{...h,putPrivate:put,baseline,session:{runId:request.runId,...baseline,publicationReceipt:baseline.publication,phase:'synthetic',expectedReviewPin:h.env.CORTEX_QA_TASK04_REVIEW_SHA256,peerCalls:0,peerEffects:0,peerOther:0}};}
const mutate=(h,mode)=>{if(mode==='source')h.put('fixture/module.ts','DUMMY_DRIFT');if(mode==='target')h.putPrivate('target.json',{...h.baseline.target,projectId:99999998});if(mode==='env')h.putPrivate('deploy.env','CONVEX_DEPLOYMENT=dev:dummy-owned-qualification\nCONVEX_DEPLOY_KEY=dev:dummy-owned-qualification|DUMMY_CHANGED\nCONVEX_URL=https://dummy-owned-qualification.convex.cloud\n');if(mode==='publication')h.putPrivate('publication-synthetic.json',{...h.baseline.publication,extra:'DRIFT'});if(mode==='pin')h.env.CORTEX_QA_TASK04_REVIEW_SHA256='0'.repeat(64);if(mode==='window')h.putPrivate('qualifier-window.json',{startedAt:new Date(Date.now()-1200001).toISOString(),deadlineMs:1200000});};
for(const when of['before','after-ticket'])for(const mode of['healthy','source','target','env','publication','pin','window']){const h=await prepared();let fetches=0,tickets=0;const helper=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts/bounded-response.mjs'),'utf8'),{context:h.vmContext});await helper.link(()=>{throw Error('NO_IMPORT');});await helper.evaluate();const guard={...h.module,reserveTicket:async(...args)=>{await h.module.reserveTicket(...args);tickets++;if(when==='after-ticket'&&mode!=='healthy')mutate(h,mode);}};h.vmContext.fetch=async()=>{fetches++;let read=0;return{status:403,body:{getReader(){return{read:async()=>++read===1?{done:false,value:Buffer.from('denied')}:{done:true},cancel:async()=>{},releaseLock(){}};}}};};const peer=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts/peer.mjs'),'utf8'),{context:h.vmContext});await peer.link(n=>{if(n==='./bounded-response.mjs')return helper;const o=n==='./guard.mjs'?guard:{default:assert};return new SyntheticModule(Object.keys(o),function(){for(const[k,v]of Object.entries(o))this.setExport(k,v);},{context:h.vmContext});});await peer.evaluate();if(when==='before'&&mode!=='healthy')mutate(h,mode);let error;try{await peer.namespace.peer(h.session,'DUMMY',undefined,403);}catch(e){error=e;}assert.equal(fetches,mode==='healthy'?1:0);assert.equal(tickets,when==='after-ticket'||mode==='healthy'?1:0);if(mode!=='healthy')assert.ok(error);else assert.equal(error,undefined);results.push({when,mode,fetches,tickets,consumedLateTicketNoRefund:when==='after-ticket'&&mode!=='healthy',error:error?.message??null,status:'PASS'});}
fs.writeFileSync(path.resolve(root,'evidence/c3-peer-dispatch-controls.json'),JSON.stringify({kind,results,scope:'EXACT_GUARD_AND_PEER_DUMMY_TARGET_STREAMS_NO_NETWORK_NATIVE_OR_PRIVATE',sourcePins:['guard.mjs','peer.mjs','bounded-response.mjs'].map(n=>({path:'scripts/'+n,sha256:digest(fs.readFileSync(path.resolve(root,'scripts',n)))}))},null,2)+'\n');console.log(kind+' '+results.length+' peer dispatch controls PASS');
