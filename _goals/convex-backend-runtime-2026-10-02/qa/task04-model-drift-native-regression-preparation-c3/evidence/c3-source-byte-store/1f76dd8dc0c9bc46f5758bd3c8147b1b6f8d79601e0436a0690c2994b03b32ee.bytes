import {build}from'esbuild';import{readFileSync,writeFileSync,cpSync,statSync}from'node:fs';import{resolve,relative}from'node:path';import{createHash}from'node:crypto';
const repo='/workspace/Project-Cortex',root=resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-extra-preparation-c3'),digest=b=>createHash('sha256').update(b).digest('hex');
cpSync(resolve(root,'fixture/convex/runtimeModelPolicyBootstrap.ts'),resolve(root,'runtime-source/convex/runtimeModelPolicyBootstrap.ts'));cpSync(resolve(root,'fixture/convex/_generated'),resolve(root,'runtime-source/convex/_generated'),{recursive:true});
const all=[];for(const[name,entry]of[['gateway',resolve(root,'runtime-source/convex/runtimeGateway.ts')],['semantic-profile',resolve(root,'runtime-source/src/domain/profile.ts')]]){
 const options={entryPoints:[entry],bundle:true,platform:'node',format:'esm',metafile:true,write:false,logLevel:'silent',banner:{js:'import { createRequire as capsuleCreateRequire } from "node:module"; const require = capsuleCreateRequire(import.meta.url);'},outfile:resolve(root,'runtime/'+name+'.mjs')};const first=await build(options),second=await build(options);if(digest(first.outputFiles[0].contents)!==digest(second.outputFiles[0].contents))throw Error('NONDETERMINISTIC_RUNTIME_BUNDLE');writeFileSync(options.outfile,first.outputFiles[0].contents);writeFileSync(resolve(root,'runtime/'+name+'.metafile.json'),JSON.stringify(first.metafile,null,2)+'\n');
 for(const path of Object.keys(first.metafile.inputs)){const source=resolve(repo,path),bytes=readFileSync(source);all.push({path:relative(repo,source),bytes:bytes.length,sha256:digest(bytes)});}
}
const unique=[...new Map(all.map(row=>[row.path,row])).values()].sort((a,b)=>a.path.localeCompare(b.path));writeFileSync(resolve(root,'dependency-inventory.json'),JSON.stringify({status:'SOURCE_BOUND_DETERMINISTIC_COMPILED_CAPSULE; actual native NOT_RUN',inputs:unique,loader:'ROOT-only compiled ESM; no fake accounting sink/no Jest alias; package dependencies fully bundled, builtin node imports only',files:['runtime/gateway.mjs','runtime/semantic-profile.mjs'].map(path=>({path,bytes:statSync(resolve(root,path)).size,sha256:digest(readFileSync(resolve(root,path)))}))},null,2)+'\n');console.log(JSON.stringify({compiledInputs:unique.length,deterministic:true}));
