import{readFileSync,writeFileSync,readdirSync}from'node:fs';import{resolve}from'node:path';import{pathToFileURL}from'node:url';import{performance}from'node:perf_hooks';
const repo='/workspace/Project-Cortex';for(const kind of['extension','regression','extra']){const root=resolve(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+kind+'-preparation-c3'),guard=await import(pathToFileURL(resolve(root,'scripts/guard.mjs'))),walk=(dir=root,prefix='')=>readdirSync(dir,{withFileTypes:true}).flatMap(entry=>{const path=prefix+entry.name;if(entry.isDirectory())return ['scripts','fixture','runtime','runtime-source'].includes(path.split('/')[0])?walk(resolve(dir,entry.name),path+'/'):[];return ['scripts/','fixture/','runtime/','runtime-source/'].some(p=>path.startsWith(p))||guard.runtimeRootInputs.includes(path)?[path]:[];}).sort();const json=name=>JSON.parse(readFileSync(resolve(root,name)));const rows=[...walk().map(path=>resolve(root,path)),...json('source-inventory.json').acceptedGateHashes.map(r=>resolve(repo,r.path)),...json('source-inventory.json').files.filter(r=>r.kind!=='baseline-generated-not-native-codegen').map(r=>resolve(repo,r.source)),...json('toolchain-evidence.json').files.map(r=>resolve(repo,r.path)),...json('runner-dependency-inventory.json').inputs.map(r=>resolve(repo,r.path)),...(kind==='extra'?json('dependency-inventory.json').inputs.map(r=>resolve(repo,r.path)):[])];let bytes=0;const samples=[];for(let n=0;n<5;n++){const before=performance.now();for(const path of rows){const body=readFileSync(guard.canonical(path,repo));guard.sha256(body);if(n===0)bytes+=body.length;}samples.push(performance.now()-before);}const result={scope:'EXACT_CONCRETE_CANDIDATE_RUNTIME_INPUT_READ_CANONICAL_HASH_WARM_FILESYSTEM_ONLY_NO_FREEZE_OR_NATIVE',rowsWithRepeatedChecks:rows.length,bytesPerCheck:bytes,samplesMs:samples,maxMs:Math.max(...samples),projected2924CallsMs:2924*Math.max(...samples),sourceFreeze:'NOT_CREATED_CALIBRATION_INPUT_LIST_ONLY',limitations:'Warm local measurements, not native network/SDK/server throughput. Deadlines fail closed; no max-latency success guarantee, no cache substituted for later native perRPC checks.',native:'NOT_RUN'};writeFileSync(resolve(root,'evidence/source-calibration.json'),JSON.stringify(result,null,2)+'\n');writeFileSync(resolve(root,'evidence/source-calibration-source.mjs.text'),readFileSync(new URL(import.meta.url)));console.log(kind+' '+result.rowsWithRepeatedChecks+' rows max '+result.maxMs.toFixed(2)+'ms');}
