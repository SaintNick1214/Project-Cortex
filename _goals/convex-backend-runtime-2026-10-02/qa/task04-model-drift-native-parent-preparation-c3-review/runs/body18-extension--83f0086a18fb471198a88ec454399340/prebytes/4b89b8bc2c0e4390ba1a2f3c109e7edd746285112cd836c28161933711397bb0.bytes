/** Complete crash-boundary liability witness over one native whole-state snapshot. */
import assert from 'node:assert/strict';
export function assertFaultLedger(rows,input,stage){assert.ok(['parent-killed','unknown-recovered','known-settled'].includes(stage));const find=(table,id)=>{const matches=rows.filter(row=>row.table===table&&row.id===id);assert.equal(matches.length,1);return matches[0].row;};const attempt=find('runtimeModelAttempts',input.attemptId);const operation=find('runtimeModelOperations',attempt.operationDocumentId);const run=find('runtimeBudgetAccounts',attempt.runAccountId),tenant=find('runtimeBudgetAccounts',attempt.tenantAccountId);assert.equal(run.kind,'run');assert.equal(tenant.kind,'tenant');assert.notEqual(attempt.runAccountId,attempt.tenantAccountId);assert.equal(operation.runAccountId,attempt.runAccountId);for(const row of [operation,run,tenant])assert.equal(row.tenantId,input.reference.tenantId);assert.equal(operation.memorySpaceId,input.reference.memorySpaceId);assert.equal(attempt.reservationUnits,100);const known=stage==='known-settled',unknown=stage==='unknown-recovered';assert.equal(attempt.state,known?'settled':unknown?'uncertain':'dispatch_pending');assert.equal(attempt.slotReleased,known);assert.equal(attempt.settledCostUnits,known?40:undefined);if(unknown)assert.equal(attempt.resultWithheld,true);const money={reservedUnits:known||unknown?0:100,uncertainUnits:unknown?100:0,settledUnits:known?40:0};for(const row of [operation,run,tenant]){for(const[key,value]of Object.entries(money))assert.equal(row[key],value,stage+' '+key);assert.equal(row.overrun,false);}for(const row of [run,tenant])assert.equal(row.activeConcurrency,known?0:1,stage+' activeConcurrency');return {stage,reservedUnits:money.reservedUnits,uncertainUnits:money.uncertainUnits,settledUnits:money.settledUnits,activeConcurrency:known?0:1,attempts:1,operations:1,accounts:2};}
