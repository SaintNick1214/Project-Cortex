/** Credential-free safe receipt/hash-chain reconciliation. Does not infer acceptance. */
import assert from 'node:assert/strict';import {readFileSync,readdirSync} from 'node:fs';import {resolve} from 'node:path';import {sha256,safeReceipt,limits} from './guard.mjs';
export function reconcile(directory){let count=0,bytes=0;const phases=new Map();for(const name of readdirSync(directory).filter(n=>/^journal-.*\.jsonl$/.test(n))){const text=readFileSync(resolve(directory,name),'utf8');assert.ok(text.endsWith('\n'),'partial journal retained; new recovery segment required');let previous='0'.repeat(64),sequence=0;for(const line of text.trimEnd().split('\n')){assert.ok(Buffer.byteLength(line)<=limits.journalBytes+128);const row=JSON.parse(line),digest=row.receiptDigest;delete row.receiptDigest;safeReceipt(row);assert.equal(row.sequence,++sequence);assert.equal(row.previousDigest,previous);assert.equal(digest,sha256(JSON.stringify(row)));previous=digest;count++;bytes+=Buffer.byteLength(line);if(row.phase==='case')phases.set(row.caseId,row.status);}}
 assert.ok(count<=limits.journalRows&&bytes<=limits.evidenceBytes);return {journalRows:count,bytes,caseOutcomes:Object.fromEntries(phases)};}
if(process.argv[1]?.endsWith('reconcile.mjs'))process.stdout.write(JSON.stringify(reconcile(process.argv[2]))+'\n');
