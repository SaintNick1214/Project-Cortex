import fs from'node:fs';import path from'node:path';import vm from'node:vm';import assert from'node:assert/strict';import crypto from'node:crypto';import{fileURLToPath,pathToFileURL}from'node:url';const rows=[];
for(const profile of['extension','regression','extra'])for(const launch of['import','exact','other']){const p=path.resolve('_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+profile+'-preparation-c3/scripts/task04-native-c8-parent-inputs.mjs'),source=fs.readFileSync(p,'utf8');let effects=0;const main=async()=>{effects++;},context=vm.createContext({process:{argv:launch==='import'?[]:['node',launch==='exact'?p:'/DUMMY_OTHER']}}),m=new vm.SourceTextModule(source,{context,initializeImportMeta:meta=>meta.url=pathToFileURL(p).href});await m.link(spec=>{const obj=spec==='./parent-inputs.mjs'?{main,profileContract:{DUMMY:profile}}:spec==='node:url'?{fileURLToPath}:spec==='node:path'?{resolve:path.resolve}:undefined;assert.ok(obj);return new vm.SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context});});await m.evaluate();assert.equal(m.namespace.main,main);assert.equal(effects,launch==='exact'?1:0);rows.push({profile,launch,effects,status:'PASS',sourceSHA256:crypto.createHash('sha256').update(source).digest('hex')});}
fs.writeFileSync(process.argv[2],JSON.stringify({status:'PASS',defined:rows.length,rows,privateReads:0,native:'NOT_RUN'},null,2)+'\n');console.log(JSON.stringify({status:'PASS',defined:rows.length}));
