import fs from'node:fs';import path from'node:path';import vm from'node:vm';import assert from'node:assert/strict';import crypto from'node:crypto';
const repo=process.cwd(),out=process.argv[2],rows=[],hash=x=>crypto.createHash('sha256').update(x).digest('hex');
for(const profile of['extension','regression','extra']){
 const dir=path.join(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+profile+'-preparation-c3/scripts');let clock=1000;const context=vm.createContext({Buffer,AbortSignal,Date:class extends Date{static now(){return clock;}},setTimeout,clearTimeout});const sources=new Map();
 const modules=new Map();async function load(name){if(modules.has(name))return modules.get(name);const source=fs.readFileSync(path.join(dir,name),'utf8');sources.set(name,hash(source));const m=new vm.SourceTextModule(source,{context,identifier:name});modules.set(name,m);await m.link(async spec=>{if(spec==='./bounded-response.mjs')return load('bounded-response.mjs');if(spec==='./publication-contract.mjs')return load('publication-contract.mjs');const obj=spec==='./guard.mjs'?{limits:{rpcMs:12000,resultBytes:256000},root:'DUMMY',scratch:'DUMMY',repo,json(){throw Error('NO_PRIVATE');},canonical(){throw Error('NO_PRIVATE');},sha256:hash,reserveTicket(){throw Error('NO_EFFECT');},livePreflight(){throw Error('NO_LIVE');},qualifierDeadline(){throw Error('NO_WINDOW');},reviewPin(){throw Error('NO_PIN');}}:await import(spec);return new vm.SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context});});return m;}
 const helper=await load('bounded-response.mjs'),peer=await load('peer.mjs'),pub=await load('publication-artifacts.mjs');await helper.evaluate();await peer.evaluate();await pub.evaluate();
 for(const [entry,max,call]of[['peer',7,(r,d)=>peer.namespace.boundedBody(r,7,d)],['publication',256000,(r,d)=>pub.namespace.boundedRawResponse(r,d)],['management',16384,(r,d)=>helper.namespace.ownedResponseBytes(r,16384,d,{requireBody:true})]])for(const mode of['exact-two-chunks','over-one','read-primary-cleanup-secondary','entry-expired','late-done','invalid-chunk','cleanup-deadline','real-read-deadline','release-primary']){
  clock=1000;let reads=0,cancels=0,releases=0,caught,value;const primary=Error('DUMMY_READ'),secondary=Error('DUMMY_CLEANUP');const deadline=mode==='entry-expired'?999:mode.includes('deadline')?1005:2000;const data=Buffer.alloc(max);const reader={async read(){reads++;if(mode==='read-primary-cleanup-secondary'||mode==='cleanup-deadline')throw primary;if(mode==='real-read-deadline')await new Promise(d=>setTimeout(d,25));if(mode==='late-done'){clock=2001;return{done:true};}if(mode==='invalid-chunk')return{done:false,value:'DUMMY_INVALID'};if(mode==='exact-two-chunks')return reads===3?{done:true}:{done:false,value:reads===1?data.subarray(0,max>>1):data.subarray(max>>1)};if(mode==='over-one')return{done:false,value:Buffer.alloc(max+1)};return{done:true};},async cancel(){cancels++;if(mode==='cleanup-deadline')await new Promise(()=>{});if(mode==='read-primary-cleanup-secondary')throw secondary;},releaseLock(){releases++;if(mode==='read-primary-cleanup-secondary'||mode==='release-primary')throw secondary;}};
  try{value=await call({body:{getReader:()=>reader}},deadline);}catch(e){caught=e;}
  if(mode==='exact-two-chunks'){assert.equal(caught,undefined);assert.equal(value.length,max);assert.equal(reads,3);assert.equal(cancels,0);}else{assert.ok(caught);if(mode==='over-one')assert.equal(caught.message,'QA_RESPONSE_CEILING');if(mode==='read-primary-cleanup-secondary'){assert.equal(caught,primary);assert.equal(caught.qaBodyCancelFailure,secondary);assert.equal(caught.qaBodyReleaseFailure,secondary);}if(mode==='entry-expired'){assert.equal(reads,0);assert.equal(cancels,1);}if(mode==='cleanup-deadline'){assert.equal(caught,primary);assert.equal(caught.qaBodyCancelFailure.message,'QA_RESPONSE_DEADLINE');}if(mode==='real-read-deadline')assert.equal(caught.message,'QA_RESPONSE_DEADLINE');if(mode==='release-primary'){assert.equal(caught,secondary);assert.equal(cancels,0);}}
  assert.equal(releases,1);rows.push({profile,entry,mode,status:'PASS',reads,cancels,releases,sourcePins:Object.fromEntries(sources)});
 }
}
fs.writeFileSync(out,JSON.stringify({status:'PASS',defined:rows.length,skipped:0,rows,native:'NOT_RUN',privateReads:0,network:0},null,2)+'\n');console.log(JSON.stringify({status:'PASS',defined:rows.length,skipped:0}));
