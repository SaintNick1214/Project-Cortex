import fs from'node:fs';import path from'node:path';import vm from'node:vm';import assert from'node:assert/strict';import crypto from'node:crypto';
const[repo,out]=process.argv.slice(2),pin='a'.repeat(64),results=[];
for(const profile of ['extension','regression','extra']){const p=path.join(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+profile+'-preparation-c3/scripts/process-owner.mjs'),source=fs.readFileSync(p,'utf8');async function one(name,opts,deny=false,untrusted=false){let spawns=0,full=0,captured;const context=vm.createContext({process:{env:{CORTEX_QA_TASK04_REVIEW_SHA256:pin,DUMMY_KEEP:'same'},execPath:'/DUMMY-NODE'},setTimeout,clearTimeout,Buffer});const module=new vm.SourceTextModule(source,{context});const mocks={'./guard.mjs':{reviewed:(...args)=>{full++;assert.equal(args.length,0,'defaultFULL');if(untrusted)throw Error('QA_REVIEW_EXPECTED_PIN');},reviewPin:()=>pin},'node:child_process':{spawn:(exe,args,options)=>{spawns++;captured=options;assert.equal(exe,'/DUMMY-NODE');return{once(){}}}},'./process-terminal.mjs':{linuxGroupMembers(){throw Error('NO_REAL_PROCESS');},terminal(){throw Error('NO_REAL_PROCESS');}}};await module.link(async spec=>{const exports=mocks[spec];assert.ok(exports);return new vm.SyntheticModule(Object.keys(exports),function(){for(const[k,v]of Object.entries(exports))this.setExport(k,v)},{context})});await module.evaluate();const owner=new module.namespace.ProcessOwner();if(deny){assert.throws(()=>owner.spawn(['DUMMY'],opts),untrusted?/QA_REVIEW_EXPECTED_PIN/:/QA_CHILD_REVIEW_PIN/);assert.equal(spawns,0);assert.equal(owner.spawned,0);assert.equal(owner.records.size,0);}else{owner.spawn(['DUMMY'],opts);assert.equal(spawns,1);assert.equal(captured.env.CORTEX_QA_TASK04_REVIEW_SHA256,pin);assert.equal(captured.detached,true);if(opts.env)assert.equal(captured.env.DUMMY_KEEP,opts.env.DUMMY_KEEP);else assert.equal(captured.env.DUMMY_KEEP,'same');}assert.equal(full,1);results.push({profile,name,status:'PASS',spawns,fullCalls:full,sourceSHA256:crypto.createHash('sha256').update(source).digest('hex'),scope:'VM_DUMMY_CHILD_ONLY'});}
await one('inherited-env-pin',{});await one('explicit-env-exact-pin',{env:{CORTEX_QA_TASK04_REVIEW_SHA256:pin,DUMMY_KEEP:'explicit'}});await one('explicit-env-pin-injected',{env:{DUMMY_KEEP:'explicit'}});await one('conflicting-pin-zero-spawn',{env:{CORTEX_QA_TASK04_REVIEW_SHA256:'b'.repeat(64)}},true);await one('untrusted-review-zero-spawn',{},true,true);}
fs.writeFileSync(out,JSON.stringify({status:'PASS',defined:results.length,skipped:0,results,actualProcesses:0,actualNetwork:0},null,2)+'\n');console.log(JSON.stringify({status:'PASS',defined:results.length}));
