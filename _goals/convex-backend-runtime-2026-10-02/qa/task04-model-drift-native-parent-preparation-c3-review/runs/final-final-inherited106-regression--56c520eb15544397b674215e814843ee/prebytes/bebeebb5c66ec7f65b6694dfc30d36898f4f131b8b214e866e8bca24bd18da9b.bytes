from pathlib import Path
import json,hashlib,datetime,sys,subprocess,uuid
r=Path.cwd();w=r/'work/resume/task04-model-drift-native-parent-preparation-c3-review';q=r/'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-parent-preparation-c3-review';name=sys.argv[1];argv=sys.argv[2:];run=q/'runs'/(name+'--'+uuid.uuid4().hex);run.mkdir(parents=True);store=run/'prebytes';store.mkdir();H=lambda b:hashlib.sha256(b).hexdigest();paths=[]
for profile in ['extension','regression','extra']:
 root=r/f'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-{profile}-preparation-c3'
 for row in json.loads((root/'runtime-freeze.json').read_bytes())['files']:paths.append(root/row['path'])
