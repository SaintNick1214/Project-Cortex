(store/'index.json').write_text(json.dumps(pre,indent=2)+'\n');start=datetime.datetime.now(datetime.timezone.utc).isoformat();p=subprocess.run(argv,cwd=r,stdout=subprocess.PIPE,stderr=subprocess.PIPE);end=datetime.datetime.now(datetime.timezone.utc).isoformat();(run/'run.stdout').write_bytes(p.stdout);(run/'run.stderr').write_bytes(p.stderr);post=[dict(path=str(x.relative_to(r)),bytes=x.stat().st_size,sha256=H(x.read_bytes())) for x in paths];(run/'run.receipt.json').write_text(json.dumps(dict(argv=argv,cwd=str(r),startedAt=start,endedAt=end,exitCode=p.returncode,sourceBefore=pre,sourceAfter=post,rawComplete=True,actualPrivateReads=0,actualProcesses=0),indent=2)+'\n');print(json.dumps(dict(name=name,exitCode=p.returncode,stdout=p.stdout.decode()[-450:],stderr=p.stderr.decode()[-500:],archive=str(run.relative_to(r)))));sys.exit(p.returncode)
