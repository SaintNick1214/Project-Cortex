   n=x['function'];left=(src/'scripts/driver.mjs').read_text();right=(c2/'scripts/driver.mjs').read_text();pat=r'export (?:async )?function '+n+r'\(';a=re.search(pat,left).start();b=re.search(pat,right).start();end={'shape':'export async function session','security':'function rawOwnedFailure','qualify':'if(process.argv[1]'}[n];left=left[a:left.index(end,a)];right=right[b:right.index(end,b)];assert left==right and H(left.encode())==x['sha256'];proved.append(x);continue
  b=(src/x['path']).read_bytes();assert b==(c2/x['path']).read_bytes();assert H(b)==x['C3SHA256']==x['C2SHA256'];proved.append(x)
