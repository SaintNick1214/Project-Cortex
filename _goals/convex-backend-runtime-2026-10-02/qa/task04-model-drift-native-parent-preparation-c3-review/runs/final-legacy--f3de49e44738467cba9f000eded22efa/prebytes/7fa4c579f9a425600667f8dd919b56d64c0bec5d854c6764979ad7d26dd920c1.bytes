/** Parent-run observation after verified crash child group termination. */
import {assertFaultLedger} from './fault-ledger.mjs';
import assert from 'node:assert/strict';import {resolve} from 'node:path';import {session} from './driver.mjs';import {scratch,json,exclusive,sha256} from './guard.mjs';
const mode=process.argv[2];if(!['before-peer','lost-receipt','before-settle'].includes(mode))throw Error('QA_FAULT_MODE');const s=await session('synthetic');const input=json(resolve(scratch,'fault-input-'+mode+'.json'),scratch,true),checkpoint=json(resolve(scratch,'fault-checkpoint-'+mode+'.json'),scratch,true),terminal=json(resolve(scratch,'fault-process-'+mode+'.json'),scratch,true);assert.equal(terminal.operation,s.target.operation);assert.equal(terminal.directChildWaited,true);assert.equal(terminal.remaining,0);assert.equal(terminal.parentForcedKill,true);
assert.equal(input.operation,s.target.operation);assert.equal(input.runId,s.runId);assert.equal(input.mode,mode);const boundary=assertFaultLedger(await s.rpc('query','qualificationOwned:snapshot',{run:s.runId}),input,'parent-killed');s.journal.append({phase:'fault',caseId:mode+'-parent-killed',status:'PASS',observedCategory:'full-liability-and-slot',counts:{reservedUnits:boundary.reservedUnits,uncertainUnits:boundary.uncertainUnits,settledUnits:boundary.settledUnits,activeConcurrency:boundary.activeConcurrency}});
const args={reference:input.reference,attemptId:input.attemptId};const counter=await s.rpc('query','qualificationPeer:counter',{run:s.runId,dispatchDigest:sha256(checkpoint.dispatchIdentity)});assert.deepEqual(counter,{requestCount:mode==='before-peer'?0:1,effectCount:mode==='before-peer'?0:1});
const recovered=await s.rpc('mutation','runtimeModelPolicy:recover',args);assert.equal(recovered.state,'uncertain');assert.equal(recovered.replayAllowed,false);const permit=await s.rpc('mutation','runtimeModelPolicy:checkpoint',{...args,requestCanonical:input.requestCanonical});assert.equal(permit.dispatchPermit,false);const unknown=assertFaultLedger(await s.rpc('query','qualificationOwned:snapshot',{run:s.runId}),input,'unknown-recovered');s.journal.append({phase:'fault',caseId:mode+'-unknown-recovered',status:'PASS',observedCategory:'full-liability-and-slot',counts:{reservedUnits:unknown.reservedUnits,uncertainUnits:unknown.uncertainUnits,settledUnits:unknown.settledUnits,activeConcurrency:unknown.activeConcurrency}});
if(mode==='before-settle'){const receipt=json(resolve(scratch,'fault-synthetic-bookkeeping-before-settle.json'),scratch,true);assert.equal(receipt.classification,'fixture-synthetic-no-provider-terminal-proof');const results=await Promise.all([s.rpc('mutation','runtimeModelPolicy:settle',{...args,receiptCanonical:receipt.receiptCanonical}),s.rpc('mutation','runtimeModelPolicy:settle',{...args,receiptCanonical:receipt.receiptCanonical})]);assert.ok(results.every(r=>r.settledCostUnits===40));const rows=await s.rpc('query','qualificationOwned:snapshot',{run:s.runId});const known=assertFaultLedger(rows,input,'known-settled');s.journal.append({phase:'fault',caseId:mode+'-known-settled',status:'PASS',observedCategory:'full-liability-and-slot',counts:{reservedUnits:known.reservedUnits,uncertainUnits:known.uncertainUnits,settledUnits:known.settledUnits,activeConcurrency:known.activeConcurrency}});}
assert.deepEqual(await s.rpc('query','qualificationPeer:counter',{run:s.runId,dispatchDigest:sha256(checkpoint.dispatchIdentity)}),counter);s.journal.append({phase:'fault',caseId:mode,status:'PASS',observedCategory:'real-peer-crash-accounting',counts:counter});s.close();exclusive(resolve(scratch,'fault-result-'+mode+'.json'),{operation:s.target.operation,mode,status:'PASS',counts:counter,boundary,unknown,actualInference:'NOT_RUN',chargeEvidence:'SYNTHETIC_ONLY'});
