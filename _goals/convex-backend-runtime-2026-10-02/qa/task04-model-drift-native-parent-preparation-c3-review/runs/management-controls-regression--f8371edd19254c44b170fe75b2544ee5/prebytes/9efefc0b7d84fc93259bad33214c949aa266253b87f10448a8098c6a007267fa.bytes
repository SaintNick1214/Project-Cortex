/** Parent-only C8 finite watcher: no RPC, signing, storage, network or model calls. */
import assert from 'node:assert/strict';
import {readFileSync,readdirSync} from 'node:fs';
import {resolve} from 'node:path';
import {fileURLToPath} from 'node:url';
import {root,scratch,json,exclusive,sha256,canonical,preservationPreflight} from './guard.mjs';
import {argumentsFor} from './arguments.mjs';
import {currentTarget,historicalEvidence,validateHistoricalInputs,exactKeys,boundedId,readPrivate} from './task04-native-c8-parent-inputs.mjs';

export async function main(){const deadline=Date.now()+120000;preservationPreflight();if(Date.now()>=deadline)throw Error('CURRENT_NATIVE_ID_TOTAL_TIME_BUDGET');if(process.argv[2]!==undefined)assert.equal(process.argv[2],'task04-model-drift-native-extension-preparation-c1','PARENT_CANDIDATE');const {target,identity}=currentTarget('synthetic');const historyPath=resolve(scratch,'historical-native-locators.json'),proofPath=resolve(scratch,'initial-physical-id-provenance.json'),historyBytes=readPrivate(historyPath,scratch),proofBytes=readPrivate(proofPath,scratch),history=JSON.parse(historyBytes),initial=JSON.parse(proofBytes),evidence=historicalEvidence();validateHistoricalInputs(target,history,initial,evidence);
 const ids={...history.ids},receipts={};let receiptFiles=0;
 while(!receipts.runtimeModelOperations||!receipts.runtimeModelAttempts){if(Date.now()>=deadline)throw Error('CURRENT_NATIVE_ID_OWNERSHIP_NOT_OBSERVED');currentTarget('synthetic',identity);const names=readdirSync(scratch).filter(name=>name.startsWith('owned-created-')).sort();assert.ok(names.length<=783,'PARENT_RECEIPT_BUDGET');for(const name of names){assert.match(name,/^owned-created-[a-f0-9]{64}\.json$/,'PARENT_RECEIPT_NAME');const path=resolve(scratch,name),bytes=readPrivate(path,scratch);assert.ok(bytes.length<=16384,'PARENT_RECEIPT_BYTES');if(!bytes.toString().endsWith('\n'))continue;const row=JSON.parse(bytes);exactKeys(row,['operation','kind','table','id','observedAt']);assert.equal(row.operation,target.operation,'PARENT_RECEIPT_OPERATION');assert.equal(row.kind,'created','PARENT_RECEIPT_KIND');assert.equal(typeof row.table,'string');assert.match(row.table,/^[a-zA-Z][a-zA-Z0-9]*$/);boundedId(row.id);assert.equal(typeof row.observedAt,'string');assert.ok(Number.isFinite(Date.parse(row.observedAt)),'PARENT_RECEIPT_TIMESTAMP');assert.equal(name,'owned-created-'+sha256(row.table+':'+row.id)+'.json','PARENT_RECEIPT_HASH');if(['runtimeModelOperations','runtimeModelAttempts'].includes(row.table)&&!receipts[row.table]){ids[row.table]=row.id;receipts[row.table]={path,sha256:sha256(bytes),locatorSHA256:sha256(row.id),bytes:bytes.length,operation:row.operation,table:row.table,kind:row.kind};}}receiptFiles=names.length;if(!receipts.runtimeModelOperations||!receipts.runtimeModelAttempts)await new Promise(done=>setTimeout(done,100));}
 assert.deepEqual(Object.keys(receipts).sort(),['runtimeModelAttempts','runtimeModelOperations']);const scope={operation:target.operation,runId:target.runId,tenantId:target.runId+'-security-owner',memorySpaceId:target.runId+'-security-owner-space',ids,storageCreated:0,nativeIdShapeVerified:true};
 const inventoryPath=resolve(root,'registration-inventory.json'),inventoryBytes=readFileSync(canonical(inventoryPath,root)),inventory=JSON.parse(inventoryBytes),publicArgs={},internalArgs={};for(const row of inventory.registrations)(row.visibility==='public'?publicArgs:internalArgs)[row.path]=argumentsFor(row,scope);
 // Recheck every real input and exact current target immediately before ANY exclusive output.
 currentTarget('synthetic',identity);assert.equal(sha256(readPrivate(historyPath,scratch)),sha256(historyBytes),'PARENT_HISTORY_CHANGED');assert.equal(sha256(readPrivate(proofPath,scratch)),sha256(proofBytes),'PARENT_PROOF_CHANGED');validateHistoricalInputs(target,history,initial,historicalEvidence());for(const[table,receipt]of Object.entries(receipts)){const bytes=readPrivate(receipt.path,scratch);assert.equal(sha256(bytes),receipt.sha256,'PARENT_RECEIPT_CHANGED');const row=JSON.parse(bytes);assert.equal(row.operation,target.operation);assert.equal(row.table,table);assert.equal(row.id,ids[table]);assert.equal(row.kind,'created');}
 if(Date.now()>=deadline)throw Error('CURRENT_NATIVE_ID_TOTAL_TIME_BUDGET');const proof={operation:target.operation,runId:target.runId,targetIdentity:identity,observedAt:new Date().toISOString(),status:'SOURCE_BOUND_NATIVE_ISSUANCE_PROVENANCE',historicalProvenanceSHA256:sha256(proofBytes),historicalProvenanceCompactSHA256:sha256(JSON.stringify(initial)),currentCoreOwnership:receipts,scopeSHA256:sha256(JSON.stringify(scope)),storageCreated:0,currentPublicStorageDecoding:'NOT_RUN; requires actual handler auth denial on the two existing noJWT sweep observations',extraRPC:0,extraRows:0,observedCreationReceipts:receiptFiles};
 preservationPreflight();if(Date.now()>=deadline)throw Error('CURRENT_NATIVE_ID_TOTAL_TIME_BUDGET');exclusive(resolve(scratch,'current-physical-id-input-receipt.json'),proof);currentTarget('synthetic',identity);if(Date.now()>=deadline)throw Error('CURRENT_NATIVE_ID_TOTAL_TIME_BUDGET');exclusive(resolve(scratch,'argument-scope.json'),scope);currentTarget('synthetic',identity);if(Date.now()>=deadline)throw Error('CURRENT_NATIVE_ID_TOTAL_TIME_BUDGET');exclusive(resolve(scratch,'public-arguments.json'),{operation:target.operation,inventorySha256:sha256(inventoryBytes),arguments:publicArgs,internalArguments:internalArgs,modelAttemptId:ids.runtimeModelAttempts});process.stdout.write(JSON.stringify({status:'PASS_SOURCE_BOUND_INPUTS',extraRPC:0,extraRows:0,storageCreated:0,currentCoreIDTables:Object.keys(receipts).sort(),currentPublicStorageDecoding:'NOT_RUN'})+'\n');}
if(process.argv[1]&&resolve(process.argv[1])===fileURLToPath(import.meta.url))throw Error('REFERENCE_ONLY_USE_FROZEN_C7_PARENT_ADAPTER');
