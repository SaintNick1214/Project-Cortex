import test from'node:test';import assert from'node:assert/strict';import *as fs from'node:fs';import *as vm from'node:vm';import{resolve}from'node:path';import{pathToFileURL}from'node:url';import{createHash}from'node:crypto';import{root,repo}from'./guard.mjs';
const hash=b=>createHash('sha256').update(b).digest('hex'),history=JSON.parse(fs.readFileSync(resolve(root,'historical-preservation.json'))),original=history.packets.find(p=>p.path.endsWith('task04-terminal-capture-parent-inputs-c7-review')),oldroot=resolve(repo,original.path);
async function probe(profile,kind){const base=resolve(root,profile),index=resolve(base,original.fullClosure.path),packet=structuredClone(original);let replacement;const originalIndex=fs.readFileSync(index);if(['duplicate','missing','schema','additional','original-binding'].includes(kind)){const j=JSON.parse(originalIndex);if(kind==='duplicate')j.files[1]=j.files[0];if(kind==='missing')j.files.pop();if(kind==='schema')j.extra=true;if(kind==='additional')j.files.find(r=>r.path.endsWith('/qa-manifest.json')).path+='-forged';if(kind==='original-binding')j.files.find(r=>r.path==='report.md').sha256='0'.repeat(64);replacement=Buffer.from(JSON.stringify(j));packet.fullClosure.bytes=replacement.length;packet.fullClosure.sha256=hash(replacement);}if(kind==='old-metadata')delete packet.fullClosure;if(kind==='wrong-path')packet.fullClosure.path='../historical-parent-c7-review-full-index.json';if(kind==='index-tamper')replacement=Buffer.concat([originalIndex,Buffer.from(' ')]);
 const mock={...fs,readFileSync(path,...args){if(String(path)===index&&replacement)return replacement;if(kind==='original-drift'&&String(path)===resolve(oldroot,'report.md'))return Buffer.from('changed');if(kind==='original-manifest-drift'&&String(path)===resolve(oldroot,'qa-manifest.json'))return Buffer.from('changed');return fs.readFileSync(path,...args);},readdirSync(path,...args){const entries=fs.readdirSync(path,...args);if(String(path)===oldroot){if(kind==='extra-file')return[...entries,{name:'unexpected-extra',isSymbolicLink:()=>false,isDirectory:()=>false}];if(kind==='missing-file')return entries.filter(e=>e.name!=='report.md');}return entries;},lstatSync(path,...args){const s=fs.lstatSync(path,...args);if(String(path)===index&&kind==='hardlink')return new Proxy(s,{get:(t,p)=>p==='nlink'?2:typeof t[p]==='function'?t[p].bind(t):t[p]});if(String(path)===index&&kind==='symlink')return new Proxy(s,{get:(t,p)=>p==='isSymbolicLink'?()=>true:typeof t[p]==='function'?t[p].bind(t):t[p]});return s;}};
 const context=vm.createContext({process,Buffer,Date,setTimeout}),url=pathToFileURL(resolve(base,'scripts/guard.mjs')).href,module=new vm.SourceTextModule(fs.readFileSync(resolve(base,'scripts/guard.mjs'),'utf8'),{context,initializeImportMeta(meta){meta.url=url;}});await module.link(async spec=>{const values=spec==='node:fs'?mock:await import(spec),names=Object.keys(values),m=new vm.SyntheticModule(names,function(){for(const name of names)this.setExport(name,values[name]);},{context});return m;});await module.evaluate();return module.namespace.verifyHistoricalPacket(packet);}
for(const profile of['','regression']){test(`${profile||'extension'} exact original80 plus complete83 supplement passes`,async()=>assert.deepEqual(JSON.parse(JSON.stringify(await probe(profile,'healthy'))),{originalRows:80,completeRows:83}));for(const kind of['old-metadata','wrong-path','index-tamper','duplicate','missing','schema','additional','original-binding','original-drift','original-manifest-drift','extra-file','missing-file','hardlink','symlink'])test(`${profile||'extension'} supplement rejects ${kind}`,async()=>assert.rejects(()=>probe(profile,kind),/QA_/));}
