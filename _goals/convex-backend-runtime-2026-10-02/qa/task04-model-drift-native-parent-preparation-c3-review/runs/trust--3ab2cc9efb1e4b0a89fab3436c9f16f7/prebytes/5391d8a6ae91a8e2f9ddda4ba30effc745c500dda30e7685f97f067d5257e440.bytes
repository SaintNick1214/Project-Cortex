import fs from'node:fs';import path from'node:path';import vm from'node:vm';import crypto from'node:crypto';import assert from'node:assert/strict';
const [repo,own,out]=process.argv.slice(2),H=b=>crypto.createHash('sha256').update(b).digest('hex'),results=[];
for(const profile of ['extension','regression','extra']){
 const sourcePath=path.join(repo,'_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+profile+'-preparation-c3/scripts/guard.mjs'),source=fs.readFileSync(sourcePath,'utf8');
 async function env(){const base=fs.mkdtempSync(path.join(own,'trust-'+profile+'-'));fs.chmodSync(base,0o700);const root=path.join(base,'a/b/c/d'),scratch=path.join(base,source.match(/export const scratch=resolve\(repo,'([^']+)'\)/)[1]);fs.mkdirSync(root,{recursive:true,mode:0o700});fs.mkdirSync(scratch,{recursive:true,mode:0o700});const write=(p,v)=>{fs.mkdirSync(path.dirname(p),{recursive:true,mode:0o700});fs.writeFileSync(p,typeof v==='string'?v:JSON.stringify(v)+'\n',{mode:0o600});fs.chmodSync(p,0o600);};const names=[...source.match(/runtimeRootInputs=Object.freeze\(\[([^]*?)\]\)/)[1].matchAll(/'([^']+)'/g)].map(x=>x[1]);for(const name of names)write(path.join(root,name),{});for(const [name,value]of Object.entries({'runtime-inputs.json':{externalSources:[]},'source-inventory.json':{acceptedGateHashes:[],files:[]},'runner-dependency-inventory.json':{inputs:[]},'toolchain-evidence.json':{files:[]},'dependency-inventory.json':{inputs:[]},'dependency-tiers.json':{rpc:{runner:[],tools:[]},boundaryOnly:{runner:[],tools:[]}},'historical-preservation.json':{packets:[]}}))if(names.includes(name))write(path.join(root,name),value);write(path.join(root,'scripts/guard.mjs'),source);write(path.join(root,'fixture/operational-DUMMY.txt'),'ORIGINAL_APPROVED_DUMMY');write(path.join(root,'nested/qa-manifest.json'),{DUMMY:'nested_manifest_included'});
 const list=(d,p='')=>fs.readdirSync(d,{withFileTypes:true}).flatMap(x=>x.isDirectory()?list(path.join(d,x.name),p+x.name+'/'):[p+x.name]).sort();const update=()=>{const operational=list(root).filter(p=>names.includes(p)||['scripts','fixture','runtime','runtime-source'].includes(p.split('/')[0]));write(path.join(root,'runtime-freeze.json'),{operationalPaths:operational,files:operational.map(p=>({path:p,sha256:H(fs.readFileSync(path.join(root,p)))}))});write(path.join(root,'qa-manifest.json'),{files:list(root).filter(p=>p!=='qa-manifest.json').map(p=>{const b=fs.readFileSync(path.join(root,p));return{path:p,bytes:b.length,sha256:H(b)}})});write(path.join(scratch,'preparation-review.json'),{independent:true,verdict:'PASS',freezeSha256:H(fs.readFileSync(path.join(root,'runtime-freeze.json'))),preservationManifestSHA256:H(fs.readFileSync(path.join(root,'qa-manifest.json')))});};update();const approved=fs.readFileSync(path.join(scratch,'preparation-review.json')),approvedPin=H(approved),proc={argv:['node','DUMMY_VM'],getuid:()=>process.getuid(),env:{CORTEX_QA_TASK04_REVIEW_SHA256:approvedPin}};const ctx=vm.createContext({Buffer,Date,setTimeout,process:proc});const m=new vm.SourceTextModule(source,{context:ctx,identifier:path.join(root,'scripts/guard.mjs'),initializeImportMeta:meta=>meta.url='file://'+path.join(root,'scripts/guard.mjs')});await m.link(async spec=>{const e=await import(spec);return new vm.SyntheticModule(Object.keys(e),function(){for(const[k,v]of Object.entries(e))this.setExport(k,v)},{context:ctx})});await m.evaluate();return{m:m.namespace,proc,root,scratch,write,update,approved,approvedPin,base};}
 async function one(name,fn){const e=await env();await fn(e);results.push({profile,name,status:'PASS',DUMMYArea:e.base,exactSourceSHA256:H(source),actualNetwork:0,actualSigning:0,actualPrivateReads:0});}
 await one('externally-anchored-positive-complete-nested',e=>{assert.ok(e.m.reviewed('rpc').files.length);assert.ok(e.m.preservationPreflight().files>0);});
 for(const pin of [undefined,'A'.repeat(64),'bad','0'.repeat(64)])await one('invalid-initial-pin-'+String(pin),e=>{if(pin===undefined)delete e.proc.env.CORTEX_QA_TASK04_REVIEW_SHA256;else e.proc.env.CORTEX_QA_TASK04_REVIEW_SHA256=pin;assert.throws(()=>e.m.reviewed('rpc'),/QA_REVIEW_EXPECTED/);assert.equal(fs.readdirSync(e.scratch).length,1);e.proc.env.CORTEX_QA_TASK04_REVIEW_SHA256=e.approvedPin;assert.ok(e.m.reviewed('rpc'));});
 await one('coherent-first-operational-full-freeze-recursive-review-substitution',e=>{e.write(path.join(e.root,'fixture/operational-DUMMY.txt'),'ATTACKER_OPERATIONAL_DUMMY');e.write(path.join(e.root,'nested/qa-manifest.json'),{DUMMY:'attacker_nested_manifest'});e.update();assert.notEqual(H(fs.readFileSync(path.join(e.scratch,'preparation-review.json'))),e.approvedPin);assert.throws(()=>e.m.reviewed('rpc'),/QA_REVIEW_EXPECTED_DIGEST/);assert.equal(fs.readdirSync(e.scratch).length,1);});
 await one('failed-first-correct-restoration-no-latch',e=>{const prior=new Map();for(const p of ['fixture/operational-DUMMY.txt','nested/qa-manifest.json','runtime-freeze.json','qa-manifest.json'])prior.set(p,fs.readFileSync(path.join(e.root,p)));e.write(path.join(e.root,'fixture/operational-DUMMY.txt'),'CHANGED');e.update();assert.throws(()=>e.m.reviewed(),/QA_REVIEW_EXPECTED_DIGEST/);for(const[p,b]of prior)e.write(path.join(e.root,p),b.toString());e.write(path.join(e.scratch,'preparation-review.json'),e.approved.toString());assert.ok(e.m.reviewed('rpc'));assert.ok(e.m.preservationPreflight());});
 await one('full-sourcePreflight-nonauthorizing-nolatch',e=>{delete e.proc.env.CORTEX_QA_TASK04_REVIEW_SHA256;assert.ok(e.m.sourcePreflight());e.write(path.join(e.root,'fixture/operational-DUMMY.txt'),'NEW_APPROVED_AFTER_NONAUTHOR');e.update();e.proc.env.CORTEX_QA_TASK04_REVIEW_SHA256=H(fs.readFileSync(path.join(e.scratch,'preparation-review.json')));assert.ok(e.m.reviewed('rpc'));});
 await one('later-pin-drift',e=>{e.m.reviewed();e.proc.env.CORTEX_QA_TASK04_REVIEW_SHA256='1'.repeat(64);assert.throws(()=>e.m.reviewed('rpc'),/QA_REVIEW_EXPECTED_PIN_DRIFT/);});
 await one('later-review-drift',e=>{e.m.reviewed();e.write(path.join(e.scratch,'preparation-review.json'),e.approved.toString()+' ');assert.throws(()=>e.m.reviewed('rpc'),/QA_REVIEW_SUBSTITUTION/);});
 await one('later-freeze-drift',e=>{e.m.reviewed();e.write(path.join(e.root,'runtime-freeze.json'),fs.readFileSync(path.join(e.root,'runtime-freeze.json'),'utf8')+' ');assert.throws(()=>e.m.reviewed('rpc'),/QA_REVIEW/);});
 await one('new-DUMMY-target-exact-profile-and-retired-denials',e=>{const request=JSON.parse(fs.readFileSync(path.join(path.dirname(path.dirname(sourcePath)),'project-request.json'))),target={...request,requestSha256:H(JSON.stringify(request)),projectId:99999999,deploymentName:'DUMMY-current-owned',deploymentUrl:'https://DUMMY-current-owned.convex.cloud',isolationVerified:true,active:true,retired:false,deleted:false},values={CONVEX_DEPLOYMENT:'dev:'+target.deploymentName,CONVEX_DEPLOY_KEY:'dev:'+target.deploymentName+'|DUMMY-NONCREDENTIAL',CONVEX_URL:target.deploymentUrl};assert.equal(e.m.validateTarget(target,request,values),target);for(const [key,value]of [['projectId',3140295],['projectId',3140351],['deploymentName','modest-puffin-359'],['deploymentName','quaint-goldfish-866'],['purpose','task04-model-drift-native-'+profile+'-c1']])assert.throws(()=>e.m.validateTarget({...target,[key]:value},request,values),/QA_TARGET/);assert.equal(fs.readdirSync(e.scratch).length,1);});
 await one('ticket-invalid-pin-zero-effects',async e=>{delete e.proc.env.CORTEX_QA_TASK04_REVIEW_SHA256;await assert.rejects(()=>e.m.reserveTicket('nested-parent',1),/QA_REVIEW_EXPECTED_PIN/);assert.deepEqual(fs.readdirSync(e.scratch),['preparation-review.json']);});
}
fs.writeFileSync(out,JSON.stringify({status:'PASS',defined:results.length,failed:0,skipped:0,results,scope:'OWN_DUMMY_EXACT_FINAL_GUARDS_EXTERNAL_PIN'},null,2)+'\n');console.log(JSON.stringify({status:'PASS',defined:results.length,skipped:0}));
