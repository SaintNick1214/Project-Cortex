/** Parent-only actual apiSpec observation after official codegen; freezes exact deployed tuples. */
import {normalizeApiSpec,assertPublishedArguments} from './publication-contract.mjs';
import assert from 'node:assert/strict';import {ConvexHttpClient} from 'convex/browser';import {makeFunctionReference} from 'convex/server';import {readFileSync,lstatSync} from 'node:fs';import {resolve} from 'node:path';
import {livePreflight,preservationPreflight,root,scratch,json,sha256,exclusive,limits,reserveTicket,qualifierDeadline,reviewPin,canonical} from './guard.mjs';import {boundedRawResponse,captureRawResponse,writePublication,assertFreshPublication} from './publication-artifacts.mjs';
const phase=process.argv[2];if(!['synthetic','empty'].includes(phase))throw Error('QA_PHASE');const {target,values}=livePreflight();preservationPreflight();const receipt=json(resolve(scratch,'codegen-'+phase+'.json'),scratch,true);assert.equal(receipt.operation,target.operation);assert.equal(receipt.status,'PASS');
assertFreshPublication(phase);const stagePath=resolve(scratch,'stage-prerequisites-'+phase+'.json'),stageBytes=readFileSync(canonical(stagePath,scratch,true)),stageSHA=sha256(stageBytes),stageInitial=JSON.parse(stageBytes);if(stageSHA!==receipt.stagePrerequisitesSha256||stageInitial.operation!==target.operation||stageInitial.phase!==phase)throw Error('QA_STAGE_DRIFT');const publicationPath=resolve(scratch,'publication-'+phase+'.json'),publicationInitial=lstatSync(publicationPath,{throwIfNoEntry:false})?sha256(readFileSync(canonical(publicationPath,scratch,true))):null;const originalPin=reviewPin(),codegenSHA=sha256(readFileSync(resolve(scratch,'codegen-'+phase+'.json')));const fresh=(window=false)=>{const current=livePreflight();if(sha256(JSON.stringify(current.target))!==sha256(JSON.stringify(target)))throw Error('QA_TARGET_DRIFT');if(sha256(JSON.stringify(current.values))!==sha256(JSON.stringify(values)))throw Error('QA_PRIVATE_SELECTOR_DRIFT');if(sha256(readFileSync(canonical(stagePath,scratch,true)))!==stageSHA)throw Error('QA_STAGE_DRIFT');if((lstatSync(publicationPath,{throwIfNoEntry:false})?sha256(readFileSync(canonical(publicationPath,scratch,true))):null)!==publicationInitial)throw Error('QA_PUBLICATION_DRIFT');for(const row of stageInitial.httpRouter.sourceHashes)if(sha256(readFileSync(canonical(resolve(scratch,'deploy-'+phase,row.path),scratch)))!==row.sha256)throw Error('QA_STAGE_DRIFT');if(reviewPin()!==originalPin)throw Error('QA_REVIEW_EXPECTED_PIN_DRIFT');if(sha256(readFileSync(resolve(scratch,'codegen-'+phase+'.json')))!==codegenSHA)throw Error('QA_CODEGEN_DRIFT');for(const row of receipt.generated??[]){if(!/^convex\/_generated\/[a-zA-Z0-9._-]+$/.test(row.path))throw Error('QA_CODEGEN');if(sha256(readFileSync(canonical(resolve(scratch,'deploy-'+phase,row.path),scratch)))!==row.sha256)throw Error('QA_CODEGEN_DRIFT');}return window||lstatSync(resolve(scratch,'qualifier-window.json'),{throwIfNoEntry:false})?qualifierDeadline():undefined;};fresh();let rawCapture,dispatchStarted=false;const client=new ConvexHttpClient(target.deploymentUrl,{logger:false,fetch:async(url,options)=>{if(new URL(url).origin!==target.deploymentUrl||new URL(url).pathname!=='/api/query'||options.method!=='POST'||JSON.parse(options.body).path!=='_system/cli/modules:apiSpec'||rawCapture)throw Error('QA_ORIGIN');if(dispatchStarted)throw Error('QA_PUBLICATION_DUPLICATE_DISPATCH');const deadline=Math.min(fresh(true),Date.now()+limits.rpcMs);dispatchStarted=true;const r=await fetch(url,{...options,redirect:'error',signal:AbortSignal.timeout(Math.max(1,deadline-Date.now()))});const body=await boundedRawResponse(r,deadline);rawCapture=captureRawResponse(phase,target.operation,body,r.status);return new Response(body,{status:r.status,headers:r.headers});}});client.setAdminAuth(values.CONVEX_DEPLOY_KEY);
await reserveTicket('native',limits.nativeClientRpc);fresh(true);const published=await client.query(makeFunctionReference('_system/cli/modules:apiSpec'),{});assert.ok(Array.isArray(published));const functions=normalizeApiSpec(published);
const expected=json(resolve(root,'registration-inventory.json')).registrations;const equality=assertPublishedArguments(functions,expected,phase);
const http=published.filter(fn=>fn.functionType==='HttpAction');assert.equal(http.length,1);const staged=json(resolve(scratch,'stage-prerequisites-'+phase+'.json'),scratch,true);assert.equal(staged.operation,target.operation);assert.equal(staged.phase,phase);assert.equal(sha256(readFileSync(resolve(scratch,'stage-prerequisites-'+phase+'.json'))),receipt.stagePrerequisitesSha256);assert.deepEqual(staged.httpRouter,receipt.httpRouter);assert.deepEqual(staged.httpRouter.routes,[{path:'/qa/task04-peer/effect',method:'POST',handler:'qualificationPeer:effect',handlerExportIdentityMatched:true}]);for(const row of staged.httpRouter.sourceHashes)assert.equal(sha256(readFileSync(resolve(scratch,'deploy-'+phase,row.path))),row.sha256);if(http[0].path!==undefined)assert.equal(http[0].path,'/qa/task04-peer/effect');if(http[0].method!==undefined)assert.equal(http[0].method,'POST');
assert.ok(rawCapture);writePublication(phase,target.operation,published,receipt,rawCapture,staged.httpRouter);
