/** Actual registered fixture ledger + installed codec, controlled DB only; never native service evidence. */
import test from'node:test';import assert from'node:assert/strict';import{build}from'esbuild';import{mkdirSync,writeFileSync}from'node:fs';import{resolve}from'node:path';import{pathToFileURL}from'node:url';import{randomUUID}from'node:crypto';import{jsonToConvex}from'convex/values';import{root,repo,fixture,sha256}from'./guard.mjs';import{canonical,request}from'./cases.mjs';import{invokeFunction}from'../../../../../node_modules/convex/dist/esm/server/impl/registration_impl.js';
const work=resolve(repo,'work/resume/task04-model-drift-native-preparation-c3/extension/error-boundary-'+randomUUID());mkdirSync(work,{mode:0o700});
test('actual accepted B registered admit and installed Convex codec retain closed denial and complete NO_EFFECT after earlier reservation',async()=>{const output=resolve(work,'actual-handler.mjs');await build({stdin:{contents:'export * as ledger from '+JSON.stringify(resolve(fixture,'convex/runtimeModelPolicy.ts'))+';export {memoryFixture} from '+JSON.stringify(resolve(repo,'tests/unit/runtimeMemory/fixture.ts'))+';',resolveDir:fixture,loader:'ts'},bundle:true,format:'esm',platform:'node',packages:'external',outfile:output,logLevel:'silent'});const {ledger,memoryFixture}=await import(pathToFileURL(output)),f=memoryFixture();f.grant.capabilities=['read','write','run','admin'];f.db.patch=async(table,id,updates)=>{const row=await f.db.get(table,id);assert.ok(row);f.db.writes++;Object.assign(row,JSON.parse(JSON.stringify(updates)));};f.db.insert=async(table,value)=>{f.db.writes++;return f.db.seed(table,JSON.parse(JSON.stringify(value)))._id;};const invoke=(name,args)=>ledger[name]._handler(f.ctx,args);await invoke('installDeploymentPolicy',{manifestId:'qa-task04-synthetic-v1',expectedRevision:1});const bound=await invoke('ensureBudget',{reference:f.reference,operationKey:'agent.respond',requestId:'codec-control',requestCanonical:canonical({text:'hello'})}),args={reference:f.reference,operationKey:'agent.respond',runBudgetId:bound.runBudgetId,semanticId:'semantic',ordinal:0,requestCanonical:canonical(request('hello'))};await invoke('admit',args);const before=canonical([...f.db.rows]),writes=f.db.writes;let caught;try{await invokeFunction(ledger.admit._handler,f.ctx,[{...args,requestCanonical:canonical(request('changed private request'))}]);}catch(error){caught=error;}assert.ok(caught);assert.equal(typeof caught.data,'string');assert.deepEqual(jsonToConvex(JSON.parse(caught.data)),{version:1,code:'IDEMPOTENCY_CONFLICT',message:'Model operation control failed.',retryable:false,outcome:'not_dispatched'});assert.equal(canonical([...f.db.rows]),before);assert.equal(f.db.writes,writes);assert.equal(f.db.table('runtimeModelAttempts').length,1);for(const row of f.db.table('runtimeBudgetAccounts')){assert.equal(row.reservedUnits,100);assert.equal(row.settledUnits,0);assert.equal(row.uncertainUnits,0);assert.equal(row.activeConcurrency,1);}writeFileSync(resolve(work,'actual-codec-denial.json'),JSON.stringify({data:jsonToConvex(JSON.parse(caught.data)),beforeSHA256:sha256(before),afterSHA256:sha256(canonical([...f.db.rows])),writesBefore:writes,writesAfter:f.db.writes},null,2)+'\n',{flag:'wx',mode:0o600});process.stdout.write(JSON.stringify({case:'actual-B-admit-installed-codec',status:'PASS',noEffect:true,priorReservationUnits:100,native:'NOT_RUN',services:0})+'\n');});
