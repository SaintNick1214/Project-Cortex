358 interface WireMessage {
359   type: string;
360   tokenType?: string;
361   value?: string;
362 }
363 
364 /** Inert opened transport: records official messages in memory, performs no network. */
365 class InertWebSocket {
366   static instances: InertWebSocket[] = [];
367   readyState = 0;
368   onopen: (() => void) | null = null;
369   onclose: ((event: { code: number; reason: string; wasClean: boolean }) => void) | null = null;
370   onerror: (() => void) | null = null;
371   onmessage: ((event: { data: string }) => void) | null = null;
372   readonly messages: WireMessage[] = [];
373 
374   constructor(readonly url: string) {
375     InertWebSocket.instances.push(this);
376     queueMicrotask(() => {
377       if (this.readyState === 0) {
378         this.readyState = 1;
379         this.onopen?.();
380       }
381     });
382   }
383 
384   send(message: string): void {
385     // The installed Convex client produces these JSON protocol objects.
386     this.messages.push(JSON.parse(message) as WireMessage);
387   }
388 
389   close(): void {
390     this.readyState = 3;
391     queueMicrotask(() => this.onclose?.({ code: 1000, reason: "test complete", wasClean: true }));
392   }
393 }
394 
395 async function flushAuthTasks(): Promise<void> {
396   // Include the single post-resume deauthentication event task.
397   await new Promise<void>((resolve) => setImmediate(resolve));
398   await new Promise<void>((resolve) => setTimeout(resolve, 0));
399   await new Promise<void>((resolve) => setImmediate(resolve));
400 }
401 
402 function assertResumedWithoutIdentity(client: ConvexClient, socket: InertWebSocket): void {
403   expect(client.getAuth()).toBeUndefined();
404   expect(client.connectionState().hasEverConnected).toBe(true);
405   const before = socket.messages.length;
406   const stop = client.onUpdate(testQuery, {}, () => undefined);
407   expect(socket.messages.slice(before).some((message) => message.type === "ModifyQuerySet")).toBe(true);
408   stop();
409 }
