56 function fixture(mode: "absent" | "disabled" | "enabled") {
57   const client = new ConvexClient("https://example.convex.cloud", { disabled: true, logger: false });
58   const mutation = jest.spyOn(client, "mutation");
59   const query = jest.spyOn(client, "query");
60   const action = jest.spyOn(client, "action");
61   const onRetry = jest.fn();
62   const resilience = new ResilienceLayer({
63     enabled: mode === "enabled",
64     retry: { maxRetries: 2, baseDelayMs: 1, maxDelayMs: 1, jitter: false },
65     onRetry,
66   });
67   const execute = jest.spyOn(resilience, "execute");
68   const users = new UsersAPI(client, undefined,
69     mode === "absent" ? undefined : resilience,
70     { userId: "sdk-user", tenantId: "tenant-a" });
71   return { users, client, mutation, query, action, resilience, execute, onRetry };
72 }
73 
