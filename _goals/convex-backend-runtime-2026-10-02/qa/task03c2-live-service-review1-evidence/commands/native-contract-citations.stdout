90   /** Bind one reactive transport using Convex's official refresh callback. */
91   bindReactiveClient(client: ReactiveAuthClient): void {
92     if (client.closed) {
93       throw new Error("Cannot bind a closed reactive client");
94     }
95     if (this.reactiveClient && this.reactiveClient !== client && !this.reactiveClient.closed) {
96       throw new Error("Host credentials already have a bound reactive client");
97     }
98     this.reactiveClient = client;
99     this.configureReactiveAuth(client, false);
100   }
101 
102   /**
103    * Call after host login, logout or identity changes. Reconfigure official Convex
104    * auth and force the first host token fetch to bypass its cache; later refresh
105    * requests are forwarded unchanged. A null token clears Convex identity.
106    * Stop private observers on logout; persisted background grants still require
107    * explicit backend revocation/deletion. Throws when unbound or already closed.
108    */
109   notifySessionChanged(): void {
110     const client = this.reactiveClient;
111     if (!client) {
112       throw new Error("No reactive client is bound to host credentials");
113     }
114     if (client.closed) {
115       this.reactiveClient = undefined;
116       throw new Error("Cannot refresh a closed reactive client");
117     }
118     this.configureReactiveAuth(client, true);
119   }
120 
121   private configureReactiveAuth(
122     client: ReactiveAuthClient,
123     forceFirstFetch: boolean,
124   ): void {
125     const version = ++this.reactiveVersion;
126     if (this.pendingDeauthTimer !== undefined) {
127       clearTimeout(this.pendingDeauthTimer);
128       this.pendingDeauthTimer = undefined;
129     }
130     const baseClient = client.client;
131     // Remove the prior session identity before setAuth pauses the transport.
132     if (baseClient.hasAuth()) {
133       baseClient.clearAuth();
134     }
135     let firstFetch = forceFirstFetch;
136     client.setAuth(async (request) => {
137       if (version !== this.reactiveVersion || client.closed) {
138         return null;
139       }
140       const currentRequest = firstFetch
141         ? { ...request, forceRefreshToken: true }
142         : request;
143       firstFetch = false;
144       const attemptId = ++this.reactiveAttemptId;
145       try {
146         const token = await this.fetchToken(currentRequest);
147         if (this.isCurrentReactiveAttempt(client, version, attemptId)) {
148           this.latestAuthFailure = undefined;
149         }
150         return token;
151       } catch (error: unknown) {
152         if (this.isCurrentReactiveAttempt(client, version, attemptId)) {
153           const failure: HostAuthFailure = Object.freeze({
154             code: error instanceof InvalidHostTokenResultError
155               ? "INVALID_HOST_TOKEN"
156               : "HOST_TOKEN_FETCH_FAILED",
157             attemptId,
158           });
159           this.latestAuthFailure = failure;
160           // Convex invokes setAuth's async callback without awaiting/catching it.
161           // Isolate both synchronous and async diagnostic observer failures too.
162           try {
163             void Promise.resolve(this.onAuthError?.(failure)).catch(() => undefined);
164           } catch (_observerError: unknown) {
165             // The diagnostic remains readable even if the observer fails.
166           }
167         }
168         // Official null handling clears identity and resumes the paused socket.
169         return null;
170       }
171     }, (authenticated) => {
172       if (authenticated || version !== this.reactiveVersion || client.closed) return;
173       const attemptId = this.reactiveAttemptId;
174       // Convex 1.46 drops Authenticate(None) while setConfig is paused. Its
175       // false callback runs before the await-refetch continuation resumes the
176       // socket. One event task lets those promise continuations finish, then
177       // uses the public clearAuth API to actually deliver identity removal.
178       if (this.pendingDeauthTimer !== undefined) {
179         clearTimeout(this.pendingDeauthTimer);
180       }
181       const timer = setTimeout(() => {
182         if (this.pendingDeauthTimer === timer) {
183           this.pendingDeauthTimer = undefined;
184         }
185         if (this.isCurrentReactiveAttempt(client, version, attemptId)) {
186           baseClient.clearAuth();
187         }
188       }, 0);
189       this.pendingDeauthTimer = timer;
190     });
191   }
192 
193   private isCurrentReactiveAttempt(
194     client: ReactiveAuthClient,
195     version: number,
196     attemptId: number,
197   ): boolean {
198     return version === this.reactiveVersion &&
199       attemptId === this.reactiveAttemptId && !client.closed;
200   }
