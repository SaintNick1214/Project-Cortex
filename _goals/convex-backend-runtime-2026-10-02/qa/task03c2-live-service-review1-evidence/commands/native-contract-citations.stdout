202   /**
203    * Fresh headers for a host-approved private Convex HTTP request. Use this
204    * result as the request's auth headers; do not retain old Authorization headers
205    * after null/logout. The caller owns route/origin validation and byte limits.
206    */
207   async getAuthorizationHeaders(
208     request: HostTokenRequest = { forceRefreshToken: false },
209   ): Promise<Record<string, string>> {
210     const token = await this.fetchToken(request);
211     return token === null ? {} : { Authorization: `Bearer ${token}` };
