214   /**
215    * Attach the current credential before one HTTP operation. The official HTTP
216    * client accepts a static token, so obtain it again for every invocation.
217    * Serialize operations on this client to keep concurrent credentials separate.
218    * No authentication failure or operation error triggers an operation retry.
219    * Use a dedicated client with this helper for all of its authenticated calls.
220    */
221   async withHttpAuth<T>(
222     client: ConvexHttpClient,
223     operation: (client: ConvexHttpClient) => Promise<T>,
224     request: HostTokenRequest = { forceRefreshToken: false },
225   ): Promise<T> {
226     const previous = this.httpOperations.get(client) ?? Promise.resolve();
227     const result = previous.then(async () => {
228       const token = await this.fetchToken(request);
229       if (token === null) {
230         client.clearAuth();
231       } else {
232         client.setAuth(token);
233       }
234       return await operation(client);
235     });
236     // A rejected operation must not poison the queue or replay that operation.
237     const settled = result.then(() => undefined, () => undefined);
238     this.httpOperations.set(client, settled);
239     try {
240       return await result;
241     } finally {
242       if (this.httpOperations.get(client) === settled) {
243         this.httpOperations.delete(client);
244       }
245     }
