FILE tests/unit/runtimeWorkerClient/sessions-maintenance.test.ts
1 import { afterEach, describe, expect, it, jest } from "@jest/globals";
2 import { ConvexClient } from "convex/browser";
3 import { SessionsAPI, SessionCapabilityError } from "../../../src/sessions";
4 import { AuthValidationError } from "../../../src/auth";
5 import { ResilienceLayer } from "../../../src/resilience";
6 import type { ExpireSessionsOptions } from "../../../src/sessions/types";
7 
8 function fixture(mode: "absent" | "disabled" | "enabled", tenantId?: string) {
9   const client = new ConvexClient("https://example.convex.cloud", {
10     disabled: true,
11     logger: false,
12   });
13   const mutation = jest.spyOn(client, "mutation");
14   const query = jest.spyOn(client, "query");
15   const action = jest.spyOn(client, "action");
16   const resilience = new ResilienceLayer({ enabled: mode === "enabled" });
17   const execute = jest.spyOn(resilience, "execute");
18   const sessions = new SessionsAPI(client, undefined,
19     mode === "absent" ? undefined : resilience,
20     tenantId === undefined ? undefined : { userId: "sdk-user", tenantId });
21   return { sessions, client, mutation, query, action, resilience, execute };
22 }
23 
24 describe.each(["absent", "disabled", "enabled"] as const)(
25   "session maintenance boundary (resilience=%s)", (mode) => {
26     let current: ReturnType<typeof fixture> | undefined;
27 
28     afterEach(async () => {
29       await current?.client.close();
30       await current?.resilience.shutdown();
31       jest.restoreAllMocks();
32     });
33 
34     function assertNotDispatched() {
35       expect(current?.mutation).not.toHaveBeenCalled();
36       expect(current?.query).not.toHaveBeenCalled();
37       expect(current?.action).not.toHaveBeenCalled();
38       expect(current?.execute).not.toHaveBeenCalled();
39     }
40 
41     it.each<ExpireSessionsOptions | undefined>([
42       undefined,
43       {},
44       { idleTimeout: 15 * 60 * 1000 },
45       { tenantId: "tenant-a" },
46       { tenantId: "tenant-a", idleTimeout: 0 },
47     ])("returns a typed undispatched outcome for valid options %j", async (options) => {
48       current = fixture(mode);
49       const error: unknown = await current.sessions.expireIdle(options)
50         .catch((failure: unknown) => failure);
51       expect(error).toBeInstanceOf(SessionCapabilityError);
52       expect(error).toMatchObject({
53         name: "SessionCapabilityError",
54         code: "BACKEND_MAINTENANCE_ONLY",
55         retryable: false,
56         outcome: "not_dispatched",
57         requiredExecution: "trusted_backend_worker",
58       });
59       if (!(error instanceof SessionCapabilityError)) throw new Error("Expected capability error");
60       expect(error.message).toContain("requires a trusted backend worker");
61       expect(Object.keys(error).sort()).toEqual([
62         "code", "name", "outcome", "requiredExecution", "retryable",
63       ]);
64       expect(JSON.stringify(error)).not.toMatch(/operator|credentials|FunctionReference/);
65       assertNotDispatched();
66     });
67 
68     it.each<ExpireSessionsOptions | undefined>([
69       undefined,
70       {},
71       { tenantId: "tenant-a", idleTimeout: 1000 },
72     ])("accepts the configured tenant selector before capability rejection %j", async (options) => {
73       current = fixture(mode, "tenant-a");
74       await expect(current.sessions.expireIdle(options)).rejects.toBeInstanceOf(SessionCapabilityError);
75       assertNotDispatched();
76     });
77 
78     it("preserves tenant mismatch validation before reading the timeout or dispatching", async () => {
79       current = fixture(mode, "tenant-a");
80       const timeoutRead = jest.fn(() => 1000);
81       const options: ExpireSessionsOptions = {
82         tenantId: "tenant-b",
83         get idleTimeout() { return timeoutRead(); },
84       };
85       const error: unknown = await current.sessions.expireIdle(options)
86         .catch((failure: unknown) => failure);
87       expect(error).toBeInstanceOf(AuthValidationError);
88       expect(error).not.toBeInstanceOf(SessionCapabilityError);
89       expect(error).toMatchObject({ code: "TENANT_SCOPE_MISMATCH", field: "tenantId" });
90       expect(timeoutRead).not.toHaveBeenCalled();
91       assertNotDispatched();
92     });
93   },
94 );
