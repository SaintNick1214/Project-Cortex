289 it("preserves actual resilience retry behavior for an ordinary transient mutation failure", async () => {
290   const current = fixture("enabled");
291   try {
292     current.query.mockResolvedValue(profile);
293     current.mutation.mockRejectedValueOnce(new Error("Server Error"))
294       .mockRejectedValueOnce(new Error("Server Error")).mockResolvedValueOnce(hydrated);
295     await expect(current.users.update("caller-user", {})).resolves.toEqual(mapped(hydrated));
296     expect(current.query).toHaveBeenCalledTimes(1);
297     expect(current.mutation).toHaveBeenCalledTimes(3);
298     expect(current.execute.mock.calls.map((call) => call[1])).toEqual(["users:get", "users:update"]);
299     expect(current.onRetry).toHaveBeenCalledTimes(2);
300     expect(current.action).not.toHaveBeenCalled();
301   } finally {
302     await current.client.close();
303     await current.resilience.shutdown();
304     jest.restoreAllMocks();
305   }
306 });
