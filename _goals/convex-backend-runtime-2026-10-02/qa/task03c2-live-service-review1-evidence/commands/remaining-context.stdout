190: // Mock only the reactive transport constructor. Domain modules and Cortex's
191: // constructor execute normally; the captured official callback is invoked below.
192: class ReactiveClient {
193:   closed = false;
194:   readonly client = { hasAuth: () => false, clearAuth: jest.fn() };
195:   readonly setAuth = jest.fn<ConvexClient["setAuth"]>();
196:   readonly close = jest.fn(async () => undefined);
197: }
198: const reactiveInstances: ReactiveClient[] = [];
199: const reactiveConstructor = jest.fn((_url: string) => {
200:   const client = new ReactiveClient();
201:   reactiveInstances.push(client);
202:   return client;
203: });
204: jest.unstable_mockModule("convex/browser", () => ({
205:   ConvexClient: reactiveConstructor,
206:   ConvexHttpClient,
207: }));
