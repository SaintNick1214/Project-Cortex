82: /** The write committed, but returning a hydrated profile requires read capability. */
83: export class UserProfileWriteReceiptError extends Error {
84:   readonly code = "PROFILE_WRITE_COMMITTED_READ_UNAVAILABLE";
85:   readonly retryable = false;
86:   readonly outcome = "committed";
87:   readonly requiredCapability = "read";
88:   readonly receipt: Readonly<UserProfileWriteReceipt>;
89: 
90:   constructor(receipt: UserProfileWriteReceipt) {
91:     super(
92:       "The user profile write committed, but the updated profile is unavailable " +
93:         "without read capability. Do not retry the committed write.",
94:     );
95:     this.name = "UserProfileWriteReceiptError";
96:     this.receipt = Object.freeze({
97:       updated: receipt.updated,
98:       type: receipt.type,
99:       id: receipt.id,
100:       tenantId: receipt.tenantId,
101:       memorySpaceId: receipt.memorySpaceId,
102:       ...(receipt.createdId === undefined ? {} : { createdId: receipt.createdId }),
103:     });
104:   }
105: }
