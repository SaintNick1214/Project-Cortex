195:   /**
196:    * Update user profile (creates new version by default)
197:    *
198:    * Throws UserProfileWriteReceiptError if the write committed but the backend
199:    * returned a safe receipt because the updated profile could not be read.
200:    *
201:    * @param userId - User ID to update
202:    * @param data - Profile data to store
203:    * @param options - Update options
204:    * @param options.skipVersioning - Don't create new version (default: false)
205:    * @param options.versionReason - Why this update happened (stored in metadata)
206:    * @param options.merge - Merge with existing data (default: true)
207:    *
208:    * @example
209:    * ```typescript
210:    * // Basic update (merges with existing, creates new version)
211:    * const updated = await cortex.users.update('user-123', {
212:    *   displayName: 'Alex Johnson',
213:    *   email: 'alex@example.com',
214:    *   preferences: { theme: 'dark' }
215:    * });
216:    *
217:    * // Skip versioning for routine updates
218:    * await cortex.users.update('user-123', {
219:    *   lastSeen: new Date().toISOString()
220:    * ```
221:    */
222:   async update(
223:     userId: string,
224:     data: Record<string, unknown>,
225:   ): Promise<UserProfile> {
226:     // Client-side validation
227:     validateUserId(userId);
228:     validateData(data, "data");
229: 
230:     // Default behavior: merge with existing data
231:     let finalData = data;
232:     const existing = await this.get(userId);
233:     if (existing) {
234:       finalData = this.deepMerge(existing.data, data);
235:     }
236: 
237:     const result = await this.executeWithResilience(
238:       () =>
239:         this.client.mutation(api.immutable.store, {
240:           type: "user",
241:           id: userId,
242:           data: finalData,
243:           tenantId: this.authContext?.tenantId, // Inject tenantId from auth context
244:         }),
245:       "users:update",
246:     );
247: 
248:     if (!result) {
249:       // Use a static error message to avoid leaking user-controlled identifiers into logs
250:       throw new Error("Failed to store user profile");
251:     }
252: 
253:     // Interpret the committed response after resilience completes so this outcome
254:     // cannot trigger another mutation attempt or an automatic follow-up read.
255:     if ("updated" in result) {
256:       throw new UserProfileWriteReceiptError(result);
257:     }
258: 
259:     return {
260:       id: result.id,
261:       tenantId: result.tenantId, // Include tenantId in response
262:       data: (result.data as Record<string, unknown> | undefined) ?? {},
263:       version: result.version,
264:       createdAt: result.createdAt,
265:       updatedAt: result.updatedAt,
266:     };
267:   }
