133:    */
134:   private async executeWithResilience<T>(
135:     operation: () => Promise<T>,
136:     operationName: string,
137:   ): Promise<T> {
138:     if (this.resilience) {
139:       return this.resilience.execute(operation, operationName);
140:     }
141:     return operation();
142:   }
