410:    * Request idle session expiration, which requires a trusted backend worker.
411:    *
412:    * Valid client requests reject with SessionCapabilityError before dispatch.
413:    * This method does not perform or schedule automatic session maintenance.
414:    * Tenant selectors retain the existing SDK auth-context mismatch validation.
415:    *
416:    * @param options - Expiration options (idle timeout defaults to 30 minutes)
417:    * @throws SessionCapabilityError when trusted backend execution is required
418:    */
419:   async expireIdle(
420:     options?: ExpireSessionsOptions,
421:   ): Promise<{ expired: number }> {
422:     resolveTenantId(this.authContext?.tenantId, options?.tenantId);
423:     // Preserve the existing default before reporting the execution boundary.
424:     const idleTimeout = options?.idleTimeout ?? 30 * 60 * 1000;
425:     void idleTimeout;
426:     throw new SessionCapabilityError();
427:   }
428: 
429:   // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
430:   // Private Helpers
431:   // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
432: 
433:   /**
434:    * Generate a cryptographically secure unique session ID
435:    */
436:   private generateSessionId(): string {
437:     const timestamp = Date.now().toString(36);
438:     const randomPart = Array.from(globalThis.crypto.getRandomValues(new Uint8Array(8)),
439:       (byte) => byte.toString(16).padStart(2, "0")).join("");
440:     return `sess-${timestamp}-${randomPart}`;
441:   }
442: }
