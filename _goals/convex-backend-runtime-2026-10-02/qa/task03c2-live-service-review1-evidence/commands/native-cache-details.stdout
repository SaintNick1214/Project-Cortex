20: export function parseServerMessage(
21:   encoded: EncodedServerMessage,
22: ): WireServerMessage {
23:   switch (encoded.type) {
24:     case "FatalError":
25:     case "AuthError":
26:     case "ActionResponse":
27:     case "TransitionChunk":
28:     case "Ping": {
29:       return { ...encoded };
30:     }
31:     case "MutationResponse": {
32:       if (encoded.success) {
33:         return { ...encoded, ts: u64ToLong(encoded.ts) };
34:       } else {
35:         return { ...encoded };
36:       }
37:     }
38:     case "Transition": {
39:       return {
40:         ...encoded,
41:         startVersion: {
42:           ...encoded.startVersion,
43:           ts: u64ToLong(encoded.startVersion.ts),
44:         },
45:         endVersion: {
46:           ...encoded.endVersion,
47:           ts: u64ToLong(encoded.endVersion.ts),
48:         },
49:       };
50:     }
51:     default: {
52:       encoded satisfies never;
53:     }
54:   }
55:   return undefined as never;
56: }
57: 
58: export function encodeClientMessage(
59:   message: ClientMessage,
60: ): EncodedClientMessage {
61:   switch (message.type) {
62:     case "Authenticate":
63:     case "ModifyQuerySet":
64:     case "Mutation":
65:     case "Action":
66:     case "Event": {
67:       return { ...message };
68:     }
69:     case "Connect": {
70:       if (message.maxObservedTimestamp !== undefined) {
71:         return {
72:           ...message,
73:           maxObservedTimestamp: longToU64(message.maxObservedTimestamp),
74:         };
75:       } else {
76:         return { ...message, maxObservedTimestamp: undefined };
77:       }
78:     }
79:     default: {
80:       message satisfies never;
81:     }
82:   }
83:   return undefined as never;
84: }
