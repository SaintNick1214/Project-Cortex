231   queryResult(queryToken: QueryToken): Value | undefined {
232     const query = this.queryResults.get(queryToken);
233     if (query === undefined) {
234       return undefined;
235     }
236     const result = query.result;
237     if (result === undefined) {
238       return undefined;
239     } else if (result.success) {
240       return result.value;
241     } else {
242       if (result.errorData !== undefined) {
243         throw forwardData(
244           result,
245           new ConvexError(
246             createHybridErrorStacktrace("query", query.udfPath, result),
247           ),
248         );
249       }
250       throw new Error(
251         createHybridErrorStacktrace("query", query.udfPath, result),
252       );
253     }
254   }
255 
256   hasQueryResult(queryToken: QueryToken): boolean {
257     return this.queryResults.get(queryToken) !== undefined;
258   }
