    q.eq("tenantId", auth.tenantId).eq("memorySpaceId", auth.memorySpaceId).eq("type", type).eq("id", id));
  const rows = await selected.filter((q) => auth.resourceAccess === "own"
    ? q.eq(q.field("ownerPrincipalId"), auth.principalId) : q.neq(q.field("ownerPrincipalId"), undefined)).take(2);
  if (rows.length > 1) denied();
  const row = rows[0] ?? null;
  if (await ctx.db.query("immutable").withIndex("by_runtime_key", (q) =>
