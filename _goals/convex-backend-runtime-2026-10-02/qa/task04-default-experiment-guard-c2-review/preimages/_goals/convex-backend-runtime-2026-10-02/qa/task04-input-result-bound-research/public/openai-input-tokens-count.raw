th="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus stldocs-icon" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus stldocs-icon" aria-hidden="true"><path d="M5 12h14"></path></svg></div><div class="stldocs-expander-summary-content"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) tools &gt; (schema) &gt; (items) &gt; (variant) 8 &gt; (property) model" class="stldocs-property-info"><div class="stldocs-property-declaration"><span class="stldocs-type-propertyname"><span class="stldocs-text-identifier">model</span></span><span class="stldocs-text-punctuation">: </span><span class="stldocs-text-punctuation">optional </span><span class="stldocs-type"><span class="stldocs-type-preview" data-stldocs-type-preview="union"><span class="stldocs-type-preview-content"><span class="stldocs-type"><span class="stldocs-type-plain">string</span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-type-preview" data-stldocs-type-preview="union"><span class="stldocs-type-preview-content"><span class="stldocs-type"><span class="stldocs-literal-string">&quot;gpt-image-1&quot;</span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-literal-string">&quot;gpt-image-1-mini&quot;</span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-literal-string">&quot;gpt-image-1.5&quot;</span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-truncation">6<!-- --> more</span></span></span></span></span></span></span></div><div class="stldocs-property-description"><div class="stldocs-markdown stldocs-content stl-ui-prose"><p>The image generation model to use. One of <code>gpt-image-1</code>,
<code>gpt-image-1-mini</code>, <code>gpt-image-1.5</code>, <code>gpt-image-2</code>,
<code>gpt-image-2-2026-04-21</code>, <code>gpt-image-2.5-sunburst</code>,
<code>gpt-image-2.5-sunburst-2026-09-08</code>, <code>gpt-image-2.5-flare</code>,
<code>gpt-image-2.5-flare-2026-09-08</code>, or <code>chatgpt-image-latest</code>. Default:
<code>gpt-image-1</code>.</p>
