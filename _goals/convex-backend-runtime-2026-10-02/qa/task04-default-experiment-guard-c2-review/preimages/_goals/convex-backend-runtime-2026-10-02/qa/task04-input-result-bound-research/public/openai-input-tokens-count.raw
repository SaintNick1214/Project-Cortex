ide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></span></a></div><div class="stldocs-property" data-stldocs-language="http"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) previous_response_id &gt; (schema)" class="stldocs-property-info"><div class="stldocs-property-declaration"><span class="stldocs-type-propertyname"><span class="stldocs-text-identifier">previous_response_id</span></span><span class="stldocs-text-punctuation">: </span><span class="stldocs-text-punctuation">optional </span><span class="stldocs-type"><span class="stldocs-type-preview" data-stldocs-type-preview="union"><span class="stldocs-type-preview-content"><span class="stldocs-type"><span class="stldocs-type-plain">string</span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-type-plain">null</span></span></span></span></span></div><div class="stldocs-property-description"><div class="stldocs-markdown stldocs-content stl-ui-prose"><p>The unique ID of the previous response to the model. Use this to create multi-turn conversations. Learn more about <a href="/api/docs/guides/conversation-state">conversation state</a>. Cannot be used in conjunction with <code>conversation</code>.</p>
</div></div></div><a href="#(resource)%20responses.input_tokens%20%3E%20(method)%20count%20%3E%20(params)%200%20%3E%20(param)%20previous_response_id%20%3E%20(schema)" aria-label="Link to this property" class="stl-ui-button stl-ui-button--outline stl-ui-button--size-sm stl-ui-button--with-border not-content stl-ui-not-prose stldocs-deep-link-button"><span class="stl-ui-button__icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></span></a></div><div class="stldocs-property" data-stldocs-language="http"><details class="stldocs-expander" data-stldocs-expander-muted="false"><summary class="stldocs-expander-summary"><div class="stldocs-expander-summary-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus stldocs-icon" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus stldocs-icon" aria-hidden="true"><path d="M5 12h14"></path></svg></div><div class="stldocs-expander-summary-content"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) reasoning &gt; (schema)" class="stldocs-property-info"><div class="stldocs-property-declaration"><span class="stldocs-type-propertyname"><span class="stldocs-text-identifier">reasoning</span></span><span class="stldocs-text-punctuation">: </span><span class="stldocs-text-punctuation">optional </span><span class="stldocs-type"><span class="stldocs-type-preview" data-stldocs-type-preview="union"><span class="stldocs-type-preview-content"><span class="stldocs-type"><span class="stldocs-type-reference"><a href="/api/reference/resources/$shared#(resource)%20%24shared%20%3E%20(model)%20reasoning%20%3E%20(schema)">Reasoning</a></span><span class="stldocs-type-preview" data-stldocs-type-preview="properties"><span class="stldocs-type-brace"> { </span><span class="stldocs-type-preview-content"><span class="stldocs-type-propertyname"><span class="stldocs-text-identifier">context</span></span><span class="stldocs-text-operator">, </span><span class="stldocs-type-propertyname"><span class="stldocs-text-identifier">effort</span></span><span class="stldocs-text-operator">, </span><span class="stldocs-type-propertyname"><span class="stldocs-text-identifier">generate_summary</span></span><span class="stldocs-text-operator">, </span><span class="stldocs-truncation">2<!-- --> more</span></span><span class="stldocs-type-brace"> } </span></span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-type-plain">null</span></span></span></span></span></div><div class="stldocs-property-description"><div class="stldocs-markdown stldocs-content stl-ui-prose"><p><strong>gpt-5 and o-series models only</strong> Configuration options for <a href="/api/docs/guides/reasoning">reasoning models</a>.</p>
</div></div></div></div></summary><div class="stldocs-expander-content"><div class="stldocs-property-children"><div class="stldocs-properties"><div class="stldocs-property" data-stldocs-language="http"><details class="stldocs-expander" data-stldocs-expander-muted="false"><summary class="stldocs-expander-summary"><div class="stldocs-expander-summary-icon"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus stldocs-icon" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus stldocs-icon" aria-hidden="true"><path d="M5 12h14"></path></svg></div><div class="stldocs-expander-summary-content"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) reasoning &gt; (schema) + (resource) $shared &gt; (model) reasoning &gt; (schema) &gt; (property) context" class="stldocs-property-info"><div class="stldocs-property-declaration"><span class="stldocs-type-propertyname"><span class="stldocs-text-identifier">context</span></span><span class="stldocs-text-punctuation">: </span><span class="stldocs-text-punctuation">optional </span><span class="stldocs-type"><span class="stldocs-type-preview" data-stldocs-type-preview="union"><span class="stldocs-type-preview-content"><span class="stldocs-type"><span class="stldocs-type-preview" data-stldocs-type-preview="union"><span class="stldocs-type-preview-content"><span class="stldocs-type"><span class="stldocs-literal-string">&quot;auto&quot;</span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-literal-string">&quot;current_turn&quot;</span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-literal-string">&quot;all_turns&quot;</span></span></span></span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-type-plain">null</span></span></span></span></span></div><div class="stldocs-property-description"><div class="stldocs-markdown stldocs-content stl-ui-prose"><p>Controls which reasoning items are rendered back to the model on later turns.
If omitted or set to <code>auto</code>, the model determines the context mode. The
<code>gpt-5.6</code> model family defaults to <code>all_turns</code>; earlier models default to
<code>current_turn</code>.</p>
<p>When returned on a response, this is the effective reasoning context mode
used for the response.</p>
</div></div></div></div></summary><div class="stldocs-expander-content"><div class="stldocs-property-children"><div class="stldocs-property-annotation">One of the following:</div><div class="stldocs-properties"><div class="stldocs-property" data-stldocs-language="http"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) reasoning &gt; (schema) + (resource) $shared &gt; (model) reasoning &gt; (schema) &gt; (property) context &gt; (member) 0" class="stldocs-property-info"><div class="stldocs-property-declaration"><span class="stldocs-type"><span class="stldocs-literal-string">&quot;auto&quot;</span></span></div></div><a href="#(resource)%20responses.input_tokens%20%3E%20(method)%20count%20%3E%20(params)%200%20%3E%20(param)%20reasoning%20%3E%20(schema)%20%2B%20(resource)%20%24shared%20%3E%20(model)%20reasoning%20%3E%20(schema)%20%3E%20(property)%20context%20%3E%20(member)%200" aria-label="Link to this property" class="stl-ui-button stl-ui-button--outline stl-ui-button--size-sm stl-ui-button--with-border not-content stl-ui-not-prose stldocs-deep-link-button"><span class="stl-ui-button__icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></span></a></div><div class="stldocs-property" data-stldocs-language="http"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) reasoning &gt; (schema) + (resource) $shared &gt; (model) reasoning &gt; (schema) &gt; (property) context &gt; (member) 1" class="stldocs-property-info"><div class="stldocs-property-declaration"><span class="stldocs-type"><span class="stldocs-literal-string">&quot;current_turn&quot;</span></span></div></div><a href="#(resource)%20responses.input_tokens%20%3E%20(method)%20count%20%3E%20(params)%200%20%3E%20(param)%20reasoning%20%3E%20(schema)%20%2B%20(resource)%20%24shared%20%3E%20(model)%20reasoning%20%3E%20(schema)%20%3E%20(property)%20context%20%3E%20(member)%201" aria-label="Link to this property" class="stl-ui-button stl-ui-button--outline stl-ui-button--size-sm stl-ui-button--with-border not-content stl-ui-not-prose stldocs-deep-link-button"><span class="stl-ui-button__icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></span></a></div><div class="stldocs-property" data-stldocs-language="http"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) reasoning &gt; (schema) + (resource) $shared &gt; (model) reasoning &gt; (schema) &gt; (property) context &gt; (member) 2" class="stldocs-property-info"><div class="stldocs-property-declaration"><span class="stldocs-type"><span class="stldocs-literal-string">&quot;all_turns&quot;</span></span></div></div><a href="#(resource)%20responses.input_tokens%20%3E%20(method)%20count%20%3E%20(params)%200%20%3E%20(param)%20reasoning%20%3E%20(schema)%20%2B%20(resource)%20%24shared%20%3E%20(model)%20reasoning%20%3E%20(schema)%20%3E%20(property)%20context%20%3E%20(member)%202" aria-label="Link to this property" class="stl-ui-button stl-ui-button--outline stl-ui-button--size-sm stl-ui-button--with-border not-content stl-ui-not-prose stldocs-deep-link-button"><span class="stl-ui-button__icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-