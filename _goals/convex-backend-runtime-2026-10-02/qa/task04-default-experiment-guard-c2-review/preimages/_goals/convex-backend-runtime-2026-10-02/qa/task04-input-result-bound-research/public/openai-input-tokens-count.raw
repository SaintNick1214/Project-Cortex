"0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-minus stldocs-icon" aria-hidden="true"><path d="M5 12h14"></path></svg></div><div class="stldocs-expander-summary-content"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) input &gt; (schema) &gt; (variant) 1 &gt; (items) &gt; (variant) 10 &gt; (property) tools &gt; (items) &gt; (variant) 8 &gt; (property) background" class="stldocs-property-info"><div class="stldocs-property-declaration"><span class="stldocs-type-propertyname"><span class="stldocs-text-identifier">background</span></span><span class="stldocs-text-punctuation">: </span><span class="stldocs-text-punctuation">optional </span><span class="stldocs-type"><span class="stldocs-type-preview" data-stldocs-type-preview="union"><span class="stldocs-type-preview-content"><span class="stldocs-type"><span class="stldocs-literal-string">&quot;transparent&quot;</span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-literal-string">&quot;opaque&quot;</span></span><span class="stldocs-text-operator"> <!-- -->or<!-- --> </span><span class="stldocs-type"><span class="stldocs-literal-string">&quot;auto&quot;</span></span></span></span></span></div><div class="stldocs-property-description"><div class="stldocs-markdown stldocs-content stl-ui-prose"><p>Set the background of the generated image. One of <code>transparent</code>, <code>opaque</code>,
or <code>auto</code>. <code>gpt-image-2.5-sunburst</code> and <code>gpt-image-2.5-flare</code>, including
their <code>2026-09-08</code> snapshots, support <code>opaque</code> and <code>transparent</code>
backgrounds. Transparent backgrounds are available for supported GPT Image
models. For <code>gpt-image-2</code> and <code>gpt-image-2-2026-04-21</code>, this support is in
preview. When using <code>transparent</code>, set the output format to <code>png</code> or <code>webp</code>.
Default: <code>auto</code>.</p>
</div></div></div></div></summary><div class="stldocs-expander-content"><div class="stldocs-property-children"><div class="stldocs-property-annotation">One of the following:</div><div class="stldocs-properties"><div class="stldocs-property" data-stldocs-language="http"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) input &gt; (schema) &gt; (variant) 1 &gt; (items) &gt; (variant) 10 &gt; (property) tools &gt; (items) &gt; (variant) 8 &gt; (property) background &gt; (member) 0" class="stldocs-property-info"><div class="stldocs-property-declaration"><span class="stldocs-type"><span class="stldocs-literal-string">&quot;transparent&quot;</span></span></div></div><a href="#(resource)%20responses.input_tokens%20%3E%20(method)%20count%20%3E%20(params)%200%20%3E%20(param)%20input%20%3E%20(schema)%20%3E%20(variant)%201%20%3E%20(items)%20%3E%20(variant)%2010%20%3E%20(property)%20tools%20%3E%20(items)%20%3E%20(variant)%208%20%3E%20(property)%20background%20%3E%20(member)%200" aria-label="Link to this property" class="stl-ui-button stl-ui-button--outline stl-ui-button--size-sm stl-ui-button--with-border not-content stl-ui-not-prose stldocs-deep-link-button"><span class="stl-ui-button__icon"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></span></a></div><div class="stldocs-property" data-stldocs-language="http"><div id="(resource) responses.input_tokens &gt; (method) count &gt; (params) 0 &gt; (param) input &gt; (schema) &gt; (variant) 1 &gt; (items) &gt; (variant) 10 &gt; (property) tools &gt; (items) &gt; (variant) 8 &gt; (property) background &gt; (member) 1" class="stldocs-property-info"><div cla