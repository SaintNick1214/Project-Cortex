def seal(root,name,refs=None):
 rows=[]
 def walk(p):
  r=row(p);r['path']=str(p.relative_to(root)) or '.';rows.append(r)
  if r['kind']=='directory':
   names=sorted(os.listdir(p));r['members']=names
   for n in names:
    if p==root and n==name:continue
    walk(p/n)
   assert r['identity']==ident(os.lstat(p))
 walk(root)
 d={'root':str(root),'excludedSelfOnly':[name],'status':'LITERAL_FROZEN_CANDIDATE_NOT_ACCEPTANCE','rows':rows,'references':refs or []};raw=(json.dumps(d,sort_keys=True,separators=(',',':'))+'\n').encode();dest=root/name
 if name.endswith('.gz'):dest.write_bytes(gzip.compress(raw,compresslevel=6,mtime=0))
 else:dest.write_bytes(raw)
 out=row(dest);out.update(decodedBytes=len(raw),decodedSHA256=hashlib.sha256(raw).hexdigest(),membershipRows=len(rows));print(json.dumps(out),flush=True);return out
