def ident(s): return fs_identity(s)
def row(p):
 s=os.lstat(p);r={'path':str(p),'identity':ident(s)}
 if stat.S_ISLNK(s.st_mode):r.update(kind='symlink',target=os.readlink(p));assert ident(s)==ident(os.lstat(p));return r
 if stat.S_ISDIR(s.st_mode):r.update(kind='directory');return r
 assert stat.S_ISREG(s.st_mode),str(p)
 fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW);h=hashlib.sha256();n=0
 try:
  assert ident(s)==ident(os.fstat(fd))
  while True:
   b=os.read(fd,1024*1024)
   if not b:break
   h.update(b);n+=len(b)
  assert ident(s)==ident(os.fstat(fd))==ident(os.lstat(p))
 finally:os.close(fd)
 r.update(kind='file',bytes=n,sha256=h.hexdigest());return r
