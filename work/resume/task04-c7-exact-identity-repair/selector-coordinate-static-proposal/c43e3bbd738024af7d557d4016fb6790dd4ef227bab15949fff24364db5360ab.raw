import assert from'node:assert/strict';import*as fs from'node:fs';import*as path from'node:path';import{SourceTextModule,SyntheticModule}from'node:vm';import{prepared}from'./prepared-guard.mjs';import{root,kind,digest}from'./dispatch-context.mjs';import{randomUUID}from'node:crypto';
const results=[];for(const mode of['healthy','source-after-build','compiler-after-build','pin-after-build']){const h=await prepared();let imports=0,builds=0,effects=0;const source=fs.readFileSync(process.argv[3]??path.resolve(root,'scripts/cli-prerequisites.mjs'),'utf8'),stage=path.resolve(h.module.scratch,'deploy-synthetic'),work=path.resolve(h.module.scratch,'router-work');fs.mkdirSync(work,{mode:0o700});fs.writeFileSync(path.resolve(stage,'convex/http.ts'),'DUMMY_PUBLIC_ROUTER');fs.writeFileSync(path.resolve(stage,'convex/qualificationPeer.ts'),'DUMMY_PUBLIC_EFFECT');const effect=()=>{effects++;};const router={getRoutes:()=>[['/qa/task04-peer/effect','POST',effect]]};const synth=obj=>new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:h.vmContext});const module=new SourceTextModule(source,{context:h.vmContext,identifier:path.resolve(root,'scripts/cli-prerequisites.mjs'),initializeImportMeta:m=>m.url='file://'+path.resolve(root,'scripts/cli-prerequisites.mjs'),importModuleDynamically:async()=>{imports++;const m=synth({router,effect});await m.link(()=>{});await m.evaluate();return m;}});await module.link(async n=>n==='./guard.mjs'?synth(h.module):n==='esbuild'?synth({build:async()=>{builds++;await Promise.resolve();if(mode==='source-after-build')h.put('fixture/module.ts','DUMMY_LATE_SOURCE_DRIFT');if(mode==='compiler-after-build')fs.writeFileSync(path.resolve(h.base,'compiler-runtime.js'),'DUMMY_LATE_COMPILER_DRIFT');if(mode==='pin-after-build')h.env.CORTEX_QA_TASK04_REVIEW_SHA256='0'.repeat(64);}}):synth(await import(n)));await module.evaluate();let error;try{await module.namespace.observedHttpRouter(stage,work);}catch(e){error=e;}let failure;try{assert.equal(builds,1);assert.equal(imports,mode==='healthy'?1:0,'original expected-zero post-build dynamic import assertion');assert.equal(effects,0);if(mode==='healthy')assert.equal(error,undefined);else assert.ok(error);}catch(e){failure=e.message;}results.push({mode,builds,imports,effects,error:error?.message??null,failure,status:failure?'FAIL':'PASS',sourceSHA256:digest(source),scope:'EXACT_CLI_PREREQUISITE_FUNCTION_ACTUAL_GUARD_DUMMY_DEFERRED_BUILD_AND_DYNAMIC_IMPORT_HOOK_NO_NATIVE'});}const file='router-import-'+randomUUID()+'.json';fs.writeFileSync(path.resolve(root,'evidence',file),JSON.stringify({kind,results,native:'NOT_RUN'},null,2)+'\n');console.log(JSON.stringify({kind,results,file}));assert.equal(results.filter(x=>x.failure).length,0,'post-build expected-zero imports remain mandatory');
