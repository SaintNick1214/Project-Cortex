import assert from'node:assert/strict';import*as fs from'node:fs';import*as path from'node:path';import{randomUUID}from'node:crypto';import{SourceTextModule,SyntheticModule}from'node:vm';import{actualDriver}from'./probe-driver-harness.mjs';import{kind,root}from'./reviewer-dispatch-context.mjs';
const results=[];
for(const mode of ['healthy','receipt-fsync','receipt-close','receipt-validation']){
 let stage='setup',seedFault=false,recoveryFault=false,clockOffset=0,s,custodyReader=()=>s.custodyComplete();const fdPaths=new Map(),events=[];const initial=Error('DUMMY_TERMINAL_FSYNC_FAILURE'),recovery=Error('DUMMY_RECOVERY_PRIMARY'),secondary=Error('DUMMY_RECOVERY_SECONDARY');const ports={openSync(p,...a){const fd=fs.openSync(p,...a);fdPaths.set(fd,p);events.push({stage,op:'open',path:p});return fd;},fstatSync(fd){const x=fs.fstatSync(fd);if(stage==='recovery'&&mode==='receipt-binding'&&fdPaths.get(fd)?.includes('/owned-created-'))return{...x,isFile:()=>true,ino:x.ino+1};return x;},fsyncSync(fd){const p=fdPaths.get(fd);events.push({stage,op:'fsync',path:p});if(stage==='seed'&&!seedFault&&p?.endsWith('ticket-native-0001.json')&&fs.readFileSync(p,'utf8').includes('QA_CREATION_SETTLED_V1')){seedFault=true;throw initial;}if(stage==='recovery'&&((mode==='receipt-fsync'&&p?.includes('/owned-deleted-'))||(['ticket-fsync','ticket-fsync-close'].includes(mode)&&p?.endsWith('ticket-native-0001.json')))){recoveryFault=true;throw recovery;}if(stage==='recovery'&&((mode==='receipt-deadline'&&p?.includes('/owned-deleted-'))||(mode==='ticket-deadline'&&p?.endsWith('ticket-native-0001.json'))))clockOffset=13000;if(stage==='recovery'&&p?.endsWith('ticket-native-0001.json'))assert.equal(custodyReader(),false,'ack forbidden before recovery fsync returns');return fs.fsyncSync(fd);},closeSync(fd){const p=fdPaths.get(fd);fs.closeSync(fd);fdPaths.delete(fd);events.push({stage,op:'close',path:p});if(stage==='recovery'&&((mode==='receipt-close'&&p?.includes('/owned-deleted-'))||(mode==='ticket-close'&&p?.endsWith('ticket-native-0001.json')))){recoveryFault=true;throw recovery;}if(stage==='recovery'&&mode==='ticket-fsync-close'&&p?.endsWith('ticket-native-0001.json'))throw secondary;if(stage==='recovery'&&p?.endsWith('ticket-native-0001.json'))assert.equal(custodyReader(),false,'ack forbidden before recovery close returns');}};
 const{h,driver}=await actualDriver(ports);const ActualDate=Date;h.vmContext.Date=class extends ActualDate{static now(){return ActualDate.now()+clockOffset;}};const refs=['runtimeAuthPrincipals','runtimeAuthMemberships','runtimeAuthScopes','runtimeAuthScopes','runtimeAuthGrants','runtimeAuthGrants','runtimeMemorySources'].map((table,i)=>({table,id:'DUMMY_EXISTING_CREATED_'+i}));let calls=0;h.vmContext.fetch=async(url,o)=>{calls++;const body=JSON.parse(o.body);if(body.path==='qualificationOwned:seed')return new Response(JSON.stringify({status:'success',value:{createdRefs:refs}}));if(body.path==='qualificationOwned:cleanup')return new Response(JSON.stringify({status:'success',value:{deletedRefs:refs}}));if(body.path==='qualificationOwned:DUMMY_unknown')throw Error('DUMMY_UNKNOWN_NATIVE_RETURN');if(body.path==='qualificationOwned:snapshot')return new Response(JSON.stringify({status:'success',value:true?[]:refs.map(ref=>({table:ref.table,id:ref.id,row:{tenantId:s.runId+'-fresh-durability',subject:s.runId+'-fresh-durability'}}))}));throw Error('DUMMY_UNEXPECTED_RPC');};s=await driver.namespace.session('synthetic');stage='seed';let caught;try{await s.rpc('mutation','qualificationOwned:seed',{run:s.runId,caseId:'fresh-durability'});}catch(e){caught=e;}assert.equal(caught,initial);assert.equal(s.custodyComplete(),false);assert.equal(s.counts().cumulativeCreatedRows,7);const ticket=path.resolve(h.module.scratch,'ticket-native-0001.json'),prefix=fs.readFileSync(ticket);const owned=fs.readdirSync(h.module.scratch).filter(n=>n.startsWith('owned-created-')).map(n=>path.resolve(h.module.scratch,n));
 stage='cleanup';await s.rpc('mutation','qualificationOwned:cleanup',{run:s.runId});const deleted=fs.readdirSync(h.module.scratch).filter(n=>n.startsWith('owned-deleted-')).map(n=>path.resolve(h.module.scratch,n));assert.equal(deleted.length,7);if(mode==='receipt-validation'){const p=deleted[0],v=JSON.parse(fs.readFileSync(p));v.operation='FOREIGN_OPERATION';fs.writeFileSync(p,JSON.stringify(v));}if(mode==='ticket-validation')fs.appendFileSync(ticket,'DUMMY_INVALID_SUFFIX');
 
 if(mode==='mixed-unknown'||mode==='unknown-pending'){stage='recovery';await assert.rejects(()=>s.rpc('mutation','qualificationOwned:DUMMY_unknown',{}),/DUMMY_UNKNOWN_NATIVE_RETURN/);}
 stage='recovery';const cut=events.length;let error;try{await s.rpc('query','qualificationOwned:snapshot',{run:s.runId});}catch(e){error=e;}
 const failing=!['healthy','fresh-process','empty-known'].includes(mode);assert.equal(s.custodyComplete(),!failing);assert.equal(s.counts().rpc,['mixed-unknown','unknown-pending'].includes(mode)?4:3);assert.equal(fs.readdirSync(h.module.scratch).filter(n=>/^ticket-native-/.test(n)).length,['mixed-unknown','unknown-pending'].includes(mode)?4:3);assert.equal(s.counts().cumulativeCreatedRows,7);assert.equal(caught,initial,'original primary identity remains unchanged');
 const later=events.slice(cut);if(!failing){assert.equal(new Set(later.filter(x=>x.op==='fsync'&&[...owned,...deleted].includes(x.path)).map(x=>x.path)).size,14);assert.equal(later.some(x=>x.op==='fsync'&&x.path===ticket),true);assert.equal(later.some(x=>x.op==='close'&&x.path===ticket),true);assert.equal(fs.readFileSync(ticket).equals(prefix),true,'immutable ticket bytes/prefix remain exact');}if(['receipt-fsync','receipt-close','ticket-fsync','ticket-close','ticket-fsync-close'].includes(mode)){assert.equal(error,recovery);assert.equal(recoveryFault,true);}if(mode==='ticket-fsync-close')assert.equal(error.qaDurableCloseFailure,secondary);if(mode==='receipt-deadline'||mode==='ticket-deadline')assert.match(error.message,/QA_RPC_TIME_BUDGET/);if(mode==='receipt-validation')assert.match(error.message,/QA_OWNERSHIP_COLLISION/);if(mode==='receipt-binding')assert.match(error.message,/QA_DURABLE_BINDING/);if(mode==='unknown-pending'||mode==='mixed-unknown')assert.equal(s.counts().unknownCreationCalls,1);
 if(mode==='fresh-process'){const fresh=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts/guard.mjs'),'utf8'),{context:h.vmContext,identifier:path.resolve(h.packet,'scripts/guard.mjs'),initializeImportMeta:m=>m.url='file://'+path.resolve(h.packet,'scripts/guard.mjs')});await fresh.link(async n=>{const obj={...await import(n),...(n==='node:fs'?ports:{})};return new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:h.vmContext});});await fresh.evaluate();custodyReader=()=>fresh.namespace.creationCustodyCounts().uncertainCreationCalls===0;assert.equal(fresh.namespace.creationCustodyCounts().knownUndurableCreationCalls,1);for(const p of owned)fresh.namespace.durableExistingPrivate(p,body=>{const v=JSON.parse(body);assert.equal(v.operation,s.target.operation);assert.equal(v.kind,'created');assert.equal(refs.some(r=>r.id===v.id&&r.table===v.table),true);});fresh.namespace.creationAcknowledge({kind:'native',sequence:1});assert.equal(fresh.namespace.creationCustodyCounts().uncertainCreationCalls,0);}
 results.push({mode,status:'PASS',calls,error:error?.message??null,counts:s.counts(),events:later,initialPrimaryPreserved:true});s.close();}
const out=path.resolve('/dev/shm/cortex-native-c6-closed-launcher-c6/mirror/work/resume/task04-model-drift-native-preparation-c5',kind+'-deleted-recovery-'+randomUUID()+'.json');fs.writeFileSync(out,JSON.stringify({results,source:'EXACT_SOURCE_INSTALLED_SDK_DUMMY_PRIVATE_FS',native:'NOT_RUN'},null,2)+'\n');console.log(JSON.stringify({kind,controls:results.length,status:'PASS',out}));
