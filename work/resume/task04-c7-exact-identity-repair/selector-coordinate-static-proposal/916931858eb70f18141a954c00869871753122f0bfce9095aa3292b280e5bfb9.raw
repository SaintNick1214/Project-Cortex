import assert from'node:assert/strict';import fs from'node:fs';import path from'node:path';import crypto from'node:crypto';import{SourceTextModule,SyntheticModule}from'node:vm';import{context,approval,kind,root,digest}from'./dispatch-context.mjs';
const results=[];for(const mode of['healthy','within-call-symlink','between-call-symlink']){const h=await context();fs.writeFileSync(path.resolve(h.packet,'fixture/z.ts'),'second');const freeze=JSON.parse(fs.readFileSync(path.resolve(h.packet,'runtime-freeze.json')));freeze.operationalPaths.push('fixture/z.ts');freeze.operationalPaths.sort();freeze.files.push({path:'fixture/z.ts',bytes:6,sha256:digest('second')});freeze.files.sort((a,b)=>a.path.localeCompare(b.path));h.put('runtime-freeze.json',freeze);const manifest=JSON.parse(fs.readFileSync(path.resolve(h.packet,'qa-manifest.json')));manifest.files.push({path:'fixture/z.ts',bytes:6,sha256:digest('second')});for(const row of manifest.files){const bytes=fs.readFileSync(path.resolve(h.packet,row.path));row.bytes=bytes.length;row.sha256=digest(bytes);}manifest.files.sort((a,b)=>a.path.localeCompare(b.path));h.put('qa-manifest.json',manifest);h.review.preservationManifestSHA256=digest(fs.readFileSync(path.resolve(h.packet,'qa-manifest.json')));const a=approval(h);h.env.CORTEX_QA_TASK04_REVIEW_SHA256=digest(fs.readFileSync(a.file));let armed=false,mutated=false;const mutate=()=>{if(mutated)return;mutated=true;fs.renameSync(path.resolve(h.packet,'fixture'),path.resolve(h.packet,'fixture-original'));fs.symlinkSync('fixture-original',path.resolve(h.packet,'fixture'));};const source=fs.readFileSync(path.resolve(root,'scripts/guard.mjs'),'utf8'),port={...fs,readFileSync(p,...args){const bytes=fs.readFileSync(p,...args);if(armed&&mode==='within-call-symlink'&&p===path.resolve(h.packet,'fixture/module.ts'))mutate();return bytes;}};const module=new SourceTextModule(source,{context:h.vmContext,identifier:path.resolve(h.packet,'scripts/guard.mjs'),initializeImportMeta:m=>m.url='file://'+path.resolve(h.packet,'scripts/guard.mjs')});await module.link(async n=>{const obj=n==='node:fs'?port:await import(n);return new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:h.vmContext});});await module.evaluate();module.namespace.reviewed();armed=true;if(mode==='between-call-symlink')mutate();let error;try{module.namespace.sourcePreflight('rpc');}catch(e){error=e;}if(mode==='healthy')assert.equal(error,undefined);else{assert.ok(error);assert.equal(error.message,'QA_PATH');}results.push({mode,status:'PASS',error:error?.message??null,mutated,nativeEffects:0});}const name='ancestor-dedup-'+crypto.randomUUID()+'.json';fs.writeFileSync(path.resolve(root,'evidence',name),JSON.stringify({kind,results,guardSHA256:digest(fs.readFileSync(path.resolve(root,'scripts/guard.mjs'))),scope:'EXACT_GUARD_WITHIN_SYNCHRONOUS_CALL_FS_PORT_INJECTION_DUMMY_PUBLIC_SOURCE_ONLY_NO_PRIVATE_CACHE'},null,2)+'\n');console.log(kind+' '+results.length+' ancestor controls PASS '+name);
