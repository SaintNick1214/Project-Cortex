/** Actual prepared case functions / registered handlers, offline fake DB only, never native/OCC proof. */
import assert from 'node:assert/strict';import{readFileSync,writeFileSync,mkdirSync}from'node:fs';import{resolve}from'node:path';import{pathToFileURL}from'node:url';import{SourceTextModule,SyntheticModule,createContext}from'node:vm';import{build}from'esbuild';import{getFunctionName}from'convex/server';import{createHash}from'node:crypto';
import{repo,root}from './guard.mjs';const work=resolve(repo,'/dev/shm/cortex-native-c6-closed-launcher-c6/mirror/work/resume/task04-model-drift-native-preparation-c5/extra');
const entry=resolve(work,'handler-entry.ts'),out=resolve(work,'handlers.mjs');writeFileSync(entry,`export * as policy from ${JSON.stringify(resolve(root,'fixture/convex/runtimeModelPolicy.ts'))};export * as owned from ${JSON.stringify(resolve(root,'fixture/convex/qualificationOwned.ts'))};export * as capture from ${JSON.stringify(resolve(root,'fixture/convex/qualificationCapture.ts'))};export {MemoryTestDb} from ${JSON.stringify(resolve(repo,'tests/unit/runtimeMemory/fixture.ts'))};`);const built=await build({entryPoints:[entry],outfile:out,bundle:true,platform:'node',format:'esm',packages:'external',metafile:true,logLevel:'silent'});writeFileSync(resolve(work,'handlers-metafile.json'),JSON.stringify(built.metafile,null,2)+'\n');const compiled=await import(pathToFileURL(out));const plan=JSON.parse(readFileSync(resolve(root,'cases.json'))),source=readFileSync(resolve(root,'scripts/cases.mjs'),'utf8');const originalCases=await import(pathToFileURL(resolve(root,'scripts/original-b-cases.mjs'))),gateway=await import(pathToFileURL(resolve(root,'scripts/gateway-native-composition.mjs')));
const hostileControls=[];const outcomes=[],failures=[];for(const definition of plan.scenarios){
 const db=new compiled.MemoryTestDb();let time=1021000,rpc=0,nested=0,peak=0;const originalNow=Date.now;Date.now=()=>time;const trace=[];
 db.patch=async(table,id,updates)=>{const row=await db.get(table,id);if(!row)throw Error('QA_MISSING');db.writes++;for(const[k,v]of Object.entries(updates))if(v===undefined)delete row[k];else row[k]=structuredClone(v);};db.delete=async(table,id)=>{if(id===undefined){id=table;table=id.split(':')[0];}const rows=db.table(table),index=rows.findIndex(x=>x._id===id);if(index<0)throw Error('QA_MISSING');db.writes++;rows.splice(index,1);};
 const invoke=async(path,args)=>{const[name,key]=path.split(':'),module={runtimeModelPolicy:compiled.policy,qualificationOwned:compiled.owned,qualificationCapture:compiled.capture}[name];assert.ok(module?.[key],path);return await module[key]._handler(ctx,args);};const ctx={db,runMutation:async(ref,args)=>{nested++;return await db.transaction(()=>invoke(getFunctionName(ref),args));}};
 let tail=Promise.resolve();const runId=JSON.parse(readFileSync(resolve(root,'project-request.json'))).runId;const s={runId,rpc:async(type,path,args)=>{rpc++;trace.push({path,type,status:'PENDING'});const row=trace.at(-1);const execute=async()=>{try{if(path==='qualificationCapture:partialMarker'){
 for(const[label,hostile]of [['invalid-run',{...args,run:'unsafe'}],['foreign-owned-run',{...args,run:'admission-'+('0'.repeat(32))}],['missing-attempt',{...args,attemptId:'runtimeModelAttempts:999999'}]]){
 const before=JSON.stringify([...db.rows]),writes=db.writes;await assert.rejects(()=>db.transaction(()=>invoke(path,hostile)));assert.equal(JSON.stringify([...db.rows]),before);assert.equal(db.writes,writes);hostileControls.push({caseId:definition.id,variant:args.variant,label,completeStateEqual:true,writes:0});
 }
 }const result=type==='mutation'?await db.transaction(()=>invoke(path,args)):await invoke(path,args);peak=Math.max(peak,[...db.rows.values()].reduce((n,a)=>n+a.length,0));row.status='PASS';return structuredClone(result);}catch(e){row.status='FAIL';row.code=e?.data?.code??e?.message;throw e;}};const pending=tail.then(execute);tail=pending.catch(()=>{});return await pending;}};
 const vm=createContext({Date,Buffer,Error,JSON,setTimeout:(fn,delay)=>{time+=delay;fn();}});const make=(name,values)=>new SyntheticModule(Object.keys(values),function(){for(const[k,v]of Object.entries(values))this.setExport(k,v);},{context:vm,identifier:name});
 const module=new SourceTextModule(source,{context:vm,identifier:'exact-prepared-drift-cases'});await module.link(name=>name==='node:assert/strict'?make(name,{default:assert}):name==='./original-b-cases.mjs'?make(name,{canonical:originalCases.canonical,request:originalCases.request}):name==='./guard.mjs'?make(name,{qualifierDeadline:()=>1021000+1200000}):name==='./gateway-native-composition.mjs'?make(name,{gatewayNative:gateway.gatewayNative}):assert.fail('UNKNOWN_IMPORT '+name));
 try{await module.evaluate();await module.namespace.scenario(s,definition.id);await s.rpc('query','qualificationOwned:snapshot',{run:runId});await s.rpc('mutation','qualificationOwned:cleanup',{run:runId});const left=await s.rpc('query','qualificationOwned:snapshot',{run:runId});assert.equal(left.length,0);const ceiling=definition.rpcCeiling;assert.ok(rpc<=ceiling,'RPC '+rpc+' exceeds '+ceiling);assert.ok(db.sequence<=definition.maximumCommittedCreatedRows,'Creates '+db.sequence+' exceeds '+definition.maximumCommittedCreatedRows);assert.ok(peak<=32);outcomes.push({id:definition.id,rpcIncludingThreePostCleanup:rpc,created:db.sequence,peak,nested,trace,status:'PASS_OFFLINE_HANDLER_COMPOSITION_ONLY'});console.log(definition.id+' '+rpc+'RPC '+db.sequence+'created PASS_OFFLINE');}
 catch(e){failures.push({id:definition.id,rpc,created:db.sequence,peak,nested,trace,error:{name:e.name,message:e.message,stack:e.stack,data:e.data},status:'FAIL'});console.error(definition.id+' FAIL '+e.message);}finally{Date.now=originalNow;}
}
writeFileSync(resolve(work,'outcomes-operative-source-validator.json'),JSON.stringify({outcomes,failures,hostileControls,sourceSha256:createHash('sha256').update(source).digest('hex'),native:'NOT_RUN'},null,2)+'\n');if(failures.length)process.exitCode=1;
