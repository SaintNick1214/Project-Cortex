import assert from'node:assert/strict';import *as fs from'node:fs';import *as path from'node:path';import{SourceTextModule,SyntheticModule}from'node:vm';import{ConvexHttpClient}from'convex/browser';import{prepared,mutate}from'./reviewer-prepared-guard.mjs';import{root,kind,digest}from'./reviewer-dispatch-context.mjs';
const output=path.resolve('/dev/shm/cortex-native-c6-closed-launcher-c6/mirror/work/resume/task04-model-drift-native-preparation-c5');const results=[];
for(const type of ['query','mutation','action'])for(const outcome of ['healthy','http','udf','transport']){
 const h=await prepared();Object.assign(h.vmContext,{URL,Response,TextDecoder,TextEncoder,Uint8Array,TransformStream,ReadableStream,WritableStream,Headers,Request,crypto:globalThis.crypto});h.vmContext.process.argv=['node','offline-queue-controls'];const cache=new Map();
 const synth=obj=>new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:h.vmContext});const guard=synth({...h.module});cache.set('guard.mjs',guard);
 async function load(name){if(cache.has(name))return cache.get(name);const m=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts',name),'utf8'),{context:h.vmContext,identifier:path.resolve(root,'scripts',name),initializeImportMeta:m=>m.url='file://'+path.resolve(root,'scripts',name)});cache.set(name,m);await m.link(async spec=>{if(spec.startsWith('.'))return load(path.normalize(path.join(path.dirname(name),spec)));return synth(await import(spec));});return m;}
 const artifacts=await load('publication-artifacts.mjs');await artifacts.evaluate();const inventory=h.module.json(path.resolve(h.packet,'registration-inventory.json')).registrations;const published=inventory.map(row=>({identifier:row.path.replace(':','.js:'),functionType:row.type[0].toUpperCase()+row.type.slice(1),visibility:row.visibility,args:row.args}));published.push({functionType:'HttpAction',path:'/qa/task04-peer/effect',method:'POST'});const raw=artifacts.namespace.captureRawResponse('synthetic',h.baseline.target.operation,Buffer.from(JSON.stringify({status:'success',value:published})),200);fs.unlinkSync(path.resolve(h.module.scratch,'publication-synthetic.json'));artifacts.namespace.writePublication('synthetic',h.baseline.target.operation,published,h.baseline.publication,raw,{routes:[{path:'/qa/task04-peer/effect',method:'POST'}],basis:'DUMMY'});h.baseline=h.module.livePreflight('synthetic');const identities=Object.fromEntries(['expiredJWT','foreign','forgedJWT','noJWT','ungranted','wrongAudience','wrongIssuer'].map(x=>[x,'']));h.putPrivate('identities.json',{operation:h.baseline.target.operation,runId:h.module.json(path.resolve(h.packet,'project-request.json')).runId,identities});
 const driver=await load('driver.mjs');await driver.evaluate();let dispatches=0;const primary=Error('DUMMY_TRANSPORT');h.vmContext.fetch=async()=>{dispatches++;if(outcome==='transport')throw primary;if(outcome==='http')return new Response(JSON.stringify({code:'InvalidAuth',message:'DUMMY'}),{status:403});if(outcome==='udf')return new Response(JSON.stringify({status:'error',errorMessage:'DUMMY',errorData:{code:'DUMMY_UDF'}}),{status:560});return new Response(JSON.stringify({status:'success',value:null}),{status:200});};const s=await driver.namespace.session('synthetic');const client=s.create('DUMMY');assert.equal(Object.keys(client).length,0);assert.equal(client.query,undefined);assert.equal(client.mutation,undefined);assert.equal(client.action,undefined);assert.equal(client.consistentQuery,undefined);let error;try{await s.rpc(type,'qualificationOwned:DUMMY_'+type,{},client);}catch(e){error=e;}assert.equal(dispatches,1);assert.equal(fs.readdirSync(h.module.scratch).filter(x=>x.startsWith('ticket-native-')).length,1);assert.equal(Boolean(error),outcome!=='healthy');const tickets=fs.readdirSync(h.module.scratch).filter(x=>x.startsWith('ticket-native-')).length;for(const method of ['consistentQuery','function','queryInner','mutationInner','setAuth','constructor'])await assert.rejects(()=>s.rpc(method,'qualificationOwned:DUMMY',{},client),e=>e.message==='QA_RPC_METHOD_BOUND');await assert.rejects(()=>s.rpc('query','qualificationOwned:DUMMY',{},{}),e=>e.message==='QA_RPC_METHOD_BOUND');assert.equal(dispatches,1);assert.equal(fs.readdirSync(h.module.scratch).filter(x=>x.startsWith('ticket-native-')).length,tickets);s.close();results.push({kind,type,outcome,callbacks:dispatches,tickets,status:'PASS'});console.log(JSON.stringify(results.at(-1)));}
fs.writeFileSync(path.resolve('/dev/shm/cortex-native-c6-closed-launcher-c6/mirror/work/resume/task04-model-drift-native-preparation-c5',kind+'-sdk-supported-results.json'),JSON.stringify({scope:'EXACT_DRIVER_ACTUAL_INSTALLED_SDK_OFFLINE_DUMMY_NETWORK_PORT',results},null,2)+'\n');
