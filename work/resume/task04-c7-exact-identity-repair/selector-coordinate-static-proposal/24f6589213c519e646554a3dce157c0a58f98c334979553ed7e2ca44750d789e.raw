import test from'node:test';import assert from'node:assert/strict';import *as fs from'node:fs';import *as path from'node:path';import *as crypto from'node:crypto';import *as util from'node:util';import{SourceTextModule,SyntheticModule,createContext}from'node:vm';import{pathToFileURL,fileURLToPath}from'node:url';const repo='/workspace/Project-Cortex';const kind=process.argv[2]??'extra';if(!['extension','regression','extra'].includes(kind))throw Error('KIND');const root=path.resolve(repo,'/dev/shm/cortex-native-c6-closed-launcher-c6/mirror/_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+kind+'-preparation-c5');
const area=path.resolve('/dev/shm/cortex-native-c6-closed-launcher-c6/mirror-tmp/runtime-proof-'+crypto.randomUUID());fs.mkdirSync(area,{mode:0o700});const digest=b=>crypto.createHash('sha256').update(b).digest('hex');
async function context(sourceOverride){const base=path.resolve(area,crypto.randomUUID()),packet=path.resolve(base,'a/b/c/d');fs.mkdirSync(path.resolve(packet,'scripts'),{recursive:true,mode:0o700});fs.mkdirSync(path.resolve(packet,'fixture'),{mode:0o700});const put=(name,value)=>fs.writeFileSync(path.resolve(packet,name),typeof value==='string'?value:JSON.stringify(value)+'\n');const external=[['parent.mjs','parent-source'],['watcher.mjs','watcher-source']].map(([name,body])=>{fs.writeFileSync(path.resolve(base,name),body);return{path:name,bytes:Buffer.byteLength(body),sha256:digest(body)};});fs.writeFileSync(path.resolve(base,'accepted.ts'),'accepted');fs.writeFileSync(path.resolve(base,'product.ts'),'product');const source=sourceOverride??fs.readFileSync(path.resolve(root,'scripts/guard.mjs'),'utf8');put('scripts/guard.mjs',source);for(const name of ['project-request.json','cases.json','registration-inventory.json','schema-evidence.json','profile.json','divergence.json','toolchain-evidence.json'])put(name,{});put('historical-preservation.json',{packets:[]});put('runtime-inputs.json',{externalSources:external});put('source-inventory.json',{acceptedGateHashes:[{path:'accepted.ts',sha256:digest('accepted')}],files:[{source:'product.ts',sha256:digest('product')}]});put('fixture/module.ts','fixture-source');put('history.txt','historical-evidence');const legacyRoots=['project-request.json','cases.json','source-inventory.json','registration-inventory.json','schema-evidence.json','profile.json','divergence.json','toolchain-evidence.json','runtime-inputs.json','historical-preservation.json'];const match=source.match(/export const runtimeRootInputs=Object.freeze\(\[([^\]]*)\]\)/),roots=match?[...match[1].matchAll(/'([^']+)'/g)].map(m=>m[1]):legacyRoots;for(const name of roots)if(!fs.existsSync(path.resolve(packet,name)))put(name,{});fs.writeFileSync(path.resolve(base,'runner-runtime.js'),'runner');fs.writeFileSync(path.resolve(base,'compiler-runtime.js'),'compiler');put('toolchain-evidence.json',{files:[{path:'compiler-runtime.js',sha256:digest('compiler')}]});put('runner-dependency-inventory.json',{inputs:[{path:'runner-runtime.js',bytes:6,sha256:digest('runner')}]});put('dependency-tiers.json',{rpc:{runner:[{path:'runner-runtime.js',bytes:6,sha256:digest('runner')}],tools:[]},boundaryOnly:{runner:[],tools:[{path:'compiler-runtime.js',sha256:digest('compiler')}]}});if(roots.includes('dependency-inventory.json'))put('dependency-inventory.json',{inputs:[]});const paths=['scripts/guard.mjs','fixture/module.ts',...roots].sort();const rec=name=>({path:name,bytes:fs.statSync(path.resolve(packet,name)).size,sha256:digest(fs.readFileSync(path.resolve(packet,name)))});put('runtime-freeze.json',{operationalPaths:paths,files:paths.map(rec)});const manifest={files:[...paths,'history.txt','runtime-freeze.json'].sort().map(rec)};put('qa-manifest.json',manifest);const review={preservationManifestSHA256:digest(fs.readFileSync(path.resolve(packet,'qa-manifest.json')))};const vmContext=createContext({process:{getuid:()=>process.getuid(),env:{}},Buffer,Date,setTimeout,clearTimeout,AbortSignal});const module=new SourceTextModule(source,{context:vmContext,importModuleDynamically:async name=>{assert.equal(name,'node:fs');const m=new SyntheticModule(Object.keys(fs),function(){for(const[k,v]of Object.entries(fs))this.setExport(k,v);},{context:vmContext});await m.link(()=>{});await m.evaluate();return m;},identifier:path.resolve(packet,'scripts/guard.mjs'),initializeImportMeta:m=>m.url=pathToFileURL(path.resolve(packet,'scripts/guard.mjs')).href});const imports={'node:fs':fs,'node:path':path,'node:url':{fileURLToPath},'node:crypto':crypto,'node:util':util};await module.link(name=>{const obj=imports[name];assert.ok(obj);return new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:vmContext});});await module.evaluate();return{base,packet,module:module.namespace,review,put,expectedFiles:manifest.files.length,env:vmContext.process.env,vmContext};}
function approval(h){fs.mkdirSync(h.module.scratch,{recursive:true,mode:0o700});const value={independent:true,verdict:'PASS',freezeSha256:digest(fs.readFileSync(path.resolve(h.packet,'runtime-freeze.json'))),preservationManifestSHA256:h.review.preservationManifestSHA256};const file=path.resolve(h.module.scratch,'preparation-review.json');fs.writeFileSync(file,JSON.stringify(value)+'\n',{mode:0o600});return{value,file};}


export{context,approval,digest,root,repo,kind};
