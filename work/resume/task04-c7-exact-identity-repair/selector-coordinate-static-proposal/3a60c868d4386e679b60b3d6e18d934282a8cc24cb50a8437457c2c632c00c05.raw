import assert from'node:assert/strict';import{readFileSync,writeFileSync}from'node:fs';import{resolve}from'node:path';import{createHash}from'node:crypto';import{SourceTextModule,SyntheticModule,createContext}from'node:vm';import{inspect}from'node:util';
const repo='/workspace/Project-Cortex',hash=x=>createHash('sha256').update(x).digest('hex');for(const kind of['extension','regression','extra']){const root=resolve(repo,'/dev/shm/cortex-native-c7-exact-identity-repair/mirror/_goals/convex-backend-runtime-2026-10-02/qa/task04-model-drift-native-'+kind+'-preparation-c5'),source=readFileSync(resolve(root,'scripts/driver.mjs'),'utf8'),request=JSON.parse(readFileSync(resolve(root,'project-request.json'))),results=[];for(const mode of['healthy','target','private-env','publication']){let preflights=0,clientCalls=0;const target={operation:request.operation,deploymentUrl:'https://dummy-not-actual.invalid'},values={CONVEX_DEPLOY_KEY:'DUMMY_SECRET_INITIAL'},publication={publicationManifest:{sha256:'f'.repeat(64)}};const fresh=tier=>{preflights++;const out=structuredClone({target,values,publication});if(preflights>1){assert.equal(tier,'rpc');if(mode==='target')out.target.operation='DUMMY_CHANGED';if(mode==='private-env')out.values.CONVEX_DEPLOY_KEY='DUMMY_SECRET_CHANGED_NEVER_PRINT';if(mode==='publication')out.publication.publicationManifest.sha256='a'.repeat(64);}return out;};const parent={operation:request.operation,runId:request.runId,identities:Object.fromEntries(['expiredJWT','foreign','forgedJWT','noJWT','ungranted','wrongAudience','wrongIssuer'].map(x=>[x,null]))};class Client{constructor(url,options){this.url=url;this.port=options.fetch;}setAdminAuth(){}setAuth(){}async query(ref,args){const response=await this.port(this.url+'/api/query',{method:'POST',body:JSON.stringify({path:ref,format:'convex_encoded_json',args:[args]})});return (await response.json()).value;}}
