import assert from'node:assert/strict';import*as fs from'node:fs';import*as path from'node:path';import{randomUUID}from'node:crypto';import{prepared}from'./reviewer-prepared-guard.mjs';import{kind,root}from'./reviewer-dispatch-context.mjs';import{SourceTextModule,SyntheticModule}from'node:vm';
const results=[];for(const mode of['response-known','response-then-settled','settle-fsync-failure','settle-close-failure','settle-partial-zero','duplicate-response','out-of-order-response','pending-snapshot-no-reset']){let armed=false,writes=0,primary=Error('DUMMY_SETTLEMENT_PRIMARY');const h=await prepared({writeSync(fd,value,...args){if(armed&&mode==='settle-partial-zero'){if(writes++)return 0;return fs.writeSync(fd,Buffer.from(value).subarray(0,1));}return fs.writeSync(fd,value,...args);},fsyncSync(fd){if(armed&&mode==='settle-fsync-failure')throw primary;return fs.fsyncSync(fd);},closeSync(fd){fs.closeSync(fd);if(armed&&mode==='settle-close-failure')throw primary;}});const ticket=await h.module.reserveTicket('native',h.module.limits.nativeClientRpc),p=path.resolve(h.module.scratch,'ticket-native-0001.json'),prefix=fs.readFileSync(p);h.module.creationDispatched(ticket);let error;if(mode==='pending-snapshot-no-reset'){assert.throws(()=>h.module.creationAcknowledge(ticket),/QA_CREATION_UNKNOWN/);assert.equal(h.module.creationCustodyCounts().unknownCreationCalls,1);}else{h.module.creationResponseKnown(ticket);if(mode==='duplicate-response')assert.throws(()=>h.module.creationResponseKnown(ticket),/QA_CREATION_STATE/);if(mode==='response-then-settled'||mode.startsWith('settle-')){armed=true;try{h.module.creationSettled(ticket);}catch(e){error=e;}armed=false;}if(mode==='out-of-order-response'){h.module.creationSettled(ticket);assert.throws(()=>h.module.creationResponseKnown(ticket),/QA_CREATION_STATE/);}}assert.equal(fs.readFileSync(p).subarray(0,prefix.length).equals(prefix),true);const counts=h.module.creationCustodyCounts();if(mode==='response-then-settled'||mode==='out-of-order-response')assert.equal(counts.uncertainCreationCalls,0);else assert.equal(counts.uncertainCreationCalls,1);if(mode==='settle-fsync-failure'||mode==='settle-close-failure')assert.equal(error,primary);if(mode==='settle-partial-zero')assert.ok(error);const fresh=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts/guard.mjs'),'utf8'),{context:h.vmContext,identifier:path.resolve(h.packet,'scripts/guard.mjs'),initializeImportMeta:m=>m.url='file://'+path.resolve(h.packet,'scripts/guard.mjs')});await fresh.link(async n=>{const obj=await import(n);return new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:h.vmContext});});await fresh.evaluate();assert.equal(fresh.namespace.creationCustodyCounts().uncertainCreationCalls,1,'readable terminal bytes never certify prior fsync/close in a new process');results.push({mode,status:'PASS',counts,fresh:JSON.parse(JSON.stringify(fresh.namespace.creationCustodyCounts())),error:error?.message??null,prefixBytes:prefix.length,ticketBytes:fs.statSync(p).size});}const name='creation-durability-'+randomUUID()+'.json';fs.writeFileSync(path.resolve(root,'evidence',name),JSON.stringify({kind,results,native:'NOT_RUN'},null,2)+'\n');console.log(kind+' '+results.length+' durability controls PASS '+name);
