import assert from'node:assert/strict';import*as fs from'node:fs';import*as path from'node:path';import{randomUUID}from'node:crypto';import{SourceTextModule,SyntheticModule}from'node:vm';import{actualDriver}from'./actual-driver-harness.mjs';import{kind,root}from'./reviewer-dispatch-context.mjs';
const results=[];
for(const mode of['healthy-owned-seed','return-lost-seed','atomic-rejection','auth-before-handler','readonly-action','ambiguous-action','journal-failure-after-known-response','ownership-failure-after-known-response']){
 const{h,driver}=await actualDriver();let dispatches=0;h.vmContext.fetch=async(url,options)=>{dispatches++;const input=JSON.parse(options.body);if(input.path==='qualificationOwned:seed'){if(mode==='return-lost-seed')throw Error('DUMMY_RETURN_LOST_POSSIBLE_SEVEN_CREATED');if(mode==='atomic-rejection')return new Response(JSON.stringify({status:'error',errorMessage:'DUMMY',errorData:{code:'DUMMY_ROLLED_BACK'}}),{status:560});if(mode==='auth-before-handler')return new Response(JSON.stringify({code:'InvalidAuth',message:'DUMMY'}),{status:403});return new Response(JSON.stringify({status:'success',value:{createdRefs:mode==='ownership-failure-after-known-response'?[{table:'runtimePrincipals',id:'x'.repeat(129)}]:Array.from({length:7},(_,i)=>({table:'runtimePrincipals',id:'DUMMY_ROW_'+i}))}}),{status:200});}if(input.path==='qualificationOwned:snapshot')return new Response(JSON.stringify({status:'success',value:[]}),{status:200});if(input.path==='qualificationOwned:cleanup')return new Response(JSON.stringify({status:'success',value:{deletedRefs:[]}}),{status:200});throw Error('DUMMY_ACTION_RETURN_LOST');};const s=await driver.namespace.session('synthetic');if(mode==='journal-failure-after-known-response')s.journal.append=()=>{throw Error('DUMMY_JOURNAL_PERSISTENCE');};let error;try{await s.rpc(mode.endsWith('action')?'action':'mutation',mode==='readonly-action'?'runtimeMemory:remember':mode==='ambiguous-action'?'qualificationOwned:DUMMY_unknown_action':'qualificationOwned:seed',{});}catch(e){error=e;}
 const ambiguous=['return-lost-seed','ambiguous-action','journal-failure-after-known-response','ownership-failure-after-known-response'].includes(mode);assert.equal(s.counts().uncertainCreationCalls,ambiguous?1:0);if(mode==='healthy-owned-seed')assert.equal(s.counts().cumulativeCreatedRows,7);if(mode==='return-lost-seed')assert.equal(s.counts().cumulativeCreatedRows,0,'unknown IDs may not be invented');if(mode==='return-lost-seed'){await s.rpc('query','qualificationOwned:snapshot',{run:s.runId});await s.rpc('mutation','qualificationOwned:cleanup',{run:s.runId});await s.rpc('query','qualificationOwned:snapshot',{run:s.runId});assert.equal(s.custodyComplete(),false,'snapshot triple cannot establish cancellation or rollback');assert.equal(s.counts().uncertainCreationCalls,1);}
 // Fresh guard module, same persisted namespace: process-local latch cannot reset ambiguity.
 const fresh=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts/guard.mjs'),'utf8'),{context:h.vmContext,identifier:path.resolve(h.packet,'scripts/guard.mjs'),initializeImportMeta:m=>m.url='file://'+path.resolve(h.packet,'scripts/guard.mjs')});await fresh.link(async spec=>{const obj=await import(spec);return new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:h.vmContext});});await fresh.evaluate();assert.equal(fresh.namespace.uncertainCreationCount(),mode==='readonly-action'?0:1,'fresh process cannot infer durable custody from readable terminal bytes');assert.equal(fresh.namespace.creationCustodyCounts().unknownCreationCalls,ambiguous?1:0);assert.equal(fresh.namespace.creationCustodyCounts().knownUndurableCreationCalls,['healthy-owned-seed','atomic-rejection','auth-before-handler'].includes(mode)?1:0);s.close();results.push({kind,mode,dispatches,error:error?.message??null,uncertainCreationCalls:s.counts().uncertainCreationCalls,knownCreatedRows:s.counts().cumulativeCreatedRows,custodyComplete:s.custodyComplete(),source:'EXACT_DRIVER_GUARD_INSTALLED_SDK_DUMMY_FETCH_NO_NATIVE',status:'PASS'});console.log(JSON.stringify(results.at(-1)));
}
fs.writeFileSync(path.resolve('/dev/shm/cortex-native-c7-exact-identity-repair/mirror/work/resume/task04-model-drift-native-preparation-c5',kind+'-creation-dispatch-'+randomUUID()+'.json'),JSON.stringify({results,native:'NOT_RUN'},null,2)+'\n');
