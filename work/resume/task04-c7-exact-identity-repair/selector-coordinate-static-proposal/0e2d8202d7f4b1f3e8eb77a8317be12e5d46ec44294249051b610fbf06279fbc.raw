import fs from'node:fs';import path from'node:path';import vm from'node:vm';import assert from'node:assert/strict';import{composition}from'./composition-engine.mjs';import{captureRows,actualRow,heldBytes}from'./preimage-store.mjs';import{reconstructParent}from'./vm-consumer.mjs';import{launchRoot}from'./root-launcher.mjs';import{rootApprovalPath,rootPinPath}from'./root-gate.mjs';
const W=path.dirname(new URL(import.meta.url).pathname),raw={...fs};
export async function executeExternalReview(supplied){const root=supplied.endsWith('/')?supplied.slice(0,-1):supplied;if(!/^\/tmp\/cortex-native-c6-independent-review-[a-z0-9-]+$/.test(root)||raw.realpathSync.native(root)!==root)throw Error('QA_C6_EXTERNAL_ROOT');const configPath=root+'/review-session.json',config=JSON.parse(heldBytes(configPath));assert.deepEqual(Object.keys(config).sort(),['absoluteDeadline','kind']);assert.equal(config.kind,'OWN_EXTERNAL_REVIEW_NOT_APPROVAL');assert.ok(Number.isSafeInteger(config.absoluteDeadline));assert.equal(raw.existsSync(rootApprovalPath),false);assert.equal(raw.existsSync(rootPinPath),false);await assert.rejects(()=>launchRoot('inventory-extra'),/QA_BRIDGE_ROOT_APPROVAL_ABSENT/);await assert.rejects(()=>launchRoot('inventory-extra','release'),/QA_BRIDGE_COMMAND_ID/);const entry=root+'/control.mjs',prepared=composition({id:'inventory-extra',mode:'REVIEW',root,entry,configRow:actualRow(configPath),parentAbsoluteDeadline:config.absoluteDeadline}),before=captureRows(prepared.dispatchInputs(),{root:prepared.archiveRoot});raw.writeFileSync(prepared.directory+'/before-install.json',JSON.stringify(before)+'\n',{flag:'wx',mode:0o600});const prior={SourceTextModule:vm.SourceTextModule,runInContext:vm.runInContext,readFileSync:fs.readFileSync},ports=await prepared.install();let primary;try{const rules=JSON.parse(heldBytes(W+'/finite-producer-rules.json')).perId.OWN_EXTERNAL_REVIEW,context=vm.createContext({Buffer,URL,setTimeout,clearTimeout,AbortSignal});function construct(source){return new vm.SourceTextModule(source,{context});}function json(){return vm.runInContext('JSON',context);}const helper=heldBytes(rules.calls.find(r=>r.kind==='SourceTextModule').sources.find(r=>r.path.endsWith('/bounded-response.mjs')).path).toString(),m=construct(helper);assert.match(m.identifier,/^vm:module\(/);await m.link(()=>assert.fail('OWN_HELPER_IMPORT_UNEXPECTED'));await m.evaluate();assert.equal(json().stringify({proof:17}),'{"proof":17}');for(const r of rules.calls.find(r=>r.kind==='SourceTextModule').sources.filter(r=>r.path.endsWith('/parent-inputs.mjs'))){construct(reconstructParent(heldBytes(r.path).toString()));}assert.throws(()=>construct(helper+'\n//UNKNOWN'),/QA_C6_VM_RECIPE/);const p=path.join(prepared.directory,'OWN-read.txt');fs.writeFileSync(p,'OWN_EXTERNAL_FD_17',{flag:'wx',mode:0o600});assert.equal(fs.readFileSync(p,'utf8'),'OWN_EXTERNAL_FD_17');const h=await fs.promises.open(p,'r');try{assert.equal(await h.readFile('utf8'),'OWN_EXTERNAL_FD_17');}finally{await h.close();}assert.throws(()=>fs.readFileSync(root+'/UNKNOWN_NOT_ADMITTED'),/QA_BRIDGE_OUTPUT_BINDING/);const {build}=await import('esbuild'),out=path.join(prepared.directory,'bundle.mjs');await build({stdin:{contents:'export const preparedCompositionValue=17;',loader:'js'},outfile:out,format:'esm',platform:'node',logLevel:'silent'});const loaded=await import('file://'+out);assert.equal(loaded.preparedCompositionValue,17);assert.equal(ports.compiler.receipts.at(-1).service.rawComplete,true);assert.ok(prepared.ledger.events.some(e=>e.classification==='EXACT_VM_CONSUMER_RECIPE'));}catch(e){primary=e;}const cleanup=await ports.close(primary);assert.equal(vm.SourceTextModule,prior.SourceTextModule);assert.equal(vm.runInContext,prior.runInContext);assert.equal(fs.readFileSync,prior.readFileSync);prepared.sourceFence();const sourcePOST=prepared.closure.map(r=>actualRow(r.path));assert.ok(sourcePOST.every((r,i)=>r.sha256===prepared.closure[i].sha256&&r.bytes===prepared.closure[i].bytes));assert.ok(Date.now()<config.absoluteDeadline);raw.writeFileSync(root+'/review-result.json',JSON.stringify({status:'PASS_CURRENT_OWN_EXTERNAL_VM_FS_COMPILER_AND_RESTORATION',before:prepared.directory+'/before-install.json',sourcePOST,cleanup,ledger:prepared.ledger.ledgerPath,compilerReceipts:ports.compiler.receipts,original122:'HELD'})+'\n',{flag:'wx',mode:0o600});assert.ok(Date.now()<config.absoluteDeadline);console.log('PASS_CURRENT_OWN_EXTERNAL_VM_FS_COMPILER_AND_RESTORATION');}
