import assert from'node:assert/strict';import *as fs from'node:fs';import *as path from'node:path';import{SourceTextModule,SyntheticModule}from'node:vm';import{prepared}from'./prepared-guard.mjs';import{root,kind,digest}from'./dispatch-context.mjs';import{randomUUID}from'node:crypto';
const results=[];for(const mode of ['healthy','project-response-lost','key-response-lost','project-write-zero','project-fsync','project-close','key-env-fsync','settlement-fsync']){const h=await prepared(),request=JSON.parse(fs.readFileSync(path.resolve(h.packet,'project-request.json'))),target=h.baseline.target;h.env.CONVEX_TEAM_ID='DUMMY_TEAM';h.env.CONVEX_TEAM_API_KEY='DUMMY_NONCREDENTIAL';for(const n of['target.json','deploy.env'])fs.unlinkSync(path.resolve(h.module.scratch,n));h.env.CORTEX_QA_TASK04_KEY_CHECK_RECEIPT=path.resolve(h.module.scratch,'key-check.json');h.putPrivate('key-check.json',{operation:request.operation,status:'PASS',publicKeyMatches:true,freezeSha256:digest(fs.readFileSync(path.resolve(h.packet,'runtime-freeze.json'))),authConfigSha256:digest(fs.readFileSync(path.resolve(root,'fixture/convex/auth.config.ts')))});h.vmContext.process.stdout={write(){}};const guard={...h.module,fixture:path.resolve(root,'fixture')};let calls=0,failed=false;const fdPaths=new Map();const applies=p=>p&&(mode.startsWith('project-')?p.endsWith('/created-project.json'):mode==='key-env-fsync'?p.endsWith('/deploy.env'):mode==='settlement-fsync'?p.endsWith('/management-provision-ticket-1.json'):false);const ports={...fs,openSync(p,...a){const fd=fs.openSync(p,...a);fdPaths.set(fd,p);return fd;},writeSync(fd,...a){if(mode==='project-write-zero'&&applies(fdPaths.get(fd))&&!failed){failed=true;return 0;}return fs.writeSync(fd,...a);},fsyncSync(fd){if((mode==='project-fsync'||mode==='key-env-fsync'||mode==='settlement-fsync')&&applies(fdPaths.get(fd))&&!failed){failed=true;throw Error('DUMMY_PERSIST_PRIMARY');}return fs.fsyncSync(fd);},closeSync(fd){const p=fdPaths.get(fd);fs.closeSync(fd);fdPaths.delete(fd);if(mode==='project-close'&&applies(p)&&!failed){failed=true;throw Error('DUMMY_CLOSE_PRIMARY');}}};const project={id:target.projectId,slug:request.projectSlug,name:request.projectName,deploymentName:target.deploymentName,deploymentUrl:target.deploymentUrl},deployment={name:target.deploymentName,projectId:target.projectId,deploymentType:'dev',kind:'cloud',deploymentUrl:target.deploymentUrl};const bodies=[project,project,deployment,[deployment],{deployKey:'dev:'+target.deploymentName+'|DUMMY_NONCREDENTIAL'}];h.vmContext.fetch=async()=>{const n=++calls;if(mode==='project-response-lost'&&n===1||mode==='key-response-lost'&&n===5)throw Error('DUMMY_TRANSPORT_LOSS');let read=0;return{status:200,body:{getReader(){return{async read(){return ++read===1?{done:false,value:Buffer.from(JSON.stringify(bodies[n-1]))}:{done:true};},async cancel(){},releaseLock(){}};}}};};const synth=obj=>new SyntheticModule(Object.keys(obj),function(){for(const[k,v]of Object.entries(obj))this.setExport(k,v);},{context:h.vmContext});const loaded=new Map();async function load(name){if(loaded.has(name))return loaded.get(name);const m=new SourceTextModule(fs.readFileSync(path.resolve(root,'scripts',name),'utf8'),{context:h.vmContext});loaded.set(name,m);await m.link(async n=>n==='./guard.mjs'?synth(guard):n==='node:fs'?synth(ports):n.startsWith('./')?load(n.slice(2)):synth(await import(n)));return m;}const entry=await load('provision.mjs');let error;try{await entry.evaluate();}catch(e){error=e;}const outcome=JSON.parse(fs.readFileSync(path.resolve(h.module.scratch,'management-provision-outcome.json'))),ticket=fs.readFileSync(path.resolve(h.module.scratch,'management-provision-ticket-1.json'),'utf8');assert.equal(outcome.creationPossible,mode!=='healthy');assert.equal(outcome.custodyComplete,mode==='healthy');assert.equal(outcome.status,mode==='healthy'?'PASS':'FAIL');assert.equal(calls,mode==='healthy'||mode.startsWith('key-')?5:1);assert.equal(outcome.creationDispatches,calls===5?2:1);assert.equal(outcome.creationResponses,mode==='healthy'?2:calls===5?1:0);assert.ok(ticket.includes('"creationPossible": true'));if(mode==='healthy')assert.equal(error,undefined);else assert.ok(error);results.push({mode,calls,outcome,error:error?.message??null,scope:'EXACT_SOURCE_MANAGEMENT_ACTUAL_FETCH_BOUNDARY_DUMMY_ONLY',status:'PASS'});}
const name='management-custody-'+randomUUID()+'.json';fs.writeFileSync(path.resolve(root,'evidence',name),JSON.stringify({kind,results,sourceSHA256:digest(fs.readFileSync(path.resolve(root,'scripts/management-transport.mjs'))),native:'NOT_RUN'},null,2)+'\n');console.log(kind+' '+results.length+' management creation custody controls PASS '+name);
